---
interface Props {
	href: string;
	label?: string;
	class?: string;
}

const { href, label = 'See More', class: className } = Astro.props;
---

<a
	href={href}
	class:list={[
		'inline-flex min-h-[34px] min-w-[108px] items-center justify-center rounded-full bg-gradient-to-r from-[#4A3B96] to-[#1D70B8] px-7 py-2 font-sans text-[12px] font-normal text-white no-underline transition hover:opacity-90 border border-white/10 shadow-sm',
		className
	]}
>
	{label}
</a>
