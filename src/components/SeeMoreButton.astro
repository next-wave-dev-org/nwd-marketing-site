---
interface Props {
	href: string;
	label?: string;
	class?: string;
}

const { href, label = 'See More', class: className } = Astro.props;
---

<a
	href={href}
	class:list={[
		'inline-flex min-h-[34px] min-w-[108px] items-center justify-center rounded-full bg-dark-blue px-7 py-2 font-sans text-[12px] font-normal text-white no-underline transition hover:bg-black',
		className
	]}
>
	{label}
</a>
