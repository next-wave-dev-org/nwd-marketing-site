---
export interface Props {
    title: string;
    description: string;
    teaser: string;
}

const { title, description, teaser } = Astro.props;
---

<div class="flex w-[370px] flex-col items-center">
    <!-- Grey Card Header Box (relative wrapper) -->
    <div class="relative h-[104px] w-full shrink-0 rounded-[10px] bg-[#CFCFCF]">
        
        <!-- Package Title: Pulled all the way to the top edge -->
        <h3 class="absolute left-0 top-[-20px] m-0 w-full whitespace-nowrap p-0 text-center font-['Inter'] text-[40px] font-semibold leading-none text-black">
            {title}
        </h3>
        
        <!-- Description: Pulled up to maintain the exact 12px gap below the title -->
        <p class="absolute left-0 top-[40px] m-0 w-full whitespace-nowrap p-0 text-center font-['Inter'] text-[24px] font-semibold leading-none text-black">
            {description}
        </p>
        
    </div>

    <!-- Teaser Body Text -->
    <p class="m-0 mt-[45px] w-[346px] whitespace-pre-line p-0 text-center font-['Inter'] text-[32px] font-normal leading-[39px] text-black">
        {teaser}
    </p>
</div>