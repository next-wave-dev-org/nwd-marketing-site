---
export interface Props { title: string; description: string; teaser: string; }
const { title, description, teaser } = Astro.props;
---
<div class="w-full">
  <!-- UNIFIED RESPONSIVE CARD -->
  <div class="flex flex-col items-center w-full max-w-[350px] md:max-w-none md:w-[370px] mx-auto md:mx-0">
    
    <div class="relative flex flex-col md:block h-auto md:h-[104px] w-full shrink-0 items-center justify-center gap-4 md:gap-0 rounded-[10px] bg-light-aqua py-8 md:py-0">
        <h3 class="m-0 w-full text-center md:absolute md:left-0 md:top-[-20px] md:whitespace-nowrap md:p-0 font-inter text-[32px] md:text-[40px] font-semibold leading-none text-black">{title}</h3>
        <p class="m-0 w-full text-center md:absolute md:left-0 md:top-[40px] md:whitespace-nowrap md:p-0 font-inter text-[18px] md:text-[24px] font-semibold leading-none text-black">{description}</p>
    </div>
    
    <div class="m-0 mt-8 md:mt-[45px] w-full md:w-[346px] px-4 md:px-0 md:p-0 text-center font-inter text-[20px] md:text-[32px] font-normal leading-tight md:leading-[39px] text-black" set:html={teaser} />
  
  </div>
</div>