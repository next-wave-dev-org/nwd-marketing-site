---
export interface Props { title: string; description: string; teaser: string; }
const { title, description, teaser } = Astro.props;
---
<div class="w-full">
  
  <!-- MOBILE (< 768px) -->
  <div class="mobile-pricing-card flex-col items-center w-full max-w-[350px] mx-auto">
    <div class="relative flex h-auto w-full flex-col items-center justify-center gap-4 rounded-[10px] bg-light-aqua py-8">
        <h3 class="m-0 w-full text-center font-inter text-[32px] font-semibold leading-none text-black">{title}</h3>
        <p class="m-0 w-full text-center font-inter text-[18px] font-semibold leading-none text-black">{description}</p>
    </div>
    <!-- Updated to a div and using set:html to render the image and list tags -->
    <div class="m-0 mt-8 w-full px-4 text-center font-inter text-[20px] font-normal leading-tight text-black" set:html={teaser} />
  </div>

  <!-- DESKTOP (>= 768px) -->
  <div class="desktop-pricing-card flex w-[370px] flex-col items-center">
    <div class="relative h-[104px] w-full shrink-0 rounded-[10px] bg-light-aqua">
        <h3 class="absolute left-0 top-[-20px] m-0 w-full whitespace-nowrap p-0 text-center font-['Inter'] text-[40px] font-semibold leading-none text-black">{title}</h3>
        <p class="absolute left-0 top-[40px] m-0 w-full whitespace-nowrap p-0 text-center font-['Inter'] text-[24px] font-semibold leading-none text-black">{description}</p>
    </div>
    <!-- Updated to a div and using set:html to render the image and list tags -->
    <div class="m-0 mt-[45px] w-[346px] p-0 text-center font-['Inter'] text-[32px] font-normal leading-[39px] text-black" set:html={teaser} />
  </div>

</div>

<style is:global>
  @media (min-width: 768px) { .mobile-pricing-card { display: none !important; } .desktop-pricing-card { display: flex !important; } }
  @media (max-width: 767px) { .desktop-pricing-card { display: none !important; } .mobile-pricing-card { display: flex !important; } }
</style>