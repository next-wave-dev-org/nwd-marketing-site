---
// src/components/HeroPanel.astro
import Button from './Button.astro';
import { Image } from 'astro:assets';
---
<div class="w-full flex justify-center mt-4 md:mt-0">
  
  <!-- UNIFIED RESPONSIVE HERO -->
  <div class="mx-auto flex w-full flex-col gap-6 md:gap-0 overflow-hidden rounded-[20px] bg-gradient-to-b from-surface to-background border border-border-subtle shadow-xl p-4 sm:p-6 md:p-10">
      
      <!-- Image & Title Container -->
      <section class="relative flex min-h-[420px] md:min-h-[600px] w-full flex-col items-center justify-center md:items-start rounded-[15px] overflow-hidden shadow-lg py-10 px-4 md:p-0 md:pl-[60px] lg:pl-[120px]">
          
          <Image src="/images/hero-wave-innovation.jpg" alt="Building the Next Wave of Digital Innovation" width={1920} height={1080} loading="eager" decoding="sync" class="absolute inset-0 w-full h-full object-cover opacity-60" />
          <div class="absolute inset-0 bg-background/70"></div>
          
          <div class="relative z-10 flex flex-col items-center">
              
              <!-- Main Hero Circle (Now with the Button Gradient) -->
              <div class="flex h-[180px] w-[180px] sm:h-[220px] sm:w-[220px] md:h-[450px] md:w-[450px] shrink-0 items-center justify-center rounded-full bg-gradient-to-r from-accent-primary to-accent-secondary shadow-2xl transition-transform hover:scale-105 p-2 xl:p-8 border border-border-subtle">
                  <h1 class="w-full text-center font-heading text-[28px] sm:text-[34px] md:text-[56px] lg:text-[64px] font-bold leading-tight text-text-heading drop-shadow-lg break-words">
                      Next<br/>Wave<br/>Dev
                  </h1>
              </div>
              
              <!-- Primary CTA -->
              <div class="mt-8 md:mt-10 relative z-10 w-full max-w-[250px] md:max-w-none flex justify-center md:block">
                  <Button href="/contact" label="Work with Us" variant="primary" />
              </div>
          </div>
          
      </section>

      <!-- Partner Logos -->
      <div aria-label="Partner logos" class="relative flex w-full flex-wrap items-center justify-center gap-10 md:gap-[100px] pt-4 md:pt-0 pb-4 md:pb-0 md:mt-12 md:mb-4">
          <Image src="/images/partner-dtb-logo.png" alt="Draw The Block Partner" width={400} height={200} loading="lazy" decoding="async" class="h-[60px] md:h-[100px] w-auto object-contain transition-transform hover:scale-105 drop-shadow-md brightness-125" />
          <Image src="/images/partner-ccg-logo.png" alt="Card Cave Games Partner" width={400} height={200} loading="lazy" decoding="async" class="h-[60px] md:h-[100px] w-auto object-contain transition-transform hover:scale-105 drop-shadow-md brightness-125" />
      </div>
      
  </div>
</div>