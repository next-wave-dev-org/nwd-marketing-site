---
import Button from './Button.astro';
---
<div class="w-full flex justify-center">

  <!-- =============================== -->
  <!-- MOBILE HERO (< 768px)           -->
  <!-- =============================== -->
  <div id="mobile-hero" class="w-full flex-col px-6 mt-4">
    <div class="w-full flex flex-col gap-6 rounded-[10px] bg-gradient-to-b from-light-aqua to-secondary-blue p-4 sm:p-6 shadow-md">
      <div class="relative flex min-h-[420px] w-full flex-col items-center justify-center overflow-hidden rounded-[10px] shadow-sm py-10 px-4">
        
        <img src="/images/hero-wave-innovation.jpg" alt="Building the Next Wave of Digital Innovation" class="absolute inset-0 w-full h-full object-cover opacity-90" />
        <div class="absolute inset-0 bg-black/10"></div>
        
        <div class="relative z-10 flex h-[180px] w-[180px] sm:h-[220px] sm:w-[220px] shrink-0 items-center justify-center rounded-full bg-primary-blue shadow-xl p-2 transition-transform hover:scale-105">
          <span class="w-full font-heading text-[28px] sm:text-[34px] font-bold leading-tight text-hero-text text-center drop-shadow-sm [text-shadow:-1px_-1px_0_#D49A1D,_1px_-1px_0_#D49A1D,_-1px_1px_0_#D49A1D,_1px_1px_0_#D49A1D] break-words">
            Next<br/>Wave<br/>Dev
          </span>
        </div>
        
        <div class="relative z-10 mt-8 w-full max-w-[250px]">
          <a href="/contact" class="inline-flex w-full items-center justify-center rounded-[30px] bg-dark-blue px-4 py-[12px] font-roboto text-[16px] font-bold text-white transition-colors hover:bg-black shadow-md text-center">
            Work with Us
          </a>
        </div>
        
      </div>

      <div class="flex flex-wrap items-center justify-center gap-6 pt-2 pb-2">
        <div class="flex h-[100px] w-[100px] sm:h-[120px] sm:w-[120px] flex-shrink-0 items-center justify-center rounded-full bg-primary-blue shadow-md overflow-hidden">
          <img src="/images/partner-dtb-logo.png" alt="DTB Art Market Partner" class="h-full w-full object-cover" />
        </div>
        <div class="flex h-[100px] w-[100px] sm:h-[120px] sm:w-[120px] flex-shrink-0 items-center justify-center rounded-full bg-primary-blue shadow-md overflow-hidden">
          <img src="/images/partner-ccg-logo.png" alt="CCG Partner" class="h-full w-full object-cover" />
        </div>
      </div>

    </div>
  </div>


  <!-- =============================== -->
  <!-- DESKTOP HERO (>= 768px)         -->
  <!-- =============================== -->
  <div id="desktop-hero" class="mx-auto flex w-full max-w-[1289px] flex-col overflow-hidden rounded-[10px] bg-gradient-to-b from-light-aqua to-secondary-blue shadow-lg p-10">
      
      <section class="relative flex min-h-[600px] w-full flex-col justify-center items-start pl-[60px] lg:pl-[120px] rounded-[15px] shadow-lg overflow-hidden">
          
          <img src="/images/hero-wave-innovation.jpg" alt="Building the Next Wave of Digital Innovation" class="absolute inset-0 w-full h-full object-cover opacity-90" />
          <div class="absolute inset-0 bg-black/10"></div>
          
          <div class="relative z-10 flex flex-col items-center">
              
              <div class="flex h-[450px] w-[450px] items-center justify-center rounded-full bg-primary-blue shadow-2xl transition-transform hover:scale-105 p-8">
                  <span class="w-full text-center font-heading text-[56px] lg:text-[64px] font-bold leading-tight text-hero-text drop-shadow-card [text-shadow:-3px_-3px_0_#D49A1D,_3px_-3px_0_#D49A1D,_-3px_3px_0_#D49A1D,_3px_3px_0_#D49A1D] break-words">
                      Next<br/>Wave<br/>Dev
                  </span>
              </div>
              
              <div class="mt-10">
                  <Button href="/contact" label="Work with Us" />
              </div>

          </div>
          
      </section>

      <div aria-label="Partner logos" class="relative flex w-full items-center justify-center mt-12 mb-4">
          <div class="flex items-center gap-[47px]">
              <div class="flex h-[168px] w-[168px] flex-shrink-0 items-center justify-center rounded-full bg-primary-blue shadow-md transition-transform hover:scale-105 overflow-hidden">
                <img src="/images/partner-dtb-logo.png" alt="DTB Art Market Partner" class="h-full w-full object-cover" />
              </div>
              <div class="flex h-[168px] w-[168px] flex-shrink-0 items-center justify-center rounded-full bg-primary-blue shadow-md transition-transform hover:scale-105 overflow-hidden">
                <img src="/images/partner-ccg-logo.png" alt="CCG Partner" class="h-full w-full object-cover" />
              </div>
          </div>
      </div>
      
  </div>

</div>

<style is:global>
  @media (min-width: 768px) {
    #mobile-hero { display: none !important; }
    #desktop-hero { display: flex !important; }
  }
  @media (max-width: 767px) {
    #desktop-hero { display: none !important; }
    #mobile-hero { display: flex !important; }
  }
</style>