---
import Button from './Button.astro';
---

<div class="w-full flex justify-center">

  <!-- MOBILE HERO (< 768px) -->
  <div id="mobile-hero" class="w-full flex-col overflow-hidden bg-gradient-to-b from-light-aqua to-secondary-blue p-6 gap-8 rounded-[10px]">
    <div class="mx-auto mt-4 flex h-[280px] w-[280px] shrink-0 items-center justify-center rounded-full bg-primary-blue">
      <span class="font-heading text-[56px] font-bold leading-none text-hero-text drop-shadow-card text-center">Next<br/>Wave<br/>Dev</span>
    </div>
    <div class="font-sans text-[20px] font-normal text-black text-center mt-4">
      Supporting the next generation of developers
    </div>
    <div class="font-sans text-[18px] font-normal text-black text-center mt-4">
      marketing image*
    </div>
    <div class="flex justify-center mt-4">
      <Button href="/contact" label="Work with Us" />
    </div>
    <div class="flex flex-wrap items-center justify-center gap-6 mt-8 py-8 border-t border-gray-400">
      {[1, 2, 3, 4].map(() => (
        <div class="flex h-[120px] w-[120px] flex-shrink-0 items-center justify-center rounded-full bg-primary-blue shadow-md">
          <span class="font-sans text-[16px] font-bold leading-none text-white text-center">company<br/>logo</span>
        </div>
      ))}
    </div>
  </div>

  <!-- DESKTOP HERO (>= 768px) -->
  <!-- EXACT ORIGINAL DESKTOP CODE -->
  <div id="desktop-hero" class="mx-auto flex w-full max-w-[1289px] flex-col overflow-hidden rounded-[10px] bg-gradient-to-b from-light-aqua to-secondary-blue">
      <section class="relative flex h-[489px] w-full items-center">
          <div class="absolute left-[47px] top-[19px] z-10 flex h-[390px] w-[390px] items-center justify-center rounded-full bg-primary-blue">
              <span class="font-heading text-[96px] font-bold leading-none text-hero-text drop-shadow-card">
                  Next<br/>Wave<br/>Dev
              </span>
          </div>
          <div class="absolute left-[669px] top-[164px] font-sans text-[20px] font-normal text-black">
              marketing image*
          </div>
          <div class="absolute left-[440px] top-[303px] w-[600px] font-sans text-[24px] font-normal leading-[33px] text-black">
              Supporting the next generation of developers
          </div>
          <div class="absolute left-[946px] top-[399px]">
              <Button href="/contact" label="Work with Us" />
          </div>
      </section>

      <div aria-label="Partner logos" class="relative flex h-[205px] w-full items-center">
          <div class="absolute left-[242px] flex items-center gap-[47px]">
              {[1, 2, 3, 4].map(() => (
                  <div class="flex h-[168px] w-[168px] flex-shrink-0 items-center justify-center rounded-full bg-primary-blue shadow-md transition-transform hover:scale-105">
                      <span class="font-sans text-[20px] font-bold leading-none text-white text-center">
                          company<br/>logo
                      </span>
                  </div>
              ))}
          </div>
      </div>
  </div>
</div>

<style is:global>
  /* PURE CSS FAILSAFE */
  @media (min-width: 768px) {
    #mobile-hero { display: none !important; }
    #desktop-hero { display: flex !important; }
  }
  @media (max-width: 767px) {
    #desktop-hero { display: none !important; }
    #mobile-hero { display: flex !important; }
  }
</style>