---
import Button from './Button.astro';
---

<div class="w-full flex justify-center">

  <!-- MOBILE HERO (< 768px) -->
  <div id="mobile-hero" class="w-full flex-col overflow-hidden bg-gradient-to-b from-light-aqua to-secondary-blue p-6 gap-8 rounded-[10px]">
    
    <!-- Updated Badge: Removed logo image, kept blue circle and gold-outlined text -->
    <div class="mx-auto mt-4 flex h-[280px] w-[280px] shrink-0 items-center justify-center rounded-full bg-primary-blue shadow-md">
      <span class="font-heading text-[56px] font-bold leading-none text-hero-text drop-shadow-card text-center [text-shadow:-2px_-2px_0_#D49A1D,_2px_-2px_0_#D49A1D,_-2px_2px_0_#D49A1D,_2px_2px_0_#D49A1D]">Next<br/>Wave<br/>Dev</span>
    </div>
    
    <!-- Hero Image -->
    <div class="w-full mt-4 flex justify-center">
      <div class="w-full max-w-[380px] rounded-[10px] shadow-md overflow-hidden">
        <img src="/images/hero-wave-innovation.jpg" alt="Building the Next Wave of Digital Innovation" class="w-full h-auto block" />
      </div>
    </div>

    <!-- Supporting Text -->
    <div class="font-sans text-[20px] font-normal text-black text-center mt-2">
    </div>

    <div class="flex justify-center mt-4">
      <Button href="/contact" label="Work with Us" />
    </div>

    <!-- Partner Logos -->
    <div class="flex flex-wrap items-center justify-center gap-6 mt-8 py-8 border-t border-gray-400">
      <div class="flex h-[120px] w-[120px] flex-shrink-0 items-center justify-center rounded-full bg-primary-blue shadow-md overflow-hidden">
        <img src="/images/partner-dtb-logo.png" alt="DTB Art Market Partner" class="h-full w-full object-cover" />
      </div>
      <div class="flex h-[120px] w-[120px] flex-shrink-0 items-center justify-center rounded-full bg-primary-blue shadow-md overflow-hidden">
        <img src="/images/partner-ccg-logo.png" alt="CCG Partner" class="h-full w-full object-cover" />
      </div>
    </div>
  </div>

  <!-- DESKTOP HERO (>= 768px) -->
  <div id="desktop-hero" class="mx-auto flex w-full max-w-[1289px] flex-col overflow-hidden rounded-[10px] bg-gradient-to-b from-light-aqua to-secondary-blue">
      <section class="relative flex h-[489px] w-full items-center">
          
          <!-- Updated Badge: Removed logo image, kept blue circle and gold-outlined text -->
          <div class="absolute left-[47px] top-[19px] z-10 flex h-[390px] w-[390px] items-center justify-center rounded-full bg-primary-blue shadow-lg">
              <span class="font-heading text-[96px] font-bold leading-none text-hero-text drop-shadow-card text-center [text-shadow:-3px_-3px_0_#D49A1D,_3px_-3px_0_#D49A1D,_-3px_3px_0_#D49A1D,_3px_3px_0_#D49A1D]">
                  Next<br/>Wave<br/>Dev
              </span>
          </div>
          
          <!-- Hero Image -->
          <div class="absolute left-[470px] top-[20px] w-[650px] rounded-[10px] shadow-lg overflow-hidden flex justify-center">
              <img src="/images/hero-wave-innovation.jpg" alt="Building the Next Wave of Digital Innovation" class="w-full h-auto block" />
          </div>
          
          <!-- Supporting Text -->
          <div class="absolute left-[470px] top-[390px] w-[650px] text-center font-sans text-[24px] font-normal leading-[33px] text-black">
          </div>

          <!-- CTA Button -->
          <div class="absolute left-[470px] top-[435px] w-[650px] flex justify-center">
              <Button href="/contact" label="Work with Us" />
          </div>
      </section>

      <!-- Partner Logos -->
      <div aria-label="Partner logos" class="relative flex h-[205px] w-full items-center justify-center">
          <div class="flex items-center gap-[47px]">
              <div class="flex h-[168px] w-[168px] flex-shrink-0 items-center justify-center rounded-full bg-primary-blue shadow-md transition-transform hover:scale-105 overflow-hidden">
                <img src="/images/partner-dtb-logo.png" alt="DTB Art Market Partner" class="h-full w-full object-cover" />
              </div>
              <div class="flex h-[168px] w-[168px] flex-shrink-0 items-center justify-center rounded-full bg-primary-blue shadow-md transition-transform hover:scale-105 overflow-hidden">
                <img src="/images/partner-ccg-logo.png" alt="CCG Partner" class="h-full w-full object-cover" />
              </div>
          </div>
      </div>
  </div>
</div>

<style is:global>
  @media (min-width: 768px) {
    #mobile-hero { display: none !important; }
    #desktop-hero { display: flex !important; }
  }
  @media (max-width: 767px) {
    #desktop-hero { display: none !important; }
    #mobile-hero { display: flex !important; }
  }
</style>