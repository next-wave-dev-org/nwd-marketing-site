---
import Button from './Button.astro';
import { Image } from 'astro:assets';
---
<div class="w-full flex justify-center">

  <!-- =============================== -->
  <!-- MOBILE HERO (< 768px)           -->
  <!-- =============================== -->
  <div id="mobile-hero" class="w-full flex flex-col px-6 mt-4 md:hidden">
    <div class="w-full flex flex-col gap-6 rounded-[10px] bg-gradient-to-b from-light-aqua to-secondary-blue p-4 sm:p-6 shadow-md">
      <div class="relative flex min-h-[420px] w-full flex-col items-center justify-center overflow-hidden rounded-[10px] shadow-sm py-10 px-4">
        
        <Image src="/images/hero-wave-innovation.jpg" alt="Building the Next Wave of Digital Innovation" width={1920} height={1080} loading="eager" decoding="sync" class="absolute inset-0 w-full h-full object-cover opacity-90" />
        <div class="absolute inset-0 bg-black/50"></div>
        
        <div class="relative z-10 flex h-[180px] w-[180px] sm:h-[220px] sm:w-[220px] shrink-0 items-center justify-center rounded-full bg-primary-blue shadow-xl p-2 transition-transform hover:scale-105">
          <span class="w-full font-heading text-[28px] sm:text-[34px] font-bold leading-tight text-hero-text text-center drop-shadow-sm [text-shadow:-1px_-1px_0_#D49A1D,_1px_-1px_0_#D49A1D,_-1px_1px_0_#D49A1D,_1px_1px_0_#D49A1D] break-words">
            Next<br/>Wave<br/>Dev
          </span>
        </div>
        
        <div class="relative z-10 mt-8 w-full max-w-[250px]">
          <a href="/contact" class="inline-flex w-full items-center justify-center rounded-[30px] bg-dark-blue px-4 py-[12px] font-roboto text-[16px] font-bold text-white transition-colors hover:bg-black shadow-md text-center outline-none focus-visible:ring-2 focus-visible:ring-primary-blue focus-visible:ring-offset-2">
            Work with Us
          </a>
        </div>
        
      </div>

      <!-- FIX: Removed the restrictive rounded-full white backgrounds so logos sit naturally -->
      <div class="flex flex-wrap items-center justify-center gap-10 pt-4 pb-4">
        <Image src="/images/partner-dtb-logo.png" alt="Draw The Block Partner" width={300} height={150} loading="lazy" decoding="async" class="h-[60px] w-auto object-contain drop-shadow-sm" />
        <Image src="/images/partner-ccg-logo.png" alt="Card Cave Games Partner" width={300} height={150} loading="lazy" decoding="async" class="h-[60px] w-auto object-contain drop-shadow-sm" />
      </div>
    </div>
  </div>

  <!-- =============================== -->
  <!-- DESKTOP HERO (>= 768px)         -->
  <!-- =============================== -->
  <div id="desktop-hero" class="mx-auto hidden md:flex w-full max-w-[1289px] flex-col overflow-hidden rounded-[10px] bg-gradient-to-b from-light-aqua to-secondary-blue shadow-lg p-10">
      
      <section class="relative flex min-h-[600px] w-full flex-col justify-center items-start pl-[60px] lg:pl-[120px] rounded-[15px] shadow-lg overflow-hidden">
          
          <Image src="/images/hero-wave-innovation.jpg" alt="Building the Next Wave of Digital Innovation" width={1920} height={1080} loading="eager" decoding="sync" class="absolute inset-0 w-full h-full object-cover opacity-90" />
          <div class="absolute inset-0 bg-black/50"></div>
          
          <div class="relative z-10 flex flex-col items-center">
              <div class="flex h-[450px] w-[450px] items-center justify-center rounded-full bg-primary-blue shadow-2xl transition-transform hover:scale-105 p-8">
                  <span class="w-full text-center font-heading text-[56px] lg:text-[64px] font-bold leading-tight text-hero-text drop-shadow-card [text-shadow:-3px_-3px_0_#D49A1D,_3px_-3px_0_#D49A1D,_-3px_3px_0_#D49A1D,_3px_3px_0_#D49A1D] break-words">
                      Next<br/>Wave<br/>Dev
                  </span>
              </div>
              <div class="mt-10">
                  <Button href="/contact" label="Work with Us" />
              </div>
          </div>
          
      </section>

      <!-- FIX: Removed the restrictive rounded-full white backgrounds so logos sit naturally -->
      <div aria-label="Partner logos" class="relative flex w-full items-center justify-center mt-12 mb-4">
          <div class="flex items-center gap-[100px]">
              <Image src="/images/partner-dtb-logo.png" alt="Draw The Block Partner" width={400} height={200} loading="lazy" decoding="async" class="h-[100px] w-auto object-contain transition-transform hover:scale-105 drop-shadow-md" />
              <Image src="/images/partner-ccg-logo.png" alt="Card Cave Games Partner" width={400} height={200} loading="lazy" decoding="async" class="h-[100px] w-auto object-contain transition-transform hover:scale-105 drop-shadow-md" />
          </div>
      </div>
      
  </div>

</div>