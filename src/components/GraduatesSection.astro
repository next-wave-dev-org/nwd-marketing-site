---
// src/components/GraduatesSection.astro
import ProfileCard from './ProfileCard.astro';

export interface Props {
  graduates: string[];
}

const { graduates } = Astro.props;
---

<div class="w-full">
  
  <!-- MOBILE (< 768px) -->
  <section class="mobile-graduates-section flex flex-col items-center w-full gap-8 mt-[80px]">
    <h2 class="m-0 p-0 font-roboto text-[40px] font-bold text-black text-center px-6">
      Graduates
    </h2>
    
    <a href="/about-us/our-team" class="flex h-[40px] items-center justify-center rounded-[25px] bg-dark-blue px-[20px] font-roboto text-[20px] font-medium text-button-secondary-text shadow-md transition-transform hover:scale-105">
      See All
    </a>

    <!-- Mobile Carousel Wrapper -->
    <div class="carousel-wrapper relative w-full mt-4">
      
      <!-- Scroll Track -->
      <div class="carousel-container flex overflow-x-auto snap-x snap-mandatory gap-6 px-6 pb-2 hide-scrollbars w-full">
        {graduates.slice(0, 4).map((graduate) => (
          <div class="shrink-0 w-[85vw] max-w-[314px] snap-center">
            <ProfileCard name={graduate} role="Program Manager" />
          </div>
        ))}
      </div>

      <!-- New Black Pill Arrows -->
      <div class="flex justify-center mt-2">
        <div class="inline-flex items-center gap-[30px] rounded-[30px] border border-black px-[30px] py-[6px]">
          <!-- Removed disabled:opacity-0 -->
          <button type="button" class="carousel-prev flex h-[50px] w-[50px] items-center justify-center rounded-full bg-black text-[28px] text-card-arrow transition-opacity" aria-label="Scroll left">&#8249;</button>
          <button type="button" class="carousel-next flex h-[50px] w-[50px] items-center justify-center rounded-full bg-black text-[28px] text-card-arrow transition-opacity" aria-label="Scroll right">&#8250;</button>
        </div>
      </div>

    </div>
  </section>

  <!-- DESKTOP (>= 768px) -->
  <section class="desktop-graduates-section mt-[150px] flex w-full flex-col max-w-[1250px] mx-auto px-8">
    
    <!-- Header Row -->
    <div class="flex items-center justify-between w-full">
      <h2 class="m-0 p-0 font-roboto text-[64px] font-bold text-black">
        Team
      </h2>
      
      <a href="/about-us/our-team" class="flex h-[40px] items-center justify-center rounded-[25px] bg-dark-blue px-[20px] font-roboto text-[24px] font-medium text-button-secondary-text shadow-md transition-transform hover:scale-105">
        See All
      </a>
    </div>
    
    <!-- Grid Layout for Profile Cards -->
    <div class="mt-[60px] grid grid-cols-4 gap-8 w-full">
      {graduates.slice(0, 4).map((graduate) => (
        <ProfileCard name={graduate} role="Program Manager" />
      ))}
    </div>
    
  </section>

</div>

<script>
  // Setup Carousel Navigation
  document.addEventListener('DOMContentLoaded', () => {
    const carousels = document.querySelectorAll('.carousel-wrapper');
    carousels.forEach(wrapper => {
      const container = wrapper.querySelector('.carousel-container') as HTMLElement;
      const prevBtn = wrapper.querySelector('.carousel-prev') as HTMLButtonElement;
      const nextBtn = wrapper.querySelector('.carousel-next') as HTMLButtonElement;

      if (!container || !prevBtn || !nextBtn) return;

      // Disabled logic removed - arrows always active
      prevBtn.addEventListener('click', () => {
        container.scrollBy({ left: -container.clientWidth * 0.8, behavior: 'smooth' });
      });

      nextBtn.addEventListener('click', () => {
        container.scrollBy({ left: container.clientWidth * 0.8, behavior: 'smooth' });
      });
    });
  });
</script>

<style is:global>
  /* Hides the ugly native scrollbar but keeps the scrolling functionality */
  .hide-scrollbars {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
  .hide-scrollbars::-webkit-scrollbar {
    display: none;
  }

  /* PURE CSS FAILSAFE: Bypasses Tailwind completely to guarantee correct view renders */
  @media (min-width: 768px) {
    .mobile-graduates-section { display: none !important; }
    .desktop-graduates-section { display: flex !important; }
  }
  @media (max-width: 767px) {
    .desktop-graduates-section { display: none !important; }
    .mobile-graduates-section { display: flex !important; }
  }
</style>
</script>
</div>