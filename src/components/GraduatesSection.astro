---
// src/components/GraduatesSection.astro
import ProfileCard from './ProfileCard.astro';
import Button from './Button.astro'; 

export interface Props {
  // Add role to the accepted types
  graduates: (string | { id?: string; name: string; image?: string; role?: string })[];
  title?: string;
}

const { graduates, title = "Team" } = Astro.props;

const normalizedGraduates = graduates.map(g => {
  return typeof g === 'string' 
    ? { name: g, image: undefined, id: g.toLowerCase().replace(/\s+/g, '-'), role: '' } 
    // Extract the role from the object
    : { name: g.name, image: g.image, id: g.id || g.name.toLowerCase().replace(/\s+/g, '-'), role: g.role || '' };
});
---

<div class="w-full">
  
  <!-- MOBILE (< 768px) -->
  <section class="mobile-graduates-section flex flex-col items-center w-full gap-6 mt-8">
    <h2 class="m-0 p-0 font-roboto text-[40px] font-bold text-black text-center px-6">
      {title}
    </h2>

    <div class="carousel-wrapper relative w-full mt-2">
      <div class="carousel-container flex overflow-x-auto snap-x snap-mandatory gap-6 px-6 pb-2 hide-scrollbars w-full">
        {normalizedGraduates.slice(0, 4).map((graduate) => (
          <a href={`/team/${graduate.id}`} class="shrink-0 w-[85vw] max-w-[314px] snap-center block transition-transform hover:scale-[1.02] outline-none">
            <ProfileCard name={graduate.name} role={graduate.role} image={graduate.image} />
          </a>
        ))}
      </div>
    </div>

    <div class="mt-2">
      <Button href="/about-us/our-team" label="See All" />
    </div>
  </section>

  <!-- DESKTOP (>= 768px) -->
  <section class="desktop-graduates-section mt-12 flex w-full flex-col max-w-[1250px] mx-auto px-8">
    
    <div class="flex items-center justify-between w-full">
      <h2 class="m-0 p-0 font-roboto text-[64px] font-bold text-black">
        {title}
      </h2>
      <Button href="/about-us/our-team" label="See All" />
    </div>
    
    <div class="mt-[40px] grid grid-cols-4 gap-8 w-full">
      {normalizedGraduates.slice(0, 4).map((graduate) => (
        <a href={`/team/${graduate.id}`} class="block transition-transform hover:scale-[1.02] outline-none">
          <ProfileCard name={graduate.name} role={graduate.role} image={graduate.image} />
        </a>
      ))}
    </div>
    
  </section>

</div>

<style is:global>
  .hide-scrollbars {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
  .hide-scrollbars::-webkit-scrollbar {
    display: none;
  }

  @media (min-width: 768px) {
    .mobile-graduates-section { display: none !important; }
    .desktop-graduates-section { display: flex !important; }
  }
  @media (max-width: 767px) {
    .desktop-graduates-section { display: none !important; }
    .mobile-graduates-section { display: flex !important; }
  }
</style>