---
// src/components/GraduatesSection.astro
import ProfileCard from './ProfileCard.astro';

export interface Props {
  graduates: string[];
}

const { graduates } = Astro.props;
---

<div class="w-full">
  
  <!-- MOBILE (< 768px) -->
  <section class="mobile-graduates-section flex flex-col items-center w-full gap-8 mt-[80px] px-6">
    <h2 class="m-0 p-0 font-roboto text-[40px] font-bold text-black text-center">
      Graduates
    </h2>
    
    <a href="/about-us/our-graduates" class="flex h-[40px] px-[20px] items-center justify-center rounded-[25px] bg-[#363636] font-roboto text-[20px] font-medium text-[#EEEEEE] transition-transform hover:scale-105 shadow-md">
      See All
    </a>

    <div class="flex flex-col gap-10 mt-8 w-full items-center">
      {graduates.slice(0, 4).map((graduate) => (
        <ProfileCard name={graduate} role="Program Manager" />
      ))}
    </div>
  </section>

  <!-- DESKTOP (>= 768px) -->
  <section class="desktop-graduates-section mt-[150px] flex w-full flex-col max-w-[1250px] mx-auto px-8">
    
    <!-- Header Row -->
    <div class="flex items-center justify-between w-full">
      <h2 class="m-0 p-0 font-roboto text-[64px] font-bold text-black">
        Graduates
      </h2>
      
      <a href="/about-us/our-graduates" class="flex h-[40px] px-[20px] items-center justify-center rounded-[25px] bg-[#363636] font-roboto text-[24px] font-medium text-[#EEEEEE] transition-transform hover:scale-105 shadow-md">
        See All
      </a>
    </div>
    
    <!-- Grid Layout for Profile Cards -->
    <div class="mt-[60px] grid grid-cols-4 gap-8 w-full">
      {graduates.slice(0, 4).map((graduate) => (
        <ProfileCard name={graduate} role="Program Manager" />
      ))}
    </div>
    
  </section>

</div>

<style is:global>
  /* PURE CSS FAILSAFE: Bypasses Tailwind completely to guarantee correct view renders */
  @media (min-width: 768px) {
    .mobile-graduates-section { display: none !important; }
    .desktop-graduates-section { display: flex !important; }
  }
  @media (max-width: 767px) {
    .desktop-graduates-section { display: none !important; }
    .mobile-graduates-section { display: flex !important; }
  }
</style>