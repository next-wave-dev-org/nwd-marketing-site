---
export interface Props {
    number: number;
    title: string;
    description: string;
}

const { number, title, description } = Astro.props;
---

<div class="relative flex flex-col w-[390px]">
    <!-- Card Container with Overlapping Number Badge -->
    <div class="relative h-[154px] mt-[18px]">
        <!-- Grey Background Container (Slightly shorter horizontally with centered text) -->
        <div class="absolute right-0 top-0 h-[154px] w-[325px] rounded-[10px] bg-[#CFCFCF] px-[20px] flex items-center justify-center text-center">
            <h3 class="font-roboto text-[40px] font-semibold leading-[47px] text-black">{title}</h3>
        </div>
        
        <!-- Circular Number Badge -->
        <div class="absolute left-[-65px] top-[26.5px] flex h-[101.87px] w-[101.87px] items-center justify-center rounded-full bg-[#505050] shadow-md z-10">
            <span class="font-inter text-[96px] font-bold leading-none text-[#D8D8D8]">{number}</span>
        </div>
    </div>

    <!-- Description -->
    <p class="mt-[22px] pl-[30px] font-sans text-[24px] font-semibold leading-[29px] text-black w-[350px]">
        {description}
    </p>
</div>