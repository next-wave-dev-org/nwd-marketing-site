---
export interface Props {
    title: string;
    description: string;
    href: string;
}

const { title, description, href } = Astro.props;
---

<div class="flex w-[300px] flex-col">
    <!-- Title -->
    <h3 class="ml-[6px] h-[94px] w-[276px] font-roboto text-[40px] font-bold leading-[47px] text-black">
        {title}
    </h3>
    
    <!-- Card Container (Relative positioning & visible overflow forced via inline styles) -->
    <a 
        href={href} 
        style="position: relative; display: block; width: 300px; height: 390px; margin-top: 12px; background-color: #A2A2A2; border-radius: 20px; box-shadow: 0 4px 4px rgba(0,0,0,0.25); overflow: visible;"
        class="transition-transform hover:-translate-y-1"
        aria-label={`Learn more about ${title}`}
    >
        <!-- Card Text -->
        <p style="position: absolute; left: 25px; top: 31px; width: 249px; color: #000000 !important; font-family: sans-serif; font-size: 20px; font-weight: normal; line-height: 27px;">
            {description}
        </p>

        <!-- Floating Black Circle Button (Explicit inline styles bypass all Tailwind JIT compilation issues) -->
        <div 
            style="position: absolute; bottom: -13px; right: -5px; width: 90px; height: 90px; background-color: #000000; border-radius: 9999px; display: flex; align-items: center; justify-content: center; z-index: 50; box-shadow: 0 4px 6px -1px rgba(0,0,0,0.3);"
        >
            <!-- iOS style Forward Chevron Arrow -->
            <svg width="24" height="40" viewBox="0 0 24 40" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M4 4L20 20L4 36" stroke="#E9E9E9" stroke-width="6" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
        </div>
    </a>
</div>