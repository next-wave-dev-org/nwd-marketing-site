---
export interface Props { title: string; description: string; href: string; }
const { title, description, href } = Astro.props;
---
<div class="w-full">
  
  <!-- MOBILE (< 768px) -->
  <div class="mobile-standard-card flex-col w-full max-w-[350px] mx-auto">
    <h3 class="w-full font-roboto text-[28px] font-bold leading-tight text-black text-center mb-4">{title}</h3>
    <a href={href} class="relative block w-full h-[300px] bg-[#E4F2F5] rounded-[20px] shadow-card transition-transform hover:-translate-y-1 overflow-visible">
      <p class="absolute left-6 top-6 w-[calc(100%-48px)] !text-black font-sans text-[18px] font-normal leading-[27px]">{description}</p>
      <div class="absolute bottom-[-13px] right-[-5px] w-[70px] h-[70px] bg-[#2244CA] rounded-full flex items-center justify-center z-50 shadow-md">
        <svg width="24" height="40" viewBox="0 0 24 40" fill="none" class="scale-75"><path d="M4 4L20 20L4 36" stroke="#E9E9E9" stroke-width="6" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </div>
    </a>
  </div>

  <!-- DESKTOP (>= 768px) EXACT ORIGINAL CODE -->
  <div class="desktop-standard-card flex w-[300px] flex-col">
    <h3 class="ml-[6px] h-[94px] w-[276px] font-roboto text-[40px] font-bold leading-[47px] text-black">{title}</h3>
    <a href={href} style="position: relative; display: block; width: 300px; height: 390px; margin-top: 12px; background-color: #E4F2F5; border-radius: 20px; box-shadow: 0 4px 4px rgba(0,0,0,0.25); overflow: visible;" class="transition-transform hover:-translate-y-1" aria-label={`Learn more about ${title}`}>
        <p style="position: absolute; left: 25px; top: 31px; width: 249px; color: #000000 !important; font-family: sans-serif; font-size: 20px; font-weight: normal; line-height: 27px;">{description}</p>
        <div style="position: absolute; bottom: -13px; right: -5px; width: 90px; height: 90px; background-color: #2244CA; border-radius: 9999px; display: flex; align-items: center; justify-content: center; z-index: 50; box-shadow: 0 4px 6px -1px rgba(0,0,0,0.3);">
            <svg width="24" height="40" viewBox="0 0 24 40" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M4 4L20 20L4 36" stroke="#E9E9E9" stroke-width="6" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </div>
    </a>
  </div>
  
</div>

<style is:global>
  @media (min-width: 768px) { .mobile-standard-card { display: none !important; } .desktop-standard-card { display: flex !important; } }
  @media (max-width: 767px) { .desktop-standard-card { display: none !important; } .mobile-standard-card { display: flex !important; } }
</style>