---
export interface Props {
  title: string;
  description: string;
  href: string;
}

const { title, description, href } = Astro.props;
---

<a href={href} class="flex flex-col justify-between rounded-[20px] bg-white p-6 shadow-md transition-transform hover:-translate-y-1 h-full">
  <div class="flex flex-col gap-2">
    <h3 class="font-roboto text-[22px] font-bold text-black m-0">{title}</h3>
    <p class="font-sans text-[16px] text-black/80 m-0 mb-4">{description}</p>
  </div>
  <!-- Right-aligned arrow matching your original design -->
  <div class="flex items-center justify-end">
    <div class="flex h-[45px] w-[45px] items-center justify-center rounded-full bg-primary-blue text-white shadow-sm">
      <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
      </svg>
    </div>
  </div>
</a>