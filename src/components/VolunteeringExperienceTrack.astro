---
const tracks = [
  {
    title: 'Front-End Engineering',
    description: 'Translate designs into clean, semantic code using HTML, CSS, JavaScript, and modern front-end frameworks to build accessible web experiences.'
  }, 
  {
    title: 'Back-end Implementation',
    description: 'Design database schemas, build secure RESTful APIs, and manage server-side logic to support dynamic application features.'
  }, 
  {
    title: 'Visual Design and UI',
    description: 'Conduct user research, develop wireframes, and create high-fidelity mockups that solve complex interface challenges.'
  }, 
  {
    title: 'Team Management',
    description: 'Learn Agile methodologies, coordinate sprint planning, and facilitate communication between developers, designers, and clients.'
  }
];
---
<div id="experience-track" class="w-full scroll-mt-10 rounded-[20px] bg-gradient-to-b from-light-aqua to-secondary-blue/70 p-6 shadow-lg lg:rounded-[40px] lg:p-12">

  <!-- MOBILE (< 768px) -->
  <div class="mobile-experience-track flex-col w-full">
    <div class="flex w-full flex-col gap-4 rounded-[20px] bg-dark-blue p-6 shadow-xl">
      <div class="w-full rounded-[15px] bg-primary-blue p-5 shadow-md">
        <h2 class="m-0 font-roboto text-[28px] font-bold !text-white">Get professional Experience</h2>
      </div>
      <div class="w-full rounded-[15px] bg-primary-blue p-5 shadow-md">
        <h3 class="m-0 mb-3 font-roboto text-[22px] font-bold !text-white">Gaining Hands on Experience</h3>
        <p class="m-0 font-sans text-[16px] font-normal leading-relaxed !text-white">
          Transitioning from the classroom to the professional world can be tough. Our experience track bridges that gap by placing you in a structured, agency-style environment.
        </p>
      </div>
    </div>

    <div class="mt-[60px]">
      <h3 class="m-0 mb-[40px] text-center font-roboto text-[24px] font-bold text-black">Work on real projects and pipelines</h3>
      <div class="flex flex-col gap-10">
        {tracks.map((track) => (
          <div class="flex flex-col items-center text-center">
            <!-- Increased height and heavily increased Y-padding to stretch the pills vertically -->
            <div class="mb-4 inline-flex min-h-[64px] py-[20px] w-max max-w-full items-center justify-center rounded-[10px] bg-dark-blue px-[30px] shadow-sm">
              <span class="m-0 font-roboto text-[18px] font-bold !text-white text-center leading-tight">{track.title}</span>
            </div>
            <p class="m-0 font-sans text-[16px] font-normal leading-relaxed text-black">{track.description}</p>
          </div>
        ))}
      </div>
    </div>
  </div>

  <!-- DESKTOP (>= 768px) -->
  <div class="desktop-experience-track flex-col w-full">
    <div class="flex w-full flex-col gap-6 rounded-[40px] bg-dark-blue p-[40px] shadow-xl lg:p-[52px]">
      <div class="w-max rounded-[20px] bg-primary-blue px-[40px] py-[24px] shadow-md">
        <h2 class="m-0 font-roboto text-[48px] font-bold !text-white">Get professional Experience</h2>
      </div>
      <div class="ml-[40px] w-full max-w-[660px] rounded-[20px] bg-primary-blue px-[40px] py-[32px] shadow-md lg:ml-[60px]">
        <h3 class="m-0 mb-[16px] font-roboto text-[36px] font-bold !text-white">Gaining Hands on Experience</h3>
        <p class="m-0 font-sans text-[24px] font-normal leading-relaxed !text-white">
          Transitioning from the classroom to the professional world can be tough. Our experience track bridges that gap by placing you in a structured, agency-style environment.
        </p>
      </div>
    </div>

    <div class="mt-[80px] px-[50px]">
      <h3 class="m-0 mb-[60px] font-roboto text-[36px] font-bold text-black">Work on real projects and pipelines</h3>
      <div class="grid grid-cols-2 gap-x-[90px] gap-y-[80px]">
        {tracks.map((track) => (
          <div class="flex flex-col">
            <!-- Increased height and heavily increased Y-padding to stretch the pills vertically -->
            <div class="mb-6 inline-flex min-h-[80px] py-[24px] w-max items-center justify-center rounded-[10px] bg-dark-blue px-[40px] shadow-sm">
              <span class="m-0 font-roboto text-[24px] font-bold !text-white text-center leading-tight">{track.title}</span>
            </div>
            <p class="m-0 font-sans text-[20px] font-normal leading-relaxed text-black">{track.description}</p>
          </div>
        ))}
      </div>
    </div>
  </div>

</div>

<style is:global>
  @media (min-width: 768px) {
    .mobile-experience-track { display: none !important; }
    .desktop-experience-track { display: flex !important; }
  }
  @media (max-width: 767px) {
    .desktop-experience-track { display: none !important; }
    .mobile-experience-track { display: flex !important; }
  }
</style>