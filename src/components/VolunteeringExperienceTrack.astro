---
const tracks = [
  {
    title: 'Front-End Engineering',
    description: 'Translate designs into clean, semantic code using HTML, CSS, JavaScript, and modern front-end frameworks to build accessible web experiences.'
  }, 
  {
    title: 'Back-end Implementation',
    description: 'Design database schemas, build secure RESTful APIs, and manage server-side logic to support dynamic application features.'
  }, 
  {
    title: 'Visual Design and UI',
    description: 'Conduct user research, develop wireframes, and create high-fidelity mockups that solve complex interface challenges.'
  }, 
  {
    title: 'Team Management',
    description: 'Learn Agile methodologies, coordinate sprint planning, and facilitate communication between developers, designers, and clients.'
  }
];
---
<div id="experience-track" class="w-full scroll-mt-10 rounded-[20px] bg-gradient-to-b from-light-aqua to-secondary-blue/70 p-6 shadow-lg lg:rounded-[40px] lg:p-12">

  <!-- UNIFIED RESPONSIVE COMPONENT -->
  <div class="flex flex-col w-full">
    
    <div class="flex w-full flex-col gap-4 md:gap-6 rounded-[20px] md:rounded-[40px] bg-dark-blue p-6 md:p-[40px] lg:p-[52px] shadow-xl">
      <div class="w-full md:w-max rounded-[15px] md:rounded-[20px] bg-primary-blue p-5 md:px-[40px] md:py-[24px] shadow-md">
        <h2 class="m-0 font-roboto text-[28px] md:text-[48px] font-bold !text-white">Get professional Experience</h2>
      </div>
      <div class="w-full md:max-w-[660px] rounded-[15px] md:rounded-[20px] bg-primary-blue p-5 md:px-[40px] md:py-[32px] shadow-md md:ml-[40px] lg:ml-[60px]">
        <h3 class="m-0 mb-3 md:mb-[16px] font-roboto text-[22px] md:text-[36px] font-bold !text-white">Gaining Hands on Experience</h3>
        <p class="m-0 font-sans text-[16px] md:text-[24px] font-normal leading-relaxed !text-white">
          Transitioning from the classroom to the professional world can be tough. Our experience track bridges that gap by placing you in a structured, agency-style environment.
        </p>
      </div>
    </div>

    <div class="mt-[60px] md:mt-[80px] md:px-[50px]">
      <h3 class="m-0 mb-[40px] md:mb-[60px] text-center md:text-left font-roboto text-[24px] md:text-[36px] font-bold text-black">Work on real projects and pipelines</h3>
      <div class="flex flex-col md:grid md:grid-cols-2 gap-10 md:gap-x-[90px] md:gap-y-[80px]">
        {tracks.map((track) => (
          <div class="flex flex-col items-center md:items-start text-center md:text-left">
            <div class="mb-4 md:mb-6 inline-flex min-h-[64px] md:min-h-[80px] py-[20px] md:py-[24px] w-max max-w-full md:max-w-none items-center justify-center rounded-[10px] bg-dark-blue px-[30px] md:px-[40px] shadow-sm">
              <span class="m-0 font-roboto text-[18px] md:text-[24px] font-bold !text-white text-center leading-tight">{track.title}</span>
            </div>
            <p class="m-0 font-sans text-[16px] md:text-[20px] font-normal leading-relaxed text-black">{track.description}</p>
          </div>
        ))}
      </div>
    </div>
    
  </div>
</div>