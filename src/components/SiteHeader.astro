---
// src/components/SiteHeader.astro

const menus = [
  {
    key: 'services',
    href: '/services',
    label: 'Services',
    items: [
      { label: 'What We Build', description: 'Explore our full suite of digital solutions.', href: '/services' },
      { label: 'Pricing Plans', description: 'Transparent models tailored to non-profits.', href: '/services/pricing' },
    ],
  },
  {
    key: 'about-us',
    href: '/about-us',
    label: 'About Us',
    items: [
      { label: 'Who We Are', description: 'Learn about our core values and team.', href: '/about-us' },
      { label: 'Client Framework', description: 'Explore our flexible partnership models.', href: '/about-us/client-framework' },
      { label: 'Portfolio', description: 'View the tech solutions we have delivered.', href: '/about-us/portfolio' },
    ],
  },
  {
    key: 'volunteering',
    href: '/volunteering',
    label: 'Volunteering'
  },
];

const currentPath = Astro.url.pathname;
---

<!-- UNIFIED RESPONSIVE HEADER (DARK MODE) -->
<header id="site-header" class="sticky top-0 z-[9999] w-full bg-background/90 backdrop-blur-md border-b border-border-subtle shadow-lg transition-all duration-300">
  
  <div class="mx-auto flex h-[80px] w-full max-w-[1440px] items-center justify-between px-6 lg:px-8">
    
    <!-- Logo -->
    <a href="/" class="flex h-[60px] sm:h-[72px] items-center transition-transform hover:scale-105 rounded outline-none focus-visible:ring-2 focus-visible:ring-[#38C1ED] focus-visible:ring-offset-2">
      <img src="/nwd-transparent.png" alt="Next Wave Dev Logo" class="h-full w-auto object-contain brightness-125" />
    </a>

    <!-- Desktop Navigation -->
    <nav class="hidden md:flex h-full items-center gap-2 lg:gap-6" aria-label="Main Navigation">
      {menus.map((menu) => {
        const isActive = currentPath.startsWith(menu.href);
        const hasDropdown = menu.items && menu.items.length > 0;
        
        return (
          <div class={`relative flex h-full items-center ${hasDropdown ? 'group' : ''}`}>
            <a 
              href={menu.href}
              aria-haspopup={hasDropdown ? "true" : undefined}
              class={`flex items-center gap-2 px-4 py-2 rounded-[10px] transition-colors outline-none focus-visible:ring-2 focus-visible:ring-[#38C1ED] ${isActive ? 'text-accent-cyan font-bold' : 'text-white hover:bg-white/5'}`}
            >
              <span class="font-roboto text-[18px]">{menu.label}</span>
              
              {hasDropdown && (
                <svg class={`h-4 w-4 transition-transform duration-200 group-hover:rotate-180 group-focus-within:rotate-180 ${isActive ? 'text-accent-cyan' : 'text-white/60 group-hover:text-white'}`} fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                </svg>
              )}
            </a>

            {hasDropdown && (
              <div class="absolute top-[calc(100%-15px)] left-0 min-w-[260px] bg-surface shadow-2xl rounded-[12px] border border-border-subtle p-2 opacity-0 pointer-events-none translate-y-2 transition-all duration-200 group-hover:opacity-100 group-hover:pointer-events-auto group-hover:translate-y-0 group-focus-within:opacity-100 group-focus-within:pointer-events-auto group-focus-within:translate-y-0 z-50 flex flex-col gap-1">
                {menu.items.map(item => {
                  const isItemActive = currentPath === item.href.split('#')[0];
                  return (
                    <a href={item.href} class={`flex flex-col gap-1 px-4 py-3 rounded-md transition-colors hover:bg-white/5 outline-none focus-visible:ring-2 focus-visible:ring-[#38C1ED] ${isItemActive ? 'text-accent-cyan' : 'text-white'}`}>
                      <span class="font-roboto text-[16px] font-bold">{item.label}</span>
                      <span class="font-sans text-[13px] text-text-body leading-snug">{item.description}</span>
                    </a>
                  )
                })}
              </div>
            )}
          </div>
        );
      })}
    </nav>

    <!-- Desktop Right Actions (Donate + Contact) -->
    <div class="hidden md:flex items-center gap-6">
      <a href="/donate" class="font-roboto text-[16px] font-bold text-white hover:text-accent-cyan transition-colors outline-none focus-visible:ring-2 focus-visible:ring-[#38C1ED] rounded px-2 py-1">
        Donate
      </a>
      <a href="/contact" class="flex h-[44px] px-8 items-center justify-center rounded-[30px] bg-gradient-to-r from-[#4A3B96] to-[#1D70B8] font-roboto text-[16px] font-bold text-white transition-all hover:from-[#1D70B8] hover:to-[#38C1ED] shadow-md outline-none focus-visible:ring-2 focus-visible:ring-[#38C1ED]">
        Contact Us
      </a>
    </div>

    <!-- Mobile Hamburger Toggle -->
    <button 
      id="mobile-menu-btn" 
      type="button"
      aria-expanded="false" 
      aria-controls="mobile-dropdown-panel"
      aria-label="Toggle mobile menu"
      class="md:hidden flex h-12 w-12 items-center justify-center rounded-[10px] text-white transition-colors hover:bg-white/5 outline-none focus-visible:ring-2 focus-visible:ring-[#38C1ED]"
    >
      <svg id="icon-menu" class="h-8 w-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
      </svg>
    </button>
  </div>

  <!-- MOBILE MENU DROPDOWN -->
  <div id="mobile-dropdown-wrapper" class="absolute left-0 top-[80px] w-full h-[calc(100dvh-80px)] z-40 hidden md:hidden">
    <div id="mobile-backdrop" class="absolute inset-0 bg-black/60 opacity-0 transition-opacity duration-300 cursor-pointer"></div>
    
    <div 
      id="mobile-dropdown-panel" 
      role="dialog"
      aria-modal="true"
      aria-label="Mobile Navigation"
      class="absolute right-0 top-0 h-full w-[85%] max-w-[360px] bg-surface border-l border-border-subtle shadow-2xl transform translate-x-full transition-transform duration-300 flex flex-col overflow-hidden text-white"
    >
      <nav class="flex flex-col gap-2 p-6 overflow-y-auto w-full h-full pb-24">
        {menus.map((menu) => {
          const isActive = currentPath.startsWith(menu.href);
          const hasDropdown = menu.items && menu.items.length > 0;
          
          return (
            <div class="flex flex-col w-full mb-6">
              <a href={menu.href} class={`block w-full font-roboto text-[24px] font-bold border-b-2 pb-2 mb-4 transition-colors outline-none focus-visible:ring-2 focus-visible:ring-[#38C1ED] rounded ${isActive ? 'text-accent-cyan border-[#38C1ED]' : 'text-white border-border-subtle hover:text-accent-cyan'}`}>
                {menu.label}
              </a>
              
              {hasDropdown && (
                <div class="flex flex-col gap-4 pl-2 border-l-2 border-border-subtle">
                  {menu.items.map((item) => (
                    <a href={item.href ?? menu.href} class={`font-sans text-[18px] font-medium pl-3 transition-colors outline-none focus-visible:ring-2 focus-visible:ring-[#38C1ED] rounded ${currentPath === (item.href ?? menu.href).split('#')[0] ? 'text-accent-cyan' : 'text-text-body hover:text-white'}`}>
                      {item.label}
                    </a>
                  ))}
                </div>
              )}
            </div>
          )
        })}

        <div class="flex flex-col gap-4 mt-auto pt-6 border-t border-border-subtle">
          <a href="/donate" class="flex h-[50px] w-full items-center justify-center rounded-[30px] border border-border-subtle font-roboto text-[18px] font-bold text-white hover:bg-white/5 transition-colors outline-none focus-visible:ring-2 focus-visible:ring-[#38C1ED]">
            Donate
          </a>
          <a href="/contact" class="flex h-[55px] w-full items-center justify-center rounded-[30px] bg-gradient-to-r from-[#4A3B96] to-[#1D70B8] font-roboto text-[18px] font-bold text-white shadow-md hover:opacity-90 transition-colors outline-none focus-visible:ring-2 focus-visible:ring-[#38C1ED]">
            Contact Us
          </a>
        </div>
      </nav>
    </div>
  </div>
</header>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const mobileBtn = document.getElementById('mobile-menu-btn');
    const mobileWrapper = document.getElementById('mobile-dropdown-wrapper');
    const mobileBackdrop = document.getElementById('mobile-backdrop');
    const mobilePanel = document.getElementById('mobile-dropdown-panel');

    function openMobileMenu() {
      mobileWrapper.classList.remove('hidden');
      mobileBtn.setAttribute('aria-expanded', 'true');
      document.body.style.overflow = 'hidden';
      
      requestAnimationFrame(() => {
        mobileBackdrop.classList.remove('opacity-0');
        mobileBackdrop.classList.add('opacity-100');
        mobilePanel.classList.remove('translate-x-full');
        mobilePanel.classList.add('translate-x-0');
      });
    }

    function closeMobileMenu() {
      mobileBtn.setAttribute('aria-expanded', 'false');
      mobileBackdrop.classList.remove('opacity-100');
      mobileBackdrop.classList.add('opacity-0');
      mobilePanel.classList.remove('translate-x-0');
      mobilePanel.classList.add('translate-x-full');
      document.body.style.overflow = '';

      setTimeout(() => {
        mobileWrapper.classList.add('hidden');
        mobileBtn.focus();
      }, 300);
    }

    if (mobileBtn && mobileWrapper) {
      mobileBtn.addEventListener('click', () => {
        if (mobileBtn.getAttribute('aria-expanded') === 'false') {
          openMobileMenu();
        } else {
          closeMobileMenu();
        }
      });
    }

    if (mobileBackdrop) mobileBackdrop.addEventListener('click', closeMobileMenu);

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && mobileBtn.getAttribute('aria-expanded') === 'true') {
        closeMobileMenu();
      }
    });
  });
</script>
