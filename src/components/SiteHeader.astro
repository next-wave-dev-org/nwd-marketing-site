---
const navLinks = [
  { href: '/services', label: 'Services' },
  { href: '/about-us', label: 'About Us' },
  { href: '/volunteering', label: 'Volunteering' },
];
---

<header class="sticky top-0 z-50 border-b border-white/10 bg-slate-950/95 backdrop-blur">
  <div class="mx-auto flex w-full max-w-[1280px] items-center gap-6 px-6 py-4">
    <a href="/" class="flex items-center gap-3 text-white">
      <img
        src="/next-wave-dev-logo.png"
        alt="Next Wave Dev logo"
        width="40"
        height="40"
        class="h-10 w-10 rounded-2xl bg-slate-950 object-cover"
      />
      <span class="text-sm font-semibold uppercase tracking-[0.2em] hidden md:inline">Next Wave Dev</span>
    </a>

    <nav aria-label="Primary navigation" class="flex flex-1 items-center justify-center gap-8">
      {navLinks.map((link) => (
        <a
          href={link.href}
          class="text-sm font-medium text-slate-200 transition hover:text-white"
        >
          {link.label}
        </a>
      ))}
    </nav>

    <div class="flex shrink-0 items-center justify-end">
      <a
        href="/contact"
        class="rounded-full bg-primary-blue px-5 py-2.5 text-sm font-semibold text-white transition hover:bg-blue-600"
      >
        Contact Us
      </a>
    </div>
  </div>
</header>
