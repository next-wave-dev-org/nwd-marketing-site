---
const menus = [
  {
    key: 'services',
    href: '/services',
    label: 'Services',
    items: [
      {
        key: 'research-process',
        label: 'Research Process',
        description:
          'Discover how we gather insights, define problems, and shape solutions through collaborative research.',
      },
      {
        key: 'marketing',
        label: 'Marketing',
        description:
          'We create campaigns that resonate with communities and amplify your mission.',
      },
      {
        key: 'design-process',
        label: 'Design Process',
        description:
          'Our team blends accessibility and aesthetic clarity to build intuitive digital experiences.',
      },
      {
        key: 'front-end',
        label: 'Front-End',
        description:
          'Responsive UI development that brings your product to life with polished interactions.',
      },
      {
        key: 'back-end',
        label: 'Back-End',
        description:
          'Robust server-side architecture engineered for security, scalability, and maintainability.',
      },
      {
        key: 'quality-assurance',
        label: 'Quality Assurance',
        description:
          'Ongoing testing, review, and optimization to ensure every release performs flawlessly.',
      },
      {
        key: 'pricing',
        label: 'Pricing',
        description:
          'Flexible packages tailored to your project’s scope, timeline, and desired impact.',
      },
    ],
  },
  {
    key: 'about-us',
    href: '/about-us',
    label: 'About Us',
    items: [
      {
        key: 'our-mission',
        label: 'Our Mission',
        description:
          'Learn how our mission drives inclusive educational opportunities and meaningful tech careers.',
      },
      {
        key: 'our-graduates',
        label: 'Our Graduates',
        description:
          'Meet graduates who have gained skills, confidence, and career pathways through our programs.',
      },
      {
        key: 'our-staff',
        label: 'Our Staff',
        description:
          'Our experienced staff guide learners and partners with expertise in education and engineering.',
      },
      {
        key: 'client-framework',
        label: 'Client Framework',
        description:
          'See how we partner with clients through discovery, strategy, execution, and support.',
      },
      {
        key: 'portfolio',
        label: 'Portfolio',
        description:
          'Explore work that showcases real outcomes for nonprofits, community initiatives, and digital services.',
      },
    ],
  },
  {
    key: 'volunteering',
    href: '/volunteering',
    label: 'Volunteering',
    items: [
      {
        key: 'how-to-join',
        label: 'How to Join',
        description:
          'Find out how to start volunteering, contribute your skills, and connect with our community.',
      },
      {
        key: 'roles',
        label: 'Roles',
        description:
          'Explore volunteer roles that support learners, projects, and outreach.',
      },
      {
        key: 'benefits',
        label: 'Benefits',
        description:
          'Learn how volunteering builds your experience, expands your network, and makes an impact.',
      },
    ],
  },
];
---

<header class="sticky top-0 z-50 border-b border-white/10 bg-slate-950 bg-opacity-100">
  <div class="mx-auto flex w-full max-w-[1280px] items-center gap-6 px-6 py-4">
    <a href="/" class="flex items-center gap-3 text-white">
      <img
        src="/next-wave-dev-logo.png"
        alt="Next Wave Dev logo"
        width="40"
        height="40"
        class="h-10 w-10 rounded-2xl bg-slate-950 object-cover"
      />
      <span class="text-sm font-semibold uppercase tracking-[0.2em] hidden md:inline">Next Wave Dev</span>
    </a>

    <div class="relative flex flex-1 items-center justify-center">
      <!-- Desktop nav (hidden on small screens) -->
      <nav aria-label="Primary navigation" class="hidden md:flex items-center justify-center gap-8">
        {menus.map((menu) => (
          <a
            href={menu.href}
            class="primary-menu-trigger group inline-flex items-center gap-2 text-sm font-medium text-slate-200 transition hover:text-white focus:outline-none focus:text-white"
            data-menu={menu.key}
            aria-expanded="false"
            aria-controls={`mega-menu-${menu.key}`}
          >
            <span>{menu.label}</span>
            <span class="inline-flex h-5 w-5 items-center justify-center rounded-full bg-white/10 text-xs text-white transition group-hover:bg-white/20">⌄</span>
          </a>
        ))}
      </nav>

      <div
        id="mega-menu-panel"
        class="pointer-events-none absolute left-1/2 top-full z-50 w-full max-w-[1200px] -translate-x-1/2 rounded-3xl border border-slate-200 bg-white px-6 py-8 opacity-0 shadow-2xl shadow-black/10 transition duration-200 ease-out"
        style="background-color: #ffffff !important;"
        aria-hidden="true"
      >
        {menus.map((menu) => (
          <div
            id={`mega-menu-${menu.key}`}
            class="mega-menu-group hidden space-y-6"
            data-menu-panel={menu.key}
          >
            <div class="grid gap-8 grid-cols-[280px_1fr] items-start">
              <div class="space-y-3 rounded-2xl bg-white p-6 shadow-card" style="background-color: #ffffff !important;">
                {menu.items.map((item) => (
                  <button
                    type="button"
                    class="w-full flex items-center justify-between text-left text-lg font-semibold text-black transition hover:text-slate-900 focus:outline-none focus:text-slate-900"
                    data-menu-item={item.key}
                    data-menu-parent={menu.key}
                    data-description={item.description}
                    style="color: #000000 !important;"
                  >
                    <span style="color: #000000 !important;">{item.label}</span>
                    <span class="text-slate-500 transition hover:text-slate-800" style="color: #000000 !important;">⌄</span>
                  </button>
                ))}
              </div>

              <div class="rounded-2xl bg-white p-6 shadow-card" style="background-color: #ffffff !important;">
                <div class="space-y-4">
                  <p class="text-xs uppercase tracking-[0.35em] text-slate-500">Preview</p>
                  <h3 class="text-2xl font-semibold text-slate-950" data-preview-title="">
                    {menu.items[0].label}
                  </h3>
                  <p class="text-sm leading-7 text-slate-700" data-preview-description="" style="color: #000000 !important;">
                    {menu.items[0].description}
                  </p>
                </div>
              </div>
            </div>
          </div>
        ))}
      </div>

      <!-- Mobile drawer overlay + panel (hidden by default). Use border around the panel instead of a full-page shell. -->
      <div id="mobile-drawer" class="hidden md:hidden fixed inset-0 z-[9998]">
        <div id="mobile-drawer-overlay" class="absolute inset-0 bg-black/50 opacity-0 transition-opacity z-[9998]"></div>
        <aside id="mobile-drawer-panel" class="fixed left-0 top-0 h-full w-80 max-w-[80%] -translate-x-full transform bg-slate-950 text-white transition-transform duration-300 ease-in-out shadow-2xl z-[9999] border border-white/10 rounded-tr-3xl rounded-br-3xl overflow-y-auto" role="dialog" aria-modal="true" aria-labelledby="mobile-drawer-title" aria-hidden="true">
          <div class="flex items-center justify-between px-4 py-4 border-b border-white/10 bg-slate-950">
            <h2 id="mobile-drawer-title" class="text-lg font-semibold">Menu</h2>
            <button id="mobile-drawer-close" class="p-2 rounded-md hover:bg-white/5" aria-label="Close menu">✕</button>
          </div>
          <nav class="px-4 py-6 space-y-4 bg-slate-950" aria-label="Mobile primary">
            {menus.map((menu) => (
              <div class="mobile-accordion">
                <button type="button" class="mobile-accordion-button w-full flex items-center justify-between py-3 text-left text-base font-semibold text-white hover:bg-white/5 rounded-md px-2" aria-expanded="false">
                  <span>{menu.label}</span>
                  <span class="inline-flex h-5 w-5 items-center justify-center rounded-full bg-white/5 text-xs text-white">⌄</span>
                </button>
                <div class="mobile-accordion-panel hidden pl-3 mt-2 bg-slate-950 border border-white/10 rounded-md shadow-inner z-[10000]">
                  <div class="py-2 space-y-1 px-2">
                    {menu.items.map((item) => (
                      <a href={`${menu.href}#${item.key}`} class="block py-2 text-sm text-slate-200 hover:text-white rounded-md px-2 bg-slate-950">{item.label}</a>
                    ))}
                  </div>
                </div>
              </div>
            ))}

            <a href="/contact" class="block mt-4 rounded-full bg-primary-blue px-4 py-2 text-sm font-semibold text-white text-center">Contact Us</a>
          </nav>
        </aside>
      </div>
    </div>

    <div class="flex shrink-0 items-center justify-end gap-3">
      <button id="mobile-menu-button" aria-controls="mobile-drawer" aria-expanded="false" class="md:hidden inline-flex items-center justify-center rounded-md p-2 text-white hover:bg-white/5 focus:outline-none z-50" aria-label="Open menu">
        <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M3 6h18M3 12h18M3 18h18" />
        </svg>
      </button>

      <a
        href="/contact"
        class="rounded-full bg-primary-blue px-5 py-2.5 text-sm font-semibold text-white transition hover:bg-blue-600"
      >
        Contact Us
      </a>
    </div>
  </div>

  <script is:inline>
    // Desktop mega menu data and behavior
    const menuData = Object.fromEntries(
      Array.from(document.querySelectorAll('[data-menu]')).map((menuLink) => [
        menuLink.dataset.menu,
        {
          trigger: menuLink,
          panel: document.getElementById(`mega-menu-${menuLink.dataset.menu}`),
          title: document.querySelector(`#mega-menu-${menuLink.dataset.menu} [data-preview-title]`),
          description: document.querySelector(`#mega-menu-${menuLink.dataset.menu} [data-preview-description]`),
          items: Array.from(document.querySelectorAll(`[data-menu-parent="${menuLink.dataset.menu}"]`)),
        },
      ]),
    );

    const panelRoot = document.getElementById('mega-menu-panel');
    let activeMenu = null;
    let activeItem = null;
    let closeTimer = null;

    function openMenu(menuKey) {
      if (!menuData[menuKey]) return;
      if (activeMenu === menuKey) return;
      activeMenu = menuKey;
      activeItem = menuData[menuKey].items[0];
      updatePanel();
    }

    function closeMenu() {
      if (!activeMenu) return;
      activeMenu = null;
      activeItem = null;
      updatePanel();
    }

    function updatePanel() {
      Object.values(menuData).forEach(({ trigger, panel }) => {
        const isOpen = trigger.dataset.menu === activeMenu;
        trigger.setAttribute('aria-expanded', String(isOpen));
        panel.classList.toggle('hidden', !isOpen);
      });

      if (activeMenu) {
        panelRoot.classList.remove('pointer-events-none', 'opacity-0');
        panelRoot.classList.add('opacity-100');
        panelRoot.setAttribute('aria-hidden', 'false');
      } else {
        panelRoot.classList.add('pointer-events-none', 'opacity-0');
        panelRoot.classList.remove('opacity-100');
        panelRoot.setAttribute('aria-hidden', 'true');
      }

      if (activeItem) {
        const current = menuData[activeMenu];
        if (current) {
          current.title.textContent = activeItem.textContent;
          current.description.textContent = activeItem.dataset.description || activeItem.dataset.description;
        }
      }
    }

    function setActiveItem(menuKey, itemKey) {
      const menu = menuData[menuKey];
      if (!menu) return;
      const item = menu.items.find((node) => node.dataset.menuItem === itemKey);
      if (!item) return;
      activeItem = item;
      menu.title.textContent = item.textContent;
      menu.description.textContent = item.dataset.description || item.dataset.description;
    }

    function scheduleClose() {
      closeTimer = window.setTimeout(closeMenu, 150);
    }

    function clearScheduledClose() {
      if (closeTimer) {
        window.clearTimeout(closeTimer);
        closeTimer = null;
      }
    }

    // Mobile drawer and accordion behavior
    function openMobileDrawer() {
      const container = document.getElementById('mobile-drawer');
      const panel = document.getElementById('mobile-drawer-panel');
      const overlay = document.getElementById('mobile-drawer-overlay');
      const toggle = document.getElementById('mobile-menu-button');
      if (!container || !panel || !overlay || !toggle) return;
      container.classList.remove('hidden');
      // animate in
      requestAnimationFrame(() => {
        overlay.classList.remove('opacity-0');
        overlay.classList.add('opacity-100');
        panel.classList.remove('-translate-x-full');
        panel.classList.add('translate-x-0');
      });
      panel.setAttribute('aria-hidden', 'false');
      toggle.setAttribute('aria-expanded', 'true');
      // prevent body scroll behind drawer
      document.documentElement.style.overflow = 'hidden';
      document.body.style.overflow = 'hidden';
    }

    function closeMobileDrawer() {
      const container = document.getElementById('mobile-drawer');
      const panel = document.getElementById('mobile-drawer-panel');
      const overlay = document.getElementById('mobile-drawer-overlay');
      const toggle = document.getElementById('mobile-menu-button');
      if (!container || !panel || !overlay || !toggle) return;
      overlay.classList.remove('opacity-100');
      overlay.classList.add('opacity-0');
      panel.classList.remove('translate-x-0');
      panel.classList.add('-translate-x-full');
      panel.setAttribute('aria-hidden', 'true');
      toggle.setAttribute('aria-expanded', 'false');
      // restore scroll after animation
      setTimeout(() => {
        container.classList.add('hidden');
        document.documentElement.style.overflow = '';
        document.body.style.overflow = '';
      }, 300);
    }

    document.addEventListener('DOMContentLoaded', () => {
      // Desktop mega-menu setup (unchanged)
      Object.entries(menuData).forEach(([menuKey, { trigger, items }]) => {
        trigger.addEventListener('mouseenter', () => {
          clearScheduledClose();
          openMenu(menuKey);
        });
        trigger.addEventListener('focus', () => {
          clearScheduledClose();
          openMenu(menuKey);
        });

        items.forEach((item) => {
          item.addEventListener('mouseenter', () => {
            setActiveItem(menuKey, item.dataset.menuItem);
          });
          item.addEventListener('focus', () => {
            setActiveItem(menuKey, item.dataset.menuItem);
          });
        });
      });

      if (panelRoot) {
        panelRoot.addEventListener('mouseenter', clearScheduledClose);
        panelRoot.addEventListener('mouseleave', scheduleClose);
        panelRoot.addEventListener('focusin', clearScheduledClose);
        panelRoot.addEventListener('focusout', (event) => {
          if (!panelRoot.contains(event.relatedTarget)) {
            scheduleClose();
          }
        });
      }

      const desktopNav = document.querySelector('nav[aria-label="Primary navigation"]');
      if (desktopNav) {
        desktopNav.addEventListener('mouseleave', scheduleClose);
        desktopNav.addEventListener('focusout', (event) => {
          if (!event.currentTarget.contains(event.relatedTarget) && !panelRoot.contains(event.relatedTarget)) {
            scheduleClose();
          }
        });
      }

      // Mobile drawer controls
      const mobileButton = document.getElementById('mobile-menu-button');
      const mobileClose = document.getElementById('mobile-drawer-close');
      const mobileOverlay = document.getElementById('mobile-drawer-overlay');
      const mobileContainer = document.getElementById('mobile-drawer');

      if (mobileButton) {
        mobileButton.addEventListener('click', (e) => {
          e.preventDefault();
          openMobileDrawer();
        });
      }
      if (mobileClose) mobileClose.addEventListener('click', closeMobileDrawer);
      if (mobileOverlay) mobileOverlay.addEventListener('click', closeMobileDrawer);

      // Close on escape
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') {
          closeMenu();
          closeMobileDrawer();
        }
      });

      // Mobile accordion setup (touch friendly)
      document.querySelectorAll('.mobile-accordion').forEach((acc) => {
        const btn = acc.querySelector('.mobile-accordion-button');
        const panel = acc.querySelector('.mobile-accordion-panel');
        if (!btn || !panel) return;
        btn.addEventListener('click', () => {
          const isOpen = btn.getAttribute('aria-expanded') === 'true';
          btn.setAttribute('aria-expanded', String(!isOpen));
          panel.classList.toggle('hidden');
        });
      });
    });
  </script>
</header>
