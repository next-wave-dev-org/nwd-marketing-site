<!-- HEADER CONTAINER (Elevated to z-[9999] so it forces itself above the page) -->
<header class="relative flex w-full justify-center z-[9999]">
  
  <!-- INNER 1440px ARTBOARD -->
  <div id="header-artboard" class="relative w-[1440px] shrink-0 h-[212px]">
    
    <!-- Logo Box -->
    <a href="/" class="absolute left-[48px] top-[49px] flex h-[163px] w-[163px] items-center justify-center rounded-[10px] bg-[#363636] z-50">
      <!-- Forced to white !important -->
      <span class="font-inter text-[40px] font-normal !text-white" style="color: #FFFFFF !important;">LOGO</span>
    </a>

    <!-- Contact Us Button -->
    <a href="/contact" class="absolute left-[1174px] top-[49px] flex h-[53px] w-[218px] items-center justify-center rounded-[10px] bg-[#363636] z-50 transition-opacity hover:opacity-90">
      <span class="font-open-sans text-[24px] font-normal !text-white" style="color: #EEEEEE !important;">Contact Us</span>
    </a>

    <!-- Nav Links Container -->
    <nav class="absolute left-[430px] top-[49px] h-[133px] flex items-end gap-[20px] z-50">
      {menus.map((menu) => (
        <a 
          href={menu.href}
          data-menu={menu.key}
          class="nav-trigger group flex h-[103px] items-center gap-3 px-[30px] rounded-t-[10px] transition-colors duration-200"
        >
          <!-- Set to black by default, becomes white on hover via global CSS below -->
          <span class="nav-text font-open-sans text-[24px] font-normal text-black transition-colors" style="color: #000000;">{menu.label}</span>
          <svg class="nav-icon h-6 w-6 text-black transition-colors" style="color: #000000;" viewBox="0 0 24 24">
            <circle cx="12" cy="12" r="11" fill="none" stroke="currentColor" stroke-width="1.5" />
            <path d="M8 10l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </a>
      ))}
    </nav>

    <!-- MEGA MENU DROPDOWN OVERLAY (Solid White Background Block) -->
    <div id="mega-menu-overlay" class="absolute left-0 top-0 h-[660px] w-full pointer-events-none opacity-0 transition-opacity duration-200 z-40" style="background-color: #FFFFFF !important;">
      
      <!-- Text Underneath the Logo (Wrapped in an extra white background container just to be perfectly safe) -->
      <div class="absolute left-[48px] top-[254px] w-[450px] pointer-events-auto bg-white pr-4 pb-4" style="background-color: #FFFFFF !important;">
        <h2 id="mega-left-title" class="font-open-sans text-[24px] font-semibold leading-[33px] text-black"></h2>
        <p id="mega-left-desc" class="mt-4 font-open-sans text-[16px] font-normal leading-[22px] text-black"></p>
      </div>

      <!-- Massive Dark Dropdown Box -->
      <div class="absolute left-[507px] top-[182px] flex h-[444px] w-[933px] rounded-[10px] bg-[#4D4D4D] shadow-xl pointer-events-auto">
        
        <!-- Left Column: Generated Sub-Links -->
        <div id="mega-sub-links" class="mt-[10px] flex w-[400px] flex-col gap-5 p-[40px]">
          <!-- JS will inject links here -->
        </div>
        
        <!-- Right Column: Dynamic Description -->
        <div class="flex-1 p-[40px] pt-[51px] pr-[100px]">
          <p id="mega-right-desc" class="font-open-sans text-[16px] font-normal leading-[22px]" style="color: #FFFFFF !important;"></p>
        </div>

      </div>
    </div>

  </div>
</header>

<!-- Pass menu data to client JS -->
<script is:inline define:vars={{ menus }}>
  window.megaMenuData = menus;
</script>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const artboard = document.getElementById('header-artboard');
    const overlay = document.getElementById('mega-menu-overlay');
    const triggers = document.querySelectorAll('.nav-trigger');
    
    // Dynamic text elements
    const leftTitle = document.getElementById('mega-left-title');
    const leftDesc = document.getElementById('mega-left-desc');
    const subLinksContainer = document.getElementById('mega-sub-links');
    const rightDesc = document.getElementById('mega-right-desc');

    let closeTimeout = null;
    let activeMenuKey = null;

    // Build the sub-links HTML (Forced White Text)
    function buildSubLinks(items) {
      return items.map((item, index) => `
        <a href="#" class="sub-link flex items-center justify-between hover:opacity-70 transition-opacity" data-index="${index}" style="color: #FFFFFF !important;">
          <span class="font-open-sans text-[24px] font-normal" style="color: #FFFFFF !important;">${item.label}</span>
          <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" style="color: #FFFFFF !important;">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
          </svg>
        </a>
      `).join('');
    }

    // Open Menu Logic
    function openMenu(menuKey) {
      if (activeMenuKey === menuKey) return;
      activeMenuKey = menuKey;

      const menuData = window.megaMenuData.find(m => m.key === menuKey);
      if (!menuData) return;

      // Update styling on top triggers
      triggers.forEach(t => {
        if (t.dataset.menu === menuKey) {
          t.classList.add('is-active');
        } else {
          t.classList.remove('is-active');
        }
      });

      // Update text below logo
      leftTitle.textContent = menuData.leftTitle;
      leftDesc.textContent = menuData.leftDescription;

      // Render Sub-links
      subLinksContainer.innerHTML = buildSubLinks(menuData.items);
      
      // Set default right description to the first item
      if (menuData.items.length > 0) {
        rightDesc.textContent = menuData.items[0].description;
      }

      // Attach hover listeners to new sub-links
      const subLinks = subLinksContainer.querySelectorAll('.sub-link');
      subLinks.forEach(link => {
        link.addEventListener('mouseenter', (e) => {
          const index = e.currentTarget.dataset.index;
          rightDesc.textContent = menuData.items[index].description;
        });
      });

      // Show the overlay
      overlay.classList.remove('opacity-0', 'pointer-events-none');
      overlay.classList.add('opacity-100');
    }

    // Close Menu Logic
    function closeMenu() {
      activeMenuKey = null;
      triggers.forEach(t => t.classList.remove('is-active'));
      overlay.classList.add('opacity-0', 'pointer-events-none');
      overlay.classList.remove('opacity-100');
    }

    // Attach Event Listeners
    triggers.forEach(trigger => {
      trigger.addEventListener('mouseenter', () => {
        clearTimeout(closeTimeout);
        openMenu(trigger.dataset.menu);
      });
    });

    artboard.addEventListener('mouseleave', () => {
      closeTimeout = setTimeout(closeMenu, 150);
    });

    artboard.addEventListener('mouseenter', () => {
      clearTimeout(closeTimeout);
    });
  });
</script>

<!-- Using is:global prevents Astro from accidentally deleting these classes during build! -->
<style is:global>
  .nav-trigger.is-active {
    background-color: #4D4D4D !important;
  }
  
  .nav-trigger.is-active .nav-text,
  .nav-trigger.is-active .nav-icon {
    color: #FFFFFF !important;
  }
</style>
