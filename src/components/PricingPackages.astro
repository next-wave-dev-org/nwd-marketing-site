---
const packages = [
  {
    prefix: 'P',
    suffix: 'ackage 1',
    theme: 'standard',
    description: 'Content about something here to get potential clients to click to go to certain section. Content about something here to get potential clients to click to go to certain section.',
    benefits: ['some kind of benefit here', 'some kind of benefit here', 'some kind of benefit here'],
  },
  {
    prefix: 'P',
    suffix: 'ackage 2',
    theme: 'highlight',
    description: 'Content about something here to get potential clients to click to go to certain section. Content about something here to get potential clients to click to go to certain section.',
    benefits: ['some kind of benefit here', 'some kind of benefit here', 'some kind of benefit here'],
  },
  {
    prefix: 'P',
    suffix: 'ackage 3',
    theme: 'standard',
    description: 'Content about something here to get potential clients to click to go to certain section. Content about something here to get potential clients to click to go to certain section.',
    benefits: ['some kind of benefit here', 'some kind of benefit here', 'some kind of benefit here'],
  },
];
---

<div class="w-full mt-10">
  
  <!-- MOBILE (< 768px) -->
  <div class="mobile-pricing-container relative flex-col w-full items-center gap-[100px] pt-[40px]">
    {packages.map((pkg) => (
      <div class={`relative flex w-full max-w-[400px] flex-col items-center rounded-[20px] px-4 pb-10 pt-[70px] ${pkg.theme === 'highlight' ? 'bg-gradient-to-b from-light-aqua to-secondary-blue shadow-[0_4px_4px_rgba(0,0,0,0.25)]' : 'bg-transparent'}`}>
        
        <!-- Floating Pill Header -->
        <div class="absolute -top-[37px] left-1/2 flex h-[75px] w-[90%] max-w-[276px] -translate-x-1/2 items-center overflow-hidden rounded-[50px] border border-black bg-light-aqua pr-4 shadow-sm">
          <div class="flex h-[74px] w-[74px] flex-shrink-0 items-center justify-center rounded-full bg-primary-blue">
            <span class="font-roboto text-[40px] font-bold leading-none !text-white">{pkg.prefix}</span>
          </div>
          <span class="ml-3 font-roboto text-[32px] font-bold leading-none text-black whitespace-nowrap">
            {pkg.suffix}
          </span>
        </div>

        <!-- Description Box -->
        <div class={`flex w-full max-w-[368px] items-center justify-center rounded-[20px] px-5 py-8 shadow-[0_4px_4px_rgba(0,0,0,0.25)] ${pkg.theme === 'highlight' ? 'bg-dark-blue' : 'bg-primary-blue'}`}>
          <p class="w-full text-left font-inter text-[18px] leading-[1.4] !text-white">
            {pkg.description}
          </p>
        </div>

        <!-- Benefits List -->
        <ul class="mb-12 mt-12 flex w-full flex-col gap-[30px] px-2">
          {pkg.benefits.map((benefit) => (
            <li class="flex items-start gap-4">
              <svg width="24" height="24" viewBox="0 0 34 26" fill="none" xmlns="http://www.w3.org/2000/svg" class="flex-shrink-0 mt-1">
                <path d="M2.5 13L11.5 22L31.5 2" class={pkg.theme === 'highlight' ? 'stroke-dark-blue' : 'stroke-primary-blue'} stroke-width="4" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
              <span class="font-inter text-[20px] leading-tight text-black font-medium">
                {benefit}
              </span>
            </li>
          ))}
        </ul>

        <!-- Action Button -->
        <button class="mt-auto flex h-[49px] w-full max-w-[251px] items-center justify-center rounded-[30px] bg-dark-blue font-inter text-[24px] font-medium !text-button-secondary-text transition-colors hover:bg-black">
          See More
        </button>
        
      </div>
    ))}
  </div>

  <!-- DESKTOP (>= 768px) EXACT FORCED ROW -->
  <div class="desktop-pricing-container relative flex-row justify-between w-full gap-[40px] items-stretch pt-[40px]">
    {packages.map((pkg) => (
      <div class={`relative flex flex-1 flex-col items-center rounded-[20px] px-4 pb-10 pt-[70px] xl:px-6 ${pkg.theme === 'highlight' ? 'bg-gradient-to-b from-light-aqua to-secondary-blue shadow-[0_4px_4px_rgba(0,0,0,0.25)]' : 'bg-transparent'}`}>
        
        <!-- Floating Pill Header -->
        <div class="absolute -top-[37px] left-1/2 flex h-[75px] w-max max-w-[95%] -translate-x-1/2 items-center overflow-hidden rounded-[50px] border border-black bg-light-aqua pr-[25px] shadow-sm xl:pr-[35px]">
          <div class="flex h-[74px] w-[74px] flex-shrink-0 items-center justify-center rounded-full bg-primary-blue">
            <span class="font-roboto text-[48px] font-bold leading-none !text-white">{pkg.prefix}</span>
          </div>
          <span class="ml-3 font-roboto text-[28px] xl:text-[32px] font-bold leading-none text-black whitespace-nowrap">
            {pkg.suffix}
          </span>
        </div>

        <!-- Description Box -->
        <div class={`flex h-[235px] w-full max-w-[368px] items-center justify-center rounded-[20px] px-5 py-8 shadow-[0_4px_4px_rgba(0,0,0,0.25)] ${pkg.theme === 'highlight' ? 'bg-dark-blue' : 'bg-primary-blue'}`}>
          <p class="w-full text-left font-inter text-[18px] leading-[1.4] !text-white">
            {pkg.description}
          </p>
        </div>

        <!-- Benefits List -->
        <ul class="mb-12 mt-12 flex w-full flex-col gap-[30px] px-0 xl:px-[20px]">
          {pkg.benefits.map((benefit) => (
            <li class="flex items-start gap-4">
              <svg width="24" height="24" viewBox="0 0 34 26" fill="none" xmlns="http://www.w3.org/2000/svg" class="flex-shrink-0 mt-1">
                <path d="M2.5 13L11.5 22L31.5 2" class={pkg.theme === 'highlight' ? 'stroke-dark-blue' : 'stroke-primary-blue'} stroke-width="4" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
              <span class="font-inter text-[18px] xl:text-[20px] leading-tight text-black font-medium">
                {benefit}
              </span>
            </li>
          ))}
        </ul>

        <!-- Action Button -->
        <button class="mt-auto flex h-[49px] w-full max-w-[251px] items-center justify-center rounded-[30px] bg-dark-blue font-inter text-[24px] font-medium !text-button-secondary-text transition-colors hover:bg-black">
          See More
        </button>
        
      </div>
    ))}
  </div>

</div>

<style is:global>
  @media (min-width: 768px) { 
    .mobile-pricing-container { display: none !important; } 
    .desktop-pricing-container { display: flex !important; flex-wrap: nowrap !important; } 
  }
  @media (max-width: 767px) { 
    .desktop-pricing-container { display: none !important; } 
    .mobile-pricing-container { display: flex !important; } 
  }
</style>