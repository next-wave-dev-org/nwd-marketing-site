---
// src/components/PricingPackages.astro
import Button from './Button.astro';

const packages = [
  {
    name: 'Starter',
    price: '$199',
    isPopular: false,
    description: 'Perfect for organizations needing routine maintenance. Get up to 8 hours of capacity to keep your digital presence secure and running smoothly.',
    benefits: ['Up to 8 hours of development', 'Routine security & maintenance', 'Minor monthly website updates'],
    href: '/services/pricing/starter'
  },
  {
    name: 'Growth',
    price: '$499',
    isPopular: true,
    description: 'Designed for active product building. Get up to 20 hours to continuously develop new features, enhance UX/UI, and scale your impact.',
    benefits: ['Up to 20 hours of development', 'New feature design & integration', 'Priority response times'],
    href: '/services/pricing/growth'
  },
  {
    name: 'Partner',
    price: '$999',
    isPopular: false,
    description: 'Your ongoing development partner. Get up to 45 hours of a dedicated technical team for custom project execution and long-term building.',
    benefits: ['Up to 45 hours of development', 'Continuous application scaling', 'Strategic technical consulting'],
    href: '/services/pricing/partner'
  },
];
---

<div class="w-full mt-10">
  
  <div class="mx-auto w-full max-w-[800px] bg-surface border border-border-subtle rounded-panel px-6 py-4 mb-12 text-center shadow-xl">
    <p class="font-sans text-[18px] font-semibold text-text-body m-0 leading-snug">
      Because we operate as a non-profit incubator, our subscription tiers are priced at exactly <strong class="text-text-heading">60% of the standard industry market rate</strong>.
    </p>
  </div>
  
  <!-- ITEM 2.7: Unified, visually equal cards using standard semantic tokens -->
  <div class="w-full">
    <div class="flex flex-col lg:flex-row justify-center gap-8 w-full items-stretch">
      {packages.map((pkg) => (
        <div class="relative flex flex-1 flex-col rounded-[20px] bg-surface border border-border-subtle p-8 shadow-xl">
          
          {/* Quiet "Most Popular" marker */}
          {pkg.isPopular && (
            <div class="absolute -top-4 left-1/2 -translate-x-1/2 rounded-full bg-accent-cyan px-4 py-1 text-[12px] font-bold uppercase tracking-wider text-background shadow-md">
              Most Popular
            </div>
          )}
          
          {/* Header: Plan Name (Plain Text) & Price (Largest Element) */}
          <div class="flex flex-col border-b border-border-subtle pb-8 text-center md:text-left">
            <h3 class="font-roboto text-[24px] font-medium text-text-body m-0">{pkg.name}</h3>
            <div class="mt-4 flex items-baseline justify-center md:justify-start gap-1">
              <span class="font-roboto text-[56px] font-bold text-text-heading leading-none tracking-tight">{pkg.price}</span>
              <span class="font-sans text-[18px] font-medium text-text-body">/ mo</span>
            </div>
          </div>

          {/* Description */}
          <div class="py-8 flex-grow">
            <p class="font-sans text-[16px] leading-relaxed text-text-body m-0">
              {pkg.description}
            </p>

            <ul class="mt-8 flex flex-col gap-4">
              {pkg.benefits.map((benefit) => (
                <li class="flex items-start gap-3">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" class="flex-shrink-0 mt-1">
                    <path d="M20 6L9 17l-5-5" class="stroke-accent-cyan" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                  <span class="font-sans text-[16px] leading-snug text-text-heading font-medium">
                    {benefit}
                  </span>
                </li>
              ))}
            </ul>
          </div>

          {/* Get Started CTA */}
          <div class="pt-4">
            <Button href={pkg.href} variant={pkg.isPopular ? 'primary' : 'secondary'} class="w-full">
              Get Started
            </Button>
          </div>
          
        </div>
      ))}
    </div>
  </div>

</div>