---
// src/components/PricingPackages.astro

const packages = [
  {
    prefix: 'S',
    suffix: 'tarter',
    theme: 'standard',
    description: 'Perfect for organizations needing routine maintenance. Get essential capacity to keep your digital presence running smoothly.<br/><br/><span class="text-[24px] font-bold">$199 / mo</span>',
    benefits: ['8 Monthly Credits', 'Occasional improvements', 'Access to NWD Portal'],
    href: '/services/pricing/starter'
  },
  {
    prefix: 'G',
    suffix: 'rowth',
    theme: 'highlight',
    description: 'Designed for active product building. Continuously develop new features, enhance UX/UI, and scale your impact with dedicated support.<br/><br/><span class="text-[24px] font-bold">$499 / mo</span>',
    benefits: ['20 Monthly Credits', 'Active product building', 'Access to NWD Portal'],
    href: '/services/pricing/growth'
  },
  {
    prefix: 'P',
    suffix: 'artner',
    theme: 'standard',
    description: 'Your ongoing development partner. We act as your dedicated technical team for large-scale custom project execution and long-term building.<br/><br/><span class="text-[24px] font-bold">$999 / mo</span>',
    benefits: ['45 Monthly Credits', 'Ongoing development partner', 'Access to NWD Portal'],
    href: '/services/pricing/partner'
  },
];
---

<div class="w-full mt-10">
  
  <!-- MOBILE (< 768px) -->
  <div class="mobile-pricing-container carousel-wrapper relative w-full pt-[20px]">
    
    <div class="carousel-container flex overflow-x-auto snap-x snap-mandatory gap-6 px-6 pb-4 hide-scrollbars w-full items-stretch">
      {packages.map((pkg) => (
        <div class="shrink-0 w-[85vw] max-w-[400px] snap-center pt-[50px]">
          <div class={`relative flex h-full w-full flex-col items-center rounded-[20px] px-4 pb-10 pt-[70px] ${pkg.theme === 'highlight' ? 'bg-gradient-to-b from-light-aqua to-secondary-blue shadow-[0_4px_4px_rgba(0,0,0,0.25)]' : 'bg-transparent'}`}>
            
            <!-- Floating Pill Header -->
            <div class="absolute -top-[37px] left-1/2 flex h-[75px] w-max -translate-x-1/2 items-center rounded-[50px] border border-black bg-light-aqua pr-[25px] shadow-sm">
              <!-- Pushed first letter tight to right edge with pr-[2px] -->
              <div class="flex h-[74px] w-[74px] flex-shrink-0 items-center justify-end rounded-full bg-primary-blue pr-[2px]">
                <span class="font-roboto text-[40px] font-bold leading-none !text-white">{pkg.prefix}</span>
              </div>
              <!-- Removed ml-2 margin to pull remaining letters closer -->
              <span class="font-roboto text-[32px] font-bold leading-tight text-black whitespace-nowrap">
                {pkg.suffix}
              </span>
            </div>

            <!-- Description Box -->
            <div class={`flex w-full max-w-[368px] items-center justify-center rounded-[20px] px-5 py-8 shadow-[0_4px_4px_rgba(0,0,0,0.25)] ${pkg.theme === 'highlight' ? 'bg-dark-blue' : 'bg-primary-blue'}`}>
              <p class="w-full text-left font-sans text-[16px] leading-[1.4] !text-white" set:html={pkg.description}></p>
            </div>

            <!-- Benefits List -->
            <ul class="mb-12 mt-12 flex w-full flex-col gap-[30px] px-2">
              {pkg.benefits.map((benefit) => (
                <li class="flex items-start gap-4">
                  <svg width="24" height="24" viewBox="0 0 34 26" fill="none" xmlns="http://www.w3.org/2000/svg" class="flex-shrink-0 mt-1">
                    <path d="M2.5 13L11.5 22L31.5 2" class={pkg.theme === 'highlight' ? 'stroke-dark-blue' : 'stroke-primary-blue'} stroke-width="4" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                  <span class="font-sans text-[18px] leading-tight text-black font-bold">
                    {benefit}
                  </span>
                </li>
              ))}
            </ul>

            <!-- Action Link -->
            <a href={pkg.href} class="mt-auto flex h-[49px] w-full max-w-[251px] items-center justify-center rounded-[30px] bg-dark-blue font-roboto text-[24px] font-bold !text-button-secondary-text transition-colors hover:bg-black shadow-sm">
              See More
            </a>
            
          </div>
        </div>
      ))}
    </div>

    <!-- Black Pill Arrows -->
    <div class="flex justify-center mt-2">
      <div class="inline-flex items-center gap-[30px] rounded-[30px] border border-black px-[30px] py-[6px]">
        <button type="button" class="carousel-prev flex h-[50px] w-[50px] items-center justify-center rounded-full bg-black text-[28px] text-card-arrow transition-opacity" aria-label="Scroll left">&#8249;</button>
        <button type="button" class="carousel-next flex h-[50px] w-[50px] items-center justify-center rounded-full bg-black text-[28px] text-card-arrow transition-opacity" aria-label="Scroll right">&#8250;</button>
      </div>
    </div>

  </div>

  <!-- DESKTOP (>= 768px) EXACT FORCED ROW -->
  <div class="desktop-pricing-container relative flex-row justify-between w-full gap-[40px] items-stretch pt-[40px]">
    {packages.map((pkg) => (
      <div class={`relative flex flex-1 flex-col items-center rounded-[20px] px-4 pb-10 pt-[70px] xl:px-6 ${pkg.theme === 'highlight' ? 'bg-gradient-to-b from-light-aqua to-secondary-blue shadow-[0_4px_4px_rgba(0,0,0,0.25)]' : 'bg-transparent'}`}>
        
        <!-- Floating Pill Header -->
        <div class="absolute -top-[37px] left-1/2 flex h-[75px] w-max -translate-x-1/2 items-center rounded-[50px] border border-black bg-light-aqua pr-[25px] shadow-sm xl:pr-[35px]">
          <!-- Pushed first letter tight to right edge with pr-[2px] -->
          <div class="flex h-[74px] w-[74px] flex-shrink-0 items-center justify-end rounded-full bg-primary-blue pr-[2px]">
            <span class="font-roboto text-[40px] font-bold leading-none !text-white">{pkg.prefix}</span>
          </div>
          <!-- Removed ml-2 margin to pull remaining letters closer -->
          <span class="font-roboto text-[32px] font-bold leading-[56px] text-black whitespace-nowrap">
            {pkg.suffix}
          </span>
        </div>

        <!-- Description Box -->
        <div class={`flex h-[235px] w-full max-w-[368px] items-center justify-center rounded-[20px] px-5 py-8 shadow-[0_4px_4px_rgba(0,0,0,0.25)] ${pkg.theme === 'highlight' ? 'bg-dark-blue' : 'bg-primary-blue'}`}>
          <p class="w-full text-left font-sans text-[18px] leading-[1.4] !text-white" set:html={pkg.description}></p>
        </div>

        <!-- Benefits List -->
        <ul class="mb-12 mt-12 flex w-full flex-col gap-[30px] px-0 xl:px-[20px]">
          {pkg.benefits.map((benefit) => (
            <li class="flex items-start gap-4">
              <svg width="24" height="24" viewBox="0 0 34 26" fill="none" xmlns="http://www.w3.org/2000/svg" class="flex-shrink-0 mt-1">
                <path d="M2.5 13L11.5 22L31.5 2" class={pkg.theme === 'highlight' ? 'stroke-dark-blue' : 'stroke-primary-blue'} stroke-width="4" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
              <span class="font-sans text-[20px] leading-tight text-black font-bold">
                {benefit}
              </span>
            </li>
          ))}
        </ul>

        <!-- Action Link -->
        <a href={pkg.href} class="mt-auto flex h-[49px] w-full max-w-[251px] items-center justify-center rounded-[30px] bg-dark-blue font-roboto text-[24px] font-bold !text-button-secondary-text transition-colors hover:bg-black shadow-sm">
          See More
        </a>
        
      </div>
    ))}
  </div>

</div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const carousels = document.querySelectorAll('.carousel-wrapper:not(.initialized)');
    carousels.forEach(wrapper => {
      wrapper.classList.add('initialized');
      const container = wrapper.querySelector('.carousel-container') as HTMLElement;
      const prevBtn = wrapper.querySelector('.carousel-prev') as HTMLButtonElement;
      const nextBtn = wrapper.querySelector('.carousel-next') as HTMLButtonElement;

      if (!container || !prevBtn || !nextBtn) return;

      prevBtn.addEventListener('click', () => {
        container.scrollBy({ left: -container.clientWidth * 0.8, behavior: 'smooth' });
      });

      nextBtn.addEventListener('click', () => {
        container.scrollBy({ left: container.clientWidth * 0.8, behavior: 'smooth' });
      });
    });
  });
</script>

<style is:global>
  .hide-scrollbars {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
  .hide-scrollbars::-webkit-scrollbar {
    display: none;
  }

  @media (min-width: 768px) { 
    .mobile-pricing-container { display: none !important; } 
    .desktop-pricing-container { display: flex !important; flex-wrap: nowrap !important; } 
  }
  @media (max-width: 767px) { 
    .desktop-pricing-container { display: none !important; } 
    .mobile-pricing-container { display: block !important; } 
  }
</style>