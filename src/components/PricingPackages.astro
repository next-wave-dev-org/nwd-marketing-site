---
// src/components/PricingPackages.astro

const packages = [
  {
    prefix: 'S',
    suffix: 'tarter',
    theme: 'standard',
    description: 'Perfect for organizations needing routine maintenance. Get up to 8 hours of capacity to keep your digital presence secure and running smoothly.<br/><br/><span class="text-[24px] font-bold text-[#38C1ED]">$199 / mo recurring</span>',
    benefits: ['Up to 8 hours of development', 'Routine security & maintenance', 'Minor monthly website updates'],
    href: '/services/pricing/starter'
  },
  {
    prefix: 'G',
    suffix: 'rowth',
    theme: 'highlight',
    description: 'Designed for active product building. Get up to 20 hours to continuously develop new features, enhance UX/UI, and scale your impact.<br/><br/><span class="text-[24px] font-bold text-white">$499 / mo recurring</span>',
    benefits: ['Up to 20 hours of development', 'New feature design & integration', 'Priority response times'],
    href: '/services/pricing/growth'
  },
  {
    prefix: 'P',
    suffix: 'artner',
    theme: 'standard',
    description: 'Your ongoing development partner. Get up to 45 hours of a dedicated technical team for custom project execution and long-term building.<br/><br/><span class="text-[24px] font-bold text-[#38C1ED]">$999 / mo recurring</span>',
    benefits: ['Up to 45 hours of development', 'Continuous application scaling', 'Strategic technical consulting'],
    href: '/services/pricing/partner'
  },
];
---

<div class="w-full mt-10">
  
  <div class="mx-auto w-full max-w-[800px] bg-[#16132A] border border-white/10 rounded-[15px] px-6 py-4 mb-8 text-center shadow-xl">
    <p class="font-sans text-[18px] font-semibold text-[#C0C5E2] m-0 leading-snug">
      Because we operate as a non-profit incubator, our subscription tiers are priced at exactly <strong class="text-white">60% of the standard industry market rate</strong>.
    </p>
  </div>
  
  <div class="relative w-full pt-[20px] md:pt-[40px]">
    <div class="flex flex-nowrap md:flex-wrap lg:flex-nowrap justify-start md:justify-between overflow-x-auto md:overflow-visible snap-x md:snap-none snap-mandatory gap-6 md:gap-[40px] px-6 md:px-0 pb-4 md:pb-0 hide-scrollbars w-full items-stretch">
      {packages.map((pkg) => (
        <div class="shrink-0 w-[85vw] max-w-[400px] md:max-w-none md:w-auto md:flex-1 snap-center pt-[50px] md:pt-[70px]">
          <div class={`relative flex h-full w-full flex-col items-center rounded-[20px] px-4 pb-10 pt-[70px] xl:px-6 border border-white/10 ${pkg.theme === 'highlight' ? 'bg-gradient-to-b from-[#16132A] to-[#0F0C20] shadow-2xl' : 'bg-[#16132A]'}`}>
            
            <div class="absolute -top-[37px] left-1/2 flex h-[75px] w-max -translate-x-1/2 items-center rounded-[50px] border border-white/10 bg-[#0F0C20] pr-[25px] xl:pr-[35px] shadow-md">
              <div class="flex h-[74px] w-[74px] flex-shrink-0 items-center justify-end rounded-full bg-[#4A3B96] border border-white/10 pr-[2px]">
                <span class="font-roboto text-[40px] font-bold leading-none text-white">{pkg.prefix}</span>
              </div>
              <span class="font-roboto text-[32px] font-bold leading-tight md:leading-[56px] text-white whitespace-nowrap pl-4">
                {pkg.suffix}
              </span>
            </div>

            <div class={`flex w-full md:h-[235px] max-w-[368px] items-center justify-center rounded-[20px] px-5 py-8 md:py-0 shadow-inner border border-white/10 ${pkg.theme === 'highlight' ? 'bg-[#4A3B96]' : 'bg-[#0F0C20]'}`}>
              <p class="w-full text-left font-sans text-[16px] md:text-[18px] leading-[1.4] text-[#C0C5E2]" set:html={pkg.description}></p>
            </div>

            <ul class="mb-12 mt-12 flex w-full flex-col gap-[30px] px-2 md:px-0 xl:px-[20px]">
              {pkg.benefits.map((benefit) => (
                <li class="flex items-start gap-4">
                  <svg width="24" height="24" viewBox="0 0 34 26" fill="none" xmlns="http://www.w3.org/2000/svg" class="flex-shrink-0 mt-1">
                    <path d="M2.5 13L11.5 22L31.5 2" class="stroke-[#38C1ED]" stroke-width="4" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                  <span class="font-sans text-[18px] md:text-[20px] leading-tight text-white font-bold">
                    {benefit}
                  </span>
                </li>
              ))}
            </ul>

            <a href={pkg.href} class="mt-auto flex h-[49px] w-full max-w-[251px] items-center justify-center rounded-[30px] bg-gradient-to-r from-[#4A3B96] to-[#1D70B8] font-roboto text-[24px] font-bold text-white transition-all hover:opacity-90 shadow-md">
              Get Started
            </a>
            
          </div>
        </div>
      ))}
    </div>
  </div>

</div>