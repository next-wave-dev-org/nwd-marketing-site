---
import { Image } from 'astro:assets';

export interface Props {
    name: string;
    role: string;
    image?: string;
}

const { name, role, image } = Astro.props;
---

<div class="w-full">
  
  <!-- MOBILE (< 768px) -->
  <div class="mobile-profile-card relative w-full max-w-[314px] shrink-0 mx-auto pb-8">
    <div class="flex h-[180px] w-full flex-col items-center rounded-[10px] bg-[#16132A] border border-white/10 px-4 pt-8 text-center shadow-xl">
      <div class="font-sans text-[18px] italic leading-tight text-[#38C1ED]">{role}</div>
      <div class="font-roboto text-[28px] font-semibold leading-tight text-white mt-2">{name}</div>
    </div>
    
    <div class="flex justify-center -mt-16 relative z-10">
      <div class="flex h-[200px] w-[200px] items-center justify-center overflow-hidden rounded-full bg-[#4A3B96] border border-white/10 shadow-[0px_8px_15px_rgba(0,0,0,0.5)]">
        {image ? (
          <Image src={image} alt={`Profile of ${name}`} width={200} height={200} class="h-full w-full object-cover opacity-90" />
        ) : (
          <div class="h-full w-full bg-[#4A3B96]"></div>
        )}
      </div>
    </div>
  </div>

  <!-- DESKTOP (>= 768px) -->
  <div class="desktop-profile-card relative h-[403px] w-[314px] shrink-0">
    <div class="absolute left-[20px] right-[19px] top-0 h-[246px] rounded-[10px] bg-[#16132A] border border-white/10 shadow-xl"></div>
    <div class="absolute left-[30px] top-[49px] font-sans text-[20px] italic leading-[20px] text-[#38C1ED]">{role}</div>
    <div class="absolute left-[26px] top-[78px] flex items-center font-roboto text-[32px] font-semibold leading-[20px] text-white">{name}</div>
    <div class="absolute left-[18px] top-[125px] flex h-[278px] w-[278px] overflow-hidden items-center justify-center rounded-full bg-[#4A3B96] border border-white/10 shadow-[0px_8px_15px_rgba(0,0,0,0.5)]">
        {image ? (
          <Image src={image} alt={`Profile of ${name}`} width={278} height={278} class="h-full w-full object-cover opacity-90" />
        ) : (
          <div class="h-full w-full bg-[#4A3B96]"></div>
        )}
    </div>
  </div>

</div>

<style is:global>
  @media (min-width: 768px) { 
    .mobile-profile-card { display: none !important; } 
    .desktop-profile-card { display: block !important; } 
  }
  @media (max-width: 767px) { 
    .desktop-profile-card { display: none !important; } 
    .mobile-profile-card { display: block !important; } 
  }
</style>