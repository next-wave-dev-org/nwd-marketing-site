---
export interface Props {
    name: string;
    role: string;
    image?: string;
}

const { name, role, image } = Astro.props;
---

<div class="w-full">
  
  <!-- MOBILE (< 768px) -->
  <div class="mobile-profile-card relative w-full max-w-[314px] shrink-0 mx-auto pb-8">
    <!-- Gradient Background Box with Flexbox to prevent text overlap -->
    <div class="flex h-[180px] w-full flex-col items-center rounded-[10px] bg-gradient-to-b from-light-aqua to-secondary-blue px-4 pt-8 text-center">
      <div class="font-sans text-[18px] italic leading-tight text-black">{role}</div>
      <div class="font-roboto text-[28px] font-semibold leading-tight text-black mt-2">{name}</div>
    </div>
    
    <!-- Profile Picture Circle overlapping naturally -->
    <div class="flex justify-center -mt-16 relative z-10">
      <!-- Added overflow-hidden to keep images perfectly round -->
      <div class="flex h-[200px] w-[200px] items-center justify-center overflow-hidden rounded-full bg-primary-blue shadow-[0px_8px_6px_rgba(0,0,0,0.25)]">
        {image ? (
          <img src={image} alt={`Profile of ${name}`} class="h-full w-full object-cover" />
        ) : (
          <span class="font-inter text-[15px] font-normal leading-[18px] text-profile-placeholder-text">
              Profile Pic*
          </span>
        )}
      </div>
    </div>
  </div>

  <!-- DESKTOP (>= 768px) EXACT ORIGINAL CODE -->
  <div class="desktop-profile-card relative h-[403px] w-[314px] shrink-0">
    <div class="absolute left-[20px] right-[19px] top-0 h-[246px] rounded-[10px] bg-gradient-to-b from-light-aqua to-secondary-blue"></div>
    <div class="absolute left-[30px] top-[49px] font-['Public_Sans'] text-[20px] italic leading-[20px] text-black">{role}</div>
    <div class="absolute left-[26px] top-[78px] flex items-center font-roboto text-[32px] font-semibold leading-[20px] text-black">{name}</div>
    <!-- Added overflow-hidden to keep images perfectly round -->
    <div class="absolute left-[18px] top-[125px] flex h-[278px] w-[278px] overflow-hidden items-center justify-center rounded-full bg-primary-blue shadow-[0px_8px_6px_rgba(0,0,0,0.25)]">
        {image ? (
          <img src={image} alt={`Profile of ${name}`} class="h-full w-full object-cover" />
        ) : (
          <span class="font-inter text-[15px] font-normal leading-[18px] text-profile-placeholder-text">
              Profile Pic*
          </span>
        )}
    </div>
  </div>

</div>

<style is:global>
  @media (min-width: 768px) { 
    .mobile-profile-card { display: none !important; } 
    .desktop-profile-card { display: block !important; } 
  }
  @media (max-width: 767px) { 
    .desktop-profile-card { display: none !important; } 
    .mobile-profile-card { display: block !important; } 
  }
</style>