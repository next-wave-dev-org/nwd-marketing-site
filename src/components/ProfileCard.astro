---
export interface Props {
    name: string;
    role: string;
}

const { name, role } = Astro.props;
---

<div class="relative h-[403px] w-[314px] shrink-0">
    <!-- Gradient Background Box (Rectangle 8) -->
    <!-- Positioned slightly inward from the edges to match the 6.37% / 6.05% Figma spacing -->
    <div class="absolute left-[20px] right-[19px] top-0 h-[246px] rounded-[10px] bg-gradient-to-b from-[#FAFAFA] to-[#B8B8B8]"></div>
    
    <!-- Role Text (Program Manager) -->
    <!-- Requires Public Sans italic -->
    <div class="absolute left-[30px] top-[49px] font-['Public_Sans'] text-[20px] italic leading-[20px] text-black">
        {role}
    </div>
    
    <!-- Name Text (Bob Smith) -->
    <div class="absolute left-[26px] top-[78px] flex items-center font-roboto text-[32px] font-semibold leading-[20px] text-black">
        {name}
    </div>
    
    <!-- Profile Picture Circle (Ellipse 7) -->
    <!-- Drops 125px down to overlap the background, exact 278px dimensions, custom drop shadow -->
    <div class="absolute left-[18px] top-[125px] flex h-[278px] w-[278px] items-center justify-center rounded-full bg-[#7D7D7D] shadow-[0px_8px_6px_rgba(0,0,0,0.25)]">
        <span class="font-inter text-[15px] font-normal leading-[18px] text-[#D3D3D3]">
            Profile Pic*
        </span>
    </div>
</div>