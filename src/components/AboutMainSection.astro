---
import Button from './Button.astro';
---

<!-- FIX: Added flex-col to prevent the mobile and desktop views from rendering side-by-side! -->
<div class="w-full flex flex-col items-center">

  <!-- =============================== -->
  <!-- MOBILE VIEW (< 768px)           -->
  <!-- =============================== -->
  <!-- FIX: Added md:hidden directly to the class list -->
  <div id="mobile-about-section" class="w-full flex flex-col font-sans text-black gap-12 px-6 md:hidden">
    
    <!-- Mobile Hero (Vertically Stacked) -->
    <div class="w-full rounded-[10px] bg-gradient-to-b from-light-aqua to-secondary-blue p-6 shadow-md mt-4">
      <div class="flex flex-col items-center text-center gap-6 w-full">
        <div class="flex h-[150px] w-[150px] shrink-0 items-center justify-center rounded-full bg-primary-blue shadow-md mx-auto">
          <h2 class="font-heading text-[24px] font-bold leading-none text-hero-text text-center drop-shadow-sm [text-shadow:-1px_-1px_0_#D49A1D,_1px_-1px_0_#D49A1D,_-1px_1px_0_#D49A1D,_1px_1px_0_#D49A1D]">
            About<br/>Us
          </h2>
        </div>
        <div class="flex flex-col gap-3 w-full">
          <h1 class="font-roboto text-[24px] font-bold leading-tight text-black">Our Mission</h1>
          <p class="font-sans text-[15px] font-normal leading-relaxed text-black">
            Bridging the gap between classroom learning and career success, we equip students and recent graduates with the skills, mentorship, and real-world experience needed to deliver high-quality tech solutions.
          </p>
        </div>
      </div>
    </div>

    <!-- Who we are -->
    <div class="flex flex-col gap-6 text-center mt-6">
      <h2 class="font-roboto text-[32px] font-bold leading-tight text-black">Who we are</h2>
      <p class="font-sans text-[18px] font-normal leading-relaxed text-black">
        Next Wave Dev is a registered 501(c)(3) non-profit organization. We operate as a managed digital product and services agency, powered by highly motivated emerging technologists and guided by experienced industry professionals.
      </p>
      <div class="flex h-[250px] w-full items-center justify-center rounded-[15px] bg-light-aqua shadow-card overflow-hidden">
        <img src="/images/who-we-are.jpg" alt="Who we are" class="w-full h-full object-cover" />
      </div>
    </div>

    <!-- Why we do what we do -->
    <div class="flex flex-col gap-6 text-center">
      <h2 class="font-roboto text-[32px] font-bold leading-tight text-black">Why we do what we do</h2>
      <p class="font-sans text-[18px] font-normal leading-relaxed text-black">
        We believe the traditional hiring loop is broken. Recent graduates struggle to find entry-level roles without experience, while mission-driven organizations struggle to afford quality digital services. By connecting the two, we solve both problems simultaneously.
      </p>
      <div class="flex h-[250px] w-full items-center justify-center rounded-[15px] bg-light-aqua shadow-card overflow-hidden">
        <img src="/images/why-we-do-what-we-do.png" alt="Why we do what we do" class="w-full h-full object-cover" />
      </div>
    </div>

    <!-- Bringing opportunities to those who need it -->
    <div class="flex flex-col gap-8 text-center mt-12">
      <h2 class="font-roboto text-[28px] font-bold leading-tight text-black">
        Bringing opportunities to those who need it
      </h2>
      <div class="flex flex-col gap-6 items-center">
        <div class="flex flex-col gap-3 w-full max-w-[420px]">
          <div class="flex min-h-[72px] py-2 w-full items-center justify-center rounded-[14px] bg-dark-blue px-8">
            <span class="font-roboto text-[22px] font-medium !text-white text-center leading-tight">Real Work Experience</span>
          </div>
          <p class="font-sans text-[16px] font-normal leading-relaxed text-black">We move beyond classroom theory by placing emerging developers in active, client-facing roles. Our graduates build, test, and deploy real digital products that have a tangible impact.</p>
        </div>
        <div class="flex flex-col gap-3 w-full max-w-[420px]">
          <div class="flex min-h-[72px] py-2 w-full items-center justify-center rounded-[14px] bg-dark-blue px-8">
            <span class="font-roboto text-[22px] font-medium !text-white text-center leading-tight">Next Generation of Talent</span>
          </div>
          <p class="font-sans text-[16px] font-normal leading-relaxed text-black">By investing in entry-level technologists, we cultivate a diverse pipeline of skilled professionals who are fully prepared to tackle the tech industry's toughest challenges.</p>
        </div>
        <div class="flex flex-col gap-3 w-full max-w-[420px]">
          <div class="flex min-h-[72px] py-2 w-full items-center justify-center rounded-[14px] bg-dark-blue px-8">
            <span class="font-roboto text-[22px] font-medium !text-white text-center leading-tight">Non-Profit</span>
          </div>
          <p class="font-sans text-[16px] font-normal leading-relaxed text-black">As a registered 501(c)(3), our priority is community impact over corporate profit. Every client subscription directly funds educational opportunities and career advancement.</p>
        </div>
        <div class="flex flex-col gap-3 w-full max-w-[420px]">
          <div class="flex min-h-[72px] py-2 w-full items-center justify-center rounded-[14px] bg-dark-blue px-8">
            <span class="font-roboto text-[22px] font-medium !text-white text-center leading-tight">Aiding Local Businesses</span>
          </div>
          <p class="font-sans text-[16px] font-normal leading-relaxed text-black">We empower small businesses, startups, and community organizations with enterprise-grade tech solutions at accessible, predictable monthly rates.</p>
        </div>
      </div>
    </div>

    <!-- Outreach Clusters (Buttons moved strictly below images) -->
    <div class="flex flex-col gap-12 text-center mt-12">
      <div class="flex flex-col gap-4">
        <h3 class="font-inter text-[28px] font-semibold text-black">Helping Seattle’s Economy</h3>
        <p class="font-sans text-[16px] font-normal leading-relaxed text-black">A thriving local economy requires a diverse and accessible talent pipeline. By partnering with organizations to solve their digital needs, we keep innovation local and foster a sustainable tech ecosystem right here in the Pacific Northwest.</p>
        <div class="mt-2 flex h-[220px] w-full items-center justify-center rounded-[15px] bg-light-aqua shadow-card overflow-hidden">
          <img src="/images/helping-seattles-economy.jpg" alt="Helping Seattle's Economy" class="w-full h-full object-cover" />
        </div>
        <div class="flex justify-center mt-2"><Button href="/about-us/our-mission" label="See More" /></div>
      </div>

      <div class="flex flex-col gap-4">
        <h3 class="font-inter text-[28px] font-semibold text-black">Advising Graduates</h3>
        <p class="font-sans text-[16px] font-normal leading-relaxed text-black">Navigating the leap from academia to the professional tech industry can be daunting. We provide hands-on mentorship, code reviews, and career guidance, ensuring our team members build the confidence and portfolios necessary to land permanent roles.</p>
        <div class="mt-2 flex h-[220px] w-full items-center justify-center rounded-[15px] bg-light-aqua shadow-card overflow-hidden">
          <img src="/images/advising-graduates.png" alt="Advising Graduates" class="w-full h-full object-cover" />
        </div>
        <!-- Link updated to our-team -->
        <div class="flex justify-center mt-2"><Button href="/about-us/our-team" label="See More" /></div>
      </div>

      <div class="flex flex-col gap-4">
        <h3 class="font-inter text-[28px] font-semibold text-black">Investing in Talent</h3>
        <p class="font-sans text-[16px] font-normal leading-relaxed text-black">Our organization is built on the fundamental belief that potential needs a place to practice. From dedicated project managers to senior technical advisors, our structure is designed to support, nurture, and elevate every individual who walks through our doors.</p>
        <div class="mt-2 flex h-[220px] w-full items-center justify-center rounded-[15px] bg-light-aqua shadow-card overflow-hidden">
          <img src="/images/investing-in-talent.jpg" alt="Investing in Talent" class="w-full h-full object-cover" />
        </div>
        <!-- Link updated to our-org -->
        <div class="flex justify-center mt-2"><Button href="/about-us/our-org" label="See More" /></div>
      </div>
    </div>

    <!-- Mobile Partner Logos -->
    <div class="flex flex-wrap items-center justify-center gap-6 py-8 mt-4">
      <div class="flex h-[120px] w-[120px] shrink-0 items-center justify-center rounded-full bg-primary-blue shadow-md overflow-hidden">
        <img src="/images/partner-dtb-logo.png" alt="DTB Partner" class="h-full w-full object-cover" />
      </div>
      <div class="flex h-[120px] w-[120px] shrink-0 items-center justify-center rounded-full bg-primary-blue shadow-md overflow-hidden">
        <img src="/images/partner-ccg-logo.png" alt="CCG Partner" class="h-full w-full object-cover" />
      </div>
    </div>

  </div>


  <!-- =============================== -->
  <!-- DESKTOP VIEW (>= 768px)         -->
  <!-- =============================== -->
  <div id="desktop-about-section" class="mx-auto hidden md:flex flex-col w-full max-w-[1289px] font-sans text-black">
      
      <!-- TOP SECTION -->
      <div class="flex w-full flex-col overflow-hidden rounded-[10px] bg-gradient-to-b from-light-aqua to-secondary-blue shadow-lg mb-[140px]">
          <section class="relative flex h-[489px] w-full items-center">
              <div class="absolute left-[47px] top-[19px] z-10 flex h-[390px] w-[390px] items-center justify-center rounded-full bg-primary-blue shadow-lg">
                  <span class="font-heading text-[96px] font-bold leading-none text-hero-text drop-shadow-card text-center [text-shadow:-3px_-3px_0_#D49A1D,_3px_-3px_0_#D49A1D,_-3px_3px_0_#D49A1D,_3px_3px_0_#D49A1D]">
                      About<br/>Us
                  </span>
              </div>
              <div class="absolute left-[470px] flex w-[650px] flex-col gap-4 text-left z-10 pr-8">
                  <h1 class="m-0 font-roboto text-[48px] lg:text-[56px] font-bold leading-[1.1] text-black break-words">Our Mission</h1>
                  <p class="m-0 font-sans text-[24px] font-normal leading-[33px] text-black">
                      Bridging the gap between classroom learning and career success, we equip students and recent graduates with the skills, mentorship, and real-world experience needed to deliver high-quality tech solutions.
                  </p>
              </div>
          </section>
      </div>

      <!-- WHO WE ARE & WHY WE DO WHAT WE DO -->
      <div class="flex flex-col gap-[80px]">
          <div class="flex items-center justify-between gap-[40px]">
              <div class="flex flex-col gap-5 w-[550px] shrink-0">
                  <h2 class="font-roboto text-[48px] font-bold leading-[60px] text-black">Who we are</h2>
                  <p class="font-sans text-[24px] font-normal leading-[33px] text-black">
                      Next Wave Dev is a registered 501(c)(3) non-profit organization. We operate as a managed digital product and services agency, powered by highly motivated emerging technologists and guided by experienced industry professionals.
                  </p>
              </div>
              <div class="flex h-[360px] w-[550px] shrink-0 items-center justify-center rounded-[15px] bg-light-aqua shadow-card overflow-hidden">
                  <img src="/images/who-we-are.jpg" alt="Who we are" class="w-full h-full object-cover" />
              </div>
          </div>
          <div class="flex items-center justify-between gap-[40px]">
              <div class="flex h-[360px] w-[550px] shrink-0 items-center justify-center rounded-[15px] bg-light-aqua shadow-card overflow-hidden">
                  <img src="/images/why-we-do-what-we-do.png" alt="Why we do what we do" class="w-full h-full object-cover" />
              </div>
              <div class="flex flex-col gap-5 w-[550px] shrink-0">
                  <h2 class="font-roboto text-[48px] font-bold leading-[60px] text-black">Why we do what we do</h2>
                  <p class="font-sans text-[24px] font-normal leading-[33px] text-black">
                      We believe the traditional hiring loop is broken. Recent graduates struggle to find entry-level roles without experience, while mission-driven organizations struggle to afford quality digital services. By connecting the two, we solve both problems simultaneously.
                  </p>
              </div>
          </div>
      </div>

      <!-- BRINGING OPPORTUNITIES TO THOSE WHO NEED IT -->
      <div class="flex flex-col gap-[40px] mt-[120px]">
          <h2 class="font-roboto text-[40px] font-bold leading-[50px] text-black">Bringing opportunities to those who need it</h2>
          <div class="grid grid-cols-2 gap-x-[90px] gap-y-[45px]">
              <div class="flex flex-col gap-4 max-w-[500px]">
                  <div class="flex min-h-[76px] py-2 w-max min-w-[340px] items-center justify-center rounded-[14px] bg-dark-blue px-8">
                      <span class="font-roboto text-[26px] font-medium !text-white text-center leading-tight">Real Work Experience</span>
                  </div>
                  <p class="font-sans text-[20px] font-normal leading-[27px] text-black">We move beyond classroom theory by placing emerging developers in active, client-facing roles. Our graduates build, test, and deploy real digital products that have a tangible impact.</p>
              </div>
              <div class="flex flex-col gap-4 max-w-[500px]">
                  <div class="flex min-h-[76px] py-2 w-max min-w-[380px] items-center justify-center rounded-[14px] bg-dark-blue px-8">
                      <span class="font-roboto text-[26px] font-medium !text-white text-center leading-tight">Next Generation of Talent</span>
                  </div>
                  <p class="font-sans text-[20px] font-normal leading-[27px] text-black">By investing in entry-level technologists, we cultivate a diverse pipeline of skilled professionals who are fully prepared to tackle the tech industry's toughest challenges.</p>
              </div>
              <div class="flex flex-col gap-4 max-w-[500px]">
                  <div class="flex min-h-[76px] py-2 w-max min-w-[340px] items-center justify-center rounded-[14px] bg-dark-blue px-8">
                      <span class="font-roboto text-[26px] font-medium !text-white text-center leading-tight">Non-Profit</span>
                  </div>
                  <p class="font-sans text-[20px] font-normal leading-[27px] text-black">As a registered 501(c)(3), our priority is community impact over corporate profit. Every client subscription directly funds educational opportunities and career advancement.</p>
              </div>
              <div class="flex flex-col gap-4 max-w-[500px]">
                  <div class="flex min-h-[76px] py-2 w-max min-w-[380px] items-center justify-center rounded-[14px] bg-dark-blue px-8">
                      <span class="font-roboto text-[26px] font-medium !text-white text-center leading-tight">Aiding Local Businesses</span>
                  </div>
                  <p class="font-sans text-[20px] font-normal leading-[27px] text-black">We empower small businesses, startups, and community organizations with enterprise-grade tech solutions at accessible, predictable monthly rates.</p>
              </div>
          </div>
      </div>

      <!-- OUTREACH CLUSTERS (Links updated) -->
      <div class="flex flex-col gap-[100px] mt-[120px]">
          <div class="flex items-center justify-between">
              <div class="flex flex-col gap-4 max-w-[531px]">
                  <h3 class="font-inter text-[40px] font-semibold leading-[48px] text-black">Helping Seattle’s Economy</h3>
                  <p class="font-sans text-[20px] font-normal leading-[27px] text-black">A thriving local economy requires a diverse and accessible talent pipeline. By partnering with organizations to solve their digital needs, we keep innovation local and foster a sustainable tech ecosystem right here in the Pacific Northwest.</p>
                  <div class="mt-4"><Button href="/about-us/our-mission" label="See More" /></div>
              </div>
              <div class="flex h-[320px] w-[540px] items-center justify-center rounded-[15px] bg-light-aqua shadow-card overflow-hidden">
                  <img src="/images/helping-seattles-economy.jpg" alt="Helping Seattle's Economy" class="w-full h-full object-cover" />
              </div>
          </div>
          <div class="flex items-center justify-between">
              <div class="flex h-[320px] w-[540px] items-center justify-center rounded-[15px] bg-light-aqua shadow-card overflow-hidden">
                  <img src="/images/advising-graduates.png" alt="Advising Graduates" class="w-full h-full object-cover" />
              </div>
              <div class="flex flex-col gap-4 max-w-[585px]">
                  <h3 class="font-inter text-[40px] font-semibold leading-[48px] text-black">Advising Graduates</h3>
                  <p class="font-sans text-[20px] font-normal leading-[27px] text-black">Navigating the leap from academia to the professional tech industry can be daunting. We provide hands-on mentorship, code reviews, and career guidance, ensuring our team members build the confidence and portfolios necessary to land permanent roles.</p>
                  <!-- Link updated to our-team -->
                  <div class="mt-4"><Button href="/about-us/our-team" label="See More" /></div>
              </div>
          </div>
          <div class="flex items-center justify-between">
              <div class="flex flex-col gap-4 max-w-[585px]">
                  <h3 class="font-inter text-[40px] font-semibold leading-[48px] text-black">Investing in Talent</h3>
                  <p class="font-sans text-[20px] font-normal leading-[27px] text-black">Our organization is built on the fundamental belief that potential needs a place to practice. From dedicated project managers to senior technical advisors, our structure is designed to support, nurture, and elevate every individual who walks through our doors.</p>
                  <!-- Link updated to our-org -->
                  <div class="mt-4"><Button href="/about-us/our-org" label="See More" /></div>
              </div>
              <div class="flex h-[320px] w-[540px] items-center justify-center rounded-[15px] bg-light-aqua shadow-card overflow-hidden">
                  <img src="/images/investing-in-talent.jpg" alt="Investing in Talent" class="w-full h-full object-cover" />
              </div>
          </div>
      </div>

      <!-- PARTNER LOGOS ROW -->
      <div class="flex items-center justify-center gap-[47px] py-10 mt-[40px]">
          <div class="flex h-[168px] w-[168px] shrink-0 items-center justify-center rounded-full bg-primary-blue shadow-md transition-transform hover:scale-105 overflow-hidden">
              <img src="/images/partner-dtb-logo.png" alt="DTB Partner" class="h-full w-full object-cover" />
          </div>
          <div class="flex h-[168px] w-[168px] shrink-0 items-center justify-center rounded-full bg-primary-blue shadow-md transition-transform hover:scale-105 overflow-hidden">
              <img src="/images/partner-ccg-logo.png" alt="CCG Partner" class="h-full w-full object-cover" />
          </div>
      </div>

  </div>

</div>