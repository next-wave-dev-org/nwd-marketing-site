---
const steps = [
  {
    title: 'Submit Application',
    description: 'Fill out our brief online application to share your background, skills, and the type of projects you are most passionate about.'
  }, 
  {
    title: 'Initial Interview',
    description: 'Meet with our team for a short conversational interview to discuss your goals, availability, and cultural fit within our organization.'
  }, 
  {
    title: 'Skills Assessment',
    description: 'Complete a brief, practical exercise relevant to your desired role so we can gauge your current proficiency and match you accordingly.'
  }, 
  {
    title: 'Onboarding',
    description: 'Get introduced to your project team, set up your development environment, and dive into your first mission-driven assignment.'
  }
];
---
<div class="w-full rounded-[20px] bg-gradient-to-b from-surface to-background border border-border-subtle p-6 shadow-xl lg:rounded-[40px] lg:p-12 text-white">

  <!-- UNIFIED RESPONSIVE COMPONENT -->
  <div class="flex flex-col w-full">
    
    <!-- Header Block -->
    <div class="flex w-full flex-col gap-4 md:gap-6 rounded-[20px] md:rounded-[40px] bg-background border border-border-subtle p-6 md:p-[40px] lg:p-[52px] shadow-xl">
      <div class="w-full md:w-max rounded-[15px] md:rounded-[20px] bg-accent-primary p-5 md:px-[40px] md:py-[24px] shadow-md border border-border-subtle">
        <h2 class="m-0 font-roboto text-[28px] md:text-[48px] font-bold text-white">The Process</h2>
      </div>
      <div class="w-full md:max-w-[660px] rounded-[15px] md:rounded-[20px] bg-accent-primary p-5 md:px-[40px] md:py-[32px] shadow-md md:ml-[40px] lg:ml-[60px] border border-border-subtle">
        <h3 class="m-0 mb-3 md:mb-[16px] font-roboto text-[22px] md:text-[36px] font-bold text-white">Simple and transparent</h3>
        <p class="m-0 font-sans text-[16px] md:text-[24px] font-normal leading-relaxed text-[#F4F6FC]">
          We've designed our onboarding process to be straightforward and welcoming. Learn how we evaluate your skills and match you with the perfect project team.
        </p>
      </div>
    </div>
    
    <!-- Steps Grid -->
    <div class="mt-[60px] md:mt-[80px] md:px-[50px]">
      <h3 class="m-0 mb-[40px] md:mb-[60px] text-center md:text-left font-roboto text-[24px] md:text-[36px] font-bold text-white">Steps to join our team</h3>
      <div class="flex flex-col md:grid md:grid-cols-2 gap-10 md:gap-x-[90px] md:gap-y-[80px]">
        {steps.map((step) => (
          <div class="flex flex-col items-center md:items-start text-center md:text-left">
            <div class="mb-4 md:mb-6 inline-flex h-[40px] md:h-[48px] w-max max-w-full items-center justify-center rounded-[10px] bg-accent-primary px-[30px] md:px-[40px] shadow-sm border border-border-subtle">
              <span class="m-0 font-roboto text-[18px] md:text-[24px] font-bold text-white">{step.title}</span>
            </div>
            <p class="m-0 font-sans text-[16px] md:text-[20px] font-normal leading-relaxed text-text-body">{step.description}</p>
          </div>
        ))}
      </div>
    </div>
    
  </div>

</div>