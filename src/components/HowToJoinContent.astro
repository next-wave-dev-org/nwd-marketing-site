---
const steps = [
  {
    title: 'Submit Application',
    description: 'Fill out our brief online application to share your background, skills, and the type of projects you are most passionate about.'
  }, 
  {
    title: 'Initial Interview',
    description: 'Meet with our team for a short conversational interview to discuss your goals, availability, and cultural fit within our organization.'
  }, 
  {
    title: 'Skills Assessment',
    description: 'Complete a brief, practical exercise relevant to your desired role so we can gauge your current proficiency and match you accordingly.'
  }, 
  {
    title: 'Onboarding',
    description: 'Get introduced to your project team, set up your development environment, and dive into your first mission-driven assignment.'
  }
];
---
<div class="w-full rounded-[20px] bg-gradient-to-b from-light-aqua to-secondary-blue/70 p-6 shadow-lg lg:rounded-[40px] lg:p-12">

  <!-- MOBILE (< 768px) -->
  <div class="flex flex-col w-full md:hidden">
    <div class="flex w-full flex-col gap-4 rounded-[20px] bg-dark-blue p-6 shadow-xl">
      <div class="w-full rounded-[15px] bg-primary-blue p-5 shadow-md">
        <h2 class="m-0 font-roboto text-[28px] font-bold !text-hero-text">The Process</h2>
      </div>
      <div class="w-full rounded-[15px] bg-primary-blue p-5 shadow-md">
        <h3 class="m-0 mb-3 font-roboto text-[22px] font-bold !text-hero-text">Simple and transparent</h3>
        <p class="m-0 font-sans text-[16px] font-normal leading-relaxed !text-hero-text">
          We've designed our onboarding process to be straightforward and welcoming. Learn how we evaluate your skills and match you with the perfect project team.
        </p>
      </div>
    </div>
    <div class="mt-[60px]">
      <h3 class="m-0 mb-[40px] text-center font-roboto text-[24px] font-bold text-black">Steps to join our team</h3>
      <div class="flex flex-col gap-10">
        {steps.map((step) => (
          <div class="flex flex-col items-center text-center">
            <div class="mb-4 inline-flex h-[40px] w-max max-w-full items-center justify-center rounded-[10px] bg-dark-blue px-[30px] shadow-sm">
              <span class="m-0 font-roboto text-[18px] font-bold !text-white">{step.title}</span>
            </div>
            <p class="m-0 font-sans text-[16px] font-normal leading-relaxed text-black">{step.description}</p>
          </div>
        ))}
      </div>
    </div>
  </div>

  <!-- DESKTOP (>= 768px) -->
  <div class="hidden md:flex flex-col w-full">
    <div class="flex w-full flex-col gap-6 rounded-[40px] bg-dark-blue p-[40px] shadow-xl lg:p-[52px]">
      <div class="w-max rounded-[20px] bg-primary-blue px-[40px] py-[24px] shadow-md">
        <h2 class="m-0 font-roboto text-[48px] font-bold !text-hero-text">The Process</h2>
      </div>
      <div class="ml-[40px] w-full max-w-[660px] rounded-[20px] bg-primary-blue px-[40px] py-[32px] shadow-md lg:ml-[60px]">
        <h3 class="m-0 mb-[16px] font-roboto text-[36px] font-bold !text-hero-text">Simple and transparent</h3>
        <p class="m-0 font-sans text-[24px] font-normal leading-relaxed !text-hero-text">
          We've designed our onboarding process to be straightforward and welcoming. Learn how we evaluate your skills and match you with the perfect project team.
        </p>
      </div>
    </div>
    <div class="mt-[80px] px-[50px]">
      <h3 class="m-0 mb-[60px] font-roboto text-[36px] font-bold text-black">Steps to join our team</h3>
      <div class="grid grid-cols-2 gap-x-[90px] gap-y-[80px]">
        {steps.map((step) => (
          <div class="flex flex-col">
            <div class="mb-6 inline-flex h-[48px] w-max items-center justify-center rounded-[10px] bg-dark-blue px-[40px] shadow-sm">
              <span class="m-0 font-roboto text-[24px] font-bold !text-white">{step.title}</span>
            </div>
            <p class="m-0 font-sans text-[20px] font-normal leading-relaxed text-black">{step.description}</p>
          </div>
        ))}
      </div>
    </div>
  </div>
</div>