---
// src/components/AboutTestimonials.astro
---

<div class="w-full flex justify-center mt-20 mb-20">

  <!-- =============================== -->
  <!-- MOBILE VIEW (< 768px)           -->
  <!-- =============================== -->
  <div id="mobile-testimonials" class="w-full flex flex-col font-sans text-black gap-16 px-6 items-center">
    
    <!-- Marketing Stats Grid -->
    <div class="flex flex-col gap-10 items-center text-center">
      <div class="flex flex-col items-center">
        <span class="font-heading text-[56px] font-medium leading-none text-black">150+</span>
        <p class="font-inter text-[18px] font-medium text-black mt-2">Graduates found full time jobs</p>
      </div>
      <div class="flex flex-col items-center">
        <span class="font-heading text-[56px] font-medium leading-none text-black">20+</span>
        <p class="font-inter text-[18px] font-medium text-black mt-2">Local business projects completed</p>
      </div>
      <div class="flex flex-col items-center">
        <span class="font-heading text-[56px] font-medium leading-none text-black">150+</span>
        <p class="font-inter text-[18px] font-medium text-black mt-2">stuff happened</p>
      </div>
    </div>

    <!-- Testimonial Card Centered -->
    <div class="relative w-full max-w-[700px] rounded-[20px] bg-[#D9D9D9] p-8 flex flex-col gap-8 items-center text-center mx-auto shadow-sm">
      <p class="font-inter italic font-light text-[22px] leading-relaxed text-[#1C1C1C]">
        “I am so happy in my new project. This program has changed my very soul and now I can see through time and reality itself.”
      </p>
      
      <div class="flex flex-col items-center gap-4">
        <div class="flex flex-col">
          <h4 class="font-inter text-[24px] font-normal text-[#1C1C1C]">Bob Smith</h4>
          <span class="font-inter text-[20px] italic font-normal text-[#1C1C1C]">Company Owner</span>
        </div>
        <div class="w-[280px] h-[240px] rounded-[20px] bg-[#6D6D6D] flex items-center justify-center shadow-md">
          <span class="font-roboto text-[16px] font-normal text-black">profile pic of CEO</span>
        </div>
      </div>
    </div>

  </div>


  <!-- =============================== -->
  <!-- DESKTOP VIEW (>= 768px)         -->
  <!-- =============================== -->
  <div id="desktop-testimonials" class="mx-auto hidden md:flex flex-col w-full max-w-[1440px] font-sans text-black items-center">
      
      <!-- Marketing Stats Row -->
      <div class="flex justify-between items-center w-full max-w-[1202px] px-4">
          <!-- Stat 1 -->
          <div class="flex flex-col items-center text-center w-[278.53px]">
              <span class="font-heading text-[64px] font-medium leading-[60px] text-black">150+</span>
              <p class="font-inter text-[20px] font-medium leading-[24px] text-black mt-[16px]">Graduates found full time jobs</p>
          </div>

          <!-- Stat 2 -->
          <div class="flex flex-col items-center text-center w-[278.53px]">
              <span class="font-heading text-[64px] font-medium leading-[60px] text-black">20+</span>
              <p class="font-inter text-[20px] font-medium leading-[24px] text-black mt-[16px]">Local business projects completed</p>
          </div>

          <!-- Stat 3 -->
          <div class="flex flex-col items-center text-center w-[278.53px]">
              <span class="font-heading text-[64px] font-medium leading-[60px] text-black">150+</span>
              <p class="font-inter text-[20px] font-medium leading-[24px] text-black mt-[16px]">stuff happened</p>
          </div>
      </div>

      <!-- Centered Testimonial Box with Full Rounded Corners -->
      <div class="relative w-[1202px] h-[480px] rounded-[20px] bg-[#D9D9D9] mt-[80px] px-[85px] py-[65px] flex justify-between items-center mx-auto shadow-sm">
          
          <!-- Quote text -->
          <p class="font-inter italic font-light text-[32px] leading-[39px] text-[#1C1C1C] max-w-[580px]">
              “I am so happy in my new project. This program has changed my very soul and now I can see through time and reality itself.”
          </p>

          <!-- Author Info & CEO Photo Placeholder -->
          <div class="flex flex-col items-start shrink-0">
              <div class="flex flex-col mb-[16px]">
                  <h4 class="font-inter text-[32px] font-normal leading-[39px] text-[#1C1C1C]">Bob Smith</h4>
                  <span class="font-inter italic text-[32px] font-normal leading-[39px] text-[#1C1C1C]">Company Owner</span>
              </div>
              <div class="w-[336.72px] h-[288px] rounded-[20px] bg-[#6D6D6D] flex items-center justify-center shadow-md">
                  <span class="font-roboto text-[16px] font-normal text-black">profile pic of CEO</span>
              </div>
          </div>

      </div>

  </div>

</div>

<style is:global>
  @media (min-width: 768px) {
    #mobile-testimonials { display: none !important; }
    #desktop-testimonials { display: flex !important; }
  }
  @media (max-width: 767px) {
    #desktop-testimonials { display: none !important; }
    #mobile-testimonials { display: flex !important; }
  }
</style>