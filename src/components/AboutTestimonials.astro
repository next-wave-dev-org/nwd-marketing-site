---
// src/components/AboutTestimonials.astro
---
<div class="w-full flex justify-center mt-0 mb-0">

  <!-- UNIFIED RESPONSIVE SECTION -->
  <div class="mx-auto flex flex-col w-full max-w-[1440px] font-sans text-white items-center mt-2 md:mt-12 mb-8 md:mb-12 px-6 md:px-0">
      
      <!-- Unified Testimonial Card (Shifted to xl for tablet stacking) -->
      <div class="relative mx-auto flex flex-col xl:flex-row xl:min-h-[480px] w-full max-w-[700px] xl:max-w-[1202px] items-center justify-between gap-8 xl:gap-0 rounded-[20px] bg-surface border border-border-subtle p-8 md:p-12 xl:px-[85px] xl:py-[65px] text-center xl:text-left shadow-2xl backdrop-blur-md">
          <p class="w-full max-w-full xl:max-w-[580px] font-inter text-[22px] md:text-[28px] xl:text-[32px] font-light italic leading-relaxed md:leading-[39px] text-text-body m-0">
              “Next Wave Dev was built on a simple idea: potential needs a place to practice. By connecting passionate new technologists with organizations that need digital solutions, we are cultivating the next generation of industry leaders right here in our community.”
          </p>
          <div class="flex flex-col items-center xl:items-start shrink-0 gap-4 xl:gap-0">
              <div class="flex flex-col mb-0 xl:mb-[16px]">
                  <h4 class="m-0 font-inter text-[24px] xl:text-[32px] font-normal xl:leading-[39px] text-white">Taylor Papke</h4>
                  <span class="font-inter text-[20px] xl:text-[32px] font-normal italic xl:leading-[39px] text-accent-cyan">Co-Founder</span>
              </div>
              <div class="flex h-[240px] w-[280px] xl:h-[288px] xl:w-[336.72px] items-center justify-center rounded-[20px] bg-accent-primary shadow-md overflow-hidden border border-border-subtle">
                  <img src="/images/profiles/taylor-papke.png" alt="Taylor Papke" class="w-full h-full object-cover" />
              </div>
          </div>
      </div>

  </div>
</div>