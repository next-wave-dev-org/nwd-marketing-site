---
// src/components/AboutTestimonials.astro
---
<div class="w-full flex justify-center mt-0 mb-0">

  <!-- UNIFIED RESPONSIVE SECTION -->
  <div class="mx-auto flex flex-col w-full max-w-[1440px] font-sans text-white items-center mt-2 md:mt-12 mb-8 md:mb-12 px-6 md:px-0">
      
      <!-- Unified Testimonial Card (Dark Mode Conversion) -->
      <div class="relative mx-auto flex flex-col md:flex-row md:h-[480px] w-full max-w-[700px] md:max-w-[1202px] items-center justify-between gap-8 md:gap-0 rounded-[20px] bg-[#16132A] border border-white/10 p-8 md:px-[85px] md:py-[65px] text-center md:text-left shadow-2xl backdrop-blur-md">
          <p class="w-full max-w-full md:max-w-[580px] font-inter text-[22px] md:text-[32px] font-light italic leading-relaxed md:leading-[39px] text-[#C0C5E2] m-0">
              “Next Wave Dev was built on a simple idea: potential needs a place to practice. By connecting passionate new technologists with organizations that need digital solutions, we are cultivating the next generation of industry leaders right here in our community.”
          </p>
          <div class="flex flex-col items-center md:items-start shrink-0 gap-4 md:gap-0">
              <div class="flex flex-col mb-0 md:mb-[16px]">
                  <h4 class="m-0 font-inter text-[24px] md:text-[32px] font-normal md:leading-[39px] text-white">Taylor Papke</h4>
                  <span class="font-inter text-[20px] md:text-[32px] font-normal italic md:leading-[39px] text-[#38C1ED]">Co-Founder</span>
              </div>
              <div class="flex h-[240px] w-[280px] md:h-[288px] md:w-[336.72px] items-center justify-center rounded-[20px] bg-[#4A3B96] shadow-md overflow-hidden border border-white/10">
                  <img src="/images/profiles/taylor-papke.png" alt="Taylor Papke" class="w-full h-full object-cover" />
              </div>
          </div>
      </div>

  </div>
</div>