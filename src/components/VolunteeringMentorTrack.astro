---
// src/components/VolunteeringMentorTrack.astro
const tracks = [
  'Technical Mentorship', 
  'Career Guidance', 
  'Project Planning', 
  'Code Review'
];
---
<div id="mentor-track" class="w-full scroll-mt-10 rounded-[20px] bg-gradient-to-b from-light-aqua to-secondary-blue/70 p-6 shadow-lg lg:rounded-[40px] lg:p-12">

  <!-- MOBILE (< 768px) -->
  <div class="mobile-mentor-track flex-col w-full">
    
    <!-- Dark Blue Outer Card -->
    <div class="flex w-full flex-col gap-4 rounded-[20px] bg-dark-blue p-6 shadow-xl">
      
      <!-- Royal Blue Inner Card 1 -->
      <div class="w-full rounded-[15px] bg-primary-blue p-5 shadow-md">
        <h2 class="m-0 font-roboto text-[28px] font-medium !text-white">
          Become a Mentor
        </h2>
      </div>
      
      <!-- Royal Blue Inner Card 2 -->
      <div class="w-full rounded-[15px] bg-primary-blue p-5 shadow-md">
        <h3 class="m-0 mb-3 font-roboto text-[22px] font-medium !text-white">
          Aid the next generation
        </h3>
        <p class="m-0 font-inter text-[16px] leading-[24px] !text-white">
          Placeholder text here to fill this section to make it look real. This body text is just random fill to fill this section to make things look real for placeholder purposes.
        </p>
      </div>

    </div>

    <div class="mt-[60px]">
      <h3 class="font-roboto text-[24px] font-medium text-black mb-[40px] text-center">Guide projects and shape futures</h3>
      <div class="flex flex-col gap-10">
        {tracks.map((track) => (
          <div class="flex flex-col items-center text-center">
            <div class="mb-4 inline-flex h-[40px] w-max max-w-full items-center justify-center rounded-[10px] bg-dark-blue px-[30px] shadow-sm">
              <span class="m-0 font-roboto text-[18px] font-medium !text-white">{track}</span>
            </div>
            <p class="font-inter text-[16px] leading-[22px] text-black">Share your industry experience with students. You are able to guide them in the right direction, offer feedback on their code, and help them build practical skills for their resumes.</p>
          </div>
        ))}
      </div>
    </div>
  </div>

  <!-- DESKTOP (>= 768px) -->
  <div class="desktop-mentor-track flex-col w-full">
    
    <!-- Dark Blue Outer Card -->
    <div class="flex w-full flex-col gap-6 rounded-[40px] bg-dark-blue p-[40px] shadow-xl lg:p-[52px]">
      
      <!-- Royal Blue Inner Card 1 -->
      <div class="w-max rounded-[20px] bg-primary-blue px-[40px] py-[24px] shadow-md">
        <h2 class="m-0 font-roboto text-[48px] font-medium !text-white">
          Become a Mentor
        </h2>
      </div>
      
      <!-- Royal Blue Inner Card 2 (Offset to the right) -->
      <div class="ml-[40px] w-full max-w-[660px] rounded-[20px] bg-primary-blue px-[40px] py-[32px] shadow-md lg:ml-[60px]">
        <h3 class="m-0 mb-[16px] font-roboto text-[36px] font-medium !text-white">
          Aid the next generation
        </h3>
        <p class="m-0 font-inter text-[20px] leading-[28px] !text-white">
          Placeholder text here to fill this section to make it look real. This body text is just random fill to fill this section to make things look real for placeholder purposes. Also more words.
        </p>
      </div>

    </div>

    <div class="mt-[80px] px-[50px]">
      <h3 class="font-roboto text-[36px] font-medium text-black mb-[60px]">Guide projects and shape futures</h3>
      <div class="grid grid-cols-2 gap-x-[90px] gap-y-[80px]">
        {tracks.map((track) => (
          <div class="flex flex-col">
            <div class="mb-6 inline-flex h-[48px] w-max items-center justify-center rounded-[10px] bg-dark-blue px-[40px] shadow-sm">
              <span class="m-0 font-roboto text-[24px] font-medium !text-white">{track}</span>
            </div>
            <p class="font-inter text-[20px] leading-[24px] text-black">Share your industry experience with students. You are able to guide them in the right direction, offer feedback on their code, and help them build practical skills for their resumes.</p>
          </div>
        ))}
      </div>
    </div>
  </div>

</div>

<style is:global>
  @media (min-width: 768px) {
    .mobile-mentor-track { display: none !important; }
    .desktop-mentor-track { display: flex !important; }
  }
  @media (max-width: 767px) {
    .desktop-mentor-track { display: none !important; }
    .mobile-mentor-track { display: flex !important; }
  }
</style>