---
const tracks = [
  {
    title: 'Technical Mentorship',
    description: 'Provide one-on-one guidance to junior developers, helping them debug complex issues and understand industry best practices.'
  }, 
  {
    title: 'Career Guidance',
    description: 'Help emerging technologists navigate their career paths, prepare for technical interviews, and build strong professional portfolios.'
  }, 
  {
    title: 'Project Planning',
    description: 'Assist teams in breaking down high-level client requirements into actionable, properly scoped technical tasks and sprints.'
  }, 
  {
    title: 'Code Review',
    description: 'Ensure high-quality deliverables by reviewing pull requests, enforcing coding standards, and teaching clean architecture principles.'
  }
];
---
<div id="mentor-track" class="w-full scroll-mt-10 rounded-[20px] bg-gradient-to-b from-light-aqua to-secondary-blue/70 p-6 shadow-lg lg:rounded-[40px] lg:p-12">

  <!-- UNIFIED RESPONSIVE COMPONENT -->
  <div class="flex flex-col w-full">
    
    <div class="flex w-full flex-col gap-4 md:gap-6 rounded-[20px] md:rounded-[40px] bg-dark-blue p-6 md:p-[40px] lg:p-[52px] shadow-xl">
      <div class="w-full md:w-max rounded-[15px] md:rounded-[20px] bg-primary-blue p-5 md:px-[40px] md:py-[24px] shadow-md">
        <h2 class="m-0 font-roboto text-[28px] md:text-[48px] font-bold !text-white">Become a Mentor</h2>
      </div>
      <div class="w-full md:max-w-[660px] rounded-[15px] md:rounded-[20px] bg-primary-blue p-5 md:px-[40px] md:py-[32px] shadow-md md:ml-[40px] lg:ml-[60px]">
        <h3 class="m-0 mb-3 md:mb-[16px] font-roboto text-[22px] md:text-[36px] font-bold !text-white">Aid the next generation</h3>
        <p class="m-0 font-sans text-[16px] md:text-[24px] font-normal leading-relaxed !text-white">
          Your industry expertise is invaluable. As a mentor, you will guide emerging talent, shape technical architectures, and lead teams delivering high-impact solutions.
        </p>
      </div>
    </div>

    <div class="mt-[60px] md:mt-[80px] md:px-[50px]">
      <h3 class="m-0 mb-[40px] md:mb-[60px] text-center md:text-left font-roboto text-[24px] md:text-[36px] font-bold text-black">Guide projects and shape futures</h3>
      <div class="flex flex-col md:grid md:grid-cols-2 gap-10 md:gap-x-[90px] md:gap-y-[80px]">
        {tracks.map((track) => (
          <div class="flex flex-col items-center md:items-start text-center md:text-left">
            <div class="mb-4 md:mb-6 inline-flex h-[40px] md:h-[48px] w-max max-w-full items-center justify-center rounded-[10px] bg-dark-blue px-[30px] md:px-[40px] shadow-sm">
              <span class="m-0 font-roboto text-[18px] md:text-[24px] font-bold !text-white">{track.title}</span>
            </div>
            <p class="m-0 font-sans text-[16px] md:text-[20px] font-normal leading-relaxed text-black">{track.description}</p>
          </div>
        ))}
      </div>
    </div>
    
  </div>
</div>