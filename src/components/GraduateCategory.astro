---
import ProfileCard from './ProfileCard.astro';

export interface Graduate {
  id: string;
  name: string;
  role: string;
}

export interface Props {
  title: string;
  graduates: Graduate[];
}

const { title, graduates } = Astro.props;

const trackIdDesktop = `desktop-track-${title.toLowerCase().replace(/[^a-z0-9]/g, '-')}`;
const trackIdMobile = `mobile-track-${title.toLowerCase().replace(/[^a-z0-9]/g, '-')}`;
---

<div class="w-full">
  
  <!-- MOBILE (< 768px): 1 profile visible at a time with arrows underneath -->
  <section class="mobile-grad-category flex flex-col items-center w-full gap-6 mt-8 px-6">
    <div class="inline-flex items-center justify-center rounded-[40px] bg-dark-blue px-6 py-3 shadow-[0_4px_4px_rgba(0,0,0,0.25)]">
      <h2 class="m-0 text-center font-roboto text-[24px] font-bold leading-tight !text-white">
        {title}
      </h2>
    </div>

    <!-- Single-card horizontal scroll track -->
    <div id={trackIdMobile} class="flex w-full snap-x snap-mandatory gap-0 overflow-x-auto pb-2 scroll-smooth hide-scrollbar mt-2">
      {graduates.map((grad) => (
        <a href={`/graduates/${grad.id}`} class="w-full flex-shrink-0 snap-center flex justify-center outline-none">
          <ProfileCard name={grad.name} role={grad.role} />
        </a>
      ))}
    </div>

    <!-- Arrows Underneath -->
    <div class="flex justify-center mt-2">
      <div class="inline-flex items-center gap-[30px] rounded-[30px] border border-black px-[30px] py-[6px]">
        <button type="button" class="grad-carousel-prev flex h-[50px] w-[50px] items-center justify-center rounded-full bg-black text-[28px] text-card-arrow" data-target={trackIdMobile} aria-label="Scroll left">&#8249;</button>
        <button type="button" class="grad-carousel-next flex h-[50px] w-[50px] items-center justify-center rounded-full bg-black text-[28px] text-card-arrow" data-target={trackIdMobile} aria-label="Scroll right">&#8250;</button>
      </div>
    </div>
  </section>

  <!-- DESKTOP (>= 768px): 4-card row layout matching GraduatesSection -->
  <section class="desktop-grad-category mx-auto mt-[60px] flex w-full max-w-[1328px] flex-col px-8">
    <!-- Header Row -->
    <div class="flex items-center justify-between">
      <div class="inline-flex items-center justify-center rounded-[50px] bg-dark-blue px-10 py-5 shadow-[0_4px_4px_rgba(0,0,0,0.25)]">
        <h2 class="m-0 p-0 font-roboto text-[48px] font-bold leading-[56px] !text-white">
          {title}
        </h2>
      </div>
      
      <!-- Desktop Carousel Arrows -->
      <div class="flex items-center gap-[34px] rounded-[30px] border border-black px-[42px] py-[6px]">
        <button type="button" class="grad-carousel-prev flex h-[70px] w-[70px] items-center justify-center rounded-full bg-black text-[40px] text-card-arrow" data-target={trackIdDesktop} aria-label="Scroll left">&#8249;</button>
        <button type="button" class="grad-carousel-next flex h-[70px] w-[70px] items-center justify-center rounded-full bg-black text-[40px] text-card-arrow" data-target={trackIdDesktop} aria-label="Scroll right">&#8250;</button>
      </div>
    </div>
    
    <!-- Row Layout for Profile Cards -->
    <div id={trackIdDesktop} class="mt-[48px] flex flex-row justify-between gap-6 overflow-hidden scroll-smooth">
      {graduates.map((grad) => (
        <a href={`/team/${grad.id}`} class="block transition-transform hover:scale-[1.02] outline-none flex-shrink-0">
          <ProfileCard name={grad.name} role={grad.role} />
        </a>
      ))}
    </div>
  </section>

</div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    document.querySelectorAll('.grad-carousel-prev:not(.initialized)').forEach(btn => {
      btn.classList.add('initialized');
      btn.addEventListener('click', () => {
        const targetId = btn.getAttribute('data-target');
        const track = document.getElementById(targetId);
        if (track) {
          const scrollDistance = window.innerWidth >= 768 ? (314 + 24) * 2 : track.clientWidth;
          track.scrollBy({ left: -scrollDistance, behavior: 'smooth' });
        }
      });
    });

    document.querySelectorAll('.grad-carousel-next:not(.initialized)').forEach(btn => {
      btn.classList.add('initialized');
      btn.addEventListener('click', () => {
        const targetId = btn.getAttribute('data-target');
        const track = document.getElementById(targetId);
        if (track) {
          const scrollDistance = window.innerWidth >= 768 ? (314 + 24) * 2 : track.clientWidth;
          track.scrollBy({ left: scrollDistance, behavior: 'smooth' });
        }
      });
    });
  });
</script>

<style is:global>
  @media (min-width: 768px) {
    .mobile-grad-category { display: none !important; }
    .desktop-grad-category { display: flex !important; }
  }
  @media (max-width: 767px) {
    .desktop-grad-category { display: none !important; }
    .mobile-grad-category { display: flex !important; }
  }

  .hide-scrollbar::-webkit-scrollbar {
    display: none;
  }
  .hide-scrollbar {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
</style>