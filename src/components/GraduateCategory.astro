---
import ProfileCard from './ProfileCard.astro';

export interface Graduate {
  id: string;
  name: string;
  role: string;
  image?: string;
}

export interface Props {
  title: string;
  graduates: Graduate[];
}

const { title, graduates } = Astro.props;
---

<div class="w-full">
  
  <!-- UNIFIED RESPONSIVE SECTION -->
  <section class="mx-auto mt-8 md:mt-[60px] flex w-full max-w-[1328px] flex-col px-0 md:px-8">
    
    <!-- Unified Header -->
    <div class="flex items-center justify-center md:justify-between w-full px-6 md:px-0">
      <div class="inline-flex items-center justify-center rounded-[40px] md:rounded-[50px] bg-dark-blue px-6 md:px-10 py-3 md:py-5 shadow-[0_4px_4px_rgba(0,0,0,0.25)]">
        <h2 class="m-0 text-center md:text-left font-roboto text-[24px] md:text-[48px] font-bold leading-tight md:leading-[56px] !text-white">
          {title}
        </h2>
      </div>
    </div>

    <!-- Unified Track -->
    <div class="flex flex-row overflow-x-auto hide-scrollbar scroll-smooth snap-x md:snap-none snap-mandatory gap-0 md:gap-6 mt-6 md:mt-[48px] w-full items-center md:items-start justify-start">
      {graduates.map((grad) => (
        <a href={`/team/${grad.id}`} class="w-full md:w-[314px] flex-shrink-0 snap-center flex md:block justify-center outline-none transition-transform hover:scale-[1.02]">
          <ProfileCard name={grad.name} role={grad.role} image={grad.image} />
        </a>
      ))}
    </div>

  </section>

</div>

<style is:global>
  .hide-scrollbar::-webkit-scrollbar {
    display: none;
  }
  .hide-scrollbar {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
</style>