---
// src/components/VolunteeringHero.astro
---
<div class="w-full">
  
  <!-- MOBILE (< 768px) -->
  <div class="mobile-volunteering-hero flex-col w-full">
    <section class="flex w-full flex-col items-center rounded-[10px] bg-gradient-to-b from-light-aqua to-secondary-blue/70 p-6 text-center shadow-lg">
      <div class="mb-6 flex h-[240px] w-[240px] items-center justify-center rounded-full bg-primary-blue shadow-md">
        <!-- Scaled font size down to 36px to fit inside the smaller 240px circle -->
        <h1 class="m-0 text-center font-heading text-[36px] font-bold leading-none text-hero-text drop-shadow-md">
          Want<br/>to<br/>Volunteer
        </h1>
      </div>
      <h2 class="m-0 font-roboto text-[24px] font-bold text-black leading-snug">
        Gain professional work experience
      </h2>
      <h3 class="m-0 my-4 font-roboto text-[24px] font-bold text-black">
        OR
      </h3>
      <h2 class="m-0 font-roboto text-[24px] font-bold text-black leading-snug">
        Become a mentor and give back to the community
      </h2>
    </section>

    <!-- Mobile Quick Links (The section below) -->
    <div class="w-full flex flex-col gap-6 mt-10">
      <a href="#experience-track" class="group block rounded-[15px] bg-primary-blue p-6 text-white no-underline shadow-md transition-colors duration-300 hover:bg-dark-blue">
        <div class="flex justify-between items-center mb-4 border-b border-white/20 pb-4">
          <h2 class="m-0 font-roboto text-[24px] font-bold text-white">Want to Volunteer?</h2>
          <div class="flex h-[40px] w-[40px] shrink-0 items-center justify-center rounded-full bg-dark-blue transition-colors group-hover:bg-primary-blue">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18l6-6-6-6"/></svg>
          </div>
        </div>
        <div class="pt-2">
          <h3 class="m-0 mb-2 font-roboto text-[20px] font-bold text-white">Gaining Hands on Experience</h3>
          <p class="m-0 font-sans text-[16px] font-normal leading-relaxed text-white">Work on real projects and pipelines to build your resume.</p>
        </div>
      </a>

      <a href="#mentor-track" class="group block rounded-[15px] bg-primary-blue p-6 text-white no-underline shadow-md transition-colors duration-300 hover:bg-dark-blue">
        <div class="flex justify-between items-center mb-4 border-b border-white/20 pb-4">
          <h2 class="m-0 font-roboto text-[24px] font-bold text-white">Want to Mentor?</h2>
          <div class="flex h-[40px] w-[40px] shrink-0 items-center justify-center rounded-full bg-dark-blue transition-colors group-hover:bg-primary-blue">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18l6-6-6-6"/></svg>
          </div>
        </div>
        <div class="pt-2">
          <h3 class="m-0 mb-2 font-roboto text-[20px] font-bold text-white">Aid the next generation</h3>
          <p class="m-0 font-sans text-[16px] font-normal leading-relaxed text-white">Research needs and wants to ensure product success.</p>
        </div>
      </a>
    </div>
  </div>

  <!-- DESKTOP (>= 768px) -->
  <div class="desktop-volunteering-hero flex-col w-full">
    <section class="relative flex min-h-[489px] w-full flex-row items-center justify-between overflow-hidden rounded-[20px] bg-gradient-to-b from-light-aqua to-secondary-blue/70 p-16 shadow-lg">
      
      <!-- Left: Large Graphic Text -->
      <div class="w-[50%] relative z-10 flex items-center justify-start ml-[40px] lg:ml-[60px]">
        <div class="flex h-[381px] w-[381px] items-center justify-center rounded-full bg-primary-blue shadow-[0_8px_16px_rgba(0,0,0,0.2)]">
          <!-- Scaled font size down to 60px to fit inside the 381px circle -->
          <h1 class="m-0 text-center font-heading text-[60px] font-bold leading-none text-hero-text drop-shadow-[0_4px_4px_rgba(0,0,0,0.25)]">
            Want<br/>to<br/>Volunteer
          </h1>
        </div>
      </div>
      
      <!-- Right: Two Paths -->
      <div class="w-[50%] flex flex-col gap-8 text-left z-10">
        <h2 class="m-0 font-roboto text-[36px] font-bold text-black leading-[42px]">
          Gain professional work experience
        </h2>
        <h3 class="m-0 pl-[120px] font-roboto text-[36px] font-bold text-black">
          OR
        </h3>
        <h2 class="m-0 font-roboto text-[36px] font-bold text-black leading-[42px]">
          Become a mentor and give back to the community
        </h2>
      </div>
    </section>

    <!-- Desktop Quick Links (The section below) -->
    <div class="w-full flex flex-row gap-8 mt-12">
      <a href="#experience-track" class="group flex flex-1 flex-col rounded-[20px] bg-primary-blue p-8 text-white no-underline shadow-md transition-colors duration-300 hover:bg-dark-blue">
        <div class="flex justify-between items-center mb-6 border-b border-white/20 pb-6">
          <h2 class="m-0 font-roboto text-[32px] font-bold text-white">Want to Volunteer?</h2>
          <div class="flex h-[60px] w-[60px] shrink-0 items-center justify-center rounded-full bg-dark-blue transition-colors group-hover:bg-primary-blue">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18l6-6-6-6"/></svg>
          </div>
        </div>
        <div class="pt-2">
          <h3 class="m-0 mb-3 font-roboto text-[24px] font-bold text-white">Gaining Hands on Experience</h3>
          <p class="m-0 font-sans text-[20px] font-normal leading-relaxed text-white">Work on real projects and pipelines to build your resume and practical skillset.</p>
        </div>
      </a>

      <a href="#mentor-track" class="group flex flex-1 flex-col rounded-[20px] bg-primary-blue p-8 text-white no-underline shadow-md transition-colors duration-300 hover:bg-dark-blue">
        <div class="flex justify-between items-center mb-6 border-b border-white/20 pb-6">
          <h2 class="m-0 font-roboto text-[32px] font-bold text-white">Want to Mentor?</h2>
          <div class="flex h-[60px] w-[60px] shrink-0 items-center justify-center rounded-full bg-dark-blue transition-colors group-hover:bg-primary-blue">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18l6-6-6-6"/></svg>
          </div>
        </div>
        <div class="pt-2">
          <h3 class="m-0 mb-3 font-roboto text-[24px] font-bold text-white">Aid the next generation</h3>
          <p class="m-0 font-sans text-[20px] font-normal leading-relaxed text-white">Whatever project or business venture, we will research the needs and wants for your project.</p>
        </div>
      </a>
    </div>
  </div>

</div>

<style is:global>
  @media (min-width: 768px) {
    .mobile-volunteering-hero { display: none !important; }
    .desktop-volunteering-hero { display: flex !important; }
  }
  @media (max-width: 767px) {
    .desktop-volunteering-hero { display: none !important; }
    .mobile-volunteering-hero { display: flex !important; }
  }
</style>