---
// src/components/VolunteeringHero.astro
---
<div class="w-full flex flex-col px-6 md:px-0 mt-4 md:mt-0 text-white">
  
  <!-- UNIFIED RESPONSIVE HERO (Semantic Tokens Applied) -->
  <section class="mx-auto flex w-full max-w-[1289px] flex-col overflow-hidden rounded-[10px] bg-gradient-to-b from-surface to-background border border-border-subtle shadow-xl p-6 md:p-0">
    <div class="relative flex flex-col lg:flex-row lg:h-[489px] w-full items-center text-center md:text-left gap-6 md:gap-0">
      
      <div class="lg:absolute lg:left-[47px] lg:top-[19px] z-10 flex h-[150px] w-[150px] lg:h-[390px] lg:w-[390px] shrink-0 items-center justify-center rounded-full bg-gradient-to-r from-accent-primary to-accent-secondary border border-border-subtle shadow-2xl mx-auto md:mx-0 p-2 md:p-8">
        <h1 class="w-full text-center font-heading text-[18px] sm:text-[20px] md:text-[48px] lg:text-[52px] font-bold leading-tight text-white drop-shadow-md break-words">
          Want<br/>to<br/>Volunteer
        </h1>
      </div>
      
      <div class="lg:absolute lg:left-[470px] flex flex-col w-full lg:w-[650px] gap-3 md:gap-6 z-10 md:pr-8">
        <h2 class="m-0 font-roboto text-[18px] sm:text-[20px] md:text-[36px] font-bold text-white leading-snug md:leading-tight break-words">Gain professional work experience while empowering your local community.</h2>
        <p class="m-0 font-sans text-[15px] md:text-[22px] lg:text-[24px] font-normal leading-relaxed md:leading-[33px] text-text-body">Work on real-world client projects under the guidance of experienced professionals. Build your portfolio, learn industry-standard workflows, and develop the skills employers actively look for.</p>
      </div>
      
    </div>
  </section>

</div>