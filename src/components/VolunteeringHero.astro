---
// src/components/VolunteeringHero.astro
---
<div class="w-full">
  
  <!-- MOBILE (< 768px) -->
  <div class="mobile-volunteering-hero flex-col w-full">
    <section class="w-full rounded-[10px] bg-gradient-to-b from-[#E4F2F5] to-[#509EBF]/70 p-6 flex flex-col items-center text-center shadow-lg">
      <div class="w-[240px] h-[240px] rounded-full bg-[#2244CA] flex items-center justify-center mb-6 shadow-md">
        <h1 class="font-unbounded font-bold text-[36px] leading-[1.1] drop-shadow-md text-center m-0" style="color: white !important;">
          Want<br/>to<br/>Volunteer
        </h1>
      </div>
      <p class="font-roboto text-[22px] font-medium text-white drop-shadow-md leading-snug m-0">
        Gain professional work experience
      </p>
      <p class="font-roboto text-[24px] font-bold text-white drop-shadow-md my-4 m-0">
        OR
      </p>
      <p class="font-roboto text-[22px] font-medium text-white drop-shadow-md leading-snug m-0">
        Become a mentor and give back to the community
      </p>
    </section>

    <!-- Mobile Quick Links (The section below) -->
    <div class="w-full flex flex-col gap-6 mt-10">
      <a href="#experience-track" class="block bg-[#2244CA] rounded-[15px] p-6 shadow-md group hover:bg-[#131D43] transition-colors duration-300" style="color: white !important; text-decoration: none !important;">
        <div class="flex justify-between items-center mb-4 border-b border-white/20 pb-4">
          <h2 class="text-[24px] font-roboto font-medium m-0" style="color: white !important;">Want to Volunteer?</h2>
          <div class="bg-[#131D43] group-hover:bg-[#2244CA] rounded-full w-[40px] h-[40px] flex items-center justify-center shrink-0 transition-colors">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18l6-6-6-6"/></svg>
          </div>
        </div>
        <div class="pt-2">
          <h3 class="font-roboto text-[18px] font-medium mb-2 m-0" style="color: white !important;">Gaining Hands on Experience</h3>
          <p class="font-inter text-[14px] m-0" style="color: white !important;">Work on real projects and pipelines to build your resume.</p>
        </div>
      </a>

      <a href="#mentor-track" class="block bg-[#2244CA] rounded-[15px] p-6 shadow-md group hover:bg-[#131D43] transition-colors duration-300" style="color: white !important; text-decoration: none !important;">
        <div class="flex justify-between items-center mb-4 border-b border-white/20 pb-4">
          <h2 class="text-[24px] font-roboto font-medium m-0" style="color: white !important;">Want to Mentor?</h2>
          <div class="bg-[#131D43] group-hover:bg-[#2244CA] rounded-full w-[40px] h-[40px] flex items-center justify-center shrink-0 transition-colors">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18l6-6-6-6"/></svg>
          </div>
        </div>
        <div class="pt-2">
          <h3 class="font-roboto text-[18px] font-medium mb-2 m-0" style="color: white !important;">Aid the next generation</h3>
          <p class="font-inter text-[14px] m-0" style="color: white !important;">Research needs and wants to ensure product success.</p>
        </div>
      </a>
    </div>
  </div>

  <!-- DESKTOP (>= 768px) -->
  <div class="desktop-volunteering-hero flex-col w-full">
    <section class="relative w-full rounded-[20px] bg-gradient-to-b from-[#E4F2F5] to-[#509EBF]/70 p-16 flex flex-row items-center justify-between shadow-lg overflow-hidden min-h-[489px]">
      
      <!-- Left: Large Graphic Text -->
      <div class="w-[50%] relative z-10 flex items-center justify-start ml-[40px] lg:ml-[60px]">
        <div class="flex w-[381px] h-[381px] rounded-full bg-[#2244CA] items-center justify-center shadow-[0_8px_16px_rgba(0,0,0,0.2)]">
          <h1 class="font-unbounded font-bold text-[96px] leading-[1] text-center drop-shadow-[0_4px_4px_rgba(0,0,0,0.25)] m-0" style="color: white !important;">
            Want<br/>to<br/>Volunteer
          </h1>
        </div>
      </div>
      
      <!-- Right: Two Paths -->
      <div class="w-[50%] flex flex-col gap-8 text-left z-10">
        <p class="font-roboto text-[36px] font-medium text-white drop-shadow-md leading-[42px] m-0">
          Gain professional work experience
        </p>
        <p class="font-roboto text-[36px] font-bold text-white drop-shadow-md pl-[120px] m-0">
          OR
        </p>
        <p class="font-roboto text-[36px] font-medium text-white drop-shadow-md leading-[42px] m-0">
          Become a mentor and give back to the community
        </p>
      </div>
    </section>

    <!-- Desktop Quick Links (The section below) -->
    <div class="w-full flex flex-row gap-8 mt-12">
      <a href="#experience-track" class="flex-1 bg-[#2244CA] rounded-[20px] p-8 shadow-md flex flex-col group hover:bg-[#131D43] transition-colors duration-300" style="color: white !important; text-decoration: none !important;">
        <div class="flex justify-between items-center mb-6 border-b border-white/20 pb-6">
          <h2 class="text-[32px] font-roboto font-medium m-0" style="color: white !important;">Want to Volunteer?</h2>
          <div class="bg-[#131D43] group-hover:bg-[#2244CA] rounded-full w-[60px] h-[60px] flex items-center justify-center shrink-0 transition-colors">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18l6-6-6-6"/></svg>
          </div>
        </div>
        <div class="pt-2">
          <h3 class="font-roboto text-[24px] font-medium mb-3 m-0" style="color: white !important;">Gaining Hands on Experience</h3>
          <p class="font-inter text-[16px] m-0" style="color: white !important;">Work on real projects and pipelines to build your resume and practical skillset.</p>
        </div>
      </a>

      <a href="#mentor-track" class="flex-1 bg-[#2244CA] rounded-[20px] p-8 shadow-md flex flex-col group hover:bg-[#131D43] transition-colors duration-300" style="color: white !important; text-decoration: none !important;">
        <div class="flex justify-between items-center mb-6 border-b border-white/20 pb-6">
          <h2 class="text-[32px] font-roboto font-medium m-0" style="color: white !important;">Want to Mentor?</h2>
          <div class="bg-[#131D43] group-hover:bg-[#2244CA] rounded-full w-[60px] h-[60px] flex items-center justify-center shrink-0 transition-colors">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18l6-6-6-6"/></svg>
          </div>
        </div>
        <div class="pt-2">
          <h3 class="font-roboto text-[24px] font-medium mb-3 m-0" style="color: white !important;">Aid the next generation</h3>
          <p class="font-inter text-[16px] m-0" style="color: white !important;">Whatever project or business venture, we will research the needs and wants for your project.</p>
        </div>
      </a>
    </div>
  </div>

</div>

<style is:global>
  @media (min-width: 768px) {
    .mobile-volunteering-hero { display: none !important; }
    .desktop-volunteering-hero { display: flex !important; }
  }
  @media (max-width: 767px) {
    .desktop-volunteering-hero { display: none !important; }
    .mobile-volunteering-hero { display: flex !important; }
  }
</style>