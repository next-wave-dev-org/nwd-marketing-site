---
// src/components/VolunteeringHero.astro
---
<div class="w-full flex flex-col px-6 md:px-0 mt-4 md:mt-0">
  
  <!-- UNIFIED RESPONSIVE HERO -->
  <section class="mx-auto flex w-full max-w-[1289px] flex-col overflow-hidden rounded-[10px] bg-gradient-to-b from-light-aqua to-secondary-blue shadow-md md:shadow-lg p-6 md:p-0">
    <div class="relative flex flex-col md:flex-row md:h-[489px] w-full items-center text-center md:text-left gap-6 md:gap-0">
      
      <div class="md:absolute md:left-[47px] md:top-[19px] z-10 flex h-[150px] w-[150px] md:h-[390px] md:w-[390px] shrink-0 items-center justify-center rounded-full bg-primary-blue shadow-md md:shadow-lg mx-auto md:mx-0 p-2 md:p-8">
        <h1 class="w-full text-center font-heading text-[18px] sm:text-[20px] md:text-[48px] lg:text-[52px] font-bold leading-tight text-hero-text drop-shadow-sm md:drop-shadow-card [text-shadow:-1px_-1px_0_#D49A1D,_1px_-1px_0_#D49A1D,_-1px_1px_0_#D49A1D,_1px_1px_0_#D49A1D] break-words">
          Want<br/>to<br/>Volunteer
        </h1>
      </div>
      
      <div class="md:absolute md:left-[470px] flex flex-col w-full md:w-[650px] gap-3 md:gap-6 z-10">
        <h2 class="m-0 font-roboto text-[18px] sm:text-[20px] md:text-[36px] font-bold text-black leading-snug md:leading-tight break-words">Gain professional work experience</h2>
        <h3 class="m-0 font-roboto text-[16px] md:text-[36px] font-bold text-black md:pl-[40px]">OR</h3>
        <h2 class="m-0 font-roboto text-[18px] sm:text-[20px] md:text-[36px] font-bold text-black leading-snug md:leading-tight break-words">Become a mentor and give back to the community</h2>
      </div>
      
    </div>
  </section>

  <!-- UNIFIED LINK TRACKS -->
  <div class="w-full max-w-[1289px] mx-auto flex flex-col md:flex-row gap-6 md:gap-8 mt-10 md:mt-12">
    <a href="#experience-track" class="group flex flex-1 flex-col rounded-[15px] md:rounded-[20px] bg-primary-blue p-6 md:p-8 text-white no-underline shadow-md transition-colors duration-300 hover:bg-dark-blue">
      <div class="flex justify-between items-center mb-4 md:mb-6 border-b border-white/20 pb-4 md:pb-6">
        <h2 class="m-0 font-roboto text-[24px] md:text-[32px] font-bold text-white">Want to Volunteer?</h2>
        <div class="flex h-[40px] w-[40px] md:h-[60px] md:w-[60px] shrink-0 items-center justify-center rounded-full bg-dark-blue transition-colors group-hover:bg-primary-blue">
          <svg class="w-5 h-5 md:w-6 md:h-6" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18l6-6-6-6"/></svg>
        </div>
      </div>
      <div class="pt-2">
        <h3 class="m-0 mb-2 md:mb-3 font-roboto text-[20px] md:text-[24px] font-bold text-white">Gaining Hands on Experience</h3>
        <p class="m-0 font-sans text-[16px] md:text-[20px] font-normal leading-relaxed text-white">Work on real projects and pipelines to build your resume and practical skillset.</p>
      </div>
    </a>

    <a href="#mentor-track" class="group flex flex-1 flex-col rounded-[15px] md:rounded-[20px] bg-primary-blue p-6 md:p-8 text-white no-underline shadow-md transition-colors duration-300 hover:bg-dark-blue">
      <div class="flex justify-between items-center mb-4 md:mb-6 border-b border-white/20 pb-4 md:pb-6">
        <h2 class="m-0 font-roboto text-[24px] md:text-[32px] font-bold text-white">Want to Mentor?</h2>
        <div class="flex h-[40px] w-[40px] md:h-[60px] md:w-[60px] shrink-0 items-center justify-center rounded-full bg-dark-blue transition-colors group-hover:bg-primary-blue">
          <svg class="w-5 h-5 md:w-6 md:h-6" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18l6-6-6-6"/></svg>
        </div>
      </div>
      <div class="pt-2">
        <h3 class="m-0 mb-2 md:mb-3 font-roboto text-[20px] md:text-[24px] font-bold text-white">Aid the next generation</h3>
        <p class="m-0 font-sans text-[16px] md:text-[20px] font-normal leading-relaxed text-white">Whatever project or business venture, we will research the needs and wants for your project.</p>
      </div>
    </a>
  </div>

</div>