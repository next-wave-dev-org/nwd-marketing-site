---
const benefits = [
  {
    title: 'Real-world Experience',
    description: 'Work on live production environments and collaborate with cross-functional teams on projects that have strict requirements and deadlines.'
  }, 
  {
    title: 'Networking Opportunities',
    description: 'Connect with industry professionals, seasoned mentors, and a community of peers who share your passion for technology and social good.'
  }, 
  {
    title: 'Portfolio Building',
    description: 'Graduate from our program with launched, functional digital products that you can proudly showcase to future employers.'
  }, 
  {
    title: 'Community Impact',
    description: 'Use your technical skills to directly empower non-profits and purpose-driven organizations, amplifying their ability to create positive change.'
  }
];
---
<div class="w-full rounded-[20px] bg-gradient-to-b from-light-aqua to-secondary-blue/70 p-6 shadow-lg lg:rounded-[40px] lg:p-12">

  <!-- MOBILE (< 768px) -->
  <div class="flex flex-col w-full md:hidden">
    <div class="flex w-full flex-col gap-4 rounded-[20px] bg-dark-blue p-6 shadow-xl">
      <div class="w-full rounded-[15px] bg-primary-blue p-5 shadow-md">
        <h2 class="m-0 font-roboto text-[28px] font-bold !text-hero-text">Why Volunteer?</h2>
      </div>
      <div class="w-full rounded-[15px] bg-primary-blue p-5 shadow-md">
        <h3 class="m-0 mb-3 font-roboto text-[22px] font-bold !text-hero-text">Gain invaluable perks</h3>
        <p class="m-0 font-sans text-[16px] font-normal leading-relaxed !text-hero-text">
          Volunteering with Next Wave Dev isn't just about giving back—it's an investment in your career. We provide the structure and support you need to thrive in the tech industry.
        </p>
      </div>
    </div>
    <div class="mt-[60px]">
      <h3 class="m-0 mb-[40px] text-center font-roboto text-[24px] font-bold text-black">What you gain with us</h3>
      <div class="flex flex-col gap-10">
        {benefits.map((benefit) => (
          <div class="flex flex-col items-center text-center">
            <div class="mb-4 inline-flex h-[40px] w-max max-w-full items-center justify-center rounded-[10px] bg-dark-blue px-[30px] shadow-sm">
              <span class="m-0 font-roboto text-[18px] font-bold !text-white">{benefit.title}</span>
            </div>
            <p class="m-0 font-sans text-[16px] font-normal leading-relaxed text-black">{benefit.description}</p>
          </div>
        ))}
      </div>
    </div>
  </div>

  <!-- DESKTOP (>= 768px) -->
  <div class="hidden md:flex flex-col w-full">
    <div class="flex w-full flex-col gap-6 rounded-[40px] bg-dark-blue p-[40px] shadow-xl lg:p-[52px]">
      <div class="w-max rounded-[20px] bg-primary-blue px-[40px] py-[24px] shadow-md">
        <h2 class="m-0 font-roboto text-[48px] font-bold !text-hero-text">Why Volunteer?</h2>
      </div>
      <div class="ml-[40px] w-full max-w-[660px] rounded-[20px] bg-primary-blue px-[40px] py-[32px] shadow-md lg:ml-[60px]">
        <h3 class="m-0 mb-[16px] font-roboto text-[36px] font-bold !text-hero-text">Gain invaluable perks</h3>
        <p class="m-0 font-sans text-[24px] font-normal leading-relaxed !text-hero-text">
          Volunteering with Next Wave Dev isn't just about giving back—it's an investment in your career. We provide the structure and support you need to thrive in the tech industry.
        </p>
      </div>
    </div>
    <div class="mt-[80px] px-[50px]">
      <h3 class="m-0 mb-[60px] font-roboto text-[36px] font-bold text-black">What you gain with us</h3>
      <div class="grid grid-cols-2 gap-x-[90px] gap-y-[80px]">
        {benefits.map((benefit) => (
          <div class="flex flex-col">
            <div class="mb-6 inline-flex h-[48px] w-max items-center justify-center rounded-[10px] bg-dark-blue px-[40px] shadow-sm">
              <span class="m-0 font-roboto text-[24px] font-bold !text-white">{benefit.title}</span>
            </div>
            <p class="m-0 font-sans text-[20px] font-normal leading-relaxed text-black">{benefit.description}</p>
          </div>
        ))}
      </div>
    </div>
  </div>
</div>