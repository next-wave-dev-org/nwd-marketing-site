---
// src/components/ContactSuccessSection.astro
import Button from './Button.astro';
---
<div class="w-full flex flex-col items-center mt-6 md:mt-16 mb-24 px-6">
  
  <!-- Consolidated Success Card -->
  <section class="relative mx-auto w-full max-w-[800px] flex-col rounded-[20px] bg-surface border border-border-subtle px-6 py-12 md:py-20 flex items-center text-center shadow-xl">
    
    <div class="flex h-16 w-16 items-center justify-center rounded-full bg-accent-primary/20 text-accent-cyan mb-6">
      <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
        <polyline points="20 6 9 17 4 12"></polyline>
      </svg>
    </div>

    <h1 class="font-roboto text-[32px] md:text-[48px] font-bold text-text-heading leading-tight m-0">
      Submission successful!
    </h1>
    
    <p class="font-sans text-[18px] md:text-[20px] font-normal text-text-body mt-4 md:mt-6 m-0 max-w-[500px]">
      Thank you for reaching out to Next Wave Dev. We look forward to connecting with you and will be in touch shortly.
    </p>
    
    <div class="mt-10 flex justify-center w-full">
      <Button href="/" label="Back to Homepage" variant="primary" />
    </div>

  </section>

</div>