---
// src/components/ContactSection.astro
---

<div class="w-full flex justify-center">

  <!-- =============================== -->
  <!-- MOBILE VIEW (< 768px)           -->
  <!-- =============================== -->
  <div id="mobile-contact" class="w-full flex flex-col font-sans text-black gap-10 px-6">
    
    <!-- Top Banner Card with Gradient -->
    <div class="relative flex w-full flex-col gap-3 rounded-button-long bg-gradient-to-b from-light-aqua to-secondary-blue/70 p-6 text-center shadow-md">
      <h2 class="font-roboto font-semibold text-h3 leading-tight text-black m-0">Let us know what you need!</h2>
      <p class="font-sans font-normal text-[18px] text-black m-0">Tell us what you need help with</p>
    </div>

    <!-- Contact Form Section Wrapper -->
    <div class="flex flex-col w-full gap-8">
      <div class="flex flex-col items-center text-center">
        <h3 class="font-roboto text-h3 font-bold text-black m-0">Contact Us</h3>
        <div class="mt-4 flex min-h-[48px] w-full items-center justify-center rounded-button-long border border-black p-4">
          <span class="font-sans text-[16px] font-bold text-black text-center m-0">Let us know your interest in our organization!</span>
        </div>
      </div>
      
      <!-- Functional Mobile Form -->
      <form class="nwd-contact-form flex flex-col gap-6 w-full">
        <div class="flex flex-col gap-2">
          <label class="font-sans text-condensed-body font-semibold text-black">Name</label>
          <input type="text" name="entry.466042137" required class="h-[50px] w-full rounded-panel border-2 border-black bg-transparent px-4 text-black outline-none" />
        </div>
        <div class="flex flex-col gap-2">
          <label class="font-sans text-condensed-body font-semibold text-black">Email</label>
          <input type="email" name="entry.738526202" required class="h-[50px] w-full rounded-panel border-2 border-black bg-transparent px-4 text-black outline-none" />
        </div>
        <div class="flex flex-col gap-2">
          <label class="font-sans text-condensed-body font-semibold text-black">Topic</label>
          <select name="entry.157022988" required class="h-[50px] w-full rounded-panel border-2 border-black bg-transparent px-4 font-sans text-[18px] font-semibold text-input-placeholder outline-none appearance-none">
            <option value="General Inquiry">General Inquiry</option>
            <option value="Product Question">Product Question</option>
            <option value="Service Request">Service Request</option>
            <option value="Other">Other</option>
          </select>
        </div>
        <div class="flex flex-col gap-2">
          <label class="font-sans text-condensed-body font-semibold text-black">Your message</label>
          <textarea name="entry.682184233" required class="h-[130px] w-full rounded-panel border-2 border-black bg-transparent p-4 text-black outline-none resize-none"></textarea>
        </div>
        <button type="submit" class="mt-2 h-[55px] w-full rounded-button-long bg-dark-blue font-roboto text-h4 font-medium text-button-muted-text transition-opacity hover:opacity-90">
          Submit
        </button>
      </form>
    </div>
    
    <!-- Contact Info Side -->
    <div class="flex flex-col items-center text-center gap-8 pt-6 border-t border-black/20">
      <p class="font-sans text-condensed-body font-semibold leading-[29px] text-black m-0">
        Next Wave Dev<br/>PO Box 17322,<br/>Seattle, WA 98127
      </p>
      <div class="flex flex-col gap-1">
        <p class="font-sans text-condensed-body font-semibold text-black m-0">Email</p>
        <p class="font-sans text-condensed-body font-medium text-black m-0">support@nextwavedev.org</p>
      </div>
      <div class="flex flex-col gap-1">
        <p class="font-sans text-condensed-body font-semibold text-black m-0">Phone</p>
        <p class="font-sans text-condensed-body font-medium text-black m-0">360-499-3512</p>
      </div>
    </div>

  </div>


  <!-- =============================== -->
  <!-- DESKTOP VIEW (>= 768px)         -->
  <!-- =============================== -->
  <section id="desktop-contact" class="relative mx-auto hidden min-h-[916px] w-full max-w-[1125px] flex-col rounded-button-long bg-gradient-to-b from-light-aqua to-secondary-blue/70 px-[94px] py-[60px] shadow-lg md:flex">
      <h2 class="font-roboto text-h2 font-semibold text-black m-0">Let us know what you need!</h2>
      <p class="font-sans text-h3 font-normal text-black mt-2 m-0">Tell us what you need help with</p>
      
      <div class="grid grid-cols-[1fr_auto] gap-[80px] mt-[60px]">
          <!-- Form Side -->
          <div class="flex flex-col w-[530px]">
              <h3 class="font-roboto text-h2 font-bold text-black m-0">Contact Us</h3>
              <div class="mt-4 flex min-h-[48px] w-full items-center justify-center rounded-button-long border border-black p-2 text-center">
                  <span class="font-sans text-condensed-body font-bold text-black m-0">Let us know your interest in our organization!</span>
              </div>
              
              <!-- Functional Desktop Form -->
              <form class="nwd-contact-form mt-10 flex flex-col gap-6">
                  <div class="flex flex-col gap-2">
                      <label class="font-sans text-h4 font-semibold text-black">Name</label>
                      <input type="text" name="entry.466042137" required class="h-[60px] w-full rounded-panel border-2 border-black bg-transparent px-4 outline-none" />
                  </div>
                  <div class="flex flex-col gap-2">
                      <label class="font-sans text-h4 font-semibold text-black">Email</label>
                      <input type="email" name="entry.738526202" required class="h-[60px] w-full rounded-panel border-2 border-black bg-transparent px-4 outline-none" />
                  </div>
                  <div class="flex flex-col gap-2">
                      <label class="font-sans text-h4 font-semibold text-black">Topic</label>
                      <select name="entry.157022988" required class="h-[60px] w-full rounded-panel border-2 border-black bg-transparent px-4 font-sans text-h4 font-semibold text-input-placeholder outline-none appearance-none">
                          <option value="General Inquiry">General Inquiry</option>
                          <option value="Product Question">Product Question</option>
                          <option value="Service Request">Service Request</option>
                          <option value="Other">Other</option>
                      </select>
                  </div>
                  <div class="flex flex-col gap-2">
                      <label class="font-sans text-h4 font-semibold text-black">Your message</label>
                      <textarea name="entry.682184233" required class="h-[150px] w-full rounded-panel border-2 border-black bg-transparent p-4 outline-none resize-none"></textarea>
                  </div>
                  <button type="submit" class="mt-5 h-[60px] w-full rounded-button-long bg-dark-blue font-roboto text-h3 font-medium text-button-muted-text transition-opacity hover:opacity-90">
                      Submit
                  </button>
              </form>
          </div>
          
          <!-- Contact Info Side -->
          <div class="flex flex-col gap-10 pt-[150px]">
              <p class="font-sans text-h4 font-semibold leading-[29px] text-black m-0">
                  Next Wave Dev<br/>PO Box 17322,<br/>Seattle, WA 98127
              </p>
              <div class="flex flex-col gap-2">
                  <p class="font-sans text-h4 font-semibold text-black m-0">Email</p>
                  <p class="font-sans text-h4 font-medium text-black m-0">support@nextwavedev.org</p>
              </div>
              <div class="flex flex-col gap-2">
                  <p class="font-sans text-h4 font-semibold text-black m-0">Phone</p>
                  <p class="font-sans text-h4 font-medium text-black m-0">360-499-3512</p>
              </div>
          </div>
      </div>
  </section>

</div>

<!-- Client-side script to silently pass data to Google Forms and redirect to /success -->
<script>
  document.addEventListener('DOMContentLoaded', () => {
    const forms = document.querySelectorAll('.nwd-contact-form');
    
    forms.forEach(form => {
      form.addEventListener('submit', (e) => {
        // Prevent the browser from trying to navigate to a new page
        e.preventDefault(); 
        
        // Package up the form inputs
        const formElement = e.target;
        const formData = new FormData(formElement);
        
        // Post to Google Forms silently using 'no-cors' mode
        fetch('https://docs.google.com/forms/d/e/1FAIpQLSf0_xJGsi1Gx41D-qI9sgpXkuoyIBFavaZZ0TuvbRkHCF2ShA/formResponse', {
          method: 'POST',
          mode: 'no-cors',
          body: formData
        })
        .then(() => {
          // Immediately redirect to the success page
          window.location.href = '/success';
        })
        .catch((error) => {
          console.error('Error submitting form:', error);
          // Redirect to success anyway as a fallback (Google often returns opaque errors in no-cors)
          window.location.href = '/success';
        });
      });
    });
  });
</script>

<style is:global>
  @media (min-width: 768px) {
    #mobile-contact { display: none !important; }
    #desktop-contact { display: flex !important; }
  }
  @media (max-width: 767px) {
    #desktop-contact { display: none !important; }
    #mobile-contact { display: flex !important; }
  }
</style>