---
// src/components/ContactSection.astro
---
<div class="w-full flex flex-col items-center">

  <!-- UNIFIED CONTACT FORM & INFO -->
  <section id="contact-section" class="relative mx-auto flex w-full max-w-[1125px] flex-col md:rounded-[10px] md:bg-gradient-to-b md:from-light-aqua md:to-secondary-blue/70 px-6 md:px-[94px] py-6 md:py-[60px] md:shadow-lg font-sans text-black mt-6 md:mt-0">
      
      <div class="flex flex-col items-center md:items-start text-center md:text-left gap-2 md:border-b md:border-black/10 pb-4 md:pb-8">
        <h2 class="font-roboto text-[32px] md:text-[48px] font-bold text-black m-0">Contact Us</h2>
        <p class="font-sans text-[16px] md:text-[24px] font-normal text-black m-0">Tell us what you need help with, and we'll be in touch.</p>
      </div>
      
      <div class="flex flex-col md:grid md:grid-cols-[1fr_auto] gap-10 md:gap-[80px] mt-8 md:mt-[40px] w-full">
          
          <!-- Unified Form Side -->
          <div class="flex flex-col w-full md:w-[530px]">
              <form class="nwd-contact-form flex flex-col gap-6">
                  
                  <div class="nwd-form-error hidden w-full rounded-[10px] bg-red-100 border border-red-400 p-4 text-center md:text-left">
                    <span class="font-sans text-[14px] md:text-[16px] font-bold text-red-700">There was a network error sending your message. Please check your connection and try again.</span>
                  </div>

                  <div class="flex flex-col gap-2">
                      <label for="entry.466042137" class="font-sans text-[16px] md:text-[20px] font-semibold text-black">Name</label>
                      <input type="text" id="entry.466042137" name="entry.466042137" required class="h-[50px] md:h-[60px] w-full rounded-[10px] border-2 border-black bg-transparent px-4 text-black outline-none focus-visible:ring-2 focus-visible:ring-primary-blue focus-visible:border-transparent transition-all" />
                  </div>
                  
                  <div class="flex flex-col gap-2">
                      <label for="entry.738526202" class="font-sans text-[16px] md:text-[20px] font-semibold text-black">Email</label>
                      <input type="email" id="entry.738526202" name="entry.738526202" required class="h-[50px] md:h-[60px] w-full rounded-[10px] border-2 border-black bg-transparent px-4 text-black outline-none focus-visible:ring-2 focus-visible:ring-primary-blue focus-visible:border-transparent transition-all" />
                  </div>
                  
                  <div class="flex flex-col gap-2">
                      <label for="entry.157022988" class="font-sans text-[16px] md:text-[20px] font-semibold text-black">Topic</label>
                      <select id="entry.157022988" name="entry.157022988" required class="h-[50px] md:h-[60px] w-full rounded-[10px] border-2 border-black bg-transparent px-4 font-sans text-[16px] md:text-[20px] font-semibold text-black outline-none appearance-none focus-visible:ring-2 focus-visible:ring-primary-blue focus-visible:border-transparent transition-all">
                          <option value="" disabled selected>Please choose...</option>
                          <option value="General Inquiry">General Inquiry</option>
                          <option value="Product Question">Product Question</option>
                          <option value="Service Request">Service Request</option>
                          <option value="Other">Other</option>
                      </select>
                  </div>
                  
                  <div class="flex flex-col gap-2">
                      <label for="entry.682184233" class="font-sans text-[16px] md:text-[20px] font-semibold text-black">Your message</label>
                      <textarea id="entry.682184233" name="entry.682184233" required class="h-[130px] md:h-[150px] w-full rounded-[10px] border-2 border-black bg-transparent p-4 text-black outline-none resize-none focus-visible:ring-2 focus-visible:ring-primary-blue focus-visible:border-transparent transition-all"></textarea>
                  </div>
                  
                  <button type="submit" class="nwd-submit-btn mt-2 md:mt-5 h-[55px] md:h-[60px] w-full md:rounded-[30px] rounded-[30px] bg-dark-blue font-roboto text-[18px] md:text-[24px] font-medium text-white transition-all hover:bg-black focus-visible:ring-2 focus-visible:ring-primary-blue focus-visible:ring-offset-2 outline-none">
                      Submit
                  </button>
              </form>
          </div>
          
          <!-- Unified Contact Info Side -->
          <div class="flex flex-col items-center md:items-start text-center md:text-left gap-8 md:gap-10 pt-6 md:pt-[20px] border-t border-black/20 md:border-t-0 w-full">
              <div class="flex flex-col gap-1 md:gap-2">
                  <p class="font-sans text-[16px] md:text-[20px] font-semibold leading-[24px] md:leading-[29px] text-black m-0">
                      Next Wave Dev<br/>PO Box 17322,<br/>Seattle, WA 98127
                  </p>
                  <p class="font-sans text-[13px] md:text-[14px] font-normal text-black/70 m-0 italic">A registered 501(c)(3) non-profit</p>
              </div>
              <div class="flex flex-col gap-1 md:gap-2">
                  <p class="font-sans text-[16px] md:text-[20px] font-semibold text-black m-0">Email Support</p>
                  <p class="font-sans text-[16px] md:text-[20px] font-medium text-black m-0">support@nextwavedev.org<br/><span class="text-[14px] md:text-[16px] font-normal italic">(Expect a reply within 24 hours)</span></p>
              </div>
              <div class="flex flex-col gap-1 md:gap-2">
                  <p class="font-sans text-[16px] md:text-[20px] font-semibold text-black m-0">Phone</p>
                  <p class="font-sans text-[16px] md:text-[20px] font-medium text-black m-0">360-499-3512</p>
              </div>
          </div>
      </div>
  </section>

  <!-- UNIFIED DONATE BANNER -->
  <section class="mx-auto mt-12 md:mt-[50px] mb-8 md:mb-0 flex w-full max-w-[1289px] flex-col md:flex-row items-center justify-center md:justify-between gap-6 md:gap-10 overflow-hidden rounded-[10px] bg-gradient-to-b from-light-aqua to-secondary-blue px-6 py-6 md:px-10 md:py-12 shadow-md md:shadow-lg lg:px-[100px] w-[calc(100%-48px)] md:w-full">
    
    <div class="flex h-[150px] w-[150px] md:h-[390px] md:w-[390px] shrink-0 items-center justify-center rounded-full bg-primary-blue shadow-sm md:shadow-lg mx-auto md:mx-0 p-2 md:p-8">
      <h2 class="w-full text-center font-heading text-[20px] md:text-[48px] lg:text-[52px] font-bold leading-tight text-hero-text drop-shadow-sm md:drop-shadow-card [text-shadow:-1px_-1px_0_#D49A1D,_1px_-1px_0_#D49A1D,_-1px_1px_0_#D49A1D,_1px_1px_0_#D49A1D] md:[text-shadow:-3px_-3px_0_#D49A1D,_3px_-3px_0_#D49A1D,_-3px_3px_0_#D49A1D,_3px_3px_0_#D49A1D] break-words m-0">
        Donate<br/>Now
      </h2>
    </div>

    <div class="flex w-full max-w-full md:max-w-[668px] flex-col gap-4 md:gap-5 text-center md:text-left items-center md:items-start">
      <h3 class="m-0 font-roboto text-[22px] md:text-[36px] lg:text-[48px] font-bold leading-tight md:leading-[1.2] text-black break-words">
        Empower the next wave of technologists while supporting mission-driven organizations.
      </h3>
      <div class="flex justify-center md:justify-start w-full mt-2 md:mt-4 lg:mt-10">
        <a href="/donate" class="inline-flex w-full md:w-max max-w-[200px] md:max-w-none items-center justify-center rounded-[30px] bg-dark-blue px-4 md:px-8 py-[12px] font-roboto text-[16px] md:text-[18px] lg:text-[24px] font-bold text-white transition-colors hover:bg-black shadow-sm text-center focus-visible:ring-2 focus-visible:ring-primary-blue focus-visible:ring-offset-2 outline-none">
          Donate
        </a>
      </div>
    </div>
  </section>

</div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const forms = document.querySelectorAll('.nwd-contact-form');
    
    forms.forEach(form => {
      form.addEventListener('submit', (e) => {
        e.preventDefault(); 
        const formElement = e.target as HTMLFormElement;
        const formData = new FormData(formElement);
        const submitBtn = formElement.querySelector('.nwd-submit-btn') as HTMLButtonElement;
        const errorContainer = formElement.querySelector('.nwd-form-error');
        
        submitBtn.disabled = true;
        submitBtn.classList.add('opacity-50', 'cursor-not-allowed');
        submitBtn.textContent = 'Sending...';
        
        if (errorContainer) {
          errorContainer.classList.add('hidden');
        }
        
        fetch('https://docs.google.com/forms/d/e/1FAIpQLSf0_xJGsi1Gx41D-qI9sgpXkuoyIBFavaZZ0TuvbRkHCF2ShA/formResponse', {
          method: 'POST',
          mode: 'no-cors',
          body: formData
        })
        .then(() => { 
          window.location.href = '/success'; 
        })
        .catch((error) => {
          console.error('Error submitting form:', error);
          if (errorContainer) {
            errorContainer.classList.remove('hidden');
          }
          submitBtn.disabled = false;
          submitBtn.classList.remove('opacity-50', 'cursor-not-allowed');
          submitBtn.textContent = 'Submit';
        });
      });
    });
  });
</script>