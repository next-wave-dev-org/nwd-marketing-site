---
// src/components/ContactSection.astro
---

<div class="w-full flex flex-col items-center">

  <!-- =============================== -->
  <!-- MOBILE VIEW (< 768px)           -->
  <!-- =============================== -->
  <div id="mobile-contact" class="w-full flex flex-col font-sans text-black gap-10 px-6 md:hidden">
    
    <!-- Top Banner Card with Gradient -->
    <div class="relative flex w-full flex-col gap-3 rounded-[10px] bg-gradient-to-b from-light-aqua to-secondary-blue/70 p-6 text-center shadow-md">
      <h2 class="font-roboto font-semibold text-[24px] leading-tight text-black m-0">Let us know what you need!</h2>
      <p class="font-sans font-normal text-[18px] text-black m-0">Tell us what you need help with</p>
    </div>

    <!-- Contact Form Section Wrapper -->
    <div class="flex flex-col w-full gap-8">
      <div class="flex flex-col items-center text-center">
        <h3 class="font-roboto text-[28px] font-bold text-black m-0">Contact Us</h3>
        <div class="mt-4 flex min-h-[48px] w-full items-center justify-center rounded-[10px] border border-black p-4">
          <span class="font-sans text-[16px] font-bold text-black text-center m-0">Let us know your interest in our organization!</span>
        </div>
      </div>
      
      <!-- Functional Mobile Form -->
      <form class="nwd-contact-form flex flex-col gap-6 w-full">
        <div class="flex flex-col gap-2">
          <label class="font-sans text-[16px] font-semibold text-black">Name</label>
          <input type="text" name="entry.466042137" required class="h-[50px] w-full rounded-[10px] border-2 border-black bg-transparent px-4 text-black outline-none" />
        </div>
        <div class="flex flex-col gap-2">
          <label class="font-sans text-[16px] font-semibold text-black">Email</label>
          <input type="email" name="entry.738526202" required class="h-[50px] w-full rounded-[10px] border-2 border-black bg-transparent px-4 text-black outline-none" />
        </div>
        <div class="flex flex-col gap-2">
          <label class="font-sans text-[16px] font-semibold text-black">Topic</label>
          <select name="entry.157022988" required class="h-[50px] w-full rounded-[10px] border-2 border-black bg-transparent px-4 font-sans text-[16px] font-semibold text-black/50 outline-none appearance-none">
            <option value="General Inquiry">General Inquiry</option>
            <option value="Product Question">Product Question</option>
            <option value="Service Request">Service Request</option>
            <option value="Other">Other</option>
          </select>
        </div>
        <div class="flex flex-col gap-2">
          <label class="font-sans text-[16px] font-semibold text-black">Your message</label>
          <textarea name="entry.682184233" required class="h-[130px] w-full rounded-[10px] border-2 border-black bg-transparent p-4 text-black outline-none resize-none"></textarea>
        </div>
        <button type="submit" class="mt-2 h-[55px] w-full rounded-[30px] bg-dark-blue font-roboto text-[18px] font-medium text-white transition-opacity hover:opacity-90">
          Submit
        </button>
      </form>
    </div>
    
    <!-- Contact Info Side -->
    <div class="flex flex-col items-center text-center gap-8 pt-6 border-t border-black/20">
      <p class="font-sans text-[16px] font-semibold leading-[24px] text-black m-0">
        Next Wave Dev<br/>PO Box 17322,<br/>Seattle, WA 98127
      </p>
      <div class="flex flex-col gap-1">
        <p class="font-sans text-[16px] font-semibold text-black m-0">Email</p>
        <p class="font-sans text-[16px] font-medium text-black m-0">support@nextwavedev.org</p>
      </div>
      <div class="flex flex-col gap-1">
        <p class="font-sans text-[16px] font-semibold text-black m-0">Phone</p>
        <p class="font-sans text-[16px] font-medium text-black m-0">360-499-3512</p>
      </div>
    </div>
  </div>

  <!-- Mobile Donate Banner (VERTICALLY STACKED FIX) -->
  <div class="w-full px-6 mt-12 mb-8 md:hidden">
    <div class="flex flex-col items-center text-center gap-6 w-full rounded-[10px] bg-gradient-to-b from-light-aqua to-secondary-blue p-6 shadow-md">
      <div class="flex h-[150px] w-[150px] shrink-0 items-center justify-center rounded-full bg-primary-blue shadow-sm mx-auto p-2">
        <span class="m-0 text-center font-heading text-[22px] font-bold leading-tight text-hero-text [text-shadow:-1px_-1px_0_#D49A1D,_1px_-1px_0_#D49A1D,_-1px_1px_0_#D49A1D,_1px_1px_0_#D49A1D] break-words">
          Donate<br/>Now
        </span>
      </div>
      <div class="flex flex-col gap-4 w-full">
        <h2 class="m-0 font-sans text-[18px] font-semibold text-black leading-snug break-words">
          Empower the next wave of technologists while supporting mission-driven organizations.
        </h2>
        <div class="flex justify-center w-full mt-2">
          <a href="/donate" class="inline-flex w-full max-w-[200px] items-center justify-center rounded-[30px] bg-dark-blue px-4 py-[12px] font-roboto text-[16px] font-bold text-white transition-colors hover:bg-black shadow-sm text-center">
            Donate
          </a>
        </div>
      </div>
    </div>
  </div>

  <!-- =============================== -->
  <!-- DESKTOP VIEW (>= 768px)         -->
  <!-- =============================== -->
  <section id="desktop-contact" class="relative mx-auto hidden min-h-[916px] w-full max-w-[1125px] flex-col rounded-[10px] bg-gradient-to-b from-light-aqua to-secondary-blue/70 px-[94px] py-[60px] shadow-lg md:flex">
      <h2 class="font-roboto text-[48px] font-semibold text-black m-0">Let us know what you need!</h2>
      <p class="font-sans text-[28px] font-normal text-black mt-2 m-0">Tell us what you need help with</p>
      
      <div class="grid grid-cols-[1fr_auto] gap-[80px] mt-[60px]">
          <!-- Form Side -->
          <div class="flex flex-col w-[530px]">
              <h3 class="font-roboto text-[48px] font-bold text-black m-0">Contact Us</h3>
              <div class="mt-4 flex min-h-[48px] w-full items-center justify-center rounded-[10px] border border-black p-2 text-center">
                  <span class="font-sans text-[18px] font-bold text-black m-0">Let us know your interest in our organization!</span>
              </div>
              
              <!-- Functional Desktop Form -->
              <form class="nwd-contact-form mt-10 flex flex-col gap-6">
                  <div class="flex flex-col gap-2">
                      <label class="font-sans text-[20px] font-semibold text-black">Name</label>
                      <input type="text" name="entry.466042137" required class="h-[60px] w-full rounded-[10px] border-2 border-black bg-transparent px-4 outline-none" />
                  </div>
                  <div class="flex flex-col gap-2">
                      <label class="font-sans text-[20px] font-semibold text-black">Email</label>
                      <input type="email" name="entry.738526202" required class="h-[60px] w-full rounded-[10px] border-2 border-black bg-transparent px-4 outline-none" />
                  </div>
                  <div class="flex flex-col gap-2">
                      <label class="font-sans text-[20px] font-semibold text-black">Topic</label>
                      <select name="entry.157022988" required class="h-[60px] w-full rounded-[10px] border-2 border-black bg-transparent px-4 font-sans text-[20px] font-semibold text-black/50 outline-none appearance-none">
                          <option value="General Inquiry">General Inquiry</option>
                          <option value="Product Question">Product Question</option>
                          <option value="Service Request">Service Request</option>
                          <option value="Other">Other</option>
                      </select>
                  </div>
                  <div class="flex flex-col gap-2">
                      <label class="font-sans text-[20px] font-semibold text-black">Your message</label>
                      <textarea name="entry.682184233" required class="h-[150px] w-full rounded-[10px] border-2 border-black bg-transparent p-4 outline-none resize-none"></textarea>
                  </div>
                  <button type="submit" class="mt-5 h-[60px] w-full rounded-[30px] bg-dark-blue font-roboto text-[24px] font-medium text-white transition-opacity hover:opacity-90">
                      Submit
                  </button>
              </form>
          </div>
          
          <!-- Contact Info Side -->
          <div class="flex flex-col gap-10 pt-[150px]">
              <p class="font-sans text-[20px] font-semibold leading-[29px] text-black m-0">
                  Next Wave Dev<br/>PO Box 17322,<br/>Seattle, WA 98127
              </p>
              <div class="flex flex-col gap-2">
                  <p class="font-sans text-[20px] font-semibold text-black m-0">Email</p>
                  <p class="font-sans text-[20px] font-medium text-black m-0">support@nextwavedev.org</p>
              </div>
              <div class="flex flex-col gap-2">
                  <p class="font-sans text-[20px] font-semibold text-black m-0">Phone</p>
                  <p class="font-sans text-[20px] font-medium text-black m-0">360-499-3512</p>
              </div>
          </div>
      </div>
  </section>

  <!-- Desktop Donate Banner -->
  <section class="hidden md:flex mx-auto mt-[50px] min-h-[489px] w-full max-w-[1289px] flex-row items-center justify-between gap-10 overflow-hidden rounded-[10px] bg-gradient-to-b from-light-aqua to-secondary-blue px-10 py-12 shadow-lg lg:px-[100px]">
    <div class="flex h-[300px] w-[300px] shrink-0 items-center justify-center rounded-full bg-primary-blue shadow-lg lg:h-[390px] lg:w-[390px] p-8">
      <span class="w-full text-center font-heading text-[48px] lg:text-[64px] font-bold leading-none text-hero-text drop-shadow-card [text-shadow:-2px_-2px_0_#D49A1D,_2px_-2px_0_#D49A1D,_-2px_2px_0_#D49A1D,_2px_2px_0_#D49A1D] lg:[text-shadow:-3px_-3px_0_#D49A1D,_3px_-3px_0_#D49A1D,_-3px_3px_0_#D49A1D,_3px_3px_0_#D49A1D] break-words">
        Donate<br/>Now
      </span>
    </div>
    <div class="flex w-full max-w-[668px] flex-col gap-5">
      <h2 class="font-sans text-[36px] font-semibold leading-[1.2] text-black m-0 lg:text-[48px]">
        Empower the next wave of technologists while supporting mission-driven organizations.
      </h2>
      <div class="mt-4 flex lg:mt-10">
        <a href="/donate" class="inline-flex w-max items-center justify-center rounded-[30px] bg-dark-blue px-8 py-[12px] font-roboto text-[18px] lg:text-[24px] font-bold text-white transition-colors hover:bg-black shadow-sm">
          Donate
        </a>
      </div>
    </div>
  </section>

</div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const forms = document.querySelectorAll('.nwd-contact-form');
    
    forms.forEach(form => {
      form.addEventListener('submit', (e) => {
        e.preventDefault(); 
        const formElement = e.target;
        const formData = new FormData(formElement);
        
        fetch('https://docs.google.com/forms/d/e/1FAIpQLSf0_xJGsi1Gx41D-qI9sgpXkuoyIBFavaZZ0TuvbRkHCF2ShA/formResponse', {
          method: 'POST',
          mode: 'no-cors',
          body: formData
        })
        .then(() => {
          window.location.href = '/success';
        })
        .catch((error) => {
          console.error('Error submitting form:', error);
          window.location.href = '/success';
        });
      });
    });
  });
</script>