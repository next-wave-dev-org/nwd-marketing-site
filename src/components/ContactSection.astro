---
// src/components/ContactSection.astro
---
<div class="w-full flex flex-col items-center">

  <section id="contact-section" class="relative mx-auto flex w-full max-w-[1125px] flex-col md:rounded-[10px] md:bg-surface md:border md:border-border-subtle px-6 md:px-12 xl:px-[94px] py-6 md:py-12 xl:py-[60px] md:shadow-2xl font-sans text-text-heading mt-6 md:mt-0">
      
      <div class="flex flex-col items-center md:items-start text-center md:text-left gap-2 border-b border-border-subtle pb-4 md:pb-8">
        <h2 class="font-roboto text-[32px] md:text-[48px] font-bold text-text-heading m-0">Contact Us</h2>
        <p class="font-sans text-[16px] md:text-[24px] font-normal text-text-body m-0">Tell us what you need help with, and we'll be in touch.</p>
      </div>
      
      <!-- Shifted from md:grid to xl:grid -->
      <div class="flex flex-col xl:grid xl:grid-cols-[1fr_auto] gap-10 md:gap-12 xl:gap-[80px] mt-8 md:mt-[40px] w-full">
          
          <div class="flex flex-col w-full xl:w-[530px]">
              <form class="nwd-contact-form flex flex-col gap-6">
                  
                  <div class="nwd-form-error hidden w-full rounded-[10px] bg-red-900/40 border border-red-500 p-4 text-center md:text-left">
                    <span class="font-sans text-[14px] md:text-[16px] font-bold text-red-200">There was a network error sending your message. Please check your connection and try again.</span>
                  </div>

                  <div class="flex flex-col gap-2">
                      <label for="entry.466042137" class="font-sans text-[16px] md:text-[20px] font-semibold text-text-heading">Name</label>
                      <input type="text" id="entry.466042137" name="entry.466042137" required class="h-[50px] md:h-[60px] w-full rounded-[10px] border border-border-subtle bg-background px-4 text-text-heading outline-none focus-visible:ring-2 focus-visible:ring-accent-cyan focus-visible:border-transparent transition-all" />
                  </div>
                  
                  <div class="flex flex-col gap-2">
                      <label for="entry.738526202" class="font-sans text-[16px] md:text-[20px] font-semibold text-text-heading">Email</label>
                      <input type="email" id="entry.738526202" name="entry.738526202" required class="h-[50px] md:h-[60px] w-full rounded-[10px] border border-border-subtle bg-background px-4 text-text-heading outline-none focus-visible:ring-2 focus-visible:ring-accent-cyan focus-visible:border-transparent transition-all" />
                  </div>
                  
                  <div class="flex flex-col gap-2">
                      <label for="entry.157022988" class="font-sans text-[16px] md:text-[20px] font-semibold text-text-heading">Topic</label>
                      <select id="entry.157022988" name="entry.157022988" required class="h-[50px] md:h-[60px] w-full rounded-[10px] border border-border-subtle bg-background px-4 font-sans text-[16px] md:text-[20px] font-semibold text-text-heading outline-none appearance-none focus-visible:ring-2 focus-visible:ring-accent-cyan focus-visible:border-transparent transition-all">
                          <option value="" disabled selected class="bg-background text-text-body">Please choose...</option>
                          <option value="General Inquiry" class="bg-background">General Inquiry</option>
                          <option value="Product Question" class="bg-background">Product Question</option>
                          <option value="Service Request" class="bg-background">Service Request</option>
                          <option value="Other" class="bg-background">Other</option>
                      </select>
                  </div>
                  
                  <div class="flex flex-col gap-2">
                      <label for="entry.682184233" class="font-sans text-[16px] md:text-[20px] font-semibold text-text-heading">Your message</label>
                      <textarea id="entry.682184233" name="entry.682184233" required class="h-[130px] md:h-[150px] w-full rounded-[10px] border border-border-subtle bg-background p-4 text-text-heading outline-none resize-none focus-visible:ring-2 focus-visible:ring-accent-cyan focus-visible:border-transparent transition-all"></textarea>
                  </div>
                  
                  <button type="submit" class="nwd-submit-btn mt-2 md:mt-5 h-[55px] md:h-[60px] w-full rounded-[30px] bg-gradient-to-r from-accent-primary to-accent-secondary font-roboto text-[18px] md:text-[24px] font-medium text-text-heading transition-all hover:opacity-90 shadow-md focus-visible:ring-2 focus-visible:ring-accent-cyan focus-visible:ring-offset-2 outline-none">
                      Submit
                  </button>
              </form>
          </div>
          
          <div class="flex flex-col items-center md:items-start text-center md:text-left gap-8 md:gap-10 pt-8 xl:pt-[20px] border-t border-border-subtle xl:border-t-0 w-full">
              <div class="flex flex-col gap-1 md:gap-2">
                  <p class="font-sans text-[16px] md:text-[20px] font-semibold leading-[24px] md:leading-[29px] text-text-heading m-0">
                      Next Wave Dev<br/>PO Box 17322,<br/>Seattle, WA 98127
                  </p>
                  <p class="font-sans text-[13px] md:text-[14px] font-normal text-accent-cyan m-0 italic">A registered 501(c)(3) non-profit</p>
              </div>
              <div class="flex flex-col gap-1 md:gap-2">
                  <p class="font-sans text-[16px] md:text-[20px] font-semibold text-text-heading m-0">Email Support</p>
                  <p class="font-sans text-[16px] md:text-[20px] font-medium text-text-body m-0">support@nextwavedev.org<br/><span class="text-[14px] md:text-[16px] font-normal italic text-text-heading/50">(Expect a reply within 24 hours)</span></p>
              </div>
              <div class="flex flex-col gap-1 md:gap-2">
                  <p class="font-sans text-[16px] md:text-[20px] font-semibold text-text-heading m-0">Phone</p>
                  <p class="font-sans text-[16px] md:text-[20px] font-medium text-text-body m-0">360-499-3512</p>
              </div>
          </div>
      </div>
  </section>

</div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const forms = document.querySelectorAll('.nwd-contact-form');
    
    forms.forEach(form => {
      form.addEventListener('submit', (e) => {
        e.preventDefault(); 
        const formElement = e.target as HTMLFormElement;
        const formData = new FormData(formElement);
        const submitBtn = formElement.querySelector('.nwd-submit-btn') as HTMLButtonElement;
        const errorContainer = formElement.querySelector('.nwd-form-error');
        
        submitBtn.disabled = true;
        submitBtn.classList.add('opacity-50', 'cursor-not-allowed');
        submitBtn.textContent = 'Sending...';
        
        if (errorContainer) {
          errorContainer.classList.add('hidden');
        }
        
        fetch('https://docs.google.com/forms/d/e/1FAIpQLSf0_xJGsi1Gx41D-qI9sgpXkuoyIBFavaZZ0TuvbRkHCF2ShA/formResponse', {
          method: 'POST',
          mode: 'no-cors',
          body: formData
        })
        .then(() => { 
          window.location.href = '/success'; 
        })
        .catch((error) => {
          console.error('Error submitting form:', error);
          if (errorContainer) {
            errorContainer.classList.remove('hidden');
          }
          submitBtn.disabled = false;
          submitBtn.classList.remove('opacity-50', 'cursor-not-allowed');
          submitBtn.textContent = 'Submit';
        });
      });
    });
  });
</script>