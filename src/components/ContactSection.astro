---
// src/components/ContactSection.astro
---

<div class="w-full flex justify-center">

  <!-- =============================== -->
  <!-- MOBILE VIEW (< 768px)           -->
  <!-- =============================== -->
  <div id="mobile-contact" class="w-full flex flex-col font-sans text-black gap-10 px-6">
    
    <!-- Top Banner Card with Gradient -->
    <div class="relative flex w-full flex-col gap-3 rounded-[20px] bg-gradient-to-b from-light-aqua to-secondary-blue p-6 text-center">
      <h2 class="font-roboto font-semibold text-[32px] leading-tight text-black">Let us know what you need!</h2>
      <p class="font-sans font-normal text-[18px] text-black">Tell us what you need help with</p>
    </div>

    <!-- Contact Form Section Wrapper -->
    <div class="flex flex-col w-full gap-8">
      <div class="flex flex-col items-center text-center">
        <h3 class="font-roboto text-[36px] font-bold text-black">Contact Us</h3>
        <div class="mt-4 flex min-h-[48px] w-full items-center justify-center rounded-[20px] border border-black p-4">
          <span class="font-sans text-[16px] font-bold text-black text-center">Let our CEO know your interest in our organization!</span>
        </div>
      </div>
      
      <form class="flex flex-col gap-6 w-full">
        <div class="flex flex-col gap-2">
          <label class="font-sans text-[20px] font-semibold text-black">Name</label>
          <input type="text" class="h-[50px] w-full rounded-[10px] border-2 border-black bg-transparent px-4 text-black outline-none" />
        </div>
        <div class="flex flex-col gap-2">
          <label class="font-sans text-[20px] font-semibold text-black">Email</label>
          <input type="email" class="h-[50px] w-full rounded-[10px] border-2 border-black bg-transparent px-4 text-black outline-none" />
        </div>
        <div class="flex flex-col gap-2">
          <label class="font-sans text-[20px] font-semibold text-black">Topic</label>
          <select class="h-[50px] w-full rounded-[10px] border-2 border-black bg-transparent px-4 font-sans text-[18px] font-semibold text-input-placeholder outline-none">
            <option>Select a Topic</option>
          </select>
        </div>
        <div class="flex flex-col gap-2">
          <label class="font-sans text-[20px] font-semibold text-black">Your message</label>
          <textarea class="h-[130px] w-full rounded-[10px] border-2 border-black bg-transparent p-4 text-black outline-none resize-none"></textarea>
        </div>
        <button type="button" class="mt-2 h-[55px] w-full rounded-[20px] bg-dark-blue font-roboto text-[24px] font-medium text-button-muted-text transition-opacity hover:opacity-90">
          Submit
        </button>
      </form>
    </div>
    
    <!-- Contact Info Side -->
    <div class="flex flex-col items-center text-center gap-8 pt-6 border-t border-black/20">
      <p class="font-sans text-[20px] font-semibold leading-[29px] text-black">
        Next Wave Dev<br/>5555 somewhere Way N,<br/>Seattle, WA 99999
      </p>
      <div class="flex flex-col gap-1">
        <p class="font-sans text-[20px] font-semibold text-black">Email</p>
        <p class="font-sans text-[20px] font-medium text-black">nextwavedev@gmail.org</p>
      </div>
      <div class="flex flex-col gap-1">
        <p class="font-sans text-[20px] font-semibold text-black">Phone</p>
        <p class="font-sans text-[20px] font-medium text-black">555.555.5555</p>
      </div>
    </div>

  </div>


  <!-- =============================== -->
  <!-- DESKTOP VIEW (>= 768px)         -->
  <!-- =============================== -->
  <section id="desktop-contact" class="relative mx-auto hidden min-h-[916px] w-full max-w-[1125px] flex-col rounded-[20px] bg-gradient-to-b from-light-aqua to-secondary-blue px-[94px] py-[40px] md:flex">
      <h2 class="font-roboto text-[48px] font-semibold text-black">Let us know what you need!</h2>
      <p class="font-sans text-[32px] font-normal text-black mt-2">Tell us what you need help with</p>
      
      <div class="grid grid-cols-2 gap-[50px] mt-[60px]">
          <!-- Form Side -->
          <div class="flex flex-col w-[530px]">
              <h3 class="font-roboto text-[48px] font-bold text-black">Contact Us</h3>
              <div class="mt-4 flex h-[48px] w-full items-center justify-center rounded-[20px] border border-black">
                  <span class="font-sans text-[20px] font-bold text-black">Let our CEO know your interest in our organization!</span>
              </div>
              
              <form class="mt-10 flex flex-col gap-6">
                  <div class="flex flex-col gap-2">
                      <label class="font-sans text-[24px] font-semibold text-black">Name</label>
                      <input type="text" class="h-[60px] w-full rounded-[10px] border-2 border-black bg-transparent px-4" />
                  </div>
                  <div class="flex flex-col gap-2">
                      <label class="font-sans text-[24px] font-semibold text-black">Email</label>
                      <input type="email" class="h-[60px] w-full rounded-[10px] border-2 border-black bg-transparent px-4" />
                  </div>
                  <div class="flex flex-col gap-2">
                      <label class="font-sans text-[24px] font-semibold text-black">Topic</label>
                      <select class="h-[60px] w-full rounded-[10px] border-2 border-black bg-transparent px-4 font-sans text-[24px] font-semibold text-input-placeholder">
                          <option>Select a Topic</option>
                      </select>
                  </div>
                  <div class="flex flex-col gap-2">
                      <label class="font-sans text-[24px] font-semibold text-black">Your message</label>
                      <textarea class="h-[150px] w-full rounded-[10px] border-2 border-black bg-transparent p-4"></textarea>
                  </div>
                  <button type="button" class="mt-5 h-[60px] w-full rounded-[20px] bg-dark-blue font-roboto text-[32px] font-medium text-button-muted-text transition-opacity hover:opacity-90">
                      Submit
                  </button>
              </form>
          </div>
          
          <!-- Contact Info Side -->
          <div class="flex flex-col gap-10 pt-[150px] pl-[50px]">
              <p class="font-sans text-[24px] font-semibold leading-[29px] text-black">
                  Next Wave Dev<br/>5555 somewhere Way N,<br/>Seattle, WA 99999
              </p>
              <div class="flex flex-col gap-2">
                  <p class="font-sans text-[24px] font-semibold text-black">Email</p>
                  <p class="font-sans text-[24px] font-medium text-black">nextwavedev@gmail.org</p>
              </div>
              <div class="flex flex-col gap-2">
                  <p class="font-sans text-[24px] font-semibold text-black">Phone</p>
                  <p class="font-sans text-[24px] font-medium text-black">555.555.5555</p>
              </div>
          </div>
      </div>
  </section>

</div>

<style is:global>
  @media (min-width: 768px) {
    #mobile-contact { display: none !important; }
    #desktop-contact { display: flex !important; }
  }
  @media (max-width: 767px) {
    #desktop-contact { display: none !important; }
    #mobile-contact { display: flex !important; }
  }
</style>