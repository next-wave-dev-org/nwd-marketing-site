---
import Button from './Button.astro';
export interface Props { title: string; subtitle: string; description?: string; href: string; }
const { title, subtitle, description = "Explore how our tailored digital solutions can help your organization reach its goals.", href } = Astro.props;
const firstLetter = title.charAt(0);
const remainingLetters = title.slice(1);
---
<div class="w-full">
  <!-- UNIFIED RESPONSIVE CARD -->
  <div class="relative flex flex-col w-full max-w-[400px] md:max-w-none md:w-[419.33px] mx-auto md:mx-0 bg-transparent">
    <div class="flex flex-col items-center md:items-start text-center md:text-left">
        
        <div class="flex items-center h-[65px] md:h-[75px] rounded-[50px] border border-black bg-white w-max pr-[25px] md:pr-[35px]">
            <div class="flex h-[64px] w-[64px] md:h-[74px] md:w-[74px] flex-shrink-0 items-center justify-end rounded-full bg-primary-blue pr-[2px]">
                <span class="font-roboto text-[32px] md:text-[40px] font-bold leading-none text-white">{firstLetter}</span>
            </div>
            <span class="font-roboto text-[32px] font-bold leading-tight md:leading-[56px] text-black whitespace-nowrap">{remainingLetters}</span>
        </div>
        
        <p class="mt-[20px] md:mt-[13px] font-roboto text-[20px] md:text-[24px] font-semibold leading-tight md:leading-[28px] text-black w-full md:w-[376.59px]">{subtitle}</p>
        
        <p class="mt-[16px] md:mt-[20px] font-sans text-[18px] md:text-[24px] font-normal leading-relaxed md:leading-[33px] text-black w-full md:w-[376.59px]">{description}</p>
    
    </div>
    
    <div class="flex justify-center md:justify-start w-full mt-6 md:mt-8">
        <Button href={href} label="See More" variant="primary" />
    </div>
  </div>
</div>
