---
import Button from './Button.astro';

export interface Props {
    title: string;
    subtitle: string;
    description?: string;
    href: string;
}

const { 
    title, 
    subtitle, 
    description = "Placeholder text to fill this section. Some more placeholder text to make this look as real as possible even though it is completely fake. Words and more words to fill this section and surprise even more words. Is this even real asdlf asdf asf asdf jglij sdf.",
    href 
} = Astro.props;

const firstLetter = title.charAt(0);
const remainingLetters = title.slice(1);
---

<div class="relative flex flex-col w-[419.33px] h-[563px] justify-between">
    <!-- Top Content Group -->
    <div class="flex flex-col">
        <!-- Pill Header -->
        <div class="flex items-center h-[75px] rounded-[50px] border border-black bg-white w-max pr-[35px]">
            <!-- Grey Circle Badge with first letter forced white -->
            <div class="flex h-[74px] w-[74px] flex-shrink-0 items-center justify-end pr-[6px] rounded-full bg-[#797979]">
                <span style="color: #ffffff !important;" class="font-roboto text-[48px] font-bold leading-none text-white">{firstLetter}</span>
            </div>
            <!-- Remaining Title Text positioned right next to the circle -->
            <span class="font-roboto text-[48px] font-bold leading-[56px] text-black whitespace-nowrap">
                {remainingLetters}
            </span>
        </div>

        <!-- Subtitle -->
        <p class="mt-[13px] font-roboto text-[24px] font-semibold leading-[28px] text-black w-[376.59px]">
            {subtitle}
        </p>

        <!-- Body Description -->
        <p class="mt-[20px] font-sans text-[24px] font-normal leading-[33px] text-black w-[376.59px]">
            {description}
        </p>
    </div>

    <!-- See More Button pinned to the bottom and centered -->
    <div class="flex justify-center w-full">
        <Button href={href} label="See More" variant="secondary" />
    </div>
</div>
