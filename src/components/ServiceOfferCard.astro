---
// src/components/ServiceOfferCard.astro
import Button from './Button.astro';
export interface Props { title: string; subtitle: string; description?: string; href: string; }
const { title, subtitle, description = "Explore how our tailored digital solutions can help your organization reach its goals.", href } = Astro.props;
---
<div class="w-full flex h-full">
  <!-- UNIFIED RESPONSIVE CARD (DARK MODE) -->
  <div class="relative flex flex-col w-full max-w-[400px] md:max-w-none mx-auto md:mx-0 bg-surface border border-border-subtle rounded-[20px] p-6 md:p-8 shadow-xl flex-1 transition-all duration-300 hover:border-[#38C1ED]/40 hover:shadow-[0_0_25px_rgba(56,193,237,0.15)]">
    <div class="flex flex-col items-center md:items-start text-center md:text-left flex-1">
        
        <!-- Title Pill Container (Full Title, No Circle) -->
        <div class="flex items-center h-[65px] md:h-[75px] rounded-[50px] border border-border-subtle bg-background w-max px-6 md:px-8 shadow-md">
            <span class="font-roboto text-[24px] sm:text-[28px] md:text-[32px] font-bold leading-tight md:leading-[56px] text-white whitespace-nowrap">{title}</span>
        </div>
        
        <!-- Subtitle -->
        <p class="mt-[20px] md:mt-[16px] font-roboto text-[20px] md:text-[24px] font-semibold leading-tight md:leading-[28px] text-accent-cyan w-full">{subtitle}</p>
        
        <!-- Description -->
        <p class="mt-[16px] md:mt-[16px] font-sans text-[16px] md:text-[18px] lg:text-[20px] font-normal leading-relaxed text-text-body w-full">{description}</p>
    
    </div>
    
    <!-- Action Button -->
    <div class="flex justify-center md:justify-start w-full mt-6 md:mt-8">
        <Button href={href} label="See More" variant="primary" />
    </div>
  </div>
</div>

