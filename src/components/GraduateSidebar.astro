---
export interface Props {
  location: string;
  education: string;
  image?: string;
  contact?: {
    email?: string;
    phone?: string;
    socials?: { name: string; url: string }[];
  };
}
const { location, education, image, contact } = Astro.props;
---

<aside class="flex w-full flex-col rounded-[10px] border border-secondary-blue/30 bg-gradient-to-b from-light-aqua to-secondary-blue px-6 py-10 shadow-lg md:px-8 md:py-12">
  
  <!-- Dynamic Avatar -->
  <div class="mx-auto flex h-[250px] w-[250px] shrink-0 items-center justify-center rounded-full bg-primary-blue shadow-xl md:h-[320px] md:w-[320px] overflow-hidden">
    {image ? (
      <img src={image} alt="Profile Picture" class="h-full w-full object-cover" />
    ) : (
      <span class="font-sans text-[18px] md:text-[24px] text-white font-semibold">profile pic*</span>
    )}
  </div>

  <!-- Content Sections -->
  <div class="flex flex-col gap-10 md:gap-12 mt-12 md:pl-4">
    
    <!-- Location -->
    <div class="flex flex-col gap-3 items-center md:items-start text-center md:text-left">
      <div class="inline-flex h-[45px] items-center justify-center rounded-full bg-dark-blue px-[32px] font-inter text-[18px] font-medium text-white shadow-md">
        <span>Location</span>
      </div>
      <p class="md:ml-2 font-roboto text-[26px] md:text-[28px] font-bold text-black">{location}</p>
    </div>

    <!-- Education -->
    <div class="flex flex-col gap-3 items-center md:items-start text-center md:text-left">
      <div class="inline-flex h-[45px] items-center justify-center rounded-full bg-dark-blue px-[32px] font-inter text-[18px] font-medium text-white shadow-md">
        <span>Education</span>
      </div>
      <p class="md:ml-2 font-roboto text-[26px] md:text-[28px] font-bold text-black leading-tight w-full">{education}</p>
    </div>

    <!-- Dynamic Contact -->
    {contact && (contact.email || contact.phone || (contact.socials && contact.socials.length > 0)) && (
      <div class="flex flex-col gap-4 items-center md:items-start text-center md:text-left">
        <div class="inline-flex h-[45px] items-center justify-center rounded-full bg-dark-blue px-[32px] font-inter text-[18px] font-medium text-white shadow-md">
          <span>Contact</span>
        </div>
        <div class="md:ml-2 flex flex-col gap-3 mt-2 font-sans text-[20px] md:text-[22px] font-bold text-black">
          {contact.email && <p>{contact.email}</p>}
          {contact.phone && <p>{contact.phone}</p>}
          
          {contact.socials && contact.socials.length > 0 && (
            <div class="flex gap-4 justify-center md:justify-start mt-4">
              {contact.socials.map((social) => {
                const isLinkedIn = social.name.toLowerCase() === 'linkedin';
                const isGithub = social.name.toLowerCase() === 'github';
                
                return (
                  <a href={social.url} target="_blank" rel="noopener noreferrer" class="flex h-[45px] w-[45px] md:h-[50px] md:w-[50px] items-center justify-center rounded-full bg-transparent border-2 border-black transition-transform hover:scale-110 cursor-pointer shrink-0 text-black hover:text-primary-blue hover:border-primary-blue">
                    <span class="sr-only">{social.name}</span>
                    
                    {/* LinkedIn Icon */}
                    {isLinkedIn && (
                      <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg">
                        <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/>
                      </svg>
                    )}

                    {/* GitHub Icon */}
                    {isGithub && (
                      <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg">
                        <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
                      </svg>
                    )}

                    {/* Default Link Icon (if a different social is used) */}
                    {!isLinkedIn && !isGithub && (
                      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"></path><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"></path>
                      </svg>
                    )}
                  </a>
                );
              })}
            </div>
          )}
        </div>
      </div>
    )}
    
  </div>
</aside>