---
export interface Props {
  location: string;
  education: string;
}
const { location, education } = Astro.props;

const contact = {
  email: 'EmailEmail@gmail.com',
  phone: '555-555-5555',
  socials: ['facebook', 'twitter', 'instagram', 'linkedin']
};
---

<!-- Sidebar Container -->
<aside class="flex flex-col w-full rounded-[10px] bg-gradient-to-b from-[#E4F2F5] to-[#509EBF] px-6 md:px-8 py-10 md:py-12 shadow-lg border border-[#509EBF]/30">
  
  <!-- Centered Avatar -->
  <div class="mx-auto flex h-[250px] w-[250px] md:h-[320px] md:w-[320px] shrink-0 items-center justify-center rounded-full bg-[#2244CA] shadow-xl">
    <span class="font-sans text-[18px] md:text-[24px] text-white font-semibold">profile pic*</span>
  </div>

  <!-- Content Sections -->
  <div class="flex flex-col gap-10 md:gap-12 mt-12 md:pl-4">
    
    <!-- Location -->
    <div class="flex flex-col gap-3 items-center md:items-start text-center md:text-left">
      <div class="inline-flex h-[45px] px-[32px] items-center justify-center rounded-full bg-[#131D43] font-inter text-[18px] font-medium shadow-md">
        <span style="color: #FFFFFF !important;">Location</span>
      </div>
      <p class="md:ml-2 font-roboto text-[26px] md:text-[28px] font-bold text-black">{location}</p>
    </div>

    <!-- Education -->
    <div class="flex flex-col gap-3 items-center md:items-start text-center md:text-left">
      <div class="inline-flex h-[45px] px-[32px] items-center justify-center rounded-full bg-[#131D43] font-inter text-[18px] font-medium shadow-md">
        <span style="color: #FFFFFF !important;">Education</span>
      </div>
      <p class="md:ml-2 font-roboto text-[26px] md:text-[28px] font-bold text-black leading-tight w-full">{education}</p>
    </div>

    <!-- Contact -->
    <div class="flex flex-col gap-4 items-center md:items-start text-center md:text-left">
      <div class="inline-flex h-[45px] px-[32px] items-center justify-center rounded-full bg-[#131D43] font-inter text-[18px] font-medium shadow-md">
        <span style="color: #FFFFFF !important;">Contact</span>
      </div>
      <div class="md:ml-2 flex flex-col gap-3 mt-2 font-sans text-[20px] md:text-[22px] font-bold text-black">
        <p>{contact.email}</p>
        <p>{contact.phone}</p>
        <div class="flex gap-4 justify-center md:justify-start mt-4">
          {contact.socials.map(() => (
            <div class="flex h-[45px] w-[45px] md:h-[50px] md:w-[50px] items-center justify-center rounded-full bg-transparent border-2 border-black transition-transform hover:scale-110 cursor-pointer shrink-0">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="black" xmlns="http://www.w3.org/2000/svg"><circle cx="12" cy="12" r="10"/></svg>
            </div>
          ))}
        </div>
      </div>
    </div>
    
  </div>
</aside>