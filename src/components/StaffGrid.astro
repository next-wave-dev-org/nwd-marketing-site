---
// src/components/StaffGrid.astro
import ProfileCard from './ProfileCard.astro';

export interface StaffMember {
  name: string;
  role: string;
  image?: string; 
}

export interface Props {
  staff: StaffMember[];
}

const { staff } = Astro.props;
---

<div class="w-full mt-0 lg:mt-4">
  <!-- Unified Responsive Flex Container -->
  <!-- Mobile: horizontally scrolls, snaps, no wrap, left-aligned -->
  <!-- Desktop (lg): visible overflow, wraps, centered, no snapping -->
  <div class="flex flex-nowrap lg:flex-wrap justify-start lg:justify-center overflow-x-auto lg:overflow-visible snap-x lg:snap-none snap-mandatory gap-6 px-6 lg:px-0 pb-4 lg:pb-0 hide-scrollbars w-full items-stretch">
    {staff.map((member) => (
      <div class="shrink-0 w-[85vw] max-w-[314px] snap-center pt-[48px] lg:pt-0">
         <ProfileCard name={member.name} role={member.role} image={member.image} />
      </div>
    ))}
  </div>
</div>

<style is:global>
  .hide-scrollbars {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
  .hide-scrollbars::-webkit-scrollbar {
    display: none;
  }
</style>