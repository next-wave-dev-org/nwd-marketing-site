---
// src/components/StaffGrid.astro
import ProfileCard from './ProfileCard.astro';

// Added image to the interface so the grid can pass it to the ProfileCard
export interface StaffMember {
  name: string;
  role: string;
  image?: string; 
}

export interface Props {
  staff: StaffMember[];
}

const { staff } = Astro.props;

// Split array into the requested 4-3-4 formation
const row1 = staff.slice(0, 4);
const row2 = staff.slice(4, 7);
const row3 = staff.slice(7, 11);
---

<div class="w-full">
  
  <!-- MOBILE / TABLET (< 1024px) -->
  <div class="mobile-staff-grid carousel-wrapper relative w-full pt-[20px]">
    
    <div class="carousel-container flex overflow-x-auto snap-x snap-mandatory gap-6 px-6 pb-4 hide-scrollbars w-full items-stretch">
      {staff.map((member) => (
        <div class="shrink-0 w-[85vw] max-w-[314px] snap-center pt-[64px]">
           <!-- Passed the image prop down -->
           <ProfileCard name={member.name} role={member.role} image={member.image} />
        </div>
      ))}
    </div>

    <!-- Black Pill Arrows -->
    <div class="flex justify-center mt-2">
      <div class="inline-flex items-center gap-[30px] rounded-[30px] border border-black px-[30px] py-[6px]">
        <button type="button" class="carousel-prev flex h-[50px] w-[50px] items-center justify-center rounded-full bg-black text-[28px] text-card-arrow transition-opacity" aria-label="Scroll left">&#8249;</button>
        <button type="button" class="carousel-next flex h-[50px] w-[50px] items-center justify-center rounded-full bg-black text-[28px] text-card-arrow transition-opacity" aria-label="Scroll right">&#8250;</button>
      </div>
    </div>

  </div>

  <!-- DESKTOP (>= 1024px) -->
  <!-- Strictly enforces the 3 rows: 4 cards, 3 cards, 4 cards -->
  <div class="desktop-staff-grid flex-col w-full items-center gap-[80px]">
    
    <!-- Row 1: 4 Cards -->
    <div class="flex w-full flex-row flex-nowrap justify-center gap-6 xl:gap-[45px]">
      {row1.map((member) => (
        <div class="flex justify-center">
          <!-- Passed the image prop down -->
          <ProfileCard name={member.name} role={member.role} image={member.image} />
        </div>
      ))}
    </div>

    <!-- Row 2: 3 Cards (Centered) -->
    <div class="flex w-full flex-row flex-nowrap justify-center gap-6 xl:gap-[45px]">
      {row2.map((member) => (
        <div class="flex justify-center">
          <ProfileCard name={member.name} role={member.role} image={member.image} />
        </div>
      ))}
    </div>

    <!-- Row 3: 4 Cards -->
    <div class="flex w-full flex-row flex-nowrap justify-center gap-6 xl:gap-[45px]">
      {row3.map((member) => (
        <div class="flex justify-center">
          <ProfileCard name={member.name} role={member.role} image={member.image} />
        </div>
      ))}
    </div>

  </div>

</div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const carousels = document.querySelectorAll('.carousel-wrapper:not(.initialized)');
    carousels.forEach(wrapper => {
      wrapper.classList.add('initialized');
      const container = wrapper.querySelector('.carousel-container') as HTMLElement;
      const prevBtn = wrapper.querySelector('.carousel-prev') as HTMLButtonElement;
      const nextBtn = wrapper.querySelector('.carousel-next') as HTMLButtonElement;

      if (!container || !prevBtn || !nextBtn) return;

      prevBtn.addEventListener('click', () => {
        container.scrollBy({ left: -container.clientWidth * 0.8, behavior: 'smooth' });
      });

      nextBtn.addEventListener('click', () => {
        container.scrollBy({ left: container.clientWidth * 0.8, behavior: 'smooth' });
      });
    });
  });
</script>

<style is:global>
  .hide-scrollbars {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
  .hide-scrollbars::-webkit-scrollbar {
    display: none;
  }

  /* PURE CSS FAILSAFE: Ensures the 4-3-4 layout only applies when there is enough screen width */
  @media (min-width: 1024px) {
    .mobile-staff-grid { display: none !important; }
    .desktop-staff-grid { display: flex !important; }
  }
  @media (max-width: 1023px) {
    .desktop-staff-grid { display: none !important; }
    .mobile-staff-grid { display: block !important; }
  }
</style>