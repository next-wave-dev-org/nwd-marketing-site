---
const roles = [
  {
    title: 'Front-End Developer',
    description: 'Build responsive, accessible user interfaces using modern frameworks like React and Astro, bringing designs to life for our non-profit partners.'
  }, 
  {
    title: 'UI/UX Designer',
    description: 'Create intuitive, user-centric wireframes and high-fidelity prototypes that ensure a seamless digital experience for our clients.'
  }, 
  {
    title: 'Project Manager',
    description: 'Lead cross-functional teams, manage project timelines, and ensure successful delivery of tech solutions from discovery to launch.'
  }, 
  {
    title: 'Marketing Specialist',
    description: 'Develop and execute digital campaigns, optimize SEO, and craft compelling content to amplify the reach of mission-driven organizations.'
  }
];
---
<div class="w-full rounded-[20px] bg-gradient-to-b from-[#16132A] to-[#0F0C20] border border-border-subtle p-6 shadow-xl lg:rounded-[40px] lg:p-12 text-white">

  <!-- UNIFIED RESPONSIVE COMPONENT -->
  <div class="flex flex-col w-full">
    
    <div class="flex w-full flex-col gap-4 md:gap-6 rounded-[20px] md:rounded-[40px] bg-background border border-border-subtle p-6 md:p-[40px] lg:p-[52px] shadow-xl">
      <div class="w-full md:w-max rounded-[15px] md:rounded-[20px] bg-accent-primary p-5 md:px-[40px] md:py-[24px] shadow-md border border-border-subtle">
        <h2 class="m-0 font-roboto text-[28px] md:text-[48px] font-bold text-white">Available Positions</h2>
      </div>
      <div class="w-full md:max-w-[660px] rounded-[15px] md:rounded-[20px] bg-accent-primary p-5 md:px-[40px] md:py-[32px] shadow-md md:ml-[40px] lg:ml-[60px] border border-border-subtle">
        <h3 class="m-0 mb-3 md:mb-[16px] font-roboto text-[22px] md:text-[36px] font-bold text-white">Find your perfect fit</h3>
        <p class="m-0 font-sans text-[16px] md:text-[24px] font-normal leading-relaxed text-[#F4F6FC]">
          Explore our open volunteer positions designed for emerging tech talent. Gain hands-on experience, build your portfolio, and make a real impact on mission-driven projects.
        </p>
      </div>
    </div>
    
    <div class="mt-[60px] md:mt-[80px] md:px-[50px]">
      <h3 class="m-0 mb-[40px] md:mb-[60px] text-center md:text-left font-roboto text-[24px] md:text-[36px] font-bold text-white">Roles we are hiring for</h3>
      <div class="flex flex-col md:grid md:grid-cols-2 gap-10 md:gap-x-[90px] md:gap-y-[80px]">
        {roles.map((role) => (
          <div class="flex flex-col items-center md:items-start text-center md:text-left">
            <div class="mb-4 md:mb-6 inline-flex h-[40px] md:h-[48px] w-max max-w-full items-center justify-center rounded-[10px] bg-accent-primary px-[30px] md:px-[40px] shadow-sm border border-border-subtle">
              <span class="m-0 font-roboto text-[18px] md:text-[24px] font-bold text-white">{role.title}</span>
            </div>
            <p class="m-0 font-sans text-[16px] md:text-[20px] font-normal leading-relaxed text-text-body">{role.description}</p>
          </div>
        ))}
      </div>
    </div>
    
  </div>
</div>