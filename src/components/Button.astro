---
interface Props {
	href: string;
	label: string;
	variant?: 'primary' | 'secondary';
}
const { href, label, variant = 'primary' } = Astro.props;

const baseStyles = "flex h-[49px] min-w-[218px] items-center justify-center rounded-full font-sans text-[20px] md:text-[24px] font-medium transition-transform hover:scale-105 mx-auto md:mx-0 px-8";
const variants = {
	primary: "bg-[#363636] text-[#EEEEEE]",
	secondary: "bg-[#0D0D0D] text-[#E4E4E4]"
};
---

<a href={href} class={`${baseStyles} ${variants[variant]}`}>
	{label}
</a>