---
import Button from './Button.astro';
---
<div class="w-full">
  
  <!-- MOBILE (< 768px) -->
  <section class="mobile-volunteer-banner flex-col overflow-hidden rounded-[10px] bg-gradient-to-b from-[rgba(242,242,242,0.93)] to-[#848484] p-6 gap-8 w-full mx-auto mt-12">
    <div class="flex h-[280px] w-[280px] shrink-0 items-center justify-center rounded-full bg-[#505050] mx-auto mt-4">
      <h2 class="font-heading text-[56px] font-bold leading-none text-[#D8D8D8] drop-shadow-[0_4px_4px_rgba(0,0,0,0.25)] text-center">Want<br/>to<br/>Volunteer</h2>
    </div>
    <div class="flex w-full flex-col text-center mt-4">
      <h3 class="font-roboto text-[28px] font-medium leading-tight text-black">Get involved with the local tech community</h3>
      <p class="mt-4 font-inter text-[18px] font-normal leading-relaxed text-black">Placeholder text here to fill this section to make it look real. This body text is just random fill to fill this section to make things look real for placeholder purposes. Also more words.</p>
    </div>
    <div class="flex w-full flex-col text-center mt-4">
      <h3 class="font-roboto text-[28px] font-semibold leading-tight text-black">Want to gain professional experience?</h3>
      <p class="mt-4 font-inter text-[18px] font-normal leading-relaxed text-black">Placeholder text here to fill this section to make it look real. This body text is just random fill to fill this section to make things look real for placeholder purposes. Also more words.</p>
    </div>
    <div class="flex w-full flex-col text-center mt-4">
      <h3 class="font-roboto text-[28px] font-semibold leading-tight text-black">Connect with other upcoming developers</h3>
      <p class="mt-4 font-inter text-[18px] font-normal leading-relaxed text-black">Placeholder text here to fill this section to make it look real. This body text is just random fill to fill this section to make things look real for placeholder purposes. Also more words.</p>
    </div>
    <div class="flex w-full justify-center mt-6 mb-4">
      <Button href="/volunteering" label="See More" />
    </div>
  </section>

  <!-- DESKTOP (>= 768px) EXACT ORIGINAL CODE -->
  <section class="desktop-volunteer-banner relative mx-auto mt-12 flex h-[900px] w-full max-w-[1289px] flex-col justify-between overflow-hidden rounded-[10px] bg-gradient-to-b from-[rgba(242,242,242,0.93)] to-[#848484] p-[60px]">
    <div class="flex w-full items-start justify-between">
      <div class="flex h-[390px] w-[390px] shrink-0 items-center justify-center rounded-full bg-[#505050]">
        <h2 class="font-heading text-[96px] font-bold leading-none text-[#D8D8D8] drop-shadow-[0_4px_4px_rgba(0,0,0,0.25)] text-center">Want<br/>to<br/>Volunteer</h2>
      </div>
      <div class="flex w-[500px] flex-col pt-4">
        <h3 class="font-roboto text-[36px] font-medium leading-[42px] text-black">Get involved with the local tech community</h3>
        <p class="mt-4 font-inter text-[20px] font-normal leading-[24px] text-black">Placeholder text here to fill this section to make it look real. This body text is just random fill to fill this section to make things look real for placeholder purposes. Also more words.</p>
      </div>
    </div>
    <div class="flex w-full justify-between items-start pb-[40px]">
      <div class="flex w-[504px] flex-col">
        <h3 class="font-roboto text-[36px] font-semibold leading-[42px] text-black">Want to gain professional experience?</h3>
        <p class="mt-4 font-inter text-[20px] font-normal leading-[24px] text-black">Placeholder text here to fill this section to make it look real. This body text is just random fill to fill this section to make things look real for placeholder purposes. Also more words.</p>
      </div>
      <div class="flex w-[504px] flex-col">
        <h3 class="font-roboto text-[36px] font-semibold leading-[42px] text-black">Connect with other upcoming developers</h3>
        <p class="mt-4 font-inter text-[20px] font-normal leading-[24px] text-black">Placeholder text here to fill this section to make it look real. This body text is just random fill to fill this section to make things look real for placeholder purposes. Also more words.</p>
      </div>
    </div>
    <div class="flex w-full justify-end">
      <Button href="/volunteering" label="See More" />
    </div>
  </section>
  
</div>

<style is:global>
  @media (min-width: 768px) { .mobile-volunteer-banner { display: none !important; } .desktop-volunteer-banner { display: flex !important; } }
  @media (max-width: 767px) { .desktop-volunteer-banner { display: none !important; } .mobile-volunteer-banner { display: flex !important; } }
</style>