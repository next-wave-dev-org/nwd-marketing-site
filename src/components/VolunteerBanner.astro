---
import Button from './Button.astro';
---
<div class="w-full">
  <!-- UNIFIED RESPONSIVE BANNER -->
  <section class="relative mx-auto mt-8 md:mt-12 flex w-full max-w-[1289px] flex-col justify-between overflow-hidden rounded-[10px] bg-gradient-to-b from-light-aqua to-secondary-blue p-6 md:p-[60px] shadow-md md:shadow-lg gap-8 md:gap-0">
    
    <div class="flex flex-col md:flex-row w-full items-center md:items-start justify-between gap-6 md:gap-0">
      <div class="flex h-[150px] w-[150px] md:h-[390px] md:w-[390px] shrink-0 items-center justify-center rounded-full bg-primary-blue shadow-md md:shadow-lg mx-auto md:mx-0 p-2 md:p-8">
        <h2 class="w-full text-center font-heading text-[18px] sm:text-[20px] md:text-[48px] lg:text-[52px] font-bold leading-tight text-hero-text drop-shadow-sm md:drop-shadow-card [text-shadow:-1px_-1px_0_#D49A1D,_1px_-1px_0_#D49A1D,_-1px_1px_0_#D49A1D,_1px_1px_0_#D49A1D] break-words">
          Want<br/>to<br/>Volunteer
        </h2>
      </div>
      <div class="flex w-full md:w-[500px] flex-col pt-0 md:pt-4 text-center md:text-left">
        <h3 class="font-roboto text-[22px] md:text-[36px] font-bold md:font-semibold leading-tight md:leading-[42px] text-black">Get involved with the local tech community</h3>
        <p class="mt-3 md:mt-4 font-sans text-[15px] md:text-[20px] font-normal leading-relaxed md:leading-[24px] text-black">Join a vibrant network of tech professionals, students, and mentors. We bridge the gap between emerging local talent and mission-driven organizations that need scalable digital solutions.</p>
      </div>
    </div>
    
    <div class="flex flex-col md:flex-row w-full justify-between items-center md:items-start pb-0 md:pb-[40px] text-center md:text-left gap-6 md:gap-0 mt-2 md:mt-0">
      <div class="flex w-full md:w-[504px] flex-col">
        <h3 class="font-roboto text-[20px] md:text-[36px] font-bold md:font-semibold leading-tight md:leading-[42px] text-black">Want to gain professional experience?</h3>
        <p class="mt-2 md:mt-4 font-sans text-[15px] md:text-[20px] font-normal leading-relaxed md:leading-[24px] text-black">Work on real-world client projects under the guidance of experienced professionals. You'll build a strong portfolio, learn industry-standard workflows, and develop the skills employers actively look for.</p>
      </div>
      <div class="flex w-full md:w-[504px] flex-col">
        <h3 class="font-roboto text-[20px] md:text-[36px] font-bold md:font-semibold leading-tight md:leading-[42px] text-black">Connect with other upcoming developers</h3>
        <p class="mt-2 md:mt-4 font-sans text-[15px] md:text-[20px] font-normal leading-relaxed md:leading-[24px] text-black">Collaborate closely with peers who share your passion for technology and social impact. Grow your technical abilities in a supportive team environment while making a tangible difference.</p>
      </div>
    </div>
    
    <div class="flex w-full justify-center md:justify-end mt-2 md:mt-0 mb-2 md:mb-0">
      <Button href="/volunteering" label="See More" />
    </div>
    
  </section>
</div>