---
import Button from './Button.astro';
---
<div class="w-full">
  
  <!-- MOBILE (< 768px) -->
  <section class="mobile-volunteer-banner mx-auto mt-12 w-full flex-col gap-8 overflow-hidden rounded-[10px] bg-gradient-to-b from-light-aqua to-secondary-blue p-6">
    <div class="mx-auto mt-4 flex h-[280px] w-[280px] shrink-0 items-center justify-center rounded-full bg-primary-blue">
      <h2 class="font-heading text-[40px] font-bold leading-none text-hero-text drop-shadow-card text-center">Want<br/>to<br/>Volunteer</h2>
    </div>
    <div class="flex w-full flex-col text-center mt-4">
      <!-- Updated to font-semibold to match others -->
      <h3 class="font-roboto text-[28px] font-semibold leading-tight text-black">Get involved with the local tech community</h3>
      <p class="mt-4 font-sans text-[18px] font-normal leading-relaxed text-black">Join a vibrant network of tech professionals, students, and mentors. We bridge the gap between emerging local talent and mission-driven organizations that need scalable digital solutions.</p>
    </div>
    <div class="flex w-full flex-col text-center mt-4">
      <h3 class="font-roboto text-[28px] font-semibold leading-tight text-black">Want to gain professional experience?</h3>
      <p class="mt-4 font-sans text-[18px] font-normal leading-relaxed text-black">Work on real-world client projects under the guidance of experienced professionals. You'll build a strong portfolio, learn industry-standard workflows, and develop the skills employers actively look for.</p>
    </div>
    <div class="flex w-full flex-col text-center mt-4">
      <h3 class="font-roboto text-[28px] font-semibold leading-tight text-black">Connect with other upcoming developers</h3>
      <p class="mt-4 font-sans text-[18px] font-normal leading-relaxed text-black">Collaborate closely with peers who share your passion for technology and social impact. Grow your technical abilities in a supportive team environment while making a tangible difference.</p>
    </div>
    <div class="flex w-full justify-center mt-6 mb-4">
      <Button href="/volunteering" label="See More" />
    </div>
  </section>

  <!-- DESKTOP (>= 768px) -->
  <section class="desktop-volunteer-banner relative mx-auto mt-12 flex h-[900px] w-full max-w-[1289px] flex-col justify-between overflow-hidden rounded-[10px] bg-gradient-to-b from-light-aqua to-secondary-blue p-[60px]">
    <div class="flex w-full items-start justify-between">
      <div class="flex h-[390px] w-[390px] shrink-0 items-center justify-center rounded-full bg-primary-blue">
        <h2 class="font-heading text-[60px] font-bold leading-none text-hero-text drop-shadow-card text-center">Want<br/>to<br/>Volunteer</h2>
      </div>
      <div class="flex w-[500px] flex-col pt-4">
        <!-- Updated to font-semibold to match others -->
        <h3 class="font-roboto text-[36px] font-semibold leading-[42px] text-black">Get involved with the local tech community</h3>
        <p class="mt-4 font-sans text-[20px] font-normal leading-[24px] text-black">Join a vibrant network of tech professionals, students, and mentors. We bridge the gap between emerging local talent and mission-driven organizations that need scalable digital solutions.</p>
      </div>
    </div>
    <div class="flex w-full justify-between items-start pb-[40px]">
      <div class="flex w-[504px] flex-col">
        <h3 class="font-roboto text-[36px] font-semibold leading-[42px] text-black">Want to gain professional experience?</h3>
        <p class="mt-4 font-sans text-[20px] font-normal leading-[24px] text-black">Work on real-world client projects under the guidance of experienced professionals. You'll build a strong portfolio, learn industry-standard workflows, and develop the skills employers actively look for.</p>
      </div>
      <div class="flex w-[504px] flex-col">
        <h3 class="font-roboto text-[36px] font-semibold leading-[42px] text-black">Connect with other upcoming developers</h3>
        <p class="mt-4 font-sans text-[20px] font-normal leading-[24px] text-black">Collaborate closely with peers who share your passion for technology and social impact. Grow your technical abilities in a supportive team environment while making a tangible difference.</p>
      </div>
    </div>
    <div class="flex w-full justify-end">
      <Button href="/volunteering" label="See More" />
    </div>
  </section>
  
</div>

<style is:global>
  @media (min-width: 768px) { .mobile-volunteer-banner { display: none !important; } .desktop-volunteer-banner { display: flex !important; } }
  @media (max-width: 767px) { .desktop-volunteer-banner { display: none !important; } .mobile-volunteer-banner { display: flex !important; } }
</style>