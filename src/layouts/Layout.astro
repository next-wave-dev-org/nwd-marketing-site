---
import '../styles/global.css';
import SiteHeader from '../components/SiteHeader.astro';
import Footer from '../components/Footer.astro';
import SEO from '../components/SEO.astro';

interface Props {
	title?: string;
	description?: string;
	image?: string;
	ogType?: 'website' | 'article';
}

const {
	title = 'Next Wave Dev',
	description = 'Next Wave Dev builds modern, mission-driven websites and campaigns that help organizations grow their impact.',
	image = '/next-wave-dev-logo.png',
	ogType = 'website'
} = Astro.props;
---
<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
        <!-- 🚨 Added initial-scale=1.0 so mobile breakpoints trigger correctly 🚨 -->
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Open+Sans:wght@400&family=Roboto:wght@500&family=Unbounded:wght@700&display=swap" rel="stylesheet">
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<SEO title={title} description={description} image={image} type={ogType} />
	</head>
    <!-- 🚨 Added overflow-x-hidden to prevent 1440px elements from causing side-scrolling on smaller laptops 🚨 -->
	<body class="bg-white text-black overflow-x-hidden">
		<SiteHeader />
		<main class="min-h-screen pt-24">
			<slot />
		</main>
		<Footer />
	</body>
</html>
