---
import '../styles/global.css';
import SiteHeader from '../components/SiteHeader.astro';
import Footer from '../components/Footer.astro';
import SEO from '../components/SEO.astro';

interface Props {
	title?: string;
	description?: string;
	image?: string;
	ogType?: 'website' | 'article';
}

const {
	title = 'Next Wave Dev',
	description = 'Next Wave Dev builds modern, mission-driven websites and campaigns that help organizations grow their impact.',
	image = '/nwd-transparent.png',
	ogType = 'website'
} = Astro.props;
---
<!doctype html>
<!-- Replaced hardcoded white/black with semantic dark tokens globally -->
<html lang="en" class="bg-background text-text-body antialiased">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Open+Sans:wght@400&family=Roboto:wght@500&family=Unbounded:wght@700&display=swap" rel="stylesheet">
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<SEO title={title} description={description} image={image} type={ogType} />
	</head>
	
	<body class="overflow-x-hidden relative min-h-screen flex flex-col">
		
		<!-- Accessibility: Skip to Content Link (Updated Z-Index) -->
		<a href="#main-content" class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-50 focus:px-6 focus:py-3 focus:bg-accent-primary focus:text-text-heading focus:font-bold focus:rounded-panel focus:outline-none focus:ring-4 focus:ring-accent-cyan/50 shadow-xl">
			Skip to main content
		</a>

		<SiteHeader />
		
		<!-- Main Content Wrapper -->
		<main id="main-content" class="flex-grow w-full pt-0 outline-none">
			<slot />
		</main>
		
		<Footer />
	</body>
</html>
