---
import Layout from './Layout.astro';
import ContactSection from '../components/ContactSection.astro';
import type { ServicePageProps } from '../types/service-page';

interface Props extends ServicePageProps {
  pageTitle?: string;
  pageDescription?: string;
}

const {
  heroBadgeTitle,
  heroTitle,
  heroSubtitle,
  steps,
  pageTitle = `${heroTitle} | Next Wave Dev`,
  pageDescription = heroSubtitle,
} = Astro.props;

const otherServices = [
  {
    title: 'Front-End',
    subtitle: 'We do the marketing and competitive auditing on your behalf.',
    description:
      'Placeholder text to fill this section. Some more placeholder text to make this look as real as possible even though it is completely fake.',
    href: '/services/front-end',
  },
  {
    title: 'Back-End',
    subtitle: 'We do the marketing and competitive auditing on your behalf.',
    description:
      'Placeholder text to fill this section. Some more placeholder text to make this look as real as possible even though it is completely fake.',
    href: '/services/back-end',
  },
  {
    title: 'Quality Testing',
    subtitle: 'We do the marketing and competitive auditing on your behalf.',
    description:
      'Placeholder text to fill this section. Some more placeholder text to make this look as real as possible even though it is completely fake.',
    href: '/services/quality-testing',
  },
];
---

<Layout title={pageTitle} description={pageDescription}>
  <div class="mx-auto w-full max-w-[1440px] bg-[#E4F2F5] px-5 pb-16 pt-10 text-black md:px-8 md:pb-24 md:pt-12">
    <section class="mx-auto w-full max-w-[1202px]">
      <div class="grid grid-cols-[186px_1fr] items-center gap-6 md:grid-cols-[529px_1fr] md:gap-[128px]">
        <div class="relative h-[220px] w-[186px] overflow-hidden rounded-[10px] bg-gradient-to-b from-[#E4F2F5] to-[#509EBF] md:h-[560px] md:w-full">
          <div class="absolute left-1/2 top-1/2 h-[160px] w-[160px] -translate-x-1/2 -translate-y-1/2 rounded-full bg-[#2244CA] md:h-[420px] md:w-[420px]"></div>
          <h1 class="absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 font-unbounded text-[30px] font-bold leading-none drop-shadow-[0_4px_4px_rgba(0,0,0,0.25)] md:text-[72px] text-center" style="color: #FFFFFF !important;" set:html={heroBadgeTitle} />
        </div>
        <div class="max-w-[600px] pl-4 pr-1 md:max-w-[440px] md:translate-x-[130px] md:pl-0 md:pr-0">
          <h2 class="font-roboto text-[26px] font-medium leading-tight md:text-[56px] md:leading-[64px]">{heroTitle}</h2>
          <p class="mt-3 font-open-sans text-[13px] leading-[1.4] md:mt-4 md:text-[20px] md:leading-[27px]">{heroSubtitle}</p>
        </div>
      </div>
    </section>

    <section class="mx-auto mt-12 flex w-full max-w-[1328px] flex-col gap-16 md:mt-14 md:gap-[72px]">
      {steps.map((step, stepIndex) => (
        <article>
          <div class="relative rounded-[10px] bg-[#131D43] px-4 pb-4 pt-5 md:px-[28px] md:pb-[32px] md:pt-[12px]">
            <div class="absolute -left-[14px] -top-[18px] flex h-[86px] w-[86px] items-center justify-center rounded-full bg-[#2244CA] md:-left-[25px] md:-top-[12px] md:h-[224px] md:w-[224px]">
              <span class="font-inter text-[60px] font-bold leading-none md:text-[128px]" style="color: #FFFFFF !important;">{stepIndex + 1}</span>
            </div>

            <div class="ml-[44px] rounded-[18px] bg-[#2244CA] px-5 py-3 md:ml-[150px] md:w-fit md:rounded-[40px] md:px-[106px] md:py-[38px]">
              <h2
                class="pl-[26px] font-roboto text-[27px] font-medium leading-tight !text-white md:pl-[12px] md:text-[48px] md:leading-[56px]"
                style="color: #FFFFFF !important;"
              >
                {step.title}
              </h2>
            </div>

            <div class="ml-[44px] mt-5 max-w-[600px] rounded-[12px] bg-[#2244CA] px-5 py-4 shadow-[0_4px_4px_rgba(0,0,0,0.25)] md:ml-[182px] md:mt-4 md:h-[264px] md:w-[600px] md:rounded-[20px] md:px-[44px] md:py-[21px]">
              <h3
                class="font-roboto text-[28px] font-medium !text-white md:text-[36px] md:leading-[42px]"
                style="color: #FFFFFF !important;"
              >
                {step.summary.title}
              </h3>
              <p
                class="mt-3 font-open-sans text-[16px] leading-[1.45] !text-white md:text-[20px] md:leading-[27px]"
                style="color: #FFFFFF !important;"
              >
                {step.summary.description}
              </p>
            </div>
          </div>

          <h3 class="mt-7 font-roboto text-[30px] font-medium leading-tight md:mt-[70px] md:text-[36px] md:leading-[42px]">
            Placeholder Deliverables
          </h3>
          <ul class="mt-5 m-0 list-none grid grid-cols-2 gap-x-[24px] gap-y-8 p-0 md:mt-[18px] md:gap-x-[90px] md:gap-y-[48px]">
            {step.deliverables.map((deliverable) => (
              <li class="max-w-[470px]">
                <h4
                  class="inline-flex min-h-[56px] w-full items-center rounded-[8px] bg-[#2244CA] px-5 py-3 font-roboto text-[22px] font-medium leading-tight !text-white md:min-h-[64px] md:min-w-[320px] md:w-auto md:px-7 md:py-3 md:text-[24px] md:leading-[28px]"
                  style="color: #FFFFFF !important;"
                >
                  {deliverable.title}
                </h4>
                <p class="mt-3 rounded-[10px] bg-white p-4 font-inter text-[16px] leading-[1.4] text-black md:p-5 md:text-[20px] md:leading-[24px]">
                  {deliverable.description}
                </p>
              </li>
            ))}
          </ul>
        </article>
      ))}
    </section>

    <section class="mx-auto mt-20 w-full max-w-[1302px] md:mt-24">
      <h2 class="font-roboto text-[42px] font-bold leading-tight md:text-[64px] md:leading-[75px]">Other Services we offer</h2>

      <div id="other-services-mobile-track" class="mt-8 flex snap-x snap-mandatory gap-6 overflow-x-auto pb-2">
        {otherServices.map((service) => (
          <article class="w-full max-w-none flex-shrink-0 snap-start">
            <div class="inline-flex w-full flex-nowrap items-center rounded-[50px] border border-black pr-6">
              <div class="flex h-[64px] w-[64px] items-center justify-center rounded-full bg-[#2244CA]">
                <span class="font-roboto text-[40px] font-bold leading-none text-[#FEFEFE]">{service.title.charAt(0)}</span>
              </div>
              <h3 class="ml-3 whitespace-nowrap font-roboto text-[40px] font-bold leading-none">{service.title.slice(1)}</h3>
            </div>

            <p class="mt-6 font-roboto text-[22px] font-semibold leading-[1.25]">{service.subtitle}</p>
            <p class="mt-4 font-open-sans text-[22px] leading-[1.4]">{service.description}</p>

            <a
              href={service.href}
              class="mt-6 inline-flex w-full justify-center rounded-[30px] bg-[#131D43] px-10 py-[10px] font-inter text-[24px] font-medium text-[#E4E4E4]"
            >
              See More
            </a>
          </article>
        ))}
      </div>

      <div id="other-services-mobile-arrows" class="mt-3 flex justify-center">
        <div class="inline-flex items-center gap-[42px] rounded-[30px] border border-black px-[42px] py-[6px]">
          <button
            type="button"
            class="service-carousel-prev inline-flex h-[70px] w-[70px] items-center justify-center rounded-full !bg-black text-[40px] text-[#E9E9E9]"
            aria-label="Show previous services"
          >
            &#8249;
          </button>
          <button
            type="button"
            class="service-carousel-next inline-flex h-[70px] w-[70px] items-center justify-center rounded-full !bg-black text-[40px] text-[#E9E9E9]"
            aria-label="Show next services"
          >
            &#8250;
          </button>
        </div>
      </div>

      <div id="other-services-desktop" class="mt-[60px] px-[12px]">
        <div id="other-services-desktop-grid" class="grid grid-cols-3 gap-[45px]">
          {otherServices.map((service) => (
            <article class="flex min-h-[620px] flex-col">
              <div class="inline-flex w-full flex-nowrap items-center rounded-[50px] border border-black pr-12">
                <div class="flex h-[74px] w-[74px] items-center justify-center rounded-full bg-[#2244CA]">
                  <span class="font-roboto text-[48px] font-bold leading-none text-[#FEFEFE]">{service.title.charAt(0)}</span>
                </div>
                <h3 class="ml-3 whitespace-nowrap font-roboto text-[48px] font-bold leading-none text-black">{service.title.slice(1)}</h3>
              </div>

              <p class="mt-8 font-roboto text-[24px] font-semibold leading-[28px] text-black">{service.subtitle}</p>
              <p class="mt-5 font-open-sans text-[24px] leading-[33px] text-black">{service.description}</p>

              <a
                href={service.href}
                class="mt-6 mx-auto inline-flex min-w-[280px] justify-center rounded-[30px] bg-[#131D43] px-10 py-[10px] font-inter text-[24px] font-medium text-[#E4E4E4]"
              >
                See More
              </a>
            </article>
          ))}
        </div>

        <div class="mt-1 flex w-full justify-center md:translate-x-[32px]">
          <div class="inline-flex items-center gap-[42px] rounded-[30px] border border-black px-[42px] py-[6px]">
            <button
              type="button"
              class="service-carousel-prev inline-flex h-[70px] w-[70px] items-center justify-center rounded-full !bg-black text-[40px] text-[#E9E9E9]"
              aria-label="Show previous services"
            >
              &#8249;
            </button>
            <button
              type="button"
              class="service-carousel-next inline-flex h-[70px] w-[70px] items-center justify-center rounded-full !bg-black text-[40px] text-[#E9E9E9]"
              aria-label="Show next services"
            >
              &#8250;
            </button>
          </div>
        </div>
      </div>
    </section>

    <section class="mx-auto mt-16 w-full max-w-[1125px] md:mt-20">
      <ContactSection />
    </section>
  </div>
</Layout>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const track = document.getElementById('other-services-mobile-track');
    const prevButton = document.querySelector('.service-carousel-prev');
    const nextButton = document.querySelector('.service-carousel-next');
    if (!track || !prevButton || !nextButton) return;

    const slideBy = () => track.clientWidth + 24;

    prevButton.addEventListener('click', () => {
      track.scrollBy({ left: -slideBy(), behavior: 'smooth' });
    });

    nextButton.addEventListener('click', () => {
      track.scrollBy({ left: slideBy(), behavior: 'smooth' });
    });
  });
</script>

<style is:global>
  @media (max-width: 767px) {
    #other-services-desktop {
      display: none !important;
    }
    #other-services-mobile-track,
    #other-services-mobile-arrows {
      display: flex !important;
    }
  }

  @media (min-width: 768px) {
    #other-services-mobile-track,
    #other-services-mobile-arrows {
      display: none !important;
    }
    #other-services-desktop {
      display: block !important;
    }
    #other-services-desktop-grid {
      display: grid !important;
      grid-template-columns: repeat(3, minmax(0, 1fr)) !important;
    }
  }
</style>
