---
import Layout from './Layout.astro';
import ContactSection from '../components/ContactSection.astro';
import ServiceOfferCard from '../components/ServiceOfferCard.astro';
import type { ServicePageProps } from '../types/service-page';

interface Props extends ServicePageProps {
  pageTitle?: string;
  pageDescription?: string;
}

const {
  heroBadgeTitle,
  heroTitle,
  heroSubtitle,
  steps,
  pageTitle = `${heroTitle} | Next Wave Dev`,
  pageDescription = heroSubtitle,
} = Astro.props;

const allServices = [
  { title: 'Research', subtitle: 'Technical Discovery', description: 'We audit your competitors, research your customers, and build a technical roadmap to set your project up for success.', href: '/services/research' },
  { title: 'Design', subtitle: 'User Experience (UX/UI)', description: 'We craft intuitive, user-friendly digital interfaces tailored to your organization\'s brand and audience needs.', href: '/services/design' },
  { title: 'Front-End', subtitle: 'Web & App Development', description: 'We develop responsive, accessible websites and custom web applications using modern frameworks.', href: '/services/front-end' },
  { title: 'Back-End', subtitle: 'Database & APIs', description: 'We build secure, scalable database architectures and server-side logic to power your digital operations.', href: '/services/back-end' },
  { title: 'Quality Assurance', subtitle: 'Testing & Maintenance', description: 'We rigorously test your software across devices to ensure ongoing reliability, security, and performance.', href: '/services/quality-assurance' },
  { title: 'Marketing', subtitle: 'Digital Campaigns', description: 'We create and execute targeted digital campaigns to amplify your mission and grow your audience.', href: '/services/marketing' }
];

const currentPath = Astro.url.pathname;
const filteredServices = allServices.filter(service => !currentPath.includes(service.href));
---

<Layout title={pageTitle} description={pageDescription}>
  <div class="mx-auto w-full max-w-[1440px] bg-light-aqua px-5 pb-16 pt-10 text-black md:px-8 md:pb-24 md:pt-12">
    
    <!-- Hero Section -->
    <section class="mx-auto w-full max-w-[1289px] px-5 md:px-0">
      
      <!-- MOBILE (< 768px) VERTICAL STACK FIX -->
      <div class="w-full rounded-[10px] bg-gradient-to-b from-light-aqua to-secondary-blue p-6 shadow-md mt-4 md:hidden">
        <div class="flex flex-col items-center text-center gap-6 w-full">
          <div class="flex h-[150px] w-[150px] shrink-0 items-center justify-center rounded-full bg-primary-blue shadow-md mx-auto p-2">
            <h1 class="font-heading text-[16px] sm:text-[18px] font-bold leading-tight text-hero-text text-center drop-shadow-sm [text-shadow:-1px_-1px_0_#D49A1D,_1px_-1px_0_#D49A1D,_-1px_1px_0_#D49A1D,_1px_1px_0_#D49A1D] break-words" set:html={heroBadgeTitle} />
          </div>
          <div class="flex flex-col gap-3 w-full">
            <h2 class="font-roboto text-[22px] font-bold leading-tight text-black break-words">{heroTitle}</h2>
            <p class="font-sans text-[15px] font-normal leading-relaxed text-black">{heroSubtitle}</p>
          </div>
        </div>
      </div>

      <!-- DESKTOP (>= 768px) Standardized Layout -->
      <div class="hidden md:flex mx-auto w-full flex-col overflow-hidden rounded-[10px] bg-gradient-to-b from-light-aqua to-secondary-blue shadow-lg">
        <section class="relative flex h-[489px] w-full items-center">
          <div class="absolute left-[47px] top-[19px] z-10 flex h-[390px] w-[390px] items-center justify-center rounded-full bg-primary-blue shadow-lg p-6">
            <h1 class="w-full text-center font-heading text-[42px] lg:text-[48px] font-bold leading-[1.1] text-hero-text drop-shadow-card [text-shadow:-3px_-3px_0_#D49A1D,_3px_-3px_0_#D49A1D,_-3px_3px_0_#D49A1D,_3px_3px_0_#D49A1D] break-words" set:html={heroBadgeTitle} />
          </div>
          <div class="absolute left-[470px] flex w-[650px] flex-col gap-4 text-left z-10 pr-8">
            <h2 class="m-0 font-roboto text-[48px] lg:text-[56px] font-bold leading-[1.1] text-black break-words">{heroTitle}</h2>
            <p class="m-0 font-sans text-[24px] font-normal leading-[33px] text-black">{heroSubtitle}</p>
          </div>
        </section>
      </div>
      
    </section>

    <!-- Phase Steps Section -->
    <section class="mx-auto mt-12 flex w-full max-w-[1328px] flex-col gap-16 md:mt-14 md:gap-[72px]">
      {steps.map((step, stepIndex) => (
        <article>
          <div class="relative rounded-[10px] bg-dark-blue px-4 pb-4 pt-5 md:px-[28px] md:pb-[32px] md:pt-[12px]">
            <div class="absolute -left-[14px] -top-[18px] flex h-[86px] w-[86px] items-center justify-center rounded-full bg-primary-blue md:-left-[25px] md:-top-[12px] md:h-[224px] md:w-[224px]">
              <span class="font-inter text-[60px] font-bold leading-none text-hero-text md:text-[128px]">{stepIndex + 1}</span>
            </div>

            <div class="ml-[44px] rounded-[18px] bg-primary-blue px-5 py-3 md:ml-[150px] md:w-fit md:rounded-[40px] md:px-[106px] md:py-[38px]">
              <h2 class="pl-[26px] font-roboto text-[27px] font-bold leading-tight !text-hero-text md:pl-[12px] md:text-[48px] md:leading-[56px]">
                {step.title}
              </h2>
            </div>

            <div class="ml-[44px] mt-5 max-w-[600px] rounded-[12px] bg-primary-blue px-5 py-4 shadow-[0_4px_4px_rgba(0,0,0,0.25)] md:ml-[182px] md:mt-4 md:h-[264px] md:w-[600px] md:rounded-[20px] md:px-[44px] md:py-[21px]">
              <h3 class="font-roboto text-[28px] font-bold !text-hero-text md:text-[36px] md:leading-[42px]">
                {step.summary.title}
              </h3>
              <p class="mt-3 font-sans text-[16px] font-normal leading-relaxed !text-hero-text md:text-[20px] md:leading-[27px]">
                {step.summary.description}
              </p>
            </div>
          </div>

          <h3 class="mt-7 font-roboto text-[30px] font-bold leading-tight text-black md:mt-[70px] md:text-[40px] md:leading-[48px]">
            Key Deliverables
          </h3>
          <ul class="mt-5 m-0 list-none grid grid-cols-1 gap-x-[24px] gap-y-8 p-0 md:grid-cols-2 md:mt-[18px] md:gap-x-[90px] md:gap-y-[48px]">
            {step.deliverables.map((deliverable) => (
              <li class="max-w-[470px]">
                <h4 class="inline-flex min-h-[56px] w-full items-center rounded-[8px] bg-primary-blue px-5 py-3 font-roboto text-[22px] font-bold leading-tight !text-hero-text md:min-h-[64px] md:min-w-[320px] md:w-auto md:px-7 md:py-3 md:text-[24px] md:leading-[28px]">
                  {deliverable.title}
                </h4>
                <p class="mt-3 rounded-[10px] bg-white p-4 font-sans text-[16px] font-normal leading-relaxed text-black md:p-5 md:text-[20px] md:leading-[27px] shadow-sm">
                  {deliverable.description}
                </p>
              </li>
            ))}
          </ul>
        </article>
      ))}
    </section>

    <!-- Other Services Carousel -->
    <section class="mx-auto mt-20 w-full max-w-[1302px] md:mt-24">
      <h2 class="font-roboto text-[42px] font-bold leading-tight text-black md:text-[64px] md:leading-[75px] px-6 md:px-0">
        Other Services we offer
      </h2>

      <div class="carousel-wrapper relative w-full mt-8">
        <div class="carousel-container flex overflow-x-auto snap-x snap-mandatory gap-6 px-6 md:px-0 pb-4 hide-scrollbars w-full items-stretch">
          {filteredServices.map((service) => (
            <div class="shrink-0 w-[85vw] max-w-[400px] md:max-w-none md:w-auto snap-center flex">
              <ServiceOfferCard
                title={service.title}
                subtitle={service.subtitle}
                description={service.description}
                href={service.href}
              />
            </div>
          ))}
        </div>

        <div class="flex justify-center mt-6">
          <div class="inline-flex items-center gap-[30px] md:gap-[42px] rounded-[30px] border border-black px-[30px] md:px-[42px] py-[6px]">
            <button type="button" class="carousel-prev inline-flex h-[50px] w-[50px] md:h-[70px] md:w-[70px] items-center justify-center rounded-full bg-black text-[28px] md:text-[40px] text-card-arrow transition-opacity">&#8249;</button>
            <button type="button" class="carousel-next inline-flex h-[50px] w-[50px] md:h-[70px] md:w-[70px] items-center justify-center rounded-full bg-black text-[28px] md:text-[40px] text-card-arrow transition-opacity">&#8250;</button>
          </div>
        </div>
      </div>
    </section>

    <!-- Contact Form -->
    <section class="mx-auto mt-16 w-full max-w-[1125px] md:mt-20">
      <ContactSection />
    </section>
    
  </div>
</Layout>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const carousels = document.querySelectorAll('.carousel-wrapper:not(.initialized)');
    carousels.forEach(wrapper => {
      wrapper.classList.add('initialized');
      const container = wrapper.querySelector('.carousel-container');
      const prevBtn = wrapper.querySelector('.carousel-prev');
      const nextBtn = wrapper.querySelector('.carousel-next');

      if (!container || !prevBtn || !nextBtn) return;

      prevBtn.addEventListener('click', () => { container.scrollBy({ left: -container.clientWidth * 0.8, behavior: 'smooth' }); });
      nextBtn.addEventListener('click', () => { container.scrollBy({ left: container.clientWidth * 0.8, behavior: 'smooth' }); });
    });
  });
</script>

<style is:global>
  .hide-scrollbars {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
  .hide-scrollbars::-webkit-scrollbar {
    display: none;
  }
</style>
