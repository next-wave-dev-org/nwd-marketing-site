---
import Layout from './Layout.astro';
import ContactSection from '../components/ContactSection.astro';
import ServiceOfferCard from '../components/ServiceOfferCard.astro';
import type { ServicePageProps } from '../types/service-page';

interface Props extends ServicePageProps {
  pageTitle?: string;
  pageDescription?: string;
}

const {
  heroBadgeTitle,
  heroTitle,
  heroSubtitle,
  steps,
  pageTitle = `${heroTitle} | Next Wave Dev`,
  pageDescription = heroSubtitle,
} = Astro.props;

// Complete list of all 6 services
const allServices = [
  {
    title: 'Research',
    subtitle: 'We do the marketing and competitive auditing on your behalf.',
    description: 'Placeholder text to fill this section. Some more placeholder text to make this look as real as possible even though it is completely fake.',
    href: '/services/research',
  },
  {
    title: 'Design',
    subtitle: 'We do the marketing and competitive auditing on your behalf.',
    description: 'Placeholder text to fill this section. Some more placeholder text to make this look as real as possible even though it is completely fake.',
    href: '/services/design',
  },
  {
    title: 'Front-End',
    subtitle: 'We do the marketing and competitive auditing on your behalf.',
    description: 'Placeholder text to fill this section. Some more placeholder text to make this look as real as possible even though it is completely fake.',
    href: '/services/front-end',
  },
  {
    title: 'Back-End',
    subtitle: 'We do the marketing and competitive auditing on your behalf.',
    description: 'Placeholder text to fill this section. Some more placeholder text to make this look as real as possible even though it is completely fake.',
    href: '/services/back-end',
  },
  {
    title: 'Quality Testing',
    subtitle: 'We do the marketing and competitive auditing on your behalf.',
    description: 'Placeholder text to fill this section. Some more placeholder text to make this look as real as possible even though it is completely fake.',
    href: '/services/quality-testing',
  },
  {
    title: 'Marketing',
    subtitle: 'We do the marketing and competitive auditing on your behalf.',
    description: 'Placeholder text to fill this section. Some more placeholder text to make this look as real as possible even though it is completely fake.',
    href: '/services/marketing',
  }
];

// Grab the current page URL (e.g., "/services/front-end")
const currentPath = Astro.url.pathname;

// Dynamically filter out the service if its href matches the current URL
const filteredServices = allServices.filter(service => !currentPath.includes(service.href));
---

<Layout title={pageTitle} description={pageDescription}>
  <div class="mx-auto w-full max-w-[1440px] bg-light-aqua px-5 pb-16 pt-10 text-black md:px-8 md:pb-24 md:pt-12">
    
    <!-- Hero Section -->
    <section class="mx-auto w-full max-w-[1202px]">
      <div class="grid grid-cols-[186px_1fr] items-center gap-6 md:grid-cols-[529px_1fr] md:gap-[128px]">
        <div class="relative h-[220px] w-[186px] overflow-hidden rounded-[10px] bg-gradient-to-b from-light-aqua to-secondary-blue md:h-[560px] md:w-full">
          <div class="absolute left-1/2 top-1/2 h-[160px] w-[160px] -translate-x-1/2 -translate-y-1/2 rounded-full bg-primary-blue md:h-[420px] md:w-[420px]"></div>
          <!-- Updated font to match global badges: font-heading text-hero-text -->
          <h1 class="absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 text-center font-heading text-[32px] font-bold leading-none text-hero-text drop-shadow-[0_4px_4px_rgba(0,0,0,0.25)] md:text-[72px]" set:html={heroBadgeTitle} />
        </div>
        <div class="max-w-[600px] pl-4 pr-1 md:max-w-[440px] md:translate-x-[130px] md:pl-0 md:pr-0">
          <h2 class="font-roboto text-[28px] font-bold leading-tight text-black md:text-[56px] md:leading-[64px]">{heroTitle}</h2>
          <p class="mt-3 font-sans text-[16px] font-normal leading-relaxed text-black md:mt-4 md:text-[24px] md:leading-[33px]">{heroSubtitle}</p>
        </div>
      </div>
    </section>

    <!-- Phase Steps Section -->
    <section class="mx-auto mt-12 flex w-full max-w-[1328px] flex-col gap-16 md:mt-14 md:gap-[72px]">
      {steps.map((step, stepIndex) => (
        <article>
          <div class="relative rounded-[10px] bg-dark-blue px-4 pb-4 pt-5 md:px-[28px] md:pb-[32px] md:pt-[12px]">
            <div class="absolute -left-[14px] -top-[18px] flex h-[86px] w-[86px] items-center justify-center rounded-full bg-primary-blue md:-left-[25px] md:-top-[12px] md:h-[224px] md:w-[224px]">
              <span class="font-inter text-[60px] font-bold leading-none text-white md:text-[128px]">{stepIndex + 1}</span>
            </div>

            <div class="ml-[44px] rounded-[18px] bg-primary-blue px-5 py-3 md:ml-[150px] md:w-fit md:rounded-[40px] md:px-[106px] md:py-[38px]">
              <h2 class="pl-[26px] font-roboto text-[27px] font-bold leading-tight !text-white md:pl-[12px] md:text-[48px] md:leading-[56px]">
                {step.title}
              </h2>
            </div>

            <div class="ml-[44px] mt-5 max-w-[600px] rounded-[12px] bg-primary-blue px-5 py-4 shadow-[0_4px_4px_rgba(0,0,0,0.25)] md:ml-[182px] md:mt-4 md:h-[264px] md:w-[600px] md:rounded-[20px] md:px-[44px] md:py-[21px]">
              <h3 class="font-roboto text-[28px] font-bold !text-white md:text-[36px] md:leading-[42px]">
                {step.summary.title}
              </h3>
              <p class="mt-3 font-sans text-[16px] font-normal leading-relaxed !text-white md:text-[20px] md:leading-[27px]">
                {step.summary.description}
              </p>
            </div>
          </div>

          <h3 class="mt-7 font-roboto text-[30px] font-bold leading-tight text-black md:mt-[70px] md:text-[40px] md:leading-[48px]">
            Placeholder Deliverables
          </h3>
          <!-- Updated to grid-cols-1 on mobile so text fits nicely -->
          <ul class="mt-5 m-0 list-none grid grid-cols-1 gap-x-[24px] gap-y-8 p-0 md:grid-cols-2 md:mt-[18px] md:gap-x-[90px] md:gap-y-[48px]">
            {step.deliverables.map((deliverable) => (
              <li class="max-w-[470px]">
                <h4 class="inline-flex min-h-[56px] w-full items-center rounded-[8px] bg-primary-blue px-5 py-3 font-roboto text-[22px] font-bold leading-tight !text-white md:min-h-[64px] md:min-w-[320px] md:w-auto md:px-7 md:py-3 md:text-[24px] md:leading-[28px]">
                  {deliverable.title}
                </h4>
                <p class="mt-3 rounded-[10px] bg-white p-4 font-sans text-[16px] font-normal leading-relaxed text-black md:p-5 md:text-[20px] md:leading-[27px] shadow-sm">
                  {deliverable.description}
                </p>
              </li>
            ))}
          </ul>
        </article>
      ))}
    </section>

    <!-- Other Services Carousel -->
    <section class="mx-auto mt-20 w-full max-w-[1302px] md:mt-24">
      <h2 class="font-roboto text-[42px] font-bold leading-tight text-black md:text-[64px] md:leading-[75px] px-6 md:px-0">
        Other Services we offer
      </h2>

      <div class="carousel-wrapper relative w-full mt-8">
        
        <div class="carousel-container flex overflow-x-auto snap-x snap-mandatory gap-6 px-6 md:px-0 pb-4 hide-scrollbars w-full items-stretch">
          {filteredServices.map((service) => (
            <div class="shrink-0 w-[85vw] max-w-[400px] md:max-w-none md:w-auto snap-center flex">
              <ServiceOfferCard
                title={service.title}
                subtitle={service.subtitle}
                description={service.description}
                href={service.href}
              />
            </div>
          ))}
        </div>

        <!-- Arrows -->
        <div class="flex justify-center mt-6">
          <div class="inline-flex items-center gap-[30px] md:gap-[42px] rounded-[30px] border border-black px-[30px] md:px-[42px] py-[6px]">
            <button
              type="button"
              class="carousel-prev inline-flex h-[50px] w-[50px] md:h-[70px] md:w-[70px] items-center justify-center rounded-full bg-black text-[28px] md:text-[40px] text-card-arrow transition-opacity"
              aria-label="Show previous services"
            >
              &#8249;
            </button>
            <button
              type="button"
              class="carousel-next inline-flex h-[50px] w-[50px] md:h-[70px] md:w-[70px] items-center justify-center rounded-full bg-black text-[28px] md:text-[40px] text-card-arrow transition-opacity"
              aria-label="Show next services"
            >
              &#8250;
            </button>
          </div>
        </div>

      </div>
    </section>

    <!-- Contact Form -->
    <section class="mx-auto mt-16 w-full max-w-[1125px] md:mt-20">
      <ContactSection />
    </section>
    
  </div>
</Layout>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const carousels = document.querySelectorAll('.carousel-wrapper:not(.initialized)');
    carousels.forEach(wrapper => {
      wrapper.classList.add('initialized');
      const container = wrapper.querySelector('.carousel-container');
      const prevBtn = wrapper.querySelector('.carousel-prev');
      const nextBtn = wrapper.querySelector('.carousel-next');

      if (!container || !prevBtn || !nextBtn) return;

      prevBtn.addEventListener('click', () => {
        container.scrollBy({ left: -container.clientWidth * 0.8, behavior: 'smooth' });
      });

      nextBtn.addEventListener('click', () => {
        container.scrollBy({ left: container.clientWidth * 0.8, behavior: 'smooth' });
      });
    });
  });
</script>

<style is:global>
  .hide-scrollbars {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
  .hide-scrollbars::-webkit-scrollbar {
    display: none;
  }
</style>
