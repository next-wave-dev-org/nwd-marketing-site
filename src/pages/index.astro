---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import HeroPanel from '../components/HeroPanel.astro';
import StandardCard from '../components/StandardCard.astro';
import Button from '../components/Button.astro';
import ProfileCard from '../components/ProfileCard.astro';
import ServiceOfferCard from '../components/ServiceOfferCard.astro';
import ClientFrameworkCard from '../components/ClientFrameworkCard.astro';
import PricingBundleCard from '../components/PricingBundleCard.astro';
import VolunteerBanner from '../components/VolunteerBanner.astro';
import ContactSection from '../components/ContactSection.astro';
import GraduatesSection from '../components/GraduatesSection.astro';
import { Image } from 'astro:assets';

const services = [
	{ title: 'Research', subtitle: 'We do the marketing and competitive auditing on your behalf.', href: '/services/research' },
	{ title: 'Design', subtitle: 'We do the marketing and competitive auditing on your behalf.', href: '/services/design' },
	{ title: 'Back-End', subtitle: 'We do the marketing and competitive auditing on your behalf.', href: '/services/back-end' },
	{ title: 'Front-End', subtitle: 'We do the marketing and competitive auditing on your behalf.', href: '/services/front-end' },
	{ title: 'Quality Assurance', subtitle: 'We do the marketing and competitive auditing on your behalf.', href: '/services/quality-assurance' },
	{ title: 'Marketing', subtitle: 'We do the marketing and competitive auditing on your behalf.', href: '/services/marketing' }
];

const frameworkSteps = [
	{ title: 'Getting to Know each other', description: 'Define goals and pain points while doing so much more with stuff and what not.' },
	{ title: 'Placeholder 2', description: 'Define goals and pain points while doing so much more with stuff and what not.' },
	{ title: 'Placeholder 3', description: 'Define goals and pain points while doing so much more with stuff and what not.' }
];

const pricingBundles = [
	{ title: 'Package 1', description: 'Define goals and pain points', teaser: 'Something Here\nSomething Here' },
	{ title: 'Package 2', description: 'Define goals and pain points', teaser: 'Something Here\nSomething Here' },
	{ title: 'Package 3', description: 'Define goals and pain points', teaser: 'Something Here\nSomething Here' }
];

const tocCards = [
    { title: 'Services we offer', description: 'Content about something here to get potential clients to click to go to certain section.' },
    { title: 'Client Framework', description: 'Content about something here to get potential clients to click to go to certain section.' },
    { title: 'Pricing Packages', description: 'Content about something here to get potential clients to click to go to certain section.' },
    { title: 'Volunteer with Us', description: 'Content about something here to get potential clients to click to go to certain section.' },
];

// Fetch the graduates collection to pass into the unified GraduatesSection component
const allGrads = await getCollection('graduates');
const teamData = allGrads.map(g => ({
  id: g.id,
  name: g.data.name || 'Bob Smith',
  image: g.data.image
}));
---

<Layout
	title="Next Wave Dev | Mission-Driven Digital Experiences"
	description="Next Wave Dev builds polished, easy-to-navigate websites and campaigns that help mission-driven organizations grow their impact."
>
	<!-- Global Background -->
	<div class="mx-auto w-full max-w-[1440px] bg-light-aqua font-sans text-black pb-20 md:pb-[300px]">
		
		<!-- =============================== -->
        <!-- MOBILE PAGE LAYOUT (< 768px)    -->
        <!-- =============================== -->
		<div id="mobile-page-layout" class="flex-col items-center w-full pt-12 gap-16">
			
			<!-- COMBINED HERO & LOGOS -->
			<div class="px-6 w-full"><HeroPanel /></div>

			<!-- WHAT WE DO -->
			<section class="flex flex-col gap-12 w-full text-center px-6">
				<div class="flex flex-col gap-5">
					<h2 class="font-roboto text-[36px] font-bold text-black m-0">What we do</h2>
					<p class="font-sans text-[18px] text-black m-0">
						Placeholder text to fill this section. Some more placeholder text to make this look as real as possible even though it is completely fake. Words and more words to fill this section and surprise even more words.
					</p>
				</div>
				<div class="flex h-[250px] w-full rounded-[15px] bg-image-placeholder shadow-md items-center justify-center">
					<span class="font-sans text-[24px] text-black">Image*</span>
				</div>

				<div class="flex flex-col gap-5 mt-8">
					<h2 class="font-roboto text-[36px] font-bold text-black m-0">Why choose us</h2>
					<p class="font-sans text-[18px] text-black m-0">
						Placeholder text to fill this section. Some more placeholder text to make this look as real as possible even though it is completely fake. Words and more words to fill this section and surprise even more words.
					</p>
				</div>
				<div class="flex h-[250px] w-full rounded-[15px] bg-image-placeholder shadow-md items-center justify-center">
					<span class="font-sans text-[24px] text-black">Image*</span>
				</div>
			</section>

			<!-- TOC CARDS (Mobile Carousel) -->
			<section class="carousel-wrapper relative w-full pt-4">
				<div class="carousel-container flex overflow-x-auto snap-x snap-mandatory gap-6 px-6 pb-2 hide-scrollbars w-full">
					{tocCards.map((card) => (
						<div class="shrink-0 w-[85vw] max-w-[350px] snap-center">
							<StandardCard 
								title={card.title}
								description={card.description}
								href={`#mobile-${card.title.toLowerCase().replace(/\s+/g, '-')}`}
							/>
						</div>
					))}
				</div>
				<div class="flex justify-center mt-2">
					<div class="inline-flex items-center gap-[30px] rounded-[30px] border border-black px-[30px] py-[6px]">
					  <button type="button" class="carousel-prev flex h-[50px] w-[50px] items-center justify-center rounded-full bg-black text-[28px] text-card-arrow transition-opacity" aria-label="Scroll left">&#8249;</button>
					  <button type="button" class="carousel-next flex h-[50px] w-[50px] items-center justify-center rounded-full bg-black text-[28px] text-card-arrow transition-opacity" aria-label="Scroll right">&#8250;</button>
					</div>
				</div>
			</section>

			<!-- SERVICES WE OFFER (Mobile Carousel) -->
			<section id="mobile-services-we-offer" class="flex flex-col items-center w-full gap-8 scroll-mt-10">
				<h2 class="font-roboto text-[40px] font-bold text-black text-center px-6 m-0">Services we offer</h2>
				<div class="carousel-wrapper relative w-full">
					<div class="carousel-container flex overflow-x-auto snap-x snap-mandatory gap-6 px-6 pb-2 hide-scrollbars w-full items-stretch">
						{services.map((service) => (
							<div class="shrink-0 w-[85vw] max-w-[400px] snap-center">
								<ServiceOfferCard 
									title={service.title} 
									subtitle={service.subtitle} 
									href={service.href} 
								/>
							</div>
						))}
					</div>
					<div class="flex justify-center mt-2">
						<div class="inline-flex items-center gap-[30px] rounded-[30px] border border-black px-[30px] py-[6px]">
						  <button type="button" class="carousel-prev flex h-[50px] w-[50px] items-center justify-center rounded-full bg-black text-[28px] text-card-arrow transition-opacity" aria-label="Scroll left">&#8249;</button>
						  <button type="button" class="carousel-next flex h-[50px] w-[50px] items-center justify-center rounded-full bg-black text-[28px] text-card-arrow transition-opacity" aria-label="Scroll right">&#8250;</button>
						</div>
					</div>
				</div>
			</section>

			<!-- CLIENT FRAMEWORK (Mobile Carousel) -->
			<section id="mobile-client-framework" class="flex flex-col items-center w-full gap-8 text-center scroll-mt-10">
				<h2 class="font-roboto text-[36px] font-bold text-black px-6 m-0">Client Framework</h2>
				<p class="font-sans text-[18px] text-black px-6 m-0">
					Here outlines a brief overview about our client interaction work flow.
				</p>
				<!-- Updated route -->
				<Button href="/about-us/client-framework" label="See More" />
				<div class="carousel-wrapper relative w-full mt-4">
					<div class="carousel-container flex overflow-x-auto snap-x snap-mandatory gap-6 px-6 pb-2 hide-scrollbars w-full">
						{frameworkSteps.map((step, index) => (
							<div class="shrink-0 w-[85vw] max-w-[350px] snap-center">
								<ClientFrameworkCard 
									number={index + 1}
									title={step.title}
									description={step.description}
								/>
							</div>
						))}
					</div>
					<div class="flex justify-center mt-2">
						<div class="inline-flex items-center gap-[30px] rounded-[30px] border border-black px-[30px] py-[6px]">
						  <button type="button" class="carousel-prev flex h-[50px] w-[50px] items-center justify-center rounded-full bg-black text-[28px] text-card-arrow transition-opacity" aria-label="Scroll left">&#8249;</button>
						  <button type="button" class="carousel-next flex h-[50px] w-[50px] items-center justify-center rounded-full bg-black text-[28px] text-card-arrow transition-opacity" aria-label="Scroll right">&#8250;</button>
						</div>
					</div>
				</div>
			</section>

			<!-- PRICING BUNDLES (Mobile Carousel) -->
			<section id="mobile-pricing-packages" class="flex flex-col items-center w-full gap-8 text-center scroll-mt-10">
				<h2 class="font-inter text-[36px] font-bold text-black px-6 m-0">Pricing Bundles</h2>
				<p class="font-sans text-[18px] text-black px-6 m-0">
					Here outlines a brief overview about our client interaction work flow.
				</p>
				<!-- Updated route -->
				<Button href="/services/pricing" label="See All" />
				<div class="carousel-wrapper relative w-full mt-4">
					<div class="carousel-container flex overflow-x-auto snap-x snap-mandatory gap-6 px-6 pb-2 hide-scrollbars w-full">
						{pricingBundles.map((bundle) => (
							<div class="shrink-0 w-[85vw] max-w-[350px] snap-center">
								<PricingBundleCard 
									title={bundle.title} 
									description={bundle.description} 
									teaser={bundle.teaser} 
								/>
							</div>
						))}
					</div>
					<div class="flex justify-center mt-2">
						<div class="inline-flex items-center gap-[30px] rounded-[30px] border border-black px-[30px] py-[6px]">
						  <button type="button" class="carousel-prev flex h-[50px] w-[50px] items-center justify-center rounded-full bg-black text-[28px] text-card-arrow transition-opacity" aria-label="Scroll left">&#8249;</button>
						  <button type="button" class="carousel-next flex h-[50px] w-[50px] items-center justify-center rounded-full bg-black text-[28px] text-card-arrow transition-opacity" aria-label="Scroll right">&#8250;</button>
						</div>
					</div>
				</div>
			</section>

			<!-- TEAM -->
			<section class="w-full mt-8 md:mt-12">
      			<GraduatesSection graduates={teamData} title="Team" />
    		</section>

			<!-- VOLUNTEER SECTION -->
			<div id="mobile-volunteer-with-us" class="w-full px-6 scroll-mt-10"><VolunteerBanner /></div>

			<!-- CONTACT FORM COMPONENT -->
			<div class="w-full px-6"><ContactSection /></div>

			<!-- DONATE NOW -->
			<section class="mt-12 mx-6 flex w-auto flex-col items-center gap-8 rounded-[20px] bg-gradient-to-b from-light-aqua to-secondary-blue p-10 text-center">
				<div class="flex h-[250px] w-[250px] items-center justify-center rounded-full bg-primary-blue">
					<span class="font-heading text-[56px] font-bold leading-none text-hero-text drop-shadow-md text-center">
						Donate<br/>Now
					</span>
				</div>
				<div class="flex flex-col items-center gap-5">
					<h2 class="font-sans text-[32px] font-semibold leading-tight text-black m-0">
						The next wave of developers<br/>something marketing
					</h2>
					<Button href="/contact" label="Donate" />
				</div>
			</section>

		</div>


        <!-- ============================================== -->
        <!-- DESKTOP PAGE LAYOUT (>= 768px) ORIGINAL DESIGN -->
        <!-- ============================================== -->
		<div id="desktop-page-layout" class="flex flex-col items-center w-full pt-12 gap-[120px] px-[115px]">
			
			<!-- COMBINED HERO & LOGOS -->
			<HeroPanel />

			<!-- WHAT WE DO -->
			<section class="mx-auto flex w-full max-w-[1223px] flex-col gap-[100px]">
				<!-- Row 1 -->
				<div class="flex items-center justify-between h-[320px]">
					<div class="flex flex-col gap-5 w-[600px]">
						<h2 class="font-roboto text-[48px] font-bold leading-tight text-black m-0">What we do</h2>
						<p class="font-sans text-[24px] font-normal leading-[33px] text-black m-0">
							Placeholder text to fill this section. Some more placeholder text to make this look as real as possible even though it is completely fake. Words and more words to fill this section and surprise even more words.
						</p>
					</div>
					<div class="flex h-[320px] w-[540px] items-center justify-center rounded-[15px] bg-image-placeholder shadow-md">
						<span class="font-sans text-[24px] text-black">Image*</span>
					</div>
				</div>

				<!-- Row 2: Why choose us -->
				<div class="flex items-center justify-between h-[320px]">
					<div class="flex h-[320px] w-[540px] items-center justify-center rounded-[15px] bg-image-placeholder shadow-md">
						<span class="font-sans text-[24px] text-black">Image*</span>
					</div>
					<div class="flex flex-col gap-5 w-[600px]">
						<h2 class="font-roboto text-[48px] font-bold leading-tight text-black m-0">Why choose us</h2>
						<p class="font-sans text-[24px] font-normal leading-[33px] text-black m-0">
							Placeholder text to fill this section. Some more placeholder text to make this look as real as possible even though it is completely fake. Words and more words to fill this section and surprise even more words.
						</p>
					</div>
				</div>
			</section>

			<!-- TOC CARDS (Grid of 4) -->
			<section class="mx-auto grid grid-cols-4 gap-[27px] w-full max-w-[1281px] pb-[40px]">
				{tocCards.map((card) => (
					<StandardCard 
						title={card.title}
						description={card.description}
						href={`#desktop-${card.title.toLowerCase().replace(/\s+/g, '-')}`}
					/>
				))}
			</section>

			<!-- SERVICES WE OFFER -->
			<section id="desktop-services-we-offer" class="mx-auto flex flex-col w-full max-w-[1288px] gap-10 scroll-mt-12">
				<h2 class="font-roboto text-[64px] font-bold text-black m-0">Services we offer</h2>
				<div class="grid grid-cols-3 gap-x-[15px] gap-y-[78px]">
					{services.map((service) => (
						<ServiceOfferCard 
							title={service.title} 
							subtitle={service.subtitle} 
							href={service.href} 
						/>
					))}
				</div>
			</section>

			<!-- CLIENT FRAMEWORK -->
			<section id="desktop-client-framework" class="mx-auto flex flex-col w-full max-w-[1368px] gap-10 scroll-mt-12">
				<div class="flex items-center justify-between pr-20">
					<div class="flex flex-col gap-2">
						<h2 class="font-roboto text-[48px] font-bold text-black m-0">Client Framework</h2>
						<p class="font-sans text-[24px] font-normal text-black w-[600px] m-0">
							Here outlines a brief overview about our client interaction work flow.
						</p>
					</div>
					<!-- Updated route -->
					<Button href="/about-us/client-framework" label="See More" />
				</div>
				
				<!-- Cards Grid Centered -->
				<div class="flex justify-center gap-[67px] mt-2">
					{frameworkSteps.map((step, index) => (
						<ClientFrameworkCard 
							number={index + 1}
							title={step.title}
							description={step.description}
						/>
					))}
				</div>
			</section>

			<!-- PRICING BUNDLES -->
			<section id="desktop-pricing-packages" class="mx-auto flex flex-col w-full max-w-[1278px] gap-10 scroll-mt-12">
				<div class="flex items-center justify-between">
					<div class="flex flex-col gap-2">
						<h2 class="font-inter text-[48px] font-bold leading-[58px] text-black m-0">Pricing Bundles</h2>
						<p class="font-sans text-[24px] font-normal leading-[29px] text-black w-[600px] m-0">
							Here outlines a brief overview about our client interaction work flow.
						</p>
					</div>
					<!-- Updated route -->
					<Button href="/services/pricing" label="See All" />
				</div>

				<!-- Bundles Cards Grid -->
				<div class="flex gap-[45px] mt-12 justify-center">
					{pricingBundles.map((bundle) => (
						<PricingBundleCard 
							title={bundle.title} 
							description={bundle.description} 
							teaser={bundle.teaser} 
						/>
					))}
				</div>
			</section>

			<!-- TEAM -->
			<section class="w-full mt-8 md:mt-12">
      			<GraduatesSection graduates={teamData} title="Team" />
    		</section>

			<!-- VOLUNTEER SECTION -->
			<div id="desktop-volunteer-with-us" class="w-full scroll-mt-12">
				<VolunteerBanner />
			</div>

			<!-- CONTACT FORM COMPONENT -->
			<ContactSection />

			<!-- DONATE NOW -->
			<section class="relative mx-auto mt-[50px] flex h-[519px] w-full max-w-[1388px] items-center overflow-hidden rounded-[20px] bg-gradient-to-b from-light-aqua to-secondary-blue shadow-lg">
				<div class="absolute left-[103px] flex h-[390px] w-[390px] items-center justify-center rounded-full bg-primary-blue">
					<span class="font-heading text-[96px] font-bold leading-none text-hero-text drop-shadow-md text-center">
						Donate<br/>Now
					</span>
				</div>
				<div class="absolute left-[697px] flex flex-col gap-5">
					<h2 class="font-sans text-[48px] font-semibold leading-[58px] text-black w-[668px] m-0">
						The next wave of developers<br/>something marketing
					</h2>
					<div class="mt-10 flex">
						<Button href="/donate" label="Donate" />
					</div>
				</div>
			</section>

		</div>
	</div>
</Layout>

<script>
	// Setup Carousel Navigation globally for the index page components
	document.addEventListener('DOMContentLoaded', () => {
	  const carousels = document.querySelectorAll('.carousel-wrapper');
	  carousels.forEach(wrapper => {
		const container = wrapper.querySelector('.carousel-container') as HTMLElement;
		const prevBtn = wrapper.querySelector('.carousel-prev') as HTMLButtonElement;
		const nextBtn = wrapper.querySelector('.carousel-next') as HTMLButtonElement;
  
		if (!container || !prevBtn || !nextBtn) return;
  
		// Disabled logic removed - arrows always active
		prevBtn.addEventListener('click', () => {
		  container.scrollBy({ left: -container.clientWidth * 0.8, behavior: 'smooth' });
		});
  
		nextBtn.addEventListener('click', () => {
		  container.scrollBy({ left: container.clientWidth * 0.8, behavior: 'smooth' });
		});
	  });
	});
</script>

<style is:global>
  html {
	scroll-behavior: smooth;
  }

  /* Hides the ugly native scrollbar but keeps the scrolling functionality */
  .hide-scrollbars {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
  .hide-scrollbars::-webkit-scrollbar {
    display: none;
  }

  /* PURE CSS FAILSAFE: Bypasses Tailwind completely to guarantee desktop renders! */
  @media (min-width: 768px) {
    #mobile-page-layout { display: none !important; }
    #desktop-page-layout { display: flex !important; }
  }
  @media (max-width: 767px) {
    #desktop-page-layout { display: none !important; }
    #mobile-page-layout { display: flex !important; }
  }
</style>
