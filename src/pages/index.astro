---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import HeroPanel from '../components/HeroPanel.astro';
import StandardCard from '../components/StandardCard.astro';
import Button from '../components/Button.astro';
import ProfileCard from '../components/ProfileCard.astro';
import ServiceOfferCard from '../components/ServiceOfferCard.astro';
import ClientFrameworkCard from '../components/ClientFrameworkCard.astro';
import PricingBundleCard from '../components/PricingBundleCard.astro';
import VolunteerBanner from '../components/VolunteerBanner.astro';
import { Image } from 'astro:assets';

const services = [
	{ title: 'Research', subtitle: 'We do the marketing and competitive auditing on your behalf.' },
	{ title: 'Design', subtitle: 'We do the marketing and competitive auditing on your behalf.' },
	{ title: 'Back-End', subtitle: 'We do the marketing and competitive auditing on your behalf.' },
	{ title: 'Front-End', subtitle: 'We do the marketing and competitive auditing on your behalf.' },
	{ title: 'Quality Testing', subtitle: 'We do the marketing and competitive auditing on your behalf.' },
	{ title: 'Marketing', subtitle: 'We do the marketing and competitive auditing on your behalf.' }
];

const frameworkSteps = [
	{ title: 'Getting to Know each other', description: 'Define goals and pain points while doing so much more with stuff and what not.' },
	{ title: 'Placeholder 2', description: 'Define goals and pain points while doing so much more with stuff and what not.' },
	{ title: 'Placeholder 3', description: 'Define goals and pain points while doing so much more with stuff and what not.' }
];

const pricingBundles = [
	{ title: 'Package 1', description: 'Define goals and pain points', teaser: 'Something Here\nSomething Here' },
	{ title: 'Package 2', description: 'Define goals and pain points', teaser: 'Something Here\nSomething Here' },
	{ title: 'Package 3', description: 'Define goals and pain points', teaser: 'Something Here\nSomething Here' }
];

const tocCards = [
    { title: 'Services we offer', description: 'Content about something here to get potential clients to click to go to certain section.' },
    { title: 'Client Framework', description: 'Content about something here to get potential clients to click to go to certain section.' },
    { title: 'Pricing Packages', description: 'Content about something here to get potential clients to click to go to certain section.' },
    { title: 'Volunteer with Us', description: 'Content about something here to get potential clients to click to go to certain section.' },
];

const graduates = ['Bob Smith', 'Bob Smith', 'Bob Smith', 'Bob Smith'];

---

<Layout
	title="Next Wave Dev | Mission-Driven Digital Experiences"
	description="Next Wave Dev builds polished, easy-to-navigate websites and campaigns that help mission-driven organizations grow their impact."
>
	<!-- Global Background -->
	<div class="mx-auto w-full max-w-[1440px] bg-[#F0F0F0] font-sans text-black pb-20 md:pb-[300px]">
		
		<!-- =============================== -->
        <!-- MOBILE PAGE LAYOUT (< 768px)    -->
        <!-- =============================== -->
		<div id="mobile-page-layout" class="flex-col items-center w-full pt-12 gap-16 px-6">
			
			<!-- COMBINED HERO & LOGOS -->
			<HeroPanel />

			<!-- WHAT WE DO -->
			<section class="flex flex-col gap-12 w-full text-center">
				<div class="flex flex-col gap-5">
					<h2 class="font-roboto text-[36px] font-bold text-black">What we do</h2>
					<p class="font-sans text-[18px] text-black">
						Placeholder text to fill this section. Some more placeholder text to make this look as real as possible even though it is completely fake. Words and more words to fill this section and surprise even more words.
					</p>
				</div>
				<div class="flex h-[250px] w-full rounded-[15px] bg-[#A2A2A2] shadow-md items-center justify-center">
					<span class="font-sans text-[24px] text-black">Image*</span>
				</div>

				<div class="flex flex-col gap-5 mt-8">
					<h2 class="font-roboto text-[36px] font-bold text-black">Why choose us</h2>
					<p class="font-sans text-[18px] text-black">
						Placeholder text to fill this section. Some more placeholder text to make this look as real as possible even though it is completely fake. Words and more words to fill this section and surprise even more words.
					</p>
				</div>
				<div class="flex h-[250px] w-full rounded-[15px] bg-[#A2A2A2] shadow-md items-center justify-center">
					<span class="font-sans text-[24px] text-black">Image*</span>
				</div>
			</section>

			<!-- TOC CARDS (Stacked) -->
			<section class="grid grid-cols-1 gap-6 w-full place-items-center">
				{tocCards.map((card) => (
					<StandardCard 
						title={card.title}
						description={card.description}
						href={`/${card.title.toLowerCase().replace(/\s+/g, '-')}`}
					/>
				))}
			</section>

			<!-- SERVICES WE OFFER -->
			<section class="flex flex-col items-center w-full gap-8">
				<h2 class="font-roboto text-[40px] font-bold text-black text-center">Services we offer</h2>
				<div class="flex flex-col gap-8 w-full items-center">
					{services.map((service) => (
						<ServiceOfferCard 
							title={service.title} 
							subtitle={service.subtitle} 
							href="/services" 
						/>
					))}
				</div>
			</section>

			<!-- CLIENT FRAMEWORK -->
			<section class="flex flex-col items-center w-full gap-8 text-center">
				<h2 class="font-roboto text-[36px] font-bold text-black">Client Framework</h2>
				<p class="font-sans text-[18px] text-black">
					Here outlines a brief overview about our client interaction work flow.
				</p>
				<Button href="/about-us" label="See More" />
				<div class="flex flex-col gap-12 mt-8">
					{frameworkSteps.map((step, index) => (
						<ClientFrameworkCard 
							number={index + 1}
							title={step.title}
							description={step.description}
						/>
					))}
				</div>
			</section>

			<!-- PRICING BUNDLES -->
			<section class="flex flex-col items-center w-full gap-8 text-center">
				<h2 class="font-inter text-[36px] font-bold text-black">Pricing Bundles</h2>
				<p class="font-sans text-[18px] text-black">
					Here outlines a brief overview about our client interaction work flow.
				</p>
				<Button href="/services" label="See All" />
				<div class="flex flex-col gap-12 mt-8">
					{pricingBundles.map((bundle) => (
						<PricingBundleCard 
							title={bundle.title} 
							description={bundle.description} 
							teaser={bundle.teaser} 
						/>
					))}
				</div>
			</section>

			<!-- GRADUATES -->
			<section class="flex flex-col items-center w-full gap-8 mt-12">
				<h2 class="font-roboto text-[40px] font-bold text-black text-center">Graduates</h2>
				<Button href="/about-us" label="See All" />
				<div class="flex flex-col gap-10 mt-8">
					{graduates.map((graduate) => (
						<ProfileCard name={graduate.name || graduate} role="Program Manager" />
					))}
				</div>
			</section>

			<!-- VOLUNTEER SECTION -->
			<VolunteerBanner />

			<!-- CONTACT FORM -->
			<section class="w-full rounded-[20px] bg-gradient-to-b from-[#949494] to-[#F0F0F0] px-6 py-10 flex flex-col items-center text-center mt-16">
				<h2 class="font-roboto text-[32px] font-semibold text-black">Let us know what you need!</h2>
				<p class="font-sans text-[20px] text-black mt-2">Tell us what you need help with</p>
				
				<h3 class="font-roboto text-[36px] font-bold text-black mt-10">Contact Us</h3>
				<div class="mt-4 flex min-h-[48px] w-full items-center justify-center rounded-[20px] border border-black p-4">
					<span class="font-sans text-[16px] font-bold text-black">Let our CEO know your interest in our organization!</span>
				</div>
				
				<form class="mt-8 flex flex-col gap-6 w-full text-left">
					<div class="flex flex-col gap-2">
						<label class="font-sans text-[20px] font-semibold text-black">Name</label>
						<input type="text" class="h-[60px] w-full rounded-[10px] border-2 border-black bg-transparent px-4" />
					</div>
					<div class="flex flex-col gap-2">
						<label class="font-sans text-[20px] font-semibold text-black">Email</label>
						<input type="email" class="h-[60px] w-full rounded-[10px] border-2 border-black bg-transparent px-4" />
					</div>
					<div class="flex flex-col gap-2">
						<label class="font-sans text-[20px] font-semibold text-black">Topic</label>
						<select class="h-[60px] w-full rounded-[10px] border-2 border-black bg-transparent px-4 font-sans text-[20px] font-semibold text-[#7C7B7B]">
							<option>Select a Topic</option>
						</select>
					</div>
					<div class="flex flex-col gap-2">
						<label class="font-sans text-[20px] font-semibold text-black">Your message</label>
						<textarea class="h-[150px] w-full rounded-[10px] border-2 border-black bg-transparent p-4"></textarea>
					</div>
					<button type="button" class="mt-5 h-[60px] w-full rounded-[20px] bg-[#323232] font-roboto text-[24px] font-medium text-[#DEDEDE]">
						Submit
					</button>
				</form>
				
				<div class="flex flex-col items-center gap-6 mt-16">
					<p class="font-sans text-[20px] font-semibold leading-[29px] text-black">
						Next Wave Dev<br/>5555 somewhere Way N,<br/>Seattle, WA 99999
					</p>
					<div class="flex flex-col gap-1">
						<p class="font-sans text-[20px] font-semibold text-black">Email</p>
						<p class="font-sans text-[20px] font-medium text-black">nextwavedev@gmail.org</p>
					</div>
					<div class="flex flex-col gap-1">
						<p class="font-sans text-[20px] font-semibold text-black">Phone</p>
						<p class="font-sans text-[20px] font-medium text-black">555.555.5555</p>
					</div>
				</div>
			</section>

			<!-- DONATE NOW -->
			<section class="flex flex-col w-full rounded-[20px] bg-gradient-to-b from-[#F0F0F0] to-[#949494] mt-12 p-10 items-center text-center gap-8">
				<div class="flex h-[250px] w-[250px] items-center justify-center rounded-full bg-[#505050]">
					<span class="font-heading text-[56px] font-bold leading-none text-[#D8D8D8] drop-shadow-md text-center">
						Donate<br/>Now
					</span>
				</div>
				<div class="flex flex-col items-center gap-5">
					<h2 class="font-sans text-[32px] font-semibold leading-tight text-black">
						The next wave of developers<br/>something marketing
					</h2>
					<Button href="/contact" label="Donate" />
				</div>
			</section>

		</div>


        <!-- ============================================== -->
        <!-- DESKTOP PAGE LAYOUT (>= 768px) ORIGINAL DESIGN -->
        <!-- ============================================== -->
		<div id="desktop-page-layout" class="flex flex-col items-center w-full pt-12 gap-[120px]">
			
			<!-- COMBINED HERO & LOGOS -->
			<HeroPanel />

			<!-- WHAT WE DO -->
			<section class="mx-auto flex w-full max-w-[1223px] flex-col gap-[100px]">
				<!-- Row 1 -->
				<div class="flex items-center justify-between h-[320px]">
					<div class="flex flex-col gap-5 w-[600px]">
						<h2 class="font-roboto text-[48px] font-bold leading-tight text-black">What we do</h2>
						<p class="font-sans text-[24px] font-normal leading-[33px] text-black">
							Placeholder text to fill this section. Some more placeholder text to make this look as real as possible even though it is completely fake. Words and more words to fill this section and surprise even more words.
						</p>
					</div>
					<div class="flex h-[320px] w-[540px] items-center justify-center rounded-[15px] bg-[#A2A2A2] shadow-md">
						<span class="font-sans text-[24px] text-black">Image*</span>
					</div>
				</div>

				<!-- Row 2: Why choose us -->
				<div class="flex items-center justify-between h-[320px]">
					<div class="flex h-[320px] w-[540px] items-center justify-center rounded-[15px] bg-[#A2A2A2] shadow-md">
						<span class="font-sans text-[24px] text-black">Image*</span>
					</div>
					<div class="flex flex-col gap-5 w-[600px]">
						<h2 class="font-roboto text-[48px] font-bold leading-tight text-black">Why choose us</h2>
						<p class="font-sans text-[24px] font-normal leading-[33px] text-black">
							Placeholder text to fill this section. Some more placeholder text to make this look as real as possible even though it is completely fake. Words and more words to fill this section and surprise even more words.
						</p>
					</div>
				</div>
			</section>

			<!-- TOC CARDS (Grid of 4) -->
			<section class="mx-auto grid grid-cols-4 gap-[27px] w-full max-w-[1281px] pb-[40px]">
				{tocCards.map((card) => (
					<StandardCard 
						title={card.title}
						description={card.description}
						href={`/${card.title.toLowerCase().replace(/\s+/g, '-')}`}
					/>
				))}
			</section>

			<!-- SERVICES WE OFFER -->
			<section class="mx-auto flex flex-col w-full max-w-[1288px] gap-10">
				<h2 class="font-roboto text-[64px] font-bold text-black">Services we offer</h2>
				<div class="grid grid-cols-3 gap-x-[15px] gap-y-[78px]">
					{services.map((service) => (
						<ServiceOfferCard 
							title={service.title} 
							subtitle={service.subtitle} 
							href="/services" 
						/>
					))}
				</div>
			</section>

			<!-- CLIENT FRAMEWORK -->
			<section class="mx-auto flex flex-col w-full max-w-[1368px] gap-10">
				<div class="flex items-center justify-between pr-20">
					<div class="flex flex-col gap-2">
						<h2 class="font-roboto text-[48px] font-bold text-black">Client Framework</h2>
						<p class="font-sans text-[24px] font-normal text-black w-[600px]">
							Here outlines a brief overview about our client interaction work flow.
						</p>
					</div>
					<!-- See More Button -->
					<Button href="/about-us" label="See More" />
				</div>
				
				<!-- Cards Grid Centered -->
				<div class="flex justify-center gap-[67px] mt-2">
					{frameworkSteps.map((step, index) => (
						<ClientFrameworkCard 
							number={index + 1}
							title={step.title}
							description={step.description}
						/>
					))}
				</div>
			</section>

			<!-- PRICING BUNDLES -->
			<section class="mx-auto flex flex-col w-full max-w-[1278px] gap-10">
				<div class="flex items-center justify-between">
					<div class="flex flex-col gap-2">
						<h2 class="font-inter text-[48px] font-bold leading-[58px] text-black">Pricing Bundles</h2>
						<p class="font-sans text-[24px] font-normal leading-[29px] text-black w-[600px]">
							Here outlines a brief overview about our client interaction work flow.
						</p>
					</div>
					<!-- See All Button -->
					<Button href="/services" label="See All" />
				</div>

				<!-- Bundles Cards Grid -->
				<div class="flex gap-[45px] mt-12 justify-center">
					{pricingBundles.map((bundle) => (
						<PricingBundleCard 
							title={bundle.title} 
							description={bundle.description} 
							teaser={bundle.teaser} 
						/>
					))}
				</div>
			</section>

			<!-- GRADUATES -->
			<section class="mx-auto mt-[100px] flex w-full max-w-[1328px] flex-col">
				<!-- Header Row -->
				<div class="flex items-center justify-between">
					<!-- Graduates Heading -->
					<h2 class="m-0 p-0 font-roboto text-[64px] font-bold leading-[75px] text-black">
						Graduates
					</h2>
					
					<!-- "See All" Button matching Figma specs -->
					<Button href="/about-us" label="See All" />
				</div>
				
				<!-- Grid Layout for Profile Cards -->
				<div class="mt-[48px] flex flex-row justify-between">
					{graduates.map((graduate) => (
						<ProfileCard name={graduate.name || graduate} role="Program Manager" />
					))}
				</div>
			</section>

			<!-- VOLUNTEER SECTION -->
			<VolunteerBanner />

			<!-- CONTACT FORM -->
			<section class="relative mx-auto w-full max-w-[1125px] min-h-[916px] rounded-[20px] bg-gradient-to-b from-[#949494] to-[#F0F0F0] px-[94px] py-[40px] mt-[100px]">
				<h2 class="font-roboto text-[48px] font-semibold text-black">Let us know what you need!</h2>
				<p class="font-sans text-[32px] font-normal text-black mt-2">Tell us what you need help with</p>
				
				<div class="grid grid-cols-2 gap-[50px] mt-[60px]">
					<!-- Form Side -->
					<div class="flex flex-col w-[530px]">
						<h3 class="font-roboto text-[48px] font-bold text-black">Contact Us</h3>
						<div class="mt-4 flex h-[48px] w-full items-center justify-center rounded-[20px] border border-black">
							<span class="font-sans text-[20px] font-bold text-black">Let our CEO know your interest in our organization!</span>
						</div>
						
						<form class="mt-10 flex flex-col gap-6">
							<div class="flex flex-col gap-2">
								<label class="font-sans text-[24px] font-semibold text-black">Name</label>
								<input type="text" class="h-[60px] w-full rounded-[10px] border-2 border-black bg-transparent px-4" />
							</div>
							<div class="flex flex-col gap-2">
								<label class="font-sans text-[24px] font-semibold text-black">Email</label>
								<input type="email" class="h-[60px] w-full rounded-[10px] border-2 border-black bg-transparent px-4" />
							</div>
							<div class="flex flex-col gap-2">
								<label class="font-sans text-[24px] font-semibold text-black">Topic</label>
								<select class="h-[60px] w-full rounded-[10px] border-2 border-black bg-transparent px-4 font-sans text-[24px] font-semibold text-[#7C7B7B]">
									<option>Select a Topic</option>
								</select>
							</div>
							<div class="flex flex-col gap-2">
								<label class="font-sans text-[24px] font-semibold text-black">Your message</label>
								<textarea class="h-[150px] w-full rounded-[10px] border-2 border-black bg-transparent p-4"></textarea>
							</div>
							<button type="button" class="mt-5 h-[60px] w-full rounded-[20px] bg-[#323232] font-roboto text-[32px] font-medium text-[#DEDEDE] transition-opacity hover:opacity-90">
								Submit
							</button>
						</form>
					</div>
					
					<!-- Contact Info Side -->
					<div class="flex flex-col gap-10 pt-[150px] pl-[50px]">
						<p class="font-sans text-[24px] font-semibold leading-[29px] text-black">
							Next Wave Dev<br/>5555 somewhere Way N,<br/>Seattle, WA 99999
						</p>
						<div class="flex flex-col gap-2">
							<p class="font-sans text-[24px] font-semibold text-black">Email</p>
							<p class="font-sans text-[24px] font-medium text-black">nextwavedev@gmail.org</p>
						</div>
						<div class="flex flex-col gap-2">
							<p class="font-sans text-[24px] font-semibold text-black">Phone</p>
							<p class="font-sans text-[24px] font-medium text-black">555.555.5555</p>
						</div>
					</div>
				</div>
			</section>

			<!-- DONATE NOW -->
			<section class="relative mx-auto flex h-[519px] w-full max-w-[1388px] items-center overflow-hidden rounded-[20px] bg-gradient-to-b from-[#F0F0F0] to-[#949494] mt-[50px]">
				<div class="absolute left-[103px] flex h-[390px] w-[390px] items-center justify-center rounded-full bg-[#505050]">
					<span class="font-heading text-[96px] font-bold leading-none text-[#D8D8D8] drop-shadow-md text-center">
						Donate<br/>Now
					</span>
				</div>
				<div class="absolute left-[697px] flex flex-col gap-5">
					<h2 class="font-sans text-[48px] font-semibold leading-[58px] text-black w-[668px]">
						The next wave of developers<br/>something marketing
					</h2>
					<div class="mt-10 flex">
						<Button href="/contact" label="Donate" />
					</div>
				</div>
			</section>

		</div>
	</div>
</Layout>

<style is:global>
  /* PURE CSS FAILSAFE: Bypasses Tailwind completely to guarantee desktop renders! */
  @media (min-width: 768px) {
    #mobile-page-layout { display: none !important; }
    #desktop-page-layout { display: flex !important; }
  }
  @media (max-width: 767px) {
    #desktop-page-layout { display: none !important; }
    #mobile-page-layout { display: flex !important; }
  }
</style>
