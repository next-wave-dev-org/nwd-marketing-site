---
import Layout from '../layouts/Layout.astro';
import ContactSection from '../components/ContactSection.astro';
import Button from '../components/Button.astro';

const services = [
  {
    id: "websites",
    icon: "M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z",
    title: "Websites & Landing Pages",
    description: "Fast, mobile-friendly websites that look great and clearly communicate your organization's mission to the world.",
    deliverables: [
      "Custom UI/UX Design",
      "Responsive Front-End Development",
      "WCAG Accessibility Compliance",
      "Content Management Systems (CMS)"
    ]
  },
  {
    id: "custom-apps",
    icon: "M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4",
    title: "Custom Apps & Portals",
    description: "Secure, reliable custom web applications and operational platforms designed to solve your unique workflow challenges.",
    deliverables: [
      "Custom Database Architecture",
      "Secure User Authentication & Logins",
      "Third-party API Integrations",
      "E-Commerce & Payment Setup"
    ]
  },
  {
    id: "maintenance",
    icon: "M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z M15 12a3 3 0 11-6 0 3 3 0 016 0z",
    title: "Maintenance & Support",
    description: "Ongoing technical care to ensure your digital presence remains fast, functional, and secure month after month.",
    deliverables: [
      "Routine Security Patching",
      "Performance & Speed Monitoring",
      "Bug Fixes & Technical Troubleshooting",
      "Minor Feature Updates"
    ]
  },
  {
    id: "growth",
    icon: "M11 3.055A9.001 9.001 0 1020.945 13H11V3.055z M20.488 9H15V3.512A9.025 9.025 0 0120.488 9z",
    title: "Digital Growth & QA",
    description: "Comprehensive testing and marketing strategies to amplify your reach and ensure your software performs flawlessly.",
    deliverables: [
      "Cross-browser & Device Testing",
      "Search Engine Optimization (SEO)",
      "Digital Campaign Strategy",
      "Performance Auditing"
    ]
  }
];

const processSteps = [
  { step: "01", title: "Discovery", description: "We start by listening. We audit your needs, map your requirements, and build a clear technical roadmap and timeline." },
  { step: "02", title: "Build", description: "Our cross-functional teams design and develop your solution, keeping you in the loop with regular check-ins and demos." },
  { step: "03", title: "Launch", description: "We rigorously test your software across devices to ensure ongoing reliability and performance before a smooth deployment." },
  { step: "04", title: "Support", description: "Technology isn't one-and-done. We offer ongoing care plans to keep your product secure, updated, and scaling." }
];
---

<Layout title="Our Services | Next Wave Dev" description="High-quality digital solutions for mission-driven organizations.">
  <div class="mx-auto w-full max-w-[1440px] overflow-hidden bg-light-aqua px-5 pb-0 pt-10 text-black md:px-8 md:pt-12">
    
    <section class="mx-auto w-full max-w-[1289px] px-0">
      
      <!-- UNIFIED RESPONSIVE PAGE HERO -->
      <div class="w-full flex flex-col md:overflow-hidden rounded-[10px] bg-gradient-to-b from-light-aqua to-secondary-blue p-6 md:p-0 shadow-md md:shadow-lg mt-4 md:mt-0">
        <section class="relative flex flex-col md:flex-row md:h-[489px] w-full items-center text-center md:text-left gap-6 md:gap-0">
          
          <div class="md:absolute md:left-[47px] md:top-[19px] z-10 flex h-[150px] w-[150px] md:h-[390px] md:w-[390px] shrink-0 items-center justify-center rounded-full bg-primary-blue shadow-md md:shadow-lg mx-auto md:mx-0 p-2 md:p-8">
            <span class="block w-full font-heading text-[18px] sm:text-[20px] md:text-[42px] lg:text-[48px] font-bold leading-tight md:leading-[1.1] text-hero-text text-center drop-shadow-sm md:drop-shadow-card [text-shadow:-1px_-1px_0_#D49A1D,_1px_-1px_0_#D49A1D,_-1px_1px_0_#D49A1D,_1px_1px_0_#D49A1D] md:[text-shadow:-3px_-3px_0_#D49A1D,_3px_-3px_0_#D49A1D,_-3px_3px_0_#D49A1D,_3px_3px_0_#D49A1D] break-words">
              Our<br/>Services
            </span>
          </div>
          
          <div class="md:absolute md:left-[470px] flex flex-col w-full md:w-[650px] gap-3 md:gap-4 z-10 md:pr-8">
            <h1 class="m-0 font-roboto text-[22px] md:text-[48px] lg:text-[56px] font-bold leading-tight md:leading-[1.1] text-black break-words">Enterprise-grade solutions, non-profit pricing.</h1>
            <p class="m-0 font-sans text-[15px] md:text-[22px] lg:text-[24px] font-normal leading-relaxed md:leading-[33px] text-black">We provide the technical capacity you need to scale your impact. From straightforward marketing websites to complex custom web applications, our teams deliver polished, accessible, and reliable digital products.</p>
            <div class="mt-4 flex justify-center md:justify-start">
              <Button href="/services/pricing" label="View Pricing" variant="primary" />
            </div>
          </div>
          
        </section>
      </div>
      
    </section>

    <!-- Services Detail -->
    <section class="mx-auto w-full max-w-[1289px] mt-16 md:mt-24">
      <div class="flex flex-col items-center md:items-start text-center md:text-left mb-12">
        <h2 class="font-roboto text-[32px] md:text-[48px] font-bold text-black m-0">What we build</h2>
        <p class="font-sans text-[18px] md:text-[24px] text-black/80 mt-4 max-w-[800px]">A full suite of digital product services under one roof.</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 md:gap-10">
        {services.map((service) => (
          <div id={service.id} class="flex flex-col gap-6 rounded-[20px] bg-white p-8 md:p-10 shadow-md border-t-4 border-primary-blue transition-transform hover:-translate-y-1 scroll-mt-24">
            <div class="flex flex-col gap-4">
              <div class="flex h-[60px] w-[60px] items-center justify-center rounded-[12px] bg-light-aqua text-primary-blue mb-2">
                <svg class="h-8 w-8" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d={service.icon} />
                </svg>
              </div>
              <h3 class="font-roboto text-[24px] md:text-[32px] font-bold text-black m-0">{service.title}</h3>
              <p class="font-sans text-[16px] md:text-[18px] font-normal leading-relaxed text-black/80 m-0 min-h-[54px]">{service.description}</p>
            </div>
            
            <div class="border-t border-black/10 pt-6 mt-auto">
              <h4 class="font-roboto text-[16px] font-bold text-black uppercase tracking-wider mb-4">Core Deliverables</h4>
              <ul class="flex flex-col gap-3">
                {service.deliverables.map(item => (
                  <li class="flex items-start gap-3">
                    <svg width="20" height="20" viewBox="0 0 34 26" fill="none" class="flex-shrink-0 mt-1">
                      <path d="M2.5 13L11.5 22L31.5 2" class="stroke-primary-blue" stroke-width="4" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                    <span class="font-sans text-[16px] leading-tight text-black font-medium">{item}</span>
                  </li>
                ))}
              </ul>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- How We Work (Simplified Process) -->
    <section class="mx-auto w-full max-w-[1289px] mt-20 md:mt-32 pb-12">
      <div class="flex flex-col items-center md:items-start text-center md:text-left mb-12">
        <h2 class="font-roboto text-[32px] md:text-[48px] font-bold text-black m-0">How we work</h2>
        <p class="font-sans text-[18px] md:text-[24px] text-black/80 mt-4 max-w-[800px]">A straightforward, transparent process designed for business owners, not just developers.</p>
      </div>
      
      <div class="grid grid-cols-1 md:grid-cols-4 gap-6 md:gap-8">
        {processSteps.map((step) => (
          <div class="flex flex-col gap-4">
            <span class="font-roboto text-[48px] md:text-[64px] font-bold text-primary-blue/20 leading-none">{step.step}</span>
            <h3 class="font-roboto text-[22px] md:text-[28px] font-bold text-black m-0">{step.title}</h3>
            <p class="font-sans text-[16px] md:text-[18px] font-normal leading-relaxed text-black/80 m-0">{step.description}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- Focused Business CTA -->
    <section class="mx-auto mt-8 w-full max-w-[1125px] relative z-10 mb-12">
       <div class="flex flex-col items-center justify-center rounded-[20px] bg-dark-blue px-6 py-12 md:py-20 text-center shadow-lg w-full">
         <h2 class="font-roboto text-[32px] md:text-[48px] font-bold text-white m-0 mb-4">Ready to start your project?</h2>
         <p class="font-sans text-[18px] md:text-[24px] text-white/90 m-0 mb-8 max-w-[600px]">Tell us what you need built, and we'll help you figure out the best way to get it done.</p>
         <Button href="/contact" label="Request a Quote" variant="primary" />
       </div>
    </section>

  </div>
</Layout>
