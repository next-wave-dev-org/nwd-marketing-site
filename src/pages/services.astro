---
import Layout from '../layouts/Layout.astro';
import ContactSection from '../components/ContactSection.astro';
import ServiceOfferCard from '../components/ServiceOfferCard.astro';
import ClientFrameworkCard from '../components/ClientFrameworkCard.astro';

const services = [
	{ 
		title: 'Research', 
		subtitle: 'Technical Discovery', 
		description: 'We audit your competitors, research your customers, and build a technical roadmap to set your project up for success.', 
		href: '/services/research' 
	},
	{ 
		title: 'Design', 
		subtitle: 'User Experience (UX/UI)', 
		description: 'We craft intuitive, user-friendly digital interfaces tailored to your organization\'s brand and audience needs.', 
		href: '/services/design' 
	},
	{ 
		title: 'Back-End', 
		subtitle: 'Database & APIs', 
		description: 'We build secure, scalable database architectures and server-side logic to power your digital operations.', 
		href: '/services/back-end' 
	},
	{ 
		title: 'Front-End', 
		subtitle: 'Web & App Development', 
		description: 'We develop responsive, accessible websites and custom web applications using modern frameworks.', 
		href: '/services/front-end' 
	},
	{ 
		title: 'Quality Assurance', 
		subtitle: 'Testing & Maintenance', 
		description: 'We rigorously test your software across devices to ensure ongoing reliability, security, and performance.', 
		href: '/services/quality-assurance' 
	},
	{ 
		title: 'Marketing', 
		subtitle: 'Digital Campaigns', 
		description: 'We create and execute targeted digital campaigns to amplify your mission and grow your audience.', 
		href: '/services/marketing' 
	}
];

const frameworkSteps = [
	{ title: 'NWD Discovery', description: 'We start by assessing your needs, mapping requirements, and building an initial project roadmap.' },
	{ title: 'Managed Subscription', description: 'Get ongoing monthly capacity for continuous product improvements, updates, and testing.' },
	{ title: 'Custom Projects', description: 'For larger engagements, we scope, price, and execute dedicated builds outside of subscription limits.' }
];
---

<Layout title="Our Services | Next Wave Dev" description="Explore the full range of digital services we offer.">
  <div class="mx-auto w-full max-w-[1440px] overflow-hidden bg-light-aqua px-0 pb-0 pt-10 text-black md:pt-12">
    
    <!-- Hero Section -->
    <section class="mx-auto w-full max-w-[1289px] px-5 md:px-8">
      
      <!-- MOBILE (< 768px) STACKED LAYOUT FIX -->
      <div class="w-full rounded-[10px] bg-gradient-to-b from-light-aqua to-secondary-blue p-6 shadow-md mt-4 md:hidden">
        <div class="flex flex-col items-center text-center gap-6 w-full">
          <div class="flex h-[150px] w-[150px] shrink-0 items-center justify-center rounded-full bg-primary-blue shadow-md mx-auto p-2">
            <h1 class="font-heading text-[18px] sm:text-[20px] font-bold leading-none text-hero-text text-center drop-shadow-sm [text-shadow:-1px_-1px_0_#D49A1D,_1px_-1px_0_#D49A1D,_-1px_1px_0_#D49A1D,_1px_1px_0_#D49A1D] break-words">
              Our<br/>Services
            </h1>
          </div>
          <div class="flex flex-col gap-3 w-full">
            <h2 class="font-roboto text-[22px] font-bold leading-tight text-black break-words">
              What we can do for you
            </h2>
            <p class="font-sans text-[15px] font-normal leading-relaxed text-black">
              Explore our comprehensive suite of digital services. From user-centric design to robust back-end architecture, our teams are equipped to bring your organization's vision to life with modern, scalable technology.
            </p>
          </div>
        </div>
      </div>

      <!-- DESKTOP (>= 768px) Standardized Layout -->
      <div class="hidden md:flex mx-auto w-full flex-col overflow-hidden rounded-[10px] bg-gradient-to-b from-light-aqua to-secondary-blue shadow-lg">
        <section class="relative flex h-[489px] w-full items-center">
          
          <!-- Badge -->
          <div class="absolute left-[47px] top-[19px] z-10 flex h-[390px] w-[390px] items-center justify-center rounded-full bg-primary-blue shadow-lg">
            <h1 class="m-0 text-center font-heading text-[56px] font-bold leading-[1.2] text-hero-text drop-shadow-card [text-shadow:-3px_-3px_0_#D49A1D,_3px_-3px_0_#D49A1D,_-3px_3px_0_#D49A1D,_3px_3px_0_#D49A1D]">
              Our<br/>Services
            </h1>
          </div>
          
          <!-- Text Content overlapping gradient background -->
          <div class="absolute left-[470px] flex w-[650px] flex-col gap-4 text-left z-10">
            <h2 class="m-0 font-roboto text-[56px] font-bold leading-tight text-black">
              What we can do for you
            </h2>
            <p class="m-0 font-sans text-[24px] font-normal leading-[33px] text-black">
              Explore our comprehensive suite of digital services. From user-centric design to robust back-end architecture, our teams are equipped to bring your organization's vision to life with modern, scalable technology.
            </p>
          </div>
          
        </section>
      </div>
      
    </section>

    <!-- Services Grid Section -->
    <section class="mx-auto mt-20 w-full max-w-[1302px] md:mt-32">
      
      <!-- MOBILE (< 768px) -->
      <div class="flex flex-col items-center w-full gap-8 md:hidden">
        <h2 class="font-roboto text-[40px] font-bold text-black text-center px-6 m-0">All Services</h2>
        <div class="carousel-wrapper relative w-full mt-4">
          <div class="carousel-container flex overflow-x-auto snap-x snap-mandatory gap-6 px-6 pb-2 hide-scrollbars w-full items-stretch">
            {services.map((service) => (
              <div class="shrink-0 w-[85vw] max-w-[400px] snap-center flex">
                <ServiceOfferCard 
                  title={service.title} 
                  subtitle={service.subtitle} 
                  description={service.description}
                  href={service.href} 
                />
              </div>
            ))}
          </div>
          <div class="flex justify-center mt-6">
            <div class="inline-flex items-center gap-[30px] rounded-[30px] border border-black px-[30px] py-[6px]">
              <button type="button" class="carousel-prev flex h-[50px] w-[50px] items-center justify-center rounded-full bg-black text-[28px] text-card-arrow transition-opacity" aria-label="Scroll left">&#8249;</button>
              <button type="button" class="carousel-next flex h-[50px] w-[50px] items-center justify-center rounded-full bg-black text-[28px] text-card-arrow transition-opacity" aria-label="Scroll right">&#8250;</button>
            </div>
          </div>
        </div>
      </div>

      <!-- DESKTOP (>= 768px) -->
      <div class="hidden md:flex flex-col w-full px-8">
        <h2 class="font-roboto text-[64px] font-bold text-black mb-12">All Services</h2>
        <div class="grid grid-cols-3 gap-x-[15px] gap-y-[78px]">
          {services.map((service) => (
            <ServiceOfferCard 
              title={service.title} 
              subtitle={service.subtitle} 
              description={service.description}
              href={service.href} 
            />
          ))}
        </div>
      </div>
      
    </section>

    <!-- Client Framework Section -->
    <section class="mx-auto mt-20 flex w-full max-w-[1368px] flex-col gap-10 md:mt-32">
      
      <!-- MOBILE (< 768px) -->
      <div class="flex flex-col items-center w-full gap-8 text-center md:hidden">
        <h2 class="font-roboto text-[36px] font-bold text-black px-6 m-0">Client Framework</h2>
        <p class="font-sans text-[16px] font-normal leading-relaxed text-black px-6 m-0">
          We believe in transparent, structured partnerships designed to provide clear communication, predictable timelines, and continuous support.
        </p>
        <div class="carousel-wrapper relative w-full mt-4">
          <div class="carousel-container flex overflow-x-auto snap-x snap-mandatory gap-6 px-6 pb-2 hide-scrollbars w-full">
            {frameworkSteps.map((step, index) => (
              <div class="shrink-0 w-[85vw] max-w-[350px] snap-center">
                <ClientFrameworkCard 
                  number={index + 1}
                  title={step.title}
                  description={step.description}
                />
              </div>
            ))}
          </div>
          <div class="flex justify-center mt-6">
            <div class="inline-flex items-center gap-[30px] rounded-[30px] border border-black px-[30px] py-[6px]">
              <button type="button" class="carousel-prev flex h-[50px] w-[50px] items-center justify-center rounded-full bg-black text-[28px] text-card-arrow transition-opacity" aria-label="Scroll left">&#8249;</button>
              <button type="button" class="carousel-next flex h-[50px] w-[50px] items-center justify-center rounded-full bg-black text-[28px] text-card-arrow transition-opacity" aria-label="Scroll right">&#8250;</button>
            </div>
          </div>
        </div>
      </div>

      <!-- DESKTOP (>= 768px) -->
      <div class="hidden md:flex flex-col w-full px-8">
        <div class="flex items-center justify-between pr-20">
          <div class="flex flex-col gap-2">
            <h2 class="font-roboto text-[48px] font-bold text-black m-0">Client Framework</h2>
            <p class="font-sans text-[24px] font-normal leading-relaxed text-black w-[600px] m-0">
              We believe in transparent, structured partnerships designed to provide clear communication, predictable timelines, and continuous support.
            </p>
          </div>
        </div>
        <div class="flex justify-center gap-[67px] mt-10">
          {frameworkSteps.map((step, index) => (
            <ClientFrameworkCard 
              number={index + 1}
              title={step.title}
              description={step.description}
            />
          ))}
        </div>
      </div>
      
    </section>

    <!-- Contact Form -->
    <section class="mx-auto mt-16 w-full max-w-[1125px] relative z-10 px-5 md:px-8 md:mt-24 mb-12">
       <ContactSection />
    </section>

  </div>
</Layout>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const carousels = document.querySelectorAll('.carousel-wrapper:not(.initialized)');
    carousels.forEach(wrapper => {
      wrapper.classList.add('initialized');
      const container = wrapper.querySelector('.carousel-container');
      const prevBtn = wrapper.querySelector('.carousel-prev');
      const nextBtn = wrapper.querySelector('.carousel-next');

      if (!container || !prevBtn || !nextBtn) return;

      prevBtn.addEventListener('click', () => {
        container.scrollBy({ left: -container.clientWidth * 0.8, behavior: 'smooth' });
      });

      nextBtn.addEventListener('click', () => {
        container.scrollBy({ left: container.clientWidth * 0.8, behavior: 'smooth' });
      });
    });
  });
</script>

<style is:global>
  .hide-scrollbars {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
  .hide-scrollbars::-webkit-scrollbar {
    display: none;
  }
</style>
