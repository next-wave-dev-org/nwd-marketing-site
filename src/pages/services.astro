---
import Layout from '../layouts/Layout.astro';
import ContactSection from '../components/ContactSection.astro';
import ServiceOfferCard from '../components/ServiceOfferCard.astro';
import ClientFrameworkCard from '../components/ClientFrameworkCard.astro';

const services = [
	{ title: 'Discovery & Strategy', subtitle: 'Project Planning', description: 'We learn about your business, research your audience, and build a clear plan to reach your goals.', href: '/services/research' },
	{ title: 'UX & Design', subtitle: 'User Experience', description: 'We create intuitive, beautiful, and easy-to-use interfaces tailored specifically to your customers.', href: '/services/design' },
	{ title: 'Website Development', subtitle: 'Front-End Engineering', description: 'We build fast, accessible, mobile-friendly websites that look great and work flawlessly on every device.', href: '/services/front-end' },
	{ title: 'Custom Apps', subtitle: 'Back-End Systems', description: 'We develop secure, reliable custom web applications and systems to power your daily operations.', href: '/services/back-end' },
	{ title: 'Testing & Support', subtitle: 'Quality Assurance', description: 'We rigorously test and maintain your digital products to ensure they remain secure and up-to-date.', href: '/services/quality-assurance' },
	{ title: 'Digital Growth', subtitle: 'Marketing Campaigns', description: 'We design and execute digital campaigns to connect you with your audience and amplify your mission.', href: '/services/marketing' }
];

const frameworkSteps = [
	{ title: '1. Discovery & Planning', description: 'We start by assessing your needs, mapping requirements, and building a clear project roadmap.' },
	{ title: '2. Monthly Care & Updates', description: 'Get ongoing, dedicated support for continuous improvements, security updates, and new features.' },
	{ title: '3. Custom Builds', description: 'For brand new websites or large applications, we scope, price, and execute dedicated projects.' }
];
---

<Layout title="Our Services | Next Wave Dev" description="Explore the full range of digital services we offer.">
  <div class="mx-auto w-full max-w-[1440px] overflow-hidden bg-light-aqua px-0 pb-0 pt-10 text-black md:pt-12">
    
    <section class="mx-auto w-full max-w-[1289px] px-5 md:px-8">
      
      <!-- MOBILE (< 768px) -->
      <div class="w-full rounded-[10px] bg-gradient-to-b from-light-aqua to-secondary-blue p-6 shadow-md mt-4 md:hidden">
        <div class="flex flex-col items-center text-center gap-6 w-full">
          <div class="flex h-[150px] w-[150px] shrink-0 items-center justify-center rounded-full bg-primary-blue shadow-md mx-auto p-2">
            <h1 class="w-full font-heading text-[18px] sm:text-[20px] font-bold leading-tight text-hero-text text-center drop-shadow-sm [text-shadow:-1px_-1px_0_#D49A1D,_1px_-1px_0_#D49A1D,_-1px_1px_0_#D49A1D,_1px_1px_0_#D49A1D] break-words">
              Our<br/>Services
            </h1>
          </div>
          <div class="flex flex-col gap-3 w-full">
            <h2 class="font-roboto text-[22px] font-bold leading-tight text-black break-words">What we can do for you</h2>
            <p class="font-sans text-[15px] font-normal leading-relaxed text-black">We build and maintain websites, apps, and digital campaigns that help your organization grow and thrive online. From strategy to ongoing support, our teams are equipped to bring your vision to life.</p>
          </div>
        </div>
      </div>

      <!-- DESKTOP (>= 768px) -->
      <div class="hidden md:flex mx-auto w-full flex-col overflow-hidden rounded-[10px] bg-gradient-to-b from-light-aqua to-secondary-blue shadow-lg">
        <section class="relative flex h-[489px] w-full items-center">
          <div class="absolute left-[47px] top-[19px] z-10 flex h-[390px] w-[390px] items-center justify-center rounded-full bg-primary-blue shadow-lg p-8">
            <h1 class="w-full text-center font-heading text-[48px] lg:text-[52px] font-bold leading-tight text-hero-text drop-shadow-card [text-shadow:-3px_-3px_0_#D49A1D,_3px_-3px_0_#D49A1D,_-3px_3px_0_#D49A1D,_3px_3px_0_#D49A1D] break-words">
              Our<br/>Services
            </h1>
          </div>
          <div class="absolute left-[470px] flex w-[650px] flex-col gap-4 text-left z-10 pr-8">
            <h2 class="m-0 font-roboto text-[56px] font-bold leading-tight text-black">What we can do for you</h2>
            <p class="m-0 font-sans text-[24px] font-normal leading-[33px] text-black">We build and maintain websites, apps, and digital campaigns that help your organization grow and thrive online. From strategy to ongoing support, our teams are equipped to bring your vision to life.</p>
          </div>
        </section>
      </div>
      
    </section>

    <!-- Services Grid Section -->
    <section class="mx-auto mt-20 w-full max-w-[1302px] md:mt-32">
      <!-- MOBILE (< 768px) -->
      <div class="flex flex-col items-center w-full gap-8 md:hidden">
        <h2 class="font-roboto text-[40px] font-bold text-black text-center px-6 m-0">All Services</h2>
        <div class="carousel-wrapper relative w-full mt-4">
          <div class="carousel-container flex overflow-x-auto snap-x snap-mandatory gap-6 px-6 pb-2 hide-scrollbars w-full items-stretch">
            {services.map((service) => (
              <div class="shrink-0 w-[85vw] max-w-[400px] snap-center flex">
                <ServiceOfferCard title={service.title} subtitle={service.subtitle} description={service.description} href={service.href} />
              </div>
            ))}
          </div>
        </div>
      </div>
      <!-- DESKTOP (>= 768px) -->
      <div class="hidden md:flex flex-col w-full px-8">
        <h2 class="font-roboto text-[64px] font-bold text-black mb-12">All Services</h2>
        <div class="grid grid-cols-3 gap-x-[15px] gap-y-[78px]">
          {services.map((service) => (
            <ServiceOfferCard title={service.title} subtitle={service.subtitle} description={service.description} href={service.href} />
          ))}
        </div>
      </div>
    </section>

    <!-- Client Framework Section -->
    <section class="mx-auto mt-20 flex w-full max-w-[1368px] flex-col gap-10 md:mt-32">
      <!-- MOBILE (< 768px) -->
      <div class="flex flex-col items-center w-full gap-8 text-center md:hidden">
        <h2 class="font-roboto text-[36px] font-bold text-black px-6 m-0">Client Framework</h2>
        <p class="font-sans text-[16px] font-normal leading-relaxed text-black px-6 m-0">We believe in transparent, structured partnerships designed to provide clear communication, predictable timelines, and continuous support.</p>
        <div class="carousel-wrapper relative w-full mt-4">
          <div class="carousel-container flex overflow-x-auto snap-x snap-mandatory gap-6 px-6 pb-2 hide-scrollbars w-full">
            {frameworkSteps.map((step, index) => (
              <div class="shrink-0 w-[85vw] max-w-[350px] snap-center">
                <ClientFrameworkCard number={index + 1} title={step.title} description={step.description} />
              </div>
            ))}
          </div>
        </div>
      </div>
      <!-- DESKTOP (>= 768px) -->
      <div class="hidden md:flex flex-col w-full px-8">
        <div class="flex items-center justify-between pr-20">
          <div class="flex flex-col gap-2">
            <h2 class="font-roboto text-[48px] font-bold text-black m-0">Client Framework</h2>
            <p class="font-sans text-[24px] font-normal leading-relaxed text-black w-[600px] m-0">We believe in transparent, structured partnerships designed to provide clear communication, predictable timelines, and continuous support.</p>
          </div>
        </div>
        <div class="flex justify-center gap-[67px] mt-10">
          {frameworkSteps.map((step, index) => (
            <ClientFrameworkCard number={index + 1} title={step.title} description={step.description} />
          ))}
        </div>
      </div>
    </section>

    <section class="mx-auto mt-16 w-full max-w-[1125px] relative z-10 px-5 md:px-8 md:mt-24 mb-12">
       <ContactSection />
    </section>

  </div>
</Layout>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const carousels = document.querySelectorAll('.carousel-wrapper:not(.initialized)');
    carousels.forEach(wrapper => {
      wrapper.classList.add('initialized');
      const container = wrapper.querySelector('.carousel-container');
      const prevBtn = wrapper.querySelector('.carousel-prev');
      const nextBtn = wrapper.querySelector('.carousel-next');

      if (!container) return;
      if (prevBtn) prevBtn.addEventListener('click', () => { container.scrollBy({ left: -container.clientWidth * 0.8, behavior: 'smooth' }); });
      if (nextBtn) nextBtn.addEventListener('click', () => { container.scrollBy({ left: container.clientWidth * 0.8, behavior: 'smooth' }); });
    });
  });
</script>

<style is:global>
  .hide-scrollbars { -ms-overflow-style: none; scrollbar-width: none; }
  .hide-scrollbars::-webkit-scrollbar { display: none; }
</style>
