---
// src/pages/contact.astro
import Layout from '../layouts/Layout.astro';
import ContactSection from '../components/ContactSection.astro';
---
<Layout title="Contact Us | Next Wave Dev" description="Get in touch with us to start your project.">
  <div class="mx-auto w-full max-w-[1440px] bg-light-aqua font-sans text-black pb-0 pt-12 overflow-x-hidden">
    <!-- FIX: Changed <main> to <div> to prevent invalid HTML landmarks, removed logo circles -->
    <div class="flex flex-col w-full px-6 md:px-[115px] pb-12">
      <ContactSection />
    </div>
  </div>
</Layout>
