---
// src/pages/contact.astro
import Layout from '../layouts/Layout.astro';
import ContactSection from '../components/ContactSection.astro';
---
<Layout title="Contact Us | Next Wave Dev" description="Get in touch with us to start your project.">
  <!-- Changed pb-20 md:pb-[200px] to pb-0 -->
  <div class="mx-auto w-full max-w-[1440px] bg-light-aqua font-sans text-black pb-0 pt-12 overflow-x-hidden">
    <main class="flex flex-col w-full px-6 md:px-[115px] pb-12">
      <ContactSection />
      <div class="mt-[100px] md:mt-[150px] w-full max-w-[1125px] mx-auto">
        <div aria-label="Partner logos" class="relative flex justify-center gap-6 md:gap-[47px] w-full items-center">
          <div class="flex h-[120px] w-[120px] md:h-[168px] md:w-[168px] shrink-0 items-center justify-center rounded-full bg-primary-blue shadow-md transition-transform hover:scale-105 overflow-hidden">
            <img src="/images/partner-dtb-logo.png" alt="DTB Art Market Partner" class="h-full w-full object-cover" />
          </div>
          <div class="flex h-[120px] w-[120px] md:h-[168px] md:w-[168px] shrink-0 items-center justify-center rounded-full bg-primary-blue shadow-md transition-transform hover:scale-105 overflow-hidden">
            <img src="/images/partner-ccg-logo.png" alt="CCG Partner" class="h-full w-full object-cover" />
          </div>
        </div>
      </div>
    </main>
  </div>
</Layout>
