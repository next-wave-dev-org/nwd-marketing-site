---
import Layout from '../layouts/Layout.astro';
import ContactSection from '../components/ContactSection.astro';
---
<Layout title="Legal | Next Wave Dev" description="Legal information and disclosures.">
  <div class="mx-auto w-full max-w-[1440px] overflow-hidden bg-light-aqua px-5 pb-0 pt-10 text-black md:px-8 md:pt-12">
    <section class="mx-auto w-full max-w-[1289px] px-5 md:px-0">
      
      <!-- MOBILE (< 768px) -->
      <div class="w-full rounded-[10px] bg-gradient-to-b from-light-aqua to-secondary-blue p-6 shadow-md mt-4 md:hidden">
        <div class="flex flex-col items-center text-center gap-6 w-full">
          <div class="flex h-[150px] w-[150px] shrink-0 items-center justify-center rounded-full bg-primary-blue shadow-md mx-auto p-2">
            <h1 class="w-full font-heading text-[18px] sm:text-[20px] font-bold leading-tight text-hero-text text-center drop-shadow-sm [text-shadow:-1px_-1px_0_#D49A1D,_1px_-1px_0_#D49A1D,_-1px_1px_0_#D49A1D,_1px_1px_0_#D49A1D] break-words">
              Legal
            </h1>
          </div>
          <div class="flex flex-col gap-3 w-full">
            <h2 class="font-roboto text-[22px] font-bold leading-tight text-black break-words">Legal Information</h2>
            <p class="font-sans text-[15px] font-normal leading-relaxed text-black">Important legal notices, disclaimers, and corporate policies regarding Next Wave Dev and our services.</p>
          </div>
        </div>
      </div>

      <!-- DESKTOP (>= 768px) Standardized Layout -->
      <div class="hidden md:flex mx-auto w-full flex-col overflow-hidden rounded-[10px] bg-gradient-to-b from-light-aqua to-secondary-blue shadow-lg">
        <section class="relative flex h-[489px] w-full items-center">
          <div class="absolute left-[47px] top-[19px] z-10 flex h-[390px] w-[390px] items-center justify-center rounded-full bg-primary-blue shadow-lg p-8">
            <h1 class="w-full text-center font-heading text-[48px] lg:text-[52px] font-bold leading-tight text-hero-text drop-shadow-card [text-shadow:-3px_-3px_0_#D49A1D,_3px_-3px_0_#D49A1D,_-3px_3px_0_#D49A1D,_3px_3px_0_#D49A1D] break-words">
              Legal
            </h1>
          </div>
          <div class="absolute left-[470px] flex w-[650px] flex-col gap-4 text-left z-10 pr-8">
            <h2 class="m-0 font-roboto text-[48px] lg:text-[56px] font-bold leading-[1.1] text-black break-words">Legal Information</h2>
            <p class="m-0 font-sans text-[22px] lg:text-[24px] font-normal leading-[33px] text-black">Important legal notices, disclaimers, and corporate policies regarding Next Wave Dev and our services.</p>
          </div>
        </section>
      </div>
    </section>

    <!-- Content Block -->
    <section class="mx-auto w-full max-w-[1000px] mt-16 md:mt-24 pb-12">
      <div class="flex flex-col gap-8 rounded-[20px] bg-white p-8 shadow-md lg:p-12">
        <div class="flex flex-col gap-4">
          <h3 class="font-roboto text-[24px] md:text-[32px] font-bold text-black">General Disclaimer</h3>
          <p class="font-sans text-[16px] md:text-[18px] font-normal leading-relaxed text-black">The information provided by Next Wave Dev on this website is for general informational purposes only. While we strive to keep the information up-to-date and correct, we make no representations or warranties of any kind, express or implied, about the completeness, accuracy, reliability, suitability, or availability with respect to the website or the information, products, or services contained on the website for any purpose.</p>
        </div>
        <div class="flex flex-col gap-4">
          <h3 class="font-roboto text-[24px] md:text-[32px] font-bold text-black">Intellectual Property</h3>
          <p class="font-sans text-[16px] md:text-[18px] font-normal leading-relaxed text-black">All content, features, and functionality on this website—including but not limited to text, graphics, logos, and digital assets—are the exclusive property of Next Wave Dev or its partners and are protected by copyright, trademark, and other intellectual property laws. Unauthorized use or reproduction of our materials is strictly prohibited.</p>
        </div>
      </div>
    </section>

    <!-- Contact Form -->
    <section class="mx-auto mt-8 w-full max-w-[1125px] relative z-10 mb-12">
       <ContactSection />
    </section>
  </div>
</Layout>