---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Legal | Next Wave Dev" description="Legal information and disclosures.">
  <div class="mx-auto w-full max-w-[1440px] overflow-hidden bg-background px-5 pb-0 pt-10 text-white md:px-8 md:pt-12">
    <section class="mx-auto w-full max-w-[1289px] px-0">
      
      <!-- UNIFIED RESPONSIVE PAGE HERO -->
      <div class="w-full flex flex-col md:overflow-hidden rounded-[10px] bg-gradient-to-b from-[#16132A] to-[#0F0C20] border border-border-subtle p-6 md:p-0 shadow-xl mt-4 md:mt-0">
        <section class="relative flex flex-col md:flex-row md:h-[489px] w-full items-center text-center md:text-left gap-6 md:gap-0">
          
          <div class="md:absolute md:left-[47px] md:top-[19px] z-10 flex h-[150px] w-[150px] md:h-[390px] md:w-[390px] shrink-0 items-center justify-center rounded-full bg-accent-primary border border-border-subtle shadow-2xl mx-auto md:mx-0 p-2 md:p-8">
            <span class="block w-full font-heading text-[18px] sm:text-[20px] md:text-[48px] lg:text-[52px] font-bold leading-tight md:leading-[1.1] text-white text-center drop-shadow-md break-words">
              Legal
            </span>
          </div>
          
          <div class="md:absolute md:left-[470px] flex flex-col w-full md:w-[650px] gap-3 md:gap-4 z-10 md:pr-8">
            <h1 class="m-0 font-roboto text-[22px] md:text-[48px] lg:text-[56px] font-bold leading-tight md:leading-[1.1] text-white break-words">Legal Information</h1>
            <p class="m-0 font-sans text-[15px] md:text-[22px] lg:text-[24px] font-normal leading-relaxed md:leading-[33px] text-text-body">Important legal notices, disclaimers, and corporate policies regarding Next Wave Dev and our services.</p>
          </div>
          
        </section>
      </div>
      
    </section>

    <!-- Content Block -->
    <section class="mx-auto w-full max-w-[1000px] mt-16 md:mt-24 pb-12">
      <div class="flex flex-col gap-8 rounded-[20px] bg-surface border border-border-subtle p-8 shadow-xl lg:p-12">
        <div class="flex flex-col gap-4">
          <h3 class="font-roboto text-[24px] md:text-[32px] font-bold text-white">General Disclaimer</h3>
          <p class="font-sans text-[16px] md:text-[18px] font-normal leading-relaxed text-text-body">The information provided by Next Wave Dev on this website is for general informational purposes only. While we strive to keep the information up-to-date and correct, we make no representations or warranties of any kind, express or implied, about the completeness, accuracy, reliability, suitability, or availability with respect to the website or the information, products, or services contained on the website for any purpose.</p>
        </div>
        <div class="flex flex-col gap-4">
          <h3 class="font-roboto text-[24px] md:text-[32px] font-bold text-white">Intellectual Property</h3>
          <p class="font-sans text-[16px] md:text-[18px] font-normal leading-relaxed text-text-body">All content, features, and functionality on this website—including but not limited to text, graphics, logos, and digital assets—are the exclusive property of Next Wave Dev or its partners and are protected by copyright, trademark, and other intellectual property laws. Unauthorized use or reproduction of our materials is strictly prohibited.</p>
        </div>
      </div>
    </section>
  </div>
</Layout>