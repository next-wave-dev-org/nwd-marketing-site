---
import Layout from '../layouts/Layout.astro';
import ContactSection from '../components/ContactSection.astro';
---

<Layout title="Legal | Next Wave Dev" description="Legal information and disclosures.">
  <div class="mx-auto w-full max-w-[1440px] overflow-hidden bg-light-aqua px-5 pb-16 pt-10 text-black md:px-8 md:pb-24 md:pt-12">
    
    <!-- Hero Section -->
    <section class="mx-auto w-full max-w-[1202px]">
      <div class="grid grid-cols-[186px_1fr] items-center gap-6 md:grid-cols-[529px_1fr] md:gap-[128px]">
        
        <!-- Badge -->
        <div class="relative h-[220px] w-[186px] overflow-hidden rounded-[10px] bg-gradient-to-b from-light-aqua to-secondary-blue md:h-[560px] md:w-full">
          <div class="absolute left-1/2 top-1/2 h-[160px] w-[160px] -translate-x-1/2 -translate-y-1/2 rounded-full bg-primary-blue md:h-[420px] md:w-[420px]"></div>
          <h1 class="absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 text-center font-heading text-[32px] font-bold leading-[1.15] text-hero-text drop-shadow-[0_4px_4px_rgba(0,0,0,0.25)] md:text-[72px]">
            Legal
          </h1>
        </div>
        
        <!-- Text Content -->
        <div class="max-w-[600px] pl-4 pr-1 md:max-w-[440px] md:translate-x-[130px] md:pl-0 md:pr-0">
          <h2 class="font-roboto text-[28px] font-bold leading-tight text-black md:text-[56px] md:leading-[64px]">
            Legal Information
          </h2>
          <p class="mt-3 font-sans text-[16px] font-normal leading-relaxed text-black md:mt-4 md:text-[24px] md:leading-[33px]">
            Important legal notices, disclaimers, and corporate policies regarding Next Wave Dev and our services.
          </p>
        </div>
        
      </div>
    </section>

    <!-- Content Block -->
    <section class="mx-auto w-full max-w-[1000px] mt-16 md:mt-24 pb-12">
      <div class="flex flex-col gap-8 rounded-[20px] bg-white p-8 shadow-md lg:p-12">
        
        <div class="flex flex-col gap-4">
          <h3 class="font-roboto text-[24px] md:text-[32px] font-bold text-black">General Disclaimer</h3>
          <p class="font-sans text-[16px] md:text-[18px] font-normal leading-relaxed text-black">
            Placeholder text for legal disclaimers. The information provided by Next Wave Dev on this website is for general informational purposes only. All information on the Site is provided in good faith, however we make no representation or warranty of any kind, express or implied, regarding the accuracy, adequacy, validity, reliability, availability, or completeness of any information on the Site.
          </p>
        </div>

        <div class="flex flex-col gap-4">
          <h3 class="font-roboto text-[24px] md:text-[32px] font-bold text-black">Intellectual Property</h3>
          <p class="font-sans text-[16px] md:text-[18px] font-normal leading-relaxed text-black">
            Placeholder text for intellectual property. The Site and its original content, features, and functionality are owned by Next Wave Dev and are protected by international copyright, trademark, patent, trade secret, and other intellectual property or proprietary rights laws.
          </p>
        </div>

      </div>
    </section>

    <!-- Contact Form -->
    <section class="mx-auto mt-8 w-full max-w-[1125px] relative z-10 md:mt-12">
       <ContactSection />
    </section>

  </div>
</Layout>