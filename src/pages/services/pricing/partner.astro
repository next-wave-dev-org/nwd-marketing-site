---
import Layout from '../../../layouts/Layout.astro';
import ContactSection from '../../../components/ContactSection.astro';
---
<Layout title="Partner Package | Next Wave Dev" description="Partner pricing package for large-scale execution - $999/mo">
  <div class="mx-auto w-full max-w-[1440px] bg-light-aqua font-sans text-black pb-20 pt-12 md:pb-[200px] overflow-x-hidden">
    
    <main class="flex flex-col w-full px-6 md:px-[115px] gap-20 md:gap-[150px]">
      
      <!-- Package Header -->
      <section class="flex flex-col items-center text-center mt-12 gap-6 w-full max-w-[800px] mx-auto">
        <h1 class="font-roboto text-[48px] md:text-[64px] font-bold leading-tight text-black m-0">Partner Package</h1>
        <div class="flex items-center justify-center rounded-[30px] bg-primary-blue px-8 py-3 shadow-md">
            <span class="font-roboto text-[32px] font-bold text-white">$999 / mo</span>
        </div>
        <p class="font-sans text-[20px] md:text-[24px] font-normal leading-relaxed text-black mt-4">
          Your ongoing development partner. We act as your dedicated fractional technical team for large-scale custom project execution, strategic planning, and long-term building.
        </p>
        
        <ul class="flex flex-col gap-4 items-start text-left mt-6 bg-white p-8 rounded-[20px] shadow-sm w-full max-w-[500px]">
          <li class="flex items-center gap-4">
            <svg width="24" height="24" viewBox="0 0 34 26" fill="none" class="flex-shrink-0">
              <path d="M2.5 13L11.5 22L31.5 2" class="stroke-primary-blue" stroke-width="4" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
            <span class="font-sans text-[20px] font-bold text-black">45 Monthly Credits</span>
          </li>
          <li class="flex items-center gap-4">
            <svg width="24" height="24" viewBox="0 0 34 26" fill="none" class="flex-shrink-0">
              <path d="M2.5 13L11.5 22L31.5 2" class="stroke-primary-blue" stroke-width="4" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
            <span class="font-sans text-[20px] font-bold text-black">Ongoing development partner</span>
          </li>
          <li class="flex items-center gap-4">
            <svg width="24" height="24" viewBox="0 0 34 26" fill="none" class="flex-shrink-0">
              <path d="M2.5 13L11.5 22L31.5 2" class="stroke-primary-blue" stroke-width="4" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
            <span class="font-sans text-[20px] font-bold text-black">Priority support & strategy</span>
          </li>
        </ul>
      </section>

      <!-- Package Details Breakdown -->
      <section class="flex flex-col md:flex-row gap-12 w-full max-w-[1000px] mx-auto items-start">
        <div class="flex flex-col w-full md:w-1/2 gap-6 bg-white p-8 md:p-10 rounded-[20px] shadow-md h-full">
          <h2 class="font-roboto text-[32px] font-bold text-black m-0">What can 45 credits do?</h2>
          <p class="font-sans text-[18px] leading-[1.6] text-black m-0">
            Forty-five credits provides the capacity of a fractional engineering team. You can undertake significant architectural changes, build robust custom backend features, or undergo entire site redesigns over just a few billing cycles.
          </p>
          <ul class="flex flex-col gap-3 mt-2 list-disc pl-5 font-sans text-[18px] text-black">
            <li>Full-stack feature development (React, Astro, backend APIs)</li>
            <li>Complex database design, migrations, and management</li>
            <li>Custom interactive portals or user dashboards</li>
            <li>Comprehensive brand and design system overhauls</li>
            <li>Dedicated technical strategy and architecture planning</li>
          </ul>
        </div>

        <div class="flex flex-col w-full md:w-1/2 gap-6 bg-gradient-to-b from-light-aqua to-secondary-blue/70 p-8 md:p-10 rounded-[20px] shadow-md h-full border border-black/10">
          <h2 class="font-roboto text-[32px] font-bold text-black m-0">Who is this for?</h2>
          <p class="font-sans text-[18px] leading-[1.6] text-black m-0">
            The Partner Package is built for established organizations that rely heavily on their digital infrastructure to deliver their mission, but do not want the high overhead of maintaining a full-time, in-house tech department.
          </p>
          <p class="font-sans text-[18px] leading-[1.6] text-black m-0">
            By choosing this tier, Next Wave Dev deeply integrates with your operations, offering priority task turnarounds and acting as long-term stewards of your software stack.
          </p>
        </div>
      </section>

      <!-- Ready to Start? (Contact Block) -->
      <ContactSection />
      
    </main>
  </div>
</Layout>