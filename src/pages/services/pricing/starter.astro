---
import Layout from '../../../layouts/Layout.astro';
import ContactSection from '../../../components/ContactSection.astro';
---
<Layout title="Starter Package | Next Wave Dev" description="Starter pricing package for routine maintenance - $199/mo">
  <div class="mx-auto w-full max-w-[1440px] bg-light-aqua font-sans text-black pb-20 pt-12 md:pb-[200px] overflow-x-hidden">
    
    <main class="flex flex-col w-full px-6 md:px-[115px] gap-20 md:gap-[150px]">
      
      <!-- Package Header -->
      <section class="flex flex-col items-center text-center mt-12 gap-6 w-full max-w-[800px] mx-auto">
        <h1 class="font-roboto text-[48px] md:text-[64px] font-bold leading-tight text-black m-0">Starter Package</h1>
        <div class="flex items-center justify-center rounded-[30px] bg-primary-blue px-8 py-3 shadow-md">
            <span class="font-roboto text-[32px] font-bold text-white">$199 / mo</span>
        </div>
        <p class="font-sans text-[20px] md:text-[24px] font-normal leading-relaxed text-black mt-4">
          Perfect for organizations needing routine maintenance. Get essential capacity to keep your digital presence running smoothly, secure, and up-to-date.
        </p>
        
        <ul class="flex flex-col gap-4 items-start text-left mt-6 bg-white p-8 rounded-[20px] shadow-sm w-full max-w-[500px]">
          <li class="flex items-center gap-4">
            <svg width="24" height="24" viewBox="0 0 34 26" fill="none" class="flex-shrink-0">
              <path d="M2.5 13L11.5 22L31.5 2" class="stroke-primary-blue" stroke-width="4" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
            <span class="font-sans text-[20px] font-bold text-black">8 Monthly Credits</span>
          </li>
          <li class="flex items-center gap-4">
            <svg width="24" height="24" viewBox="0 0 34 26" fill="none" class="flex-shrink-0">
              <path d="M2.5 13L11.5 22L31.5 2" class="stroke-primary-blue" stroke-width="4" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
            <span class="font-sans text-[20px] font-bold text-black">Routine improvements</span>
          </li>
          <li class="flex items-center gap-4">
            <svg width="24" height="24" viewBox="0 0 34 26" fill="none" class="flex-shrink-0">
              <path d="M2.5 13L11.5 22L31.5 2" class="stroke-primary-blue" stroke-width="4" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
            <span class="font-sans text-[20px] font-bold text-black">Access to NWD Portal</span>
          </li>
        </ul>
      </section>

      <!-- Package Details Breakdown -->
      <section class="flex flex-col md:flex-row gap-12 w-full max-w-[1000px] mx-auto items-start">
        <div class="flex flex-col w-full md:w-1/2 gap-6 bg-white p-8 md:p-10 rounded-[20px] shadow-md h-full">
          <h2 class="font-roboto text-[32px] font-bold text-black m-0">What can 8 credits do?</h2>
          <p class="font-sans text-[18px] leading-[1.6] text-black m-0">
            Our credit system is designed for maximum transparency. Eight credits give you enough capacity each month to handle vital website upkeep without needing to hire a freelancer or agency on an hourly basis. 
          </p>
          <ul class="flex flex-col gap-3 mt-2 list-disc pl-5 font-sans text-[18px] text-black">
            <li>Content and image swaps on existing pages</li>
            <li>Basic SEO audits and meta-tag updates</li>
            <li>Software, plugin, and security patching</li>
            <li>Minor CSS tweaks and UI bug fixes</li>
            <li>Monthly site health and analytics reports</li>
          </ul>
        </div>

        <div class="flex flex-col w-full md:w-1/2 gap-6 bg-gradient-to-b from-light-aqua to-secondary-blue/70 p-8 md:p-10 rounded-[20px] shadow-md h-full border border-black/10">
          <h2 class="font-roboto text-[32px] font-bold text-black m-0">Who is this for?</h2>
          <p class="font-sans text-[18px] leading-[1.6] text-black m-0">
            This tier is ideal for small non-profits and mission-driven startups that already have a functioning website but lack a dedicated IT or web manager. 
          </p>
          <p class="font-sans text-[18px] leading-[1.6] text-black m-0">
            If you find your team struggling to find the time to post new blog updates, fix broken links, or ensure your site is secure, the Starter Package acts as your reliable webmaster on retainer.
          </p>
        </div>
      </section>

      <!-- Ready to Start? (Contact Block) -->
      <ContactSection />
      
    </main>
  </div>
</Layout>