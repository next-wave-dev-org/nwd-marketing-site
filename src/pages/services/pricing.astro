---
import Layout from '../../layouts/Layout.astro';
import ContactSection from '../../components/ContactSection.astro';
import PricingPackages from '../../components/PricingPackages.astro';
---

<Layout title="Our Pricing | Next Wave Dev" description="Build your service plan">
  <div class="mx-auto w-full max-w-[1440px] overflow-hidden bg-light-aqua px-5 pb-16 pt-10 text-black md:px-8 md:pb-24 md:pt-12">
    
    <!-- Side-by-Side Hero Section -->
    <section class="mx-auto w-full max-w-[1202px]">
      <div class="grid grid-cols-[186px_1fr] items-center gap-6 md:grid-cols-[529px_1fr] md:gap-[128px]">
        
        <!-- Badge -->
        <div class="relative h-[220px] w-[186px] overflow-hidden rounded-[10px] bg-gradient-to-b from-light-aqua to-secondary-blue md:h-[560px] md:w-full">
          <div class="absolute left-1/2 top-1/2 flex h-[160px] w-[160px] -translate-x-1/2 -translate-y-1/2 items-center justify-center rounded-full bg-primary-blue shadow-lg md:h-[420px] md:w-[420px]">
            <h1 class="relative z-10 w-full px-2 text-center font-heading text-[26px] font-bold leading-[1.2] text-hero-text drop-shadow-[0_4px_4px_rgba(0,0,0,0.25)] [text-shadow:-2px_-2px_0_#D49A1D,_2px_-2px_0_#D49A1D,_-2px_2px_0_#D49A1D,_2px_2px_0_#D49A1D] md:px-4 md:text-[56px] md:[text-shadow:-3px_-3px_0_#D49A1D,_3px_-3px_0_#D49A1D,_-3px_3px_0_#D49A1D,_3px_3px_0_#D49A1D]">
              Our<br/>Pricing
            </h1>
          </div>
        </div>
        
        <!-- Text Content -->
        <div class="max-w-[600px] pl-4 pr-1 md:max-w-[440px] md:translate-x-[130px] md:pl-0 md:pr-0">
          <h2 class="font-roboto text-[28px] font-bold leading-tight text-black md:text-[56px] md:leading-[64px]">
            Build your service plan
          </h2>
          <p class="mt-3 font-sans text-[16px] font-normal leading-relaxed text-black md:mt-5 md:text-[24px] md:leading-[33px]">
            Our service packages are designed to allow companies to choose exactly what they are looking for, while maintaining a competitive price calculated at sixty percent of the standard market rate.
          </p>
        </div>
        
      </div>
    </section>

    <!-- Pricing Packages Component Container -->
    <section class="mx-auto w-full max-w-[1310px] mt-24 md:mt-[160px] pb-12">
      <PricingPackages />
    </section>
    
    <!-- Contact Form -->
    <section class="mx-auto mt-8 w-full max-w-[1125px] relative z-10 md:mt-12">
       <ContactSection />
    </section>

  </div>
</Layout>