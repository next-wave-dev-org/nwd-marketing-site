---
import Layout from '../../layouts/Layout.astro';
import ContactSection from '../../components/ContactSection.astro';
import PricingPackages from '../../components/PricingPackages.astro';
---

<Layout title="Our Pricing | Next Wave Dev" description="Build your service plan">
  <div class="mx-auto w-full max-w-[1440px] bg-[#E4F2F5] px-5 pb-16 pt-10 text-black md:px-8 md:pb-24 md:pt-12 overflow-hidden">
    
    <!-- Side-by-Side Hero Section -->
    <section class="mx-auto w-full max-w-[1202px]">
      <div class="grid grid-cols-[186px_1fr] items-center gap-6 md:grid-cols-[400px_1fr] md:gap-[128px]">
        
        <!-- Badge -->
        <div class="relative h-[220px] w-[186px] overflow-hidden rounded-[10px] bg-gradient-to-b from-[#E4F2F5] to-[#509EBF] md:h-[400px] md:w-full">
          <div class="absolute left-1/2 top-1/2 h-[160px] w-[160px] -translate-x-1/2 -translate-y-1/2 rounded-full bg-[#2244CA] md:h-[280px] md:w-[280px]"></div>
          <h1 class="absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 text-center font-unbounded text-[32px] font-bold leading-[1.15] drop-shadow-[0_4px_4px_rgba(0,0,0,0.25)] md:text-[64px]" style="color: #FFFFFF !important;">
            Our<br/>Pricing
          </h1>
        </div>
        
        <!-- Text Content -->
        <div class="w-full max-w-[600px] pl-4 pr-1 md:pl-0 md:pr-0">
          <h2 class="font-roboto text-[26px] font-bold leading-tight md:text-[48px] md:leading-[56px] text-black">
            Build your service plan
          </h2>
          <p class="mt-3 font-open-sans text-[14px] leading-[1.4] md:mt-5 md:text-[22px] md:leading-[32px] text-black">
            Our service packages are designed to allow companies to choose exactly what they are looking for, while maintaining a competitive price calculated at sixty percent of the standard market rate.
          </p>
        </div>
        
      </div>
    </section>

    <!-- Pricing Packages Component Container -->
    <section class="mx-auto w-full max-w-[1310px] mt-24 md:mt-[160px] pb-12">
      <PricingPackages />
    </section>
    
    <!-- Contact Form -->
    <section class="mx-auto mt-8 w-full max-w-[1125px] md:mt-12 relative z-10">
       <ContactSection />
    </section>

  </div>
</Layout>