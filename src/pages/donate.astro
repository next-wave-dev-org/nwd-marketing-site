---
// src/pages/donate.astro
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
---
<Layout title="Donate | Next Wave Dev" description="Support the next generation of developers.">
  <div class="mx-auto w-full max-w-[1440px] bg-background font-sans text-white pb-0 pt-12 overflow-x-hidden">
    <div class="flex flex-col w-full px-6 md:px-[115px] pb-12">
      <section class="relative mx-auto flex min-h-[450px] md:min-h-[600px] w-full max-w-[1289px] flex-col items-center justify-center overflow-hidden rounded-[10px] border border-border-subtle shadow-xl p-6 md:p-12">
        <Image src="/images/hero-wave-innovation.jpg" alt="Marketing wave innovation" width={1920} height={1080} loading="eager" decoding="sync" class="absolute inset-0 h-full w-full object-cover opacity-60" />
        <div class="absolute inset-0 bg-background/60"></div>
        <div class="relative z-10 flex flex-col text-center items-center justify-center">
          <h1 class="font-heading font-bold text-white m-0 drop-shadow-lg">
            <span class="block text-[48px] sm:text-[64px] md:text-[90px] leading-[1.1]">SUPPORT THE</span>
            <span class="block text-[32px] sm:text-[42px] md:text-[72px] leading-[1.2] mt-2 md:mt-4 break-words text-accent-cyan">NEXT WAVE</span>
          </h1>
          <p class="font-sans text-[16px] sm:text-[20px] md:text-[28px] text-text-body tracking-[0.05em] mt-6 md:mt-8 m-0 uppercase font-semibold drop-shadow-md">
            Empower the next generation of developers
          </p>
        </div>
      </section>

      <section class="relative mx-auto mt-12 md:mt-20 w-full max-w-[1224px] min-h-[600px] rounded-[10px] border border-border-subtle bg-surface shadow-2xl overflow-hidden p-4 md:p-10 flex flex-col justify-center">
        <div class="w-full relative">
          <!-- Primary Zeffy Embed -->
          <div data-zeffy-embed data-form-url="/embed/donation-form/support-the-next-wave-of-developers"></div>
          
          <!-- Ad-Blocker / JavaScript Disabled Fallback -->
          <noscript>
            <div class="flex flex-col items-center justify-center w-full p-8 text-center bg-background rounded-panel border border-border-subtle">
              <p class="font-sans text-[18px] text-text-body mb-6">
                It looks like your browser is blocking our embedded donation form.
              </p>
              <a href="https://www.zeffy.com/donation-form/support-the-next-wave-of-developers" target="_blank" rel="noopener noreferrer" class="flex h-[44px] px-8 items-center justify-center rounded-[30px] bg-gradient-to-r from-accent-primary to-accent-secondary font-roboto text-[16px] font-bold text-white transition-all hover:from-accent-secondary hover:to-accent-cyan shadow-md outline-none focus-visible:ring-2 focus-visible:ring-accent-cyan">
                Donate Directly on Zeffy
              </a>
            </div>
          </noscript>

          <!-- Standard Zeffy Fallback (for partial script failures) -->
          <div data-zeffy-embed-fallback style="display:none;">
            <div style="position:relative;overflow:hidden;height:450px;width:100%;">
              <iframe 
                title='Donation form powered by Zeffy' 
                style='position: absolute; border: 0; top:0;left:0;bottom:0;right:0;width:100%;height:100%' 
                data-zeffy-embed-src='https://www.zeffy.com/embed/donation-form/support-the-next-wave-of-developers' 
                allowpaymentrequest 
                allowTransparency="true">
              </iframe>
            </div>
          </div>
          
          <script is:inline
            src="https://www.zeffy.com/embed/v2/zeffy-embed.js"
            onerror="document.querySelectorAll('[data-zeffy-embed-fallback]').forEach(function(el){el.style.display='block';el.querySelectorAll('iframe[data-zeffy-embed-src]').forEach(function(f){f.src=f.getAttribute('data-zeffy-embed-src');});});">
          </script>
        </div>
      </section>
    </div>
  </div>
</Layout>