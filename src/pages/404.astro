---
import Layout from '../layouts/Layout.astro';
import Button from '../components/Button.astro';
---

<Layout
  title="Page Not Found | Next Wave Dev"
  description="The page you are looking for could not be found. Return to the Next Wave Dev homepage."
>
  <section class="mx-auto flex min-h-[60vh] w-full max-w-6xl items-center justify-center px-6 py-16 bg-[#0F0C20] text-white">
    <div class="w-full max-w-2xl rounded-[20px] border border-white/10 bg-[#16132A] p-8 shadow-2xl sm:p-10 text-center">
      <p class="font-sans text-[16px] font-bold uppercase tracking-[0.2em] text-[#38C1ED] m-0">404 Error</p>
      <h1 class="mt-4 font-roboto text-[36px] sm:text-[48px] font-bold text-white leading-tight m-0">We couldn't find that page.</h1>
      <p class="mt-6 font-sans text-[18px] leading-[1.6] text-[#C0C5E2]">
        The link may be outdated or the page may have moved. Head back to the homepage to continue exploring Next Wave Dev.
      </p>
      <div class="mt-10 flex justify-center">
        <Button href="/" variant="primary">Return to Homepage</Button>
      </div>
    </div>
  </section>
</Layout>
