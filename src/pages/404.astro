---
import Layout from '../layouts/Layout.astro';
import Button from '../components/Button.astro';
---

<Layout
  title="Page Not Found | Next Wave Dev"
  description="The page you are looking for could not be found. Return to the Next Wave Dev homepage."
>
  <section class="mx-auto flex min-h-[60vh] w-full max-w-6xl items-center px-6 py-16">
    <div class="w-full max-w-2xl rounded-3xl border border-white/15 bg-slate-900/60 p-8 shadow-card sm:p-10">
      <p class="text-sm font-semibold uppercase tracking-[0.24em] text-primary-blue">404 Error</p>
      <h1 class="mt-4 text-4xl font-bold text-white sm:text-5xl">We couldn&apos;t find that page.</h1>
      <p class="mt-6 text-base leading-8 text-slate-300">
        The link may be outdated or the page may have moved. Head back to the homepage to continue exploring Next Wave Dev.
      </p>
      <div class="mt-8">
        <Button href="/" variant="standard">Return to Homepage</Button>
      </div>
    </div>
  </section>
</Layout>
