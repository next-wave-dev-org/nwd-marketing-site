---
// src/pages/about-us.astro
import Layout from '../layouts/Layout.astro';
import AboutMainSection from '../components/AboutMainSection.astro';
---

<Layout
	title="About Us | Next Wave Dev"
	description="Learn about Next Wave Dev's mission, our talented graduates, and how we deliver human-built digital experiences."
>
	<div class="mx-auto w-full max-w-[1440px] bg-[#F0F0F0] font-sans text-black pb-20 md:pb-[300px] overflow-x-hidden">
		
		<div class="flex flex-col items-center w-full pt-12 gap-16 md:gap-[100px] px-6 md:px-0">
			
			<!-- Replaces the top sections with our new all-in-one component -->
			<AboutMainSection />

		</div>
	</div>
</Layout>
