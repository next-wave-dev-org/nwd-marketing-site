---
// src/pages/about-us.astro
import Layout from '../layouts/Layout.astro';
import AboutMainSection from '../components/AboutMainSection.astro';
import AboutTestimonials from '../components/AboutTestimonials.astro';
import ContactSection from '../components/ContactSection.astro';
---

<Layout
	title="About Us | Next Wave Dev"
	description="Learn about Next Wave Dev's mission, our talented graduates, and how we deliver human-built digital experiences."
>
	<div class="mx-auto w-full max-w-[1440px] overflow-x-hidden bg-light-aqua pb-0 font-sans text-black">
		
		<div class="flex flex-col w-full pt-12 px-6 md:px-0">
			
			<AboutMainSection />
			
			<div class="w-full mt-8 md:mt-16 flex justify-center">
				<AboutTestimonials />
			</div>

			<div class="w-full mt-8 md:mt-16 mb-12 flex justify-center">
				<ContactSection />
			</div>

		</div>
	</div>
</Layout>
