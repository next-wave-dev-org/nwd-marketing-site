---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import ContactSection from '../../components/ContactSection.astro';
import GraduateCategory from '../../components/GraduateCategory.astro';

// Fetch all the .md files
const allGrads = await getCollection('graduates');

// Helper to format the data for the ProfileCards
const formatGrads = (grads: any[]) => grads.map(g => ({
  id: g.id,
  name: g.data.name,
  role: g.data.specialization,
  image: g.data.image
}));

// Filter the .md files into their respective categories
const marketing = allGrads.filter(g => g.data.specialization.includes('Marketing'));
const design = allGrads.filter(g => g.data.specialization.includes('Design'));
const frontend = allGrads.filter(g => g.data.specialization.includes('Front-End'));
const backend = allGrads.filter(g => g.data.specialization.includes('Back-End'));

const categories = [
  { title: "Marketing Specialists", graduates: formatGrads(marketing) },
  { title: "Design Specialists", graduates: formatGrads(design) },
  { title: "Front-End Specialists", graduates: formatGrads(frontend) },
  { title: "Back-End Specialists", graduates: formatGrads(backend) }
];
---

<Layout title="Our Team | Next Wave Dev" description="See our roster of Team Members">
  <div class="mx-auto w-full max-w-[1440px] bg-light-aqua px-0 pb-16 pt-10 text-black md:pb-24 md:pt-12 overflow-hidden">
    
    <!-- Hero Section -->
    <section class="mx-auto w-full max-w-[1202px] px-5 md:px-8">
      <div class="grid grid-cols-[186px_1fr] items-center gap-6 md:grid-cols-[529px_1fr] md:gap-[128px]">
        
        <!-- Badge -->
        <div class="relative h-[220px] w-[186px] overflow-hidden rounded-[10px] bg-gradient-to-b from-light-aqua to-secondary-blue md:h-[560px] md:w-full">
          <div class="absolute left-1/2 top-1/2 flex h-[160px] w-[160px] -translate-x-1/2 -translate-y-1/2 items-center justify-center rounded-full bg-primary-blue shadow-lg md:h-[420px] md:w-[420px]">
            <h1 class="relative z-10 w-full px-2 text-center font-heading text-[26px] font-bold leading-[1.2] text-hero-text drop-shadow-[0_4px_4px_rgba(0,0,0,0.25)] [text-shadow:-2px_-2px_0_#D49A1D,_2px_-2px_0_#D49A1D,_-2px_2px_0_#D49A1D,_2px_2px_0_#D49A1D] md:px-4 md:text-[56px] md:[text-shadow:-3px_-3px_0_#D49A1D,_3px_-3px_0_#D49A1D,_-3px_3px_0_#D49A1D,_3px_3px_0_#D49A1D]">
              Our<br/>Team
            </h1>
          </div>
        </div>
        
        <!-- Text Content -->
        <div class="max-w-[600px] pl-4 pr-1 md:max-w-[440px] md:translate-x-[130px] md:pl-0 md:pr-0">
          <h2 class="font-roboto text-[28px] font-bold leading-tight text-black md:text-[56px] md:leading-[64px]">
            See our roster of Team Members
          </h2>
          <p class="mt-3 font-sans text-[16px] font-normal leading-relaxed text-black md:mt-4 md:text-[24px] md:leading-[33px]">
            Placeholder text here to fill this section to make it look real. This body text is just random fill to fill this section to make things look real for placeholder purposes. Also more words.
          </p>
        </div>
        
      </div>
    </section>

    <!-- Categories Directory -->
    <section class="mx-auto mt-20 flex w-full flex-col items-center md:mt-[140px]">
      {categories.map(category => (
        <GraduateCategory 
          title={category.title} 
          graduates={category.graduates} 
        />
      ))}
    </section>

    <!-- Contact Form -->
    <section class="mx-auto mt-10 w-full max-w-[1125px] relative z-10 px-5 md:px-8 md:mt-16">
       <ContactSection />
    </section>

  </div>
</Layout>