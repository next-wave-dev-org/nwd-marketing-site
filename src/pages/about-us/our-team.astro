---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import ContactSection from '../../components/ContactSection.astro';
import GraduateCategory from '../../components/GraduateCategory.astro';

const allGrads = await getCollection('graduates');

const formatGrads = (grads: any[]) => grads.map(g => ({
  id: g.id,
  name: g.data.name,
  role: g.data.specialization,
  image: g.data.image
}));

const categories = [
  { title: "Volunteers", graduates: formatGrads(allGrads) }
].filter(category => category.graduates.length > 0);
---

<Layout title="Our Team | Next Wave Dev" description="See our roster of Team Members">
  <div class="mx-auto w-full max-w-[1440px] bg-light-aqua px-0 pb-0 pt-10 text-black md:pt-12 overflow-hidden">
    
    <section class="mx-auto w-full max-w-[1289px] px-5 md:px-0">
      
      <!-- UNIFIED RESPONSIVE PAGE HERO -->
      <div class="w-full flex flex-col md:overflow-hidden rounded-[10px] bg-gradient-to-b from-light-aqua to-secondary-blue p-6 md:p-0 shadow-md md:shadow-lg mt-4 md:mt-0">
        <section class="relative flex flex-col md:flex-row md:h-[489px] w-full items-center text-center md:text-left gap-6 md:gap-0">
          
          <div class="md:absolute md:left-[47px] md:top-[19px] z-10 flex h-[150px] w-[150px] md:h-[390px] md:w-[390px] shrink-0 items-center justify-center rounded-full bg-primary-blue shadow-md md:shadow-lg mx-auto md:mx-0 p-2 md:p-8">
            <span class="block w-full font-heading text-[18px] sm:text-[20px] md:text-[48px] lg:text-[52px] font-bold leading-tight md:leading-[1.1] text-hero-text text-center drop-shadow-sm md:drop-shadow-card [text-shadow:-1px_-1px_0_#D49A1D,_1px_-1px_0_#D49A1D,_-1px_1px_0_#D49A1D,_1px_1px_0_#D49A1D] md:[text-shadow:-3px_-3px_0_#D49A1D,_3px_-3px_0_#D49A1D,_-3px_3px_0_#D49A1D,_3px_3px_0_#D49A1D] break-words">
              Our<br/>Team
            </span>
          </div>
          
          <div class="md:absolute md:left-[470px] flex flex-col w-full md:w-[650px] gap-3 md:gap-4 z-10 md:pr-8">
            <h1 class="m-0 font-roboto text-[22px] md:text-[48px] lg:text-[56px] font-bold leading-tight md:leading-[1.1] text-black break-words">See our roster of dedicated specialists</h1>
            <p class="m-0 font-sans text-[15px] md:text-[22px] lg:text-[24px] font-normal leading-relaxed md:leading-[33px] text-black">Next Wave Dev is powered by a community of talented, recently graduated technologists. Our cross-functional teams bring fresh perspectives, modern skills, and a dedicated focus to every client engagement, ensuring high-quality deliverables across design, engineering, and marketing.</p>
          </div>
          
        </section>
      </div>
      
    </section>

    <!-- Categories Directory -->
    <section class="mx-auto mt-20 flex w-full flex-col items-center md:mt-[140px]">
      {categories.map(category => (
        <GraduateCategory title={category.title} graduates={category.graduates} />
      ))}
    </section>

    <section class="mx-auto mt-10 w-full max-w-[1125px] relative z-10 px-5 mb-12 md:px-8 md:mt-16">
       <ContactSection />
    </section>

  </div>
</Layout>