---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import ContactSection from '../../components/ContactSection.astro';
import GraduateCategory from '../../components/GraduateCategory.astro';

const allGrads = await getCollection('graduates');

const formatGrads = (grads: any[]) => grads.map(g => ({
  id: g.id,
  name: g.data.name,
  role: g.data.specialization,
  image: g.data.image
}));

const marketing = allGrads.filter(g => g.data.specialization.includes('Marketing'));
const design = allGrads.filter(g => g.data.specialization.includes('Design'));
const frontend = allGrads.filter(g => g.data.specialization.includes('Front-End'));
const backend = allGrads.filter(g => g.data.specialization.includes('Back-End'));

const categories = [
  { title: "Marketing Specialists", graduates: formatGrads(marketing) },
  { title: "Design Specialists", graduates: formatGrads(design) },
  { title: "Front-End Specialists", graduates: formatGrads(frontend) },
  { title: "Back-End Specialists", graduates: formatGrads(backend) }
];
---

<Layout title="Our Team | Next Wave Dev" description="See our roster of Team Members">
  <div class="mx-auto w-full max-w-[1440px] bg-light-aqua px-0 pb-16 pt-10 text-black md:pb-24 md:pt-12 overflow-hidden">
    
    <!-- Hero Section -->
    <section class="mx-auto w-full max-w-[1289px] px-5 md:px-0">
      
      <!-- MOBILE (< 768px) -->
      <div class="w-full rounded-[10px] bg-gradient-to-b from-light-aqua to-secondary-blue p-4 sm:p-6 shadow-md mt-4 md:hidden">
        <div class="grid grid-cols-[130px_1fr] sm:grid-cols-[140px_1fr] items-center gap-4 w-full">
          <div class="flex h-[130px] w-[130px] shrink-0 items-center justify-center rounded-full bg-primary-blue shadow-md mx-auto p-2">
            <h1 class="font-heading text-[15px] sm:text-[17px] font-bold leading-tight text-hero-text text-center drop-shadow-sm [text-shadow:-1px_-1px_0_#D49A1D,_1px_-1px_0_#D49A1D,_-1px_1px_0_#D49A1D,_1px_1px_0_#D49A1D] break-words">
              Our<br/>Team
            </h1>
          </div>
          <div class="flex flex-col gap-2 min-w-0 w-full">
            <h2 class="font-roboto text-[20px] sm:text-[22px] font-bold leading-tight text-black break-words">
              See our roster of dedicated specialists
            </h2>
            <p class="font-sans text-[13px] sm:text-[14px] font-normal leading-relaxed text-black">
              Next Wave Dev is powered by a community of talented, recently graduated technologists. Our cross-functional teams bring fresh perspectives, modern skills, and a dedicated focus to every client engagement, ensuring high-quality deliverables across design, engineering, and marketing.
            </p>
          </div>
        </div>
      </div>

      <!-- DESKTOP (>= 768px) Standardized Layout -->
      <div class="hidden md:flex mx-auto w-full flex-col overflow-hidden rounded-[10px] bg-gradient-to-b from-light-aqua to-secondary-blue shadow-lg">
        <section class="relative flex h-[489px] w-full items-center">
          <div class="absolute left-[47px] top-[19px] z-10 flex h-[390px] w-[390px] items-center justify-center rounded-full bg-primary-blue shadow-lg p-6">
            <h1 class="w-full text-center font-heading text-[52px] lg:text-[60px] font-bold leading-[1.1] text-hero-text drop-shadow-card [text-shadow:-3px_-3px_0_#D49A1D,_3px_-3px_0_#D49A1D,_-3px_3px_0_#D49A1D,_3px_3px_0_#D49A1D] break-words">
              Our<br/>Team
            </h1>
          </div>
          <div class="absolute left-[470px] flex w-[650px] flex-col gap-4 text-left z-10 pr-8">
            <h2 class="m-0 font-roboto text-[48px] lg:text-[56px] font-bold leading-[1.1] text-black break-words">
              See our roster of dedicated specialists
            </h2>
            <p class="m-0 font-sans text-[22px] lg:text-[24px] font-normal leading-[33px] text-black">
              Next Wave Dev is powered by a community of talented, recently graduated technologists. Our cross-functional teams bring fresh perspectives, modern skills, and a dedicated focus to every client engagement, ensuring high-quality deliverables across design, engineering, and marketing.
            </p>
          </div>
        </section>
      </div>
      
    </section>

    <!-- Categories Directory -->
    <section class="mx-auto mt-20 flex w-full flex-col items-center md:mt-[140px]">
      {categories.map(category => (
        <GraduateCategory 
          title={category.title} 
          graduates={category.graduates} 
        />
      ))}
    </section>

    <!-- Contact Form -->
    <section class="mx-auto mt-10 w-full max-w-[1125px] relative z-10 px-5 md:px-8 md:mt-16">
       <ContactSection />
    </section>

  </div>
</Layout>