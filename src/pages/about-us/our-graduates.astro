---
import Layout from '../../layouts/Layout.astro';
import ContactSection from '../../components/ContactSection.astro';
import GraduateCategory from '../../components/GraduateCategory.astro';

const generateMockGraduates = (role: string, count: number, startId: number) => {
  return Array.from({ length: count }).map((_, index) => ({
    id: `grad-${startId + index}`,
    name: 'Bob Smith',
    role: role
  }));
};

const categories = [
  {
    title: "Marketing Specialists",
    graduates: generateMockGraduates("Program Manager", 4, 100)
  },
  {
    title: "Design Specialists",
    graduates: generateMockGraduates("Program Manager", 4, 200)
  },
  {
    title: "Front-End Specialists",
    graduates: generateMockGraduates("Program Manager", 4, 300)
  },
  {
    title: "Back-End Specialists",
    graduates: generateMockGraduates("Program Manager", 4, 400)
  }
];
---

<Layout title="Our Graduates | Next Wave Dev" description="See our roster of Graduates">
  <div class="mx-auto w-full max-w-[1440px] overflow-hidden bg-light-aqua px-0 pb-16 pt-10 text-black md:pb-24 md:pt-12">
    
    <!-- Hero Section -->
    <section class="mx-auto w-full max-w-[1202px] px-5 md:px-8">
      <div class="grid grid-cols-[186px_1fr] items-center gap-6 md:grid-cols-[400px_1fr] md:gap-[128px]">
        
        <!-- Badge -->
        <div class="relative h-[220px] w-[186px] overflow-hidden rounded-[10px] bg-gradient-to-b from-light-aqua to-secondary-blue md:h-[400px] md:w-full">
          <div class="absolute left-1/2 top-1/2 h-[160px] w-[160px] -translate-x-1/2 -translate-y-1/2 rounded-full bg-primary-blue md:h-[280px] md:w-[280px]"></div>
          <h1 class="absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 text-center font-heading text-[32px] font-bold leading-[1.15] text-hero-text drop-shadow-[0_4px_4px_rgba(0,0,0,0.25)] md:text-[72px]">
            Our<br/>Grads
          </h1>
        </div>
        
        <!-- Text Content -->
        <div class="w-full max-w-[600px] pl-4 pr-1 md:pl-0 md:pr-0">
          <h2 class="font-roboto text-[26px] font-bold leading-tight md:text-[48px] md:leading-[56px] text-black">
            See our roster of Graduates
          </h2>
          <p class="mt-3 font-sans text-[16px] font-normal leading-relaxed text-black md:mt-5 md:text-[24px] md:leading-[33px]">
            Placeholder text here to fill this section to make it look real. This body text is just random fill to fill this section to make things look real for placeholder purposes. Also more words.
          </p>
        </div>
        
      </div>
    </section>

    <!-- Graduates Categories Directory -->
    <section class="mx-auto mt-20 flex w-full flex-col items-center md:mt-[140px]">
      {categories.map(category => (
        <GraduateCategory 
          title={category.title} 
          graduates={category.graduates} 
        />
      ))}
    </section>

    <!-- Contact Form -->
    <section class="mx-auto mt-10 w-full max-w-[1125px] relative z-10 px-5 md:px-8 md:mt-16">
       <ContactSection />
    </section>

  </div>
</Layout>