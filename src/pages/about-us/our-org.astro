---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import ContactSection from '../../components/ContactSection.astro';
import GraduatesSection from '../../components/GraduatesSection.astro';
import StaffGrid from '../../components/StaffGrid.astro';

const leadershipMembers = [
  { name: 'Taylor Papke', role: 'Founding Board Member', image: '/images/profiles/taylor-papke.png' },
  { name: 'Jesse Caddell', role: 'Founding Board Member', image: '/images/profiles/jesse-caddell.jpeg' },
  { name: 'Robert Bunge', role: 'Board Member', image: '/images/profiles/robert-bunge.jpeg' },
  { name: 'Nicklas Di Pietro', role: 'Board Member', image: '/images/profiles/nicklas-di-pietro.jpeg' }
];

const allGrads = await getCollection('graduates');

const teamData = allGrads.map(g => ({
  id: g.id,
  name: g.data.name,
  image: g.data.image,
  role: g.data.specialization 
}));
---

<Layout title="Our Org | Next Wave Dev" description="Building our community and impact">
  <div class="mx-auto w-full max-w-[1440px] overflow-hidden bg-light-aqua px-5 pb-0 pt-10 text-black md:px-8 md:pt-12">
    
    <section class="mx-auto w-full max-w-[1289px] px-0">
      
      <!-- UNIFIED RESPONSIVE PAGE HERO -->
      <div class="w-full flex flex-col md:overflow-hidden rounded-[10px] bg-gradient-to-b from-light-aqua to-secondary-blue p-6 md:p-0 shadow-md md:shadow-lg mt-4 md:mt-0">
        <section class="relative flex flex-col md:flex-row md:h-[489px] w-full items-center text-center md:text-left gap-6 md:gap-0">
          
          <div class="md:absolute md:left-[47px] md:top-[19px] z-10 flex h-[150px] w-[150px] md:h-[390px] md:w-[390px] shrink-0 items-center justify-center rounded-full bg-primary-blue shadow-md md:shadow-lg mx-auto md:mx-0 p-2 md:p-8">
            <span class="block w-full font-heading text-[18px] sm:text-[20px] md:text-[48px] lg:text-[52px] font-bold leading-tight md:leading-[1.1] text-hero-text text-center drop-shadow-sm md:drop-shadow-card [text-shadow:-1px_-1px_0_#D49A1D,_1px_-1px_0_#D49A1D,_-1px_1px_0_#D49A1D,_1px_1px_0_#D49A1D] md:[text-shadow:-3px_-3px_0_#D49A1D,_3px_-3px_0_#D49A1D,_-3px_3px_0_#D49A1D,_3px_3px_0_#D49A1D] break-words">
              Our<br/>Org
            </span>
          </div>
          
          <div class="md:absolute md:left-[470px] flex flex-col w-full md:w-[650px] gap-3 md:gap-4 z-10 md:pr-8">
            <h1 class="m-0 font-roboto text-[22px] md:text-[48px] lg:text-[56px] font-bold leading-tight md:leading-[1.1] text-black break-words">Building our community and impact.</h1>
            <p class="m-0 font-sans text-[15px] md:text-[22px] lg:text-[24px] font-normal leading-relaxed md:leading-[33px] text-black">As a 501(c)(3) non-profit, Next Wave Dev bridges the gap between emerging tech talent and mission-driven organizations. We provide recent graduates with real-world client projects, fostering professional growth while delivering high-quality digital solutions to the communities that need them most.</p>
          </div>
          
        </section>
      </div>
      
    </section>

    <!-- Leadership Grid -->
    <section class="mx-auto mt-16 flex w-full max-w-[1328px] flex-col items-center md:mt-24">
      <h2 class="mb-6 text-center font-roboto text-[40px] font-bold leading-tight text-black md:mb-[60px] md:text-[48px]">Board of Directors</h2>
      <StaffGrid staff={leadershipMembers} />
    </section>

    <!-- Team Section -->
    <section class="w-full mt-8 md:mt-12">
      <GraduatesSection graduates={teamData} title="Our Team" />
    </section>

    <!-- Contact Form -->
    <section class="mx-auto mt-20 w-full max-w-[1125px] relative z-10 mb-12 md:mt-24">
       <ContactSection />
    </section>

  </div>
</Layout>