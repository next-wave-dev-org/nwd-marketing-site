---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import ContactSection from '../../components/ContactSection.astro';
import GraduatesSection from '../../components/GraduatesSection.astro';
import StaffGrid from '../../components/StaffGrid.astro';

const leadershipMembers = [
  { name: 'Taylor Papke', role: 'Program Manager', image: '/images/profiles/taylor-papke.png' }
];

const allGrads = await getCollection('graduates');

const teamData = allGrads.map(g => ({
  id: g.id,
  name: g.data.name || 'Bob Smith',
  image: g.data.image
}));
---

<Layout title="Our Org | Next Wave Dev" description="Building our community and impact">
  <div class="mx-auto w-full max-w-[1440px] overflow-hidden bg-light-aqua px-5 pb-0 pt-10 text-black md:px-8 md:pt-12">
    
    <!-- Hero Section -->
    <section class="mx-auto w-full max-w-[1289px] px-5 md:px-0">
      
      <!-- MOBILE (< 768px) STACKED LAYOUT -->
      <div class="w-full rounded-[10px] bg-gradient-to-b from-light-aqua to-secondary-blue p-6 shadow-md mt-4 md:hidden">
        <div class="flex flex-col items-center text-center gap-6 w-full">
          <div class="flex h-[150px] w-[150px] shrink-0 items-center justify-center rounded-full bg-primary-blue shadow-md mx-auto p-2">
            <h1 class="font-heading text-[18px] sm:text-[20px] font-bold leading-tight text-hero-text text-center drop-shadow-sm [text-shadow:-1px_-1px_0_#D49A1D,_1px_-1px_0_#D49A1D,_-1px_1px_0_#D49A1D,_1px_1px_0_#D49A1D] break-words">
              Our<br/>Org
            </h1>
          </div>
          <div class="flex flex-col gap-3 w-full">
            <h2 class="font-roboto text-[22px] font-bold leading-tight text-black break-words">
              Building our community and impact
            </h2>
            <p class="font-sans text-[15px] font-normal leading-relaxed text-black">
              As a 501(c)(3) non-profit, Next Wave Dev bridges the gap between emerging tech talent and mission-driven organizations. We provide recent graduates with real-world client projects, fostering professional growth while delivering high-quality digital solutions to the communities that need them most.
            </p>
          </div>
        </div>
      </div>

      <!-- DESKTOP (>= 768px) -->
      <div class="hidden md:flex mx-auto w-full flex-col overflow-hidden rounded-[10px] bg-gradient-to-b from-light-aqua to-secondary-blue shadow-lg">
        <section class="relative flex h-[489px] w-full items-center">
          <div class="absolute left-[47px] top-[19px] z-10 flex h-[390px] w-[390px] items-center justify-center rounded-full bg-primary-blue shadow-lg p-6">
            <h1 class="w-full text-center font-heading text-[52px] lg:text-[60px] font-bold leading-[1.1] text-hero-text drop-shadow-card [text-shadow:-3px_-3px_0_#D49A1D,_3px_-3px_0_#D49A1D,_-3px_3px_0_#D49A1D,_3px_3px_0_#D49A1D] break-words">
              Our<br/>Org
            </h1>
          </div>
          <div class="absolute left-[470px] flex w-[650px] flex-col gap-4 text-left z-10 pr-8">
            <h2 class="m-0 font-roboto text-[48px] lg:text-[56px] font-bold leading-[1.1] text-black break-words">
              Building our community and impact
            </h2>
            <p class="m-0 font-sans text-[22px] lg:text-[24px] font-normal leading-[33px] text-black">
              As a 501(c)(3) non-profit, Next Wave Dev bridges the gap between emerging tech talent and mission-driven organizations. We provide recent graduates with real-world client projects, fostering professional growth while delivering high-quality digital solutions to the communities that need them most.
            </p>
          </div>
        </section>
      </div>
      
    </section>

    <!-- Leadership Grid -->
    <section class="mx-auto mt-16 flex w-full max-w-[1328px] flex-col items-center md:mt-24">
      <!-- FIXED: Changed mb-12 to mb-6 on mobile so it hugs the profile card -->
      <h2 class="mb-6 text-center font-roboto text-[40px] font-bold leading-tight text-black md:mb-[60px] md:text-[48px]">
        Leadership
      </h2>
      <StaffGrid staff={leadershipMembers} />
    </section>

    <!-- Team Section -->
    <section class="w-full mt-8 md:mt-12">
      <GraduatesSection graduates={teamData} title="Team" />
    </section>

    <!-- Contact Form -->
    <section class="mx-auto mt-20 w-full max-w-[1125px] relative z-10 md:mt-24">
       <ContactSection />
    </section>

  </div>
</Layout>