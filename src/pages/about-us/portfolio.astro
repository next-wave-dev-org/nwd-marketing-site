---
import Layout from '../../layouts/Layout.astro';
import ContactSection from '../../components/ContactSection.astro';

const projects = [
  {
    company: "Acme Corporation",
    title: "E-Commerce Platform Redesign",
    description: "A complete overhaul of the front-end shopping experience, leading to a 35% increase in mobile conversions. Built with React and Tailwind CSS.",
    link: "#"
  },
  {
    company: "Global Tech Solutions",
    title: "Analytics Dashboard",
    description: "Engineered a robust back-end analytics dashboard handling thousands of concurrent users, providing real-time data visualization.",
    link: "#"
  },
  {
    company: "Seattle Community Non-Profit",
    title: "Volunteer Management Portal",
    description: "Designed and developed an accessible platform to coordinate community volunteers, track hours, and manage local outreach events.",
    link: "#"
  },
  {
    company: "Stellar Startup",
    title: "Marketing Landing Page",
    description: "Delivered a high-performance, SEO-optimized marketing campaign site that increased brand visibility and lead generation.",
    link: "#"
  }
];
---

<Layout title="Portfolio | Next Wave Dev" description="See the projects our graduates have built.">
  <div class="mx-auto w-full max-w-[1440px] overflow-hidden bg-light-aqua px-5 pb-16 pt-10 text-black md:px-8 md:pb-24 md:pt-12">
    
    <!-- Hero Section -->
    <section class="mx-auto w-full max-w-[1202px]">
      <div class="grid grid-cols-[186px_1fr] items-center gap-6 md:grid-cols-[529px_1fr] md:gap-[128px]">
        
        <!-- Badge -->
        <div class="relative h-[220px] w-[186px] overflow-hidden rounded-[10px] bg-gradient-to-b from-light-aqua to-secondary-blue md:h-[560px] md:w-full">
          <div class="absolute left-1/2 top-1/2 flex h-[160px] w-[160px] -translate-x-1/2 -translate-y-1/2 items-center justify-center rounded-full bg-primary-blue shadow-lg md:h-[420px] md:w-[420px]">
            <h1 class="relative z-10 w-full px-2 text-center font-heading text-[26px] font-bold leading-[1.2] text-hero-text drop-shadow-[0_4px_4px_rgba(0,0,0,0.25)] [text-shadow:-2px_-2px_0_#D49A1D,_2px_-2px_0_#D49A1D,_-2px_2px_0_#D49A1D,_2px_2px_0_#D49A1D] md:px-4 md:text-[56px] md:[text-shadow:-3px_-3px_0_#D49A1D,_3px_-3px_0_#D49A1D,_-3px_3px_0_#D49A1D,_3px_3px_0_#D49A1D]">
              Portfolio
            </h1>
          </div>
        </div>
        
        <!-- Text Content -->
        <div class="max-w-[600px] pl-4 pr-1 md:max-w-[440px] md:translate-x-[130px] md:pl-0 md:pr-0">
          <h2 class="font-roboto text-[28px] font-bold leading-tight text-black md:text-[56px] md:leading-[64px]">
            Our Past Work
          </h2>
          <p class="mt-3 font-sans text-[16px] font-normal leading-relaxed text-black md:mt-4 md:text-[24px] md:leading-[33px]">
            Explore the high-quality tech solutions our students and graduates have delivered for companies, non-profits, and local businesses.
          </p>
        </div>
        
      </div>
    </section>

    <!-- Projects Grid -->
    <section class="mx-auto w-full max-w-[1310px] mt-20 md:mt-32 pb-12">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-x-[60px] gap-y-[80px]">
        {projects.map((project) => (
          <div class="flex flex-col w-full bg-white rounded-[20px] p-6 shadow-md transition-transform hover:-translate-y-2 hover:shadow-lg">
            <!-- Image Placeholder -->
            <div class="w-full h-[250px] md:h-[320px] bg-image-placeholder rounded-[15px] flex items-center justify-center mb-6">
              <span class="font-sans text-[20px] text-black/50">Project Image Placeholder</span>
            </div>
            
            <h4 class="font-roboto text-[18px] font-bold text-primary-blue uppercase tracking-wider mb-2">
              {project.company}
            </h4>
            <h3 class="font-roboto text-[28px] md:text-[32px] font-bold text-black leading-tight mb-4">
              {project.title}
            </h3>
            <p class="font-sans text-[16px] md:text-[18px] font-normal leading-relaxed text-black mb-8 flex-grow">
              {project.description}
            </p>
            
            <a href={project.link} class="inline-flex w-max items-center justify-center rounded-[30px] bg-dark-blue px-8 py-[12px] font-roboto text-[18px] font-bold text-white transition-colors hover:bg-black shadow-sm">
              View Project
            </a>
          </div>
        ))}
      </div>
    </section>

    <!-- Contact Form -->
    <section class="mx-auto mt-8 w-full max-w-[1125px] relative z-10 md:mt-12">
       <ContactSection />
    </section>

  </div>
</Layout>