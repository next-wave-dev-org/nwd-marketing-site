---
import Layout from '../../layouts/Layout.astro';
import Button from '../../components/Button.astro';

const projects = [
  {
    company: "Draw The Block",
    title: "Community Art Market Website",
    description: "A fast, accessible, and fully responsive static website built to support a local Seattle art market. By highlighting vendor directories, upcoming events, and community resources, we helped drive local engagement while giving our developers experience shipping a production-ready application.",
    link: "https://drawtheblock.org",
    image: "/images/dtb-website-screenshot.png"
  }
];
---

<Layout title="Our Work | Next Wave Dev" description="Explore the digital solutions we've built for mission-driven organizations.">
  <div class="mx-auto w-full max-w-[1440px] overflow-hidden bg-background px-5 pb-0 pt-10 text-white md:px-8 md:pt-12">
    
    <section class="mx-auto w-full max-w-[1289px] px-0">
      
      <!-- UNIFIED RESPONSIVE PAGE HERO -->
      <div class="w-full flex flex-col lg:overflow-hidden rounded-[10px] bg-gradient-to-b from-surface to-background border border-border-subtle p-6 md:p-0 shadow-xl mt-4 md:mt-0">
        <section class="relative flex flex-col lg:flex-row lg:h-[489px] w-full items-center text-center md:text-left gap-6 md:gap-0">
          
          <div class="xl:absolute xl:left-[47px] xl:top-[19px] z-10 flex h-[150px] w-[150px] xl:h-[390px] xl:w-[390px] shrink-0 items-center justify-center rounded-full bg-gradient-to-r from-accent-primary to-accent-secondary border border-border-subtle shadow-2xl mx-auto md:mx-0 p-2 xl:p-8">
            <span class="block w-full font-heading text-[18px] sm:text-[20px] xl:text-[52px] font-bold leading-tight md:leading-[1.1] text-white text-center drop-shadow-md break-words">
              Our<br/>Work
            </span>
          </div>
          
          <div class="xl:absolute xl:left-[470px] flex flex-col w-full xl:w-[650px] gap-3 md:gap-4 z-10 md:pr-8">
            <h1 class="m-0 font-roboto text-[22px] md:text-[48px] lg:text-[56px] font-bold leading-tight md:leading-[1.1] text-white break-words">Recent Work</h1>
            <p class="m-0 font-sans text-[15px] md:text-[22px] lg:text-[24px] font-normal leading-relaxed md:leading-[33px] text-text-body">Explore the high-quality tech solutions our students and graduates have delivered for companies, non-profits, and local businesses.</p>
          </div>
          
        </section>
      </div>
      
    </section>

    <!-- Projects List -->
    <section class="mx-auto w-full max-w-[1223px] mt-16 md:mt-24 pb-12">
      <div class="flex flex-col gap-16 md:gap-24">
        {projects.map((project) => (
          <div class="flex flex-col xl:flex-row items-center justify-between rounded-[20px] bg-surface border border-border-subtle p-6 md:p-8 xl:p-12 shadow-xl gap-8 xl:gap-[60px]">
            <div class="flex w-full xl:w-[600px] shrink-0 items-center justify-center rounded-[15px] bg-background overflow-hidden shadow-inner border border-border-subtle">
              <img src={project.image} alt={`Screenshot of ${project.title}`} class="w-full h-auto object-cover opacity-90" />
            </div>
            <div class="flex flex-col gap-5 w-full text-center xl:text-left">
              <span class="block font-roboto text-[18px] font-bold text-accent-cyan uppercase tracking-wider m-0">{project.company}</span>
              <h2 class="font-roboto text-[28px] xl:text-[40px] font-bold leading-tight text-white m-0">{project.title}</h2>
              <p class="font-sans text-[16px] xl:text-[20px] font-normal leading-relaxed text-text-body m-0">
                {project.description}
              </p>
              <div class="mt-2 flex justify-center xl:justify-start">
                <Button href={project.link} label="Visit Website" rel="noopener noreferrer" target="_blank" variant="primary" />
              </div>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- Contextual CTA -->
    <section class="mx-auto mt-8 w-full max-w-[1125px] relative z-10 mb-12">
       <div class="flex flex-col items-center justify-center rounded-[20px] bg-surface border border-border-subtle px-6 py-12 md:py-20 text-center shadow-xl w-full">
         <h2 class="font-roboto text-[32px] md:text-[48px] font-bold text-white m-0 mb-4">Start a project like this</h2>
         <p class="font-sans text-[18px] md:text-[24px] text-text-body m-0 mb-8 max-w-[600px]">Get enterprise-grade digital services at highly accessible non-profit rates.</p>
         <Button href="/contact" label="Request a Quote" variant="primary" />
       </div>
    </section>

  </div>
</Layout>