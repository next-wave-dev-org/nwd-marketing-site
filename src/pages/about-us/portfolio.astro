---
import Layout from '../../layouts/Layout.astro';
import ContactSection from '../../components/ContactSection.astro';

const projects = [
  {
    company: "Draw The Block",
    title: "Community Art Market Website",
    description: "A fast, accessible, and fully responsive static website built to support a local Seattle art market. It highlights vendor directories, upcoming events, and community resources to drive local engagement.",
    link: "https://drawtheblock.org",
    image: "/images/partner-dtb-logo.png"
  }
];
---

<Layout title="Portfolio | Next Wave Dev" description="See the projects our graduates have built.">
  <div class="mx-auto w-full max-w-[1440px] overflow-hidden bg-light-aqua px-5 pb-0 pt-10 text-black md:px-8 md:pt-12">
    
    <section class="mx-auto w-full max-w-[1289px] px-0">
      
      <!-- UNIFIED RESPONSIVE PAGE HERO -->
      <div class="w-full flex flex-col md:overflow-hidden rounded-[10px] bg-gradient-to-b from-light-aqua to-secondary-blue p-6 md:p-0 shadow-md md:shadow-lg mt-4 md:mt-0">
        <section class="relative flex flex-col md:flex-row md:h-[489px] w-full items-center text-center md:text-left gap-6 md:gap-0">
          
          <div class="md:absolute md:left-[47px] md:top-[19px] z-10 flex h-[150px] w-[150px] md:h-[390px] md:w-[390px] shrink-0 items-center justify-center rounded-full bg-primary-blue shadow-md md:shadow-lg mx-auto md:mx-0 p-2 md:p-8">
            <span class="block w-full font-heading text-[18px] sm:text-[20px] md:text-[48px] lg:text-[52px] font-bold leading-tight md:leading-[1.1] text-hero-text text-center drop-shadow-sm md:drop-shadow-card [text-shadow:-1px_-1px_0_#D49A1D,_1px_-1px_0_#D49A1D,_-1px_1px_0_#D49A1D,_1px_1px_0_#D49A1D] md:[text-shadow:-3px_-3px_0_#D49A1D,_3px_-3px_0_#D49A1D,_-3px_3px_0_#D49A1D,_3px_3px_0_#D49A1D] break-words">
              Portfolio
            </span>
          </div>
          
          <div class="md:absolute md:left-[470px] flex flex-col w-full md:w-[650px] gap-3 md:gap-4 z-10 md:pr-8">
            <h1 class="m-0 font-roboto text-[22px] md:text-[48px] lg:text-[56px] font-bold leading-tight md:leading-[1.1] text-black break-words">Our Past Work</h1>
            <p class="m-0 font-sans text-[15px] md:text-[22px] lg:text-[24px] font-normal leading-relaxed md:leading-[33px] text-black">Explore the high-quality tech solutions our students and graduates have delivered for companies, non-profits, and local businesses.</p>
          </div>
          
        </section>
      </div>
      
    </section>

    <!-- Projects Grid -->
    <section class="mx-auto w-full max-w-[1310px] mt-20 md:mt-32 pb-12">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-x-[60px] gap-y-[80px]">
        {projects.map((project) => (
          <div class="flex flex-col w-full bg-white rounded-[20px] p-6 shadow-md transition-transform hover:-translate-y-2 hover:shadow-lg">
            <div class="w-full h-[250px] md:h-[320px] bg-primary-blue rounded-[15px] flex items-center justify-center mb-6 overflow-hidden shadow-inner p-8">
              <img src={project.image} alt={`${project.company} Logo`} class="w-full h-full object-contain" />
            </div>
            <h4 class="font-roboto text-[18px] font-bold text-primary-blue uppercase tracking-wider mb-2">
              {project.company}
            </h4>
            <h3 class="font-roboto text-[28px] md:text-[32px] font-bold text-black leading-tight mb-4">
              {project.title}
            </h3>
            <p class="font-sans text-[16px] md:text-[18px] font-normal leading-relaxed text-black mb-8 flex-grow">
              {project.description}
            </p>
            <a href={project.link} target={project.link !== "#" ? "_blank" : undefined} rel={project.link !== "#" ? "noopener noreferrer" : undefined} class="inline-flex w-max items-center justify-center rounded-[30px] bg-dark-blue px-8 py-[12px] font-roboto text-[18px] font-bold text-white transition-colors hover:bg-black shadow-sm">
              View Project
            </a>
          </div>
        ))}
      </div>
    </section>

    <!-- Contact Form -->
    <section class="mx-auto mt-8 w-full max-w-[1125px] relative z-10 mb-12 md:mt-12">
       <ContactSection />
    </section>

  </div>
</Layout>