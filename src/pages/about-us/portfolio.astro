---
import Layout from '../../layouts/Layout.astro';
import ContactSection from '../../components/ContactSection.astro';

const projects = [
  {
    company: "Draw The Block",
    title: "Community Art Market Website",
    description: "A fast, accessible, and fully responsive static website built to support a local Seattle art market. It highlights vendor directories, upcoming events, and community resources to drive local engagement.",
    link: "https://github.com/next-wave-dev-org/draw-the-block-static-site",
    image: "/images/partner-dtb-logo.png"
  },
  {
    company: "Card Cave Games",
    title: "E-Commerce Retail Platform",
    description: "An upcoming digital storefront tailored for a local trading card retailer. The project focuses on streamlining inventory management, optimizing the e-commerce shopping experience, and processing online transactions for collectors and players.",
    link: "#",
    image: "/images/partner-ccg-logo.png"
  }
];
---

<Layout title="Portfolio | Next Wave Dev" description="See the projects our graduates have built.">
  <div class="mx-auto w-full max-w-[1440px] overflow-hidden bg-light-aqua px-5 pb-0 pt-10 text-black md:px-8 md:pt-12">
    
    <section class="mx-auto w-full max-w-[1289px] px-5 md:px-0">
      
      <!-- MOBILE (< 768px) -->
      <div class="w-full rounded-[10px] bg-gradient-to-b from-light-aqua to-secondary-blue p-6 shadow-md mt-4 md:hidden">
        <div class="flex flex-col items-center text-center gap-6 w-full">
          <div class="flex h-[150px] w-[150px] shrink-0 items-center justify-center rounded-full bg-primary-blue shadow-md mx-auto p-2">
            <h1 class="w-full font-heading text-[18px] sm:text-[20px] font-bold leading-tight text-hero-text text-center drop-shadow-sm [text-shadow:-1px_-1px_0_#D49A1D,_1px_-1px_0_#D49A1D,_-1px_1px_0_#D49A1D,_1px_1px_0_#D49A1D] break-words">
              Portfolio
            </h1>
          </div>
          <div class="flex flex-col gap-3 w-full">
            <h2 class="font-roboto text-[22px] font-bold leading-tight text-black break-words">Our Past Work</h2>
            <p class="font-sans text-[15px] font-normal leading-relaxed text-black">Explore the high-quality tech solutions our students and graduates have delivered for companies, non-profits, and local businesses.</p>
          </div>
        </div>
      </div>

      <!-- DESKTOP (>= 768px) -->
      <div class="hidden md:flex mx-auto w-full flex-col overflow-hidden rounded-[10px] bg-gradient-to-b from-light-aqua to-secondary-blue shadow-lg">
        <section class="relative flex h-[489px] w-full items-center">
          <div class="absolute left-[47px] top-[19px] z-10 flex h-[390px] w-[390px] items-center justify-center rounded-full bg-primary-blue shadow-lg p-8">
            <h1 class="w-full text-center font-heading text-[48px] lg:text-[52px] font-bold leading-[1.1] text-hero-text drop-shadow-card [text-shadow:-3px_-3px_0_#D49A1D,_3px_-3px_0_#D49A1D,_-3px_3px_0_#D49A1D,_3px_3px_0_#D49A1D] break-words">
              Portfolio
            </h1>
          </div>
          <div class="absolute left-[470px] flex w-[650px] flex-col gap-4 text-left z-10 pr-8">
            <h2 class="m-0 font-roboto text-[48px] lg:text-[56px] font-bold leading-[1.1] text-black break-words">Our Past Work</h2>
            <p class="m-0 font-sans text-[22px] lg:text-[24px] font-normal leading-[33px] text-black">Explore the high-quality tech solutions our students and graduates have delivered for companies, non-profits, and local businesses.</p>
          </div>
        </section>
      </div>
      
    </section>

    <!-- Projects Grid -->
    <section class="mx-auto w-full max-w-[1310px] mt-20 md:mt-32 pb-12">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-x-[60px] gap-y-[80px]">
        {projects.map((project) => (
          <div class="flex flex-col w-full bg-white rounded-[20px] p-6 shadow-md transition-transform hover:-translate-y-2 hover:shadow-lg">
            <div class="w-full h-[250px] md:h-[320px] bg-primary-blue rounded-[15px] flex items-center justify-center mb-6 overflow-hidden shadow-inner p-8">
              <img src={project.image} alt={`${project.company} Logo`} class="w-full h-full object-contain" />
            </div>
            <h4 class="font-roboto text-[18px] font-bold text-primary-blue uppercase tracking-wider mb-2">
              {project.company}
            </h4>
            <h3 class="font-roboto text-[28px] md:text-[32px] font-bold text-black leading-tight mb-4">
              {project.title}
            </h3>
            <p class="font-sans text-[16px] md:text-[18px] font-normal leading-relaxed text-black mb-8 flex-grow">
              {project.description}
            </p>
            <a href={project.link} target={project.link !== "#" ? "_blank" : undefined} rel={project.link !== "#" ? "noopener noreferrer" : undefined} class="inline-flex w-max items-center justify-center rounded-[30px] bg-dark-blue px-8 py-[12px] font-roboto text-[18px] font-bold text-white transition-colors hover:bg-black shadow-sm">
              View Project
            </a>
          </div>
        ))}
      </div>
    </section>

    <!-- Contact Form -->
    <section class="mx-auto mt-8 w-full max-w-[1125px] relative z-10 mb-12 md:mt-12">
       <ContactSection />
    </section>

  </div>
</Layout>