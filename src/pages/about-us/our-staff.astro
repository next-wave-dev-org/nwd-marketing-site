---
import Layout from '../../layouts/Layout.astro';
import ContactSection from '../../components/ContactSection.astro';
import ProfileCard from '../../components/ProfileCard.astro';
import GraduatesSection from '../../components/GraduatesSection.astro';
import StaffGrid from '../../components/StaffGrid.astro';

// Data Mocking
const ceos = [
  { name: 'Bob Smith', role: 'CEO', bio: 'Placeholder text here to fill this section to make it look real. This body text is just random fill to fill this section to make things look real for placeholder purposes. Also more words.' },
  { name: 'Bob Smith', role: 'CTO', bio: 'Placeholder text here to fill this section to make it look real. This body text is just random fill to fill this section to make things look real for placeholder purposes. Also more words.' }
];

// 11 total staff members to feed the 4-3-4 row component
const staffMembers = Array(11).fill({ name: 'Bob Smith', role: 'Program Manager' });

// Using the graduates data established in index.astro
const graduatesData = ['Bob Smith', 'Bob Smith', 'Bob Smith', 'Bob Smith'];
---

<Layout title="Our Staff | Next Wave Dev" description="See who runs the org">
  <div class="mx-auto w-full max-w-[1440px] overflow-hidden bg-light-aqua px-5 pb-16 pt-10 text-black md:px-8 md:pb-24 md:pt-12">
    
    <!-- Hero Section -->
    <section class="mx-auto w-full max-w-[1202px]">
      <div class="grid grid-cols-[186px_1fr] items-center gap-6 md:grid-cols-[400px_1fr] md:gap-[128px]">
        
        <!-- Badge -->
        <div class="relative h-[220px] w-[186px] overflow-hidden rounded-[10px] bg-gradient-to-b from-light-aqua to-secondary-blue md:h-[400px] md:w-full">
          <div class="absolute left-1/2 top-1/2 h-[160px] w-[160px] -translate-x-1/2 -translate-y-1/2 rounded-full bg-primary-blue md:h-[280px] md:w-[280px]"></div>
          <h1 class="absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 text-center font-unbounded text-[32px] font-bold leading-[1.15] text-white drop-shadow-[0_4px_4px_rgba(0,0,0,0.25)] md:text-[64px]">
            Our<br/>Staff
          </h1>
        </div>
        
        <!-- Text Content -->
        <div class="w-full max-w-[600px] pl-4 pr-1 md:pl-0 md:pr-0">
          <h2 class="font-roboto text-[26px] font-bold leading-tight md:text-[48px] md:leading-[56px] text-black">
            See who runs the org
          </h2>
          <p class="mt-3 font-open-sans text-[14px] leading-[1.4] md:mt-5 md:text-[20px] md:leading-[24px] text-black">
            Placeholder text here to fill this section to make it look real. This body text is just random fill to fill this section to make things look real for placeholder purposes. Also more words.
          </p>
        </div>
        
      </div>
    </section>

    <!-- CEO Spotlight Section (Forced Side-by-Side) -->
    <section class="mx-auto mt-20 flex w-full max-w-[1100px] flex-row flex-nowrap items-start justify-center gap-4 md:mt-[140px] md:gap-[100px] lg:gap-[150px]">
      {ceos.map((leader) => (
        <div class="flex w-1/2 flex-col items-center">
          <div class="flex w-full justify-center transform scale-[0.85] sm:scale-100 lg:scale-125 mb-4 lg:mb-16">
             <ProfileCard name={leader.name} role={leader.role} />
          </div>
          <p class="mt-2 text-center font-inter text-[13px] sm:text-[16px] leading-[1.4] text-black lg:text-left lg:text-[20px] max-w-[450px]">
            {leader.bio}
          </p>
        </div>
      ))}
    </section>

    <!-- Staff Members Grid (4-3-4 Component) -->
    <section class="mx-auto mt-24 flex w-full max-w-[1328px] flex-col items-center md:mt-[180px]">
      <h2 class="mb-12 text-center font-roboto text-[40px] font-bold leading-tight text-black md:mb-[80px] md:text-[48px]">
        Staff Members
      </h2>
      <StaffGrid staff={staffMembers} />
    </section>

    <!-- Graduates Section Component -->
    <section class="w-full mt-8 md:mt-12">
      <GraduatesSection graduates={graduatesData} />
    </section>

    <!-- Contact Form -->
    <section class="mx-auto mt-20 w-full max-w-[1125px] relative z-10 md:mt-24">
       <ContactSection />
    </section>

  </div>
</Layout>