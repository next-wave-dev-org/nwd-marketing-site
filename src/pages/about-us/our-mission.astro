---
import Layout from '../../layouts/Layout.astro';
import ContactSection from '../../components/ContactSection.astro';

const coreValues = [
  { title: "Empowering Students", description: "Providing the essential bridge between academic theory and practical, real-world application." },
  { title: "Delivering Quality", description: "Ensuring every tech solution we produce meets rigorous industry standards." },
  { title: "Fostering Mentorship", description: "Pairing emerging talent with experienced industry professionals to guide their growth." },
  { title: "Community Impact", description: "Building accessible, human-centered digital experiences for organizations that matter." }
];
---

<Layout title="Our Mission | Next Wave Dev" description="Bridging the gap between classroom learning and career success.">
  <div class="mx-auto w-full max-w-[1440px] overflow-hidden bg-light-aqua px-5 pb-0 pt-10 text-black md:px-8 md:pt-12">
    
    <!-- Hero Section -->
    <section class="mx-auto w-full max-w-[1289px] px-5 md:px-0">
      
      <!-- MOBILE (< 768px) STACKED LAYOUT FIX -->
      <div class="w-full rounded-[10px] bg-gradient-to-b from-light-aqua to-secondary-blue p-6 shadow-md mt-4 md:hidden">
        <div class="flex flex-col items-center text-center gap-6 w-full">
          <div class="flex h-[150px] w-[150px] shrink-0 items-center justify-center rounded-full bg-primary-blue shadow-md mx-auto p-2">
            <h1 class="font-heading text-[18px] sm:text-[20px] font-bold leading-tight text-hero-text text-center drop-shadow-sm [text-shadow:-1px_-1px_0_#D49A1D,_1px_-1px_0_#D49A1D,_-1px_1px_0_#D49A1D,_1px_1px_0_#D49A1D] break-words">
              Our<br/>Mission
            </h1>
          </div>
          <div class="flex flex-col gap-3 w-full">
            <h2 class="font-roboto text-[22px] font-bold leading-tight text-black break-words">Our Purpose</h2>
            <p class="font-sans text-[15px] font-normal leading-relaxed text-black">Bridging the gap between classroom learning and career success, we equip students and recent graduates with the skills, mentorship, and real-world experience needed to deliver high-quality tech solutions.</p>
          </div>
        </div>
      </div>

      <!-- DESKTOP (>= 768px) Standardized Layout -->
      <div class="hidden md:flex mx-auto w-full flex-col overflow-hidden rounded-[10px] bg-gradient-to-b from-light-aqua to-secondary-blue shadow-lg">
        <section class="relative flex h-[489px] w-full items-center">
          <div class="absolute left-[47px] top-[19px] z-10 flex h-[390px] w-[390px] items-center justify-center rounded-full bg-primary-blue shadow-lg p-6">
            <h1 class="w-full text-center font-heading text-[52px] lg:text-[60px] font-bold leading-[1.1] text-hero-text drop-shadow-card [text-shadow:-3px_-3px_0_#D49A1D,_3px_-3px_0_#D49A1D,_-3px_3px_0_#D49A1D,_3px_3px_0_#D49A1D] break-words">
              Our<br/>Mission
            </h1>
          </div>
          <div class="absolute left-[470px] flex w-[650px] flex-col gap-4 text-left z-10 pr-8">
            <h2 class="m-0 font-roboto text-[48px] lg:text-[56px] font-bold leading-[1.1] text-black break-words">
              Our Purpose
            </h2>
            <p class="m-0 font-sans text-[22px] lg:text-[24px] font-normal leading-[33px] text-black">
              Bridging the gap between classroom learning and career success, we equip students and recent graduates with the skills, mentorship, and real-world experience needed to deliver high-quality tech solutions.
            </p>
          </div>
        </section>
      </div>
      
    </section>

    <!-- Core Values Section -->
    <section class="mx-auto w-full max-w-[1310px] mt-16 md:mt-24 pb-12">
      <div class="w-full rounded-[20px] bg-gradient-to-b from-light-aqua to-secondary-blue/70 p-6 shadow-lg lg:rounded-[40px] lg:p-12">
        <div class="flex w-full flex-col gap-6 rounded-[40px] bg-dark-blue p-6 md:p-[52px] shadow-xl">
          <div class="w-max rounded-[15px] md:rounded-[20px] bg-primary-blue px-6 py-4 md:px-[40px] md:py-[24px] shadow-md">
            <h2 class="m-0 font-roboto text-[28px] md:text-[48px] font-bold !text-hero-text">Core Values</h2>
          </div>
          
          <div class="mt-4 grid grid-cols-1 md:grid-cols-2 gap-6">
            {coreValues.map((value) => (
              <div class="flex flex-col rounded-[20px] bg-primary-blue px-6 py-6 md:px-[40px] md:py-[32px] shadow-md">
                <h3 class="m-0 mb-3 font-roboto text-[22px] md:text-[32px] font-bold !text-hero-text">{value.title}</h3>
                <p class="m-0 font-sans text-[16px] md:text-[20px] font-normal leading-relaxed !text-hero-text">{value.description}</p>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- Contact Form -->
    <section class="mx-auto mt-8 w-full max-w-[1125px] relative z-10 mb-12 md:mt-12">
       <ContactSection />
    </section>

  </div>
</Layout>