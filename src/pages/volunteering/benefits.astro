---
import Layout from '../../layouts/Layout.astro';
import ContactSection from '../../components/ContactSection.astro';
import BenefitsContent from '../../components/BenefitsContent.astro';
---
<Layout title="Volunteer Benefits | Next Wave Dev" description="See the perks of volunteering.">
  <div class="mx-auto w-full max-w-[1440px] overflow-hidden bg-light-aqua px-5 pb-0 pt-10 text-black md:px-8 md:pt-12">
    <section class="mx-auto w-full max-w-[1289px] px-5 md:px-0">
      
      <!-- MOBILE VERTICAL STACK FIX -->
      <div class="w-full rounded-[10px] bg-gradient-to-b from-light-aqua to-secondary-blue p-6 shadow-md mt-4 md:hidden">
        <div class="flex flex-col items-center text-center gap-6 w-full">
          <div class="flex h-[150px] w-[150px] shrink-0 items-center justify-center rounded-full bg-primary-blue shadow-md mx-auto p-2">
            <h1 class="font-heading text-[17px] font-bold leading-tight text-hero-text text-center drop-shadow-sm [text-shadow:-1px_-1px_0_#D49A1D,_1px_-1px_0_#D49A1D,_-1px_1px_0_#D49A1D,_1px_1px_0_#D49A1D] break-words">Benefits</h1>
          </div>
          <div class="flex flex-col gap-3 w-full">
            <h2 class="font-roboto text-[22px] font-bold leading-tight text-black break-words">Volunteer Perks</h2>
            <p class="font-sans text-[15px] font-normal leading-relaxed text-black">Join a community dedicated to growth and impact. As a volunteer at Next Wave Dev, you'll gain hands-on experience, build a professional portfolio, and receive mentorship—all while helping mission-driven organizations thrive.</p>
          </div>
        </div>
      </div>

      <!-- DESKTOP -->
      <div class="hidden md:flex mx-auto w-full flex-col overflow-hidden rounded-[10px] bg-gradient-to-b from-light-aqua to-secondary-blue shadow-lg">
        <section class="relative flex h-[489px] w-full items-center">
          <div class="absolute left-[47px] top-[19px] z-10 flex h-[390px] w-[390px] items-center justify-center rounded-full bg-primary-blue shadow-lg p-6">
            <h1 class="w-full text-center font-heading text-[60px] font-bold leading-[1.1] text-hero-text drop-shadow-card [text-shadow:-3px_-3px_0_#D49A1D,_3px_-3px_0_#D49A1D,_-3px_3px_0_#D49A1D,_3px_3px_0_#D49A1D] break-words">Benefits</h1>
          </div>
          <div class="absolute left-[470px] flex w-[650px] flex-col gap-4 text-left z-10 pr-8">
            <h2 class="m-0 font-roboto text-[56px] font-bold leading-[1.1] text-black break-words">Volunteer Perks</h2>
            <p class="m-0 font-sans text-[24px] font-normal leading-[33px] text-black">Join a community dedicated to growth and impact. As a volunteer at Next Wave Dev, you'll gain hands-on experience, build a professional portfolio, and receive mentorship—all while helping mission-driven organizations thrive.</p>
          </div>
        </section>
      </div>
    </section>

    <section class="mx-auto w-full max-w-[1310px] mt-16 md:mt-24 pb-12"><BenefitsContent /></section>
    <section class="mx-auto mt-8 w-full max-w-[1125px] relative z-10 mb-12"><ContactSection /></section>
  </div>
</Layout>