---
// src/pages/volunteering.astro
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import VolunteeringHero from '../components/VolunteeringHero.astro';
import VolunteeringExperienceTrack from '../components/VolunteeringExperienceTrack.astro';
import VolunteeringMentorTrack from '../components/VolunteeringMentorTrack.astro';
import GraduatesSection from '../components/GraduatesSection.astro';
import ContactSection from '../components/ContactSection.astro';

const allGrads = await getCollection('graduates');
const teamData = allGrads.map(g => ({
  id: g.id,
  name: g.data.name || 'Bob Smith',
  image: g.data.image
}));
---
<Layout title="Volunteering | Next Wave Dev" description="Gain professional work experience or become a mentor.">
  <div class="mx-auto w-full max-w-[1440px] overflow-x-hidden bg-light-aqua pb-0 font-sans text-black">
    <main class="flex flex-col w-full pt-8 md:pt-12 px-6 md:px-[115px] pb-12">
      <VolunteeringHero />
      <div class="mt-[80px] md:mt-[120px] w-full"><VolunteeringExperienceTrack /></div>
      <div class="mt-[100px] md:mt-[160px] w-full"><VolunteeringMentorTrack /></div>
      <div class="mt-[50px] md:mt-[80px] w-full"><GraduatesSection graduates={teamData} title="Team" /></div>
      <div class="mt-[80px] md:mt-[120px] w-full max-w-[1125px] mx-auto"><ContactSection /></div>
    </main>
  </div>
</Layout>
