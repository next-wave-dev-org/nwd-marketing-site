---
import Layout from '../layouts/Layout.astro';
import VolunteeringHero from '../components/VolunteeringHero.astro';
import BenefitsContent from '../components/BenefitsContent.astro';
import RolesContent from '../components/RolesContent.astro';
import HowToJoinContent from '../components/HowToJoinContent.astro';
import Button from '../components/Button.astro';

const applicationUrl = "https://docs.google.com/forms/d/e/1FAIpQLSctT3LN53mdK31PISovBb_al5MaDndIOZJt1MzhPERyJ56hEA/viewform?usp=dialog";
---

<Layout title="Volunteering | Next Wave Dev" description="Gain professional work experience or become a mentor.">
  <div class="mx-auto w-full max-w-[1440px] overflow-x-hidden bg-light-aqua pb-0 font-sans text-black">
    <main class="flex flex-col w-full pt-8 md:pt-12 px-0 pb-12">
      
      <div class="w-full px-6 md:px-[115px]">
        <VolunteeringHero />
      </div>
      
      <section class="mx-auto w-full max-w-[1310px] mt-20 md:mt-32 px-6 md:px-8">
        <BenefitsContent />
      </section>

      <section class="mx-auto w-full max-w-[1310px] mt-20 md:mt-32 px-6 md:px-8">
        <RolesContent />
        <div class="flex justify-center mt-10">
            <a href={applicationUrl} target="_blank" rel="noopener noreferrer" class="inline-flex items-center justify-center rounded-[30px] bg-dark-blue px-8 py-[14px] font-roboto text-[18px] md:text-[20px] font-bold text-white transition-colors hover:bg-black shadow-sm outline-none focus-visible:ring-2 focus-visible:ring-primary-blue focus-visible:ring-offset-2">
              Apply Now
            </a>
        </div>
      </section>

      <section class="mx-auto w-full max-w-[1310px] mt-20 md:mt-32 px-6 md:px-8">
        <HowToJoinContent />
      </section>

    </main>
  </div>
</Layout>
