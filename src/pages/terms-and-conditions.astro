---
import Layout from '../layouts/Layout.astro';
import ContactSection from '../components/ContactSection.astro';
---

<Layout title="Terms & Conditions | Next Wave Dev" description="Read our Terms of Service.">
  <div class="mx-auto w-full max-w-[1440px] overflow-hidden bg-light-aqua px-5 pb-16 pt-10 text-black md:px-8 md:pb-24 md:pt-12">
    
    <!-- Hero Section -->
    <section class="mx-auto w-full max-w-[1202px]">
      <div class="grid grid-cols-[186px_1fr] items-center gap-6 md:grid-cols-[529px_1fr] md:gap-[128px]">
        
        <!-- Badge -->
        <div class="relative h-[220px] w-[186px] overflow-hidden rounded-[10px] bg-gradient-to-b from-light-aqua to-secondary-blue md:h-[560px] md:w-full">
          <div class="absolute left-1/2 top-1/2 flex h-[160px] w-[160px] -translate-x-1/2 -translate-y-1/2 items-center justify-center rounded-full bg-primary-blue shadow-lg md:h-[420px] md:w-[420px]">
            <h1 class="relative z-10 w-full px-2 text-center font-heading text-[22px] font-bold leading-[1.2] text-hero-text drop-shadow-[0_4px_4px_rgba(0,0,0,0.25)] [text-shadow:-2px_-2px_0_#D49A1D,_2px_-2px_0_#D49A1D,_-2px_2px_0_#D49A1D,_2px_2px_0_#D49A1D] md:px-4 md:text-[56px] md:[text-shadow:-3px_-3px_0_#D49A1D,_3px_-3px_0_#D49A1D,_-3px_3px_0_#D49A1D,_3px_3px_0_#D49A1D]">
              Terms &<br/>Conditions
            </h1>
          </div>
        </div>
        
        <!-- Text Content -->
        <div class="max-w-[600px] pl-4 pr-1 md:max-w-[440px] md:translate-x-[130px] md:pl-0 md:pr-0">
          <h2 class="font-roboto text-[28px] font-bold leading-tight text-black md:text-[56px] md:leading-[64px]">
            Terms of Service
          </h2>
          <p class="mt-3 font-sans text-[16px] font-normal leading-relaxed text-black md:mt-4 md:text-[24px] md:leading-[33px]">
            Please read these terms and conditions carefully before using our service or interacting with our platform.
          </p>
        </div>
        
      </div>
    </section>

    <!-- Content Block -->
    <section class="mx-auto w-full max-w-[1000px] mt-16 md:mt-24 pb-12">
      <div class="flex flex-col gap-8 rounded-[20px] bg-white p-8 shadow-md lg:p-12">
        
        <div class="flex flex-col gap-4">
          <h3 class="font-roboto text-[24px] md:text-[32px] font-bold text-black">1. Acceptance of Terms</h3>
          <p class="font-sans text-[16px] md:text-[18px] font-normal leading-relaxed text-black">
            Placeholder text for acceptance of terms. By accessing or using the Service you agree to be bound by these Terms. If you disagree with any part of the terms then you may not access the Service.
          </p>
        </div>

        <div class="flex flex-col gap-4">
          <h3 class="font-roboto text-[24px] md:text-[32px] font-bold text-black">2. User Responsibilities</h3>
          <p class="font-sans text-[16px] md:text-[18px] font-normal leading-relaxed text-black">
            Placeholder text for user responsibilities. You are responsible for any activity that occurs through your account and you agree you will not sell, transfer, license or assign your account, followers, username, or any account rights.
          </p>
        </div>

        <div class="flex flex-col gap-4">
          <h3 class="font-roboto text-[24px] md:text-[32px] font-bold text-black">3. Governing Law</h3>
          <p class="font-sans text-[16px] md:text-[18px] font-normal leading-relaxed text-black">
            Placeholder text for governing law. These Terms shall be governed and construed in accordance with the laws of the applicable jurisdiction, without regard to its conflict of law provisions.
          </p>
        </div>

      </div>
    </section>

    <!-- Contact Form -->
    <section class="mx-auto mt-8 w-full max-w-[1125px] relative z-10 md:mt-12">
       <ContactSection />
    </section>

  </div>
</Layout>