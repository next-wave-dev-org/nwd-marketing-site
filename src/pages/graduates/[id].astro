---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import GraduateSidebar from '../../components/GraduateSidebar.astro';
import GraduateDetails from '../../components/GraduateDetails.astro';
import GraduatesSection from '../../components/GraduatesSection.astro';

export async function getStaticPaths() {
  const graduates = await getCollection('graduates');
  return graduates.map((grad) => ({
    params: { id: grad.id }, 
    props: { grad, allGrads: graduates },
  }));
}

const { grad, allGrads } = Astro.props;
const { Content } = await render(grad);

const data = grad.data;
const name = data.name;
const role = data.specialization; 
const location = data.location;
const education = data.education;
const skills = data.skills;
const projects = data.projectLinks;

// Map the collection entries to an array of string names for the GraduatesSection component
const graduateNames = allGrads.map(g => g.data.name || 'Bob Smith');
---

<Layout title={`${name} | Graduate Profile`}>
  <!-- Main Background Container -->
  <div class="mx-auto w-full max-w-[1440px] bg-light-aqua px-6 pb-[200px] pt-12 text-black lg:px-12">
    
    <!-- STRICT CUSTOM CSS GRID (Side-by-side layout) -->
    <div class="guaranteed-desktop-grid">
      
      <!-- LEFT COLUMN (Sidebar Component) -->
      <div class="sidebar-column">
        <GraduateSidebar 
          location={location} 
          education={education} 
        />
      </div>

      <!-- RIGHT COLUMN (Details Component) -->
      <div class="details-column">
        <GraduateDetails 
          name={name} 
          role={role} 
          skills={skills} 
          projects={projects}
        >
          {Content ? (
            <Content />
          ) : (
            <>
              <p>Placeholder text for this bio to fill this section with random words. More words to fill this section to make it look real and some more words here for your eyes.</p>
              <p>Placeholder text for this bio to fill this section with random words. More words to fill this section to make it look real and some more words here for your eyes.</p>
            </>
          )}
        </GraduateDetails>
      </div>

    </div>

    <!-- ============================== -->
    <!-- BOTTOM GRADUATES GRID          -->
    <!-- ============================== -->
    <div class="mt-[50px] w-full">
      <GraduatesSection graduates={graduateNames} />
    </div>

  </div>
</Layout>

<style>
  /* Base Mobile Layout (Stacked) */
  .guaranteed-desktop-grid {
    display: flex;
    flex-direction: column;
    gap: 3rem;
    width: 100%;
    max-width: 1250px;
    margin: 2rem auto 0 auto;
  }
  
  .sidebar-column {
    width: 100%;
  }
  
  .details-column {
    width: 100%;
  }

  /* Strict Desktop Layout (Side-by-Side) */
  @media (min-width: 1024px) {
    .guaranteed-desktop-grid {
      display: grid !important;
      grid-template-columns: 420px minmax(0, 1fr) !important;
      gap: 4rem !important;
      align-items: start !important;
      margin-top: 3rem !important;
    }
  }
</style>